+        s.frame.land_changed_bytes.fetch_add(changed, std::memory_order_relaxed);
+        std::scoped_lock lk{s.mutex};
+        auto& entry = s.changed_ranges[addr];
+        ++entry.first;
+        entry.second += size;
+    }
+}
+
+/// 0920: a trapped guest read of GPU-written memory answered at once (preemptive: the area is
+/// downloaded at fences, so later reads of it are not trapped and see the last landing).
+inline void NoteCpuReadPreemptive(bool frame_in_flight) {
+    State& s = Get();
+    s.frame.cpuread_pre.fetch_add(1, std::memory_order_relaxed);
+    if (frame_in_flight) {
+        s.frame.cpuread_pre_ahead.fetch_add(1, std::memory_order_relaxed);
+    }
+}
