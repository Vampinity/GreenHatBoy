+inline void NoteLanding(u64 addr, u64 size, u64 changed) {
+    State& s = Get();
+    s.frame.land.fetch_add(1, std::memory_order_relaxed);
+    s.frame.land_bytes.fetch_add(size, std::memory_order_relaxed);
+    if (changed != 0) {
