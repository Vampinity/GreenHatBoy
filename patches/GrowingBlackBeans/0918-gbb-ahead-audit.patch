diff --git a/src/video_core/gbb_ahead_audit.h b/src/video_core/gbb_ahead_audit.h
new file mode 100644
index 0000000000..c7bc687d3f
--- /dev/null
+++ b/src/video_core/gbb_ahead_audit.h
@@ -0,0 +1,226 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <memory>
+#include <mutex>
+#include <unordered_map>
+
+#include "common/common_types.h"
+#include "common/logging.h"
+#include "video_core/readback_wait.h"
+
+/// GrowingBlackBeans 0918, with EDEN_NX2_OVERWRITE_CHECK=1: the reads the overwrite check and the
+/// frame-ahead guard (ahead_guard.h) do not see. The buffer cache's "ahead" guest writes (made
+/// after a present whose frame the GPU thread has not finished) are kept here at 64-byte
+/// granularity until that fence, and these are counted per CPU frame:
+///   tex     an image re-upload (TextureCache::RefreshContents) that overlaps an ahead write:
+///           the frame in flight is textured with the next frame's bytes;
+///   desc    a texture or sampler descriptor (TIC/TSC) read that overlaps an ahead write
+///           ("changed": the value differs from the last one read for that slot);
+///   handle  a texture handle or storage buffer pointer read from a constant buffer at a draw
+///           (AheadGuard::ReadGpu) that overlaps an ahead write;
+///   cpuread a guest read of GPU-written memory (reactive flush) while the latest presented
+///           frame's fence is not reached: the game reads a result that frame may still write.
+/// "behind": the present ran ahead although the previous frame was still on the GPU (the case
+/// the gpu_behind full wait covers, skipped with EDEN_UP_AHEAD_ALWAYS=1).
+namespace VideoCore::GbbAheadAudit {
+
+inline constexpr u64 PageBits = 12;
+inline constexpr u64 PageLimit = u64{1} << 24; // 36-bit device addresses
+
+struct Counters {
+    std::atomic<u64> tex{}, tex_bytes{}, tex_first{};
+    std::atomic<u64> desc{}, desc_changed{}, desc_first{};
+    std::atomic<u64> handle{}, handle_first{};
+    std::atomic<u64> cpuread{}, cpuread_ahead{}, cpuread_first{};
+};
+
+struct State {
+    std::mutex mutex;
+    std::unordered_map<u32, u64> chunks; ///< page -> 64-byte chunks written ahead
+    std::unique_ptr<std::atomic<u64>[]> pages{new std::atomic<u64>[PageLimit / 64]()};
+    std::atomic<bool> any{};
+    Counters frame;
+    // 5 s totals (closing thread only)
+    u64 frames{}, behind_frames{}, frames_with_any{}, behind_with_any{};
+    std::array<u64, 5> totals{};
+    std::chrono::steady_clock::time_point start{};
+    u64 lines{};
+    std::array<std::atomic<u8>, 1024> behind{}; ///< by present number & 1023
+};
+
+inline State& Get() {
+    static State* const state = new State{};
+    return *state;
+}
+
+inline bool On() {
+    return VideoCore::Readback::OverwriteCheck();
+}
+
+inline void MarkBehind(u64 present_number, bool behind) {
+    Get().behind[present_number & 1023].store(behind ? 1 : 0, std::memory_order_relaxed);
+}
+
+inline void AddWrite(u64 addr, u64 size) {
+    if (size == 0 || addr >= (PageLimit << PageBits)) {
+        return;
+    }
+    State& s = Get();
+    const u64 end = (std::min)(addr + size, PageLimit << PageBits);
+    std::scoped_lock lk{s.mutex};
+    for (u64 page = addr >> PageBits; page <= (end - 1) >> PageBits; ++page) {
+        const u64 page_lo = page << PageBits;
+        const u64 lo = (std::max)(addr, page_lo) - page_lo;
+        const u64 hi = (std::min)(end, page_lo + (u64{1} << PageBits)) - page_lo; // exclusive
+        u64 mask = 0;
+        for (u64 c = lo >> 6; c <= (hi - 1) >> 6; ++c) {
+            mask |= u64{1} << c;
+        }
+        s.chunks[static_cast<u32>(page)] |= mask;
+        s.pages[page / 64].fetch_or(u64{1} << (page % 64), std::memory_order_relaxed);
+    }
+    s.any.store(true, std::memory_order_release);
+}
+
+inline void Clear() {
+    State& s = Get();
+    if (!s.any.load(std::memory_order_acquire)) {
+        return;
+    }
+    std::scoped_lock lk{s.mutex};
+    for (const auto& [page, mask] : s.chunks) {
+        s.pages[page / 64].fetch_and(~(u64{1} << (page % 64)), std::memory_order_relaxed);
+    }
+    s.chunks.clear();
+    s.any.store(false, std::memory_order_release);
+}
+
+inline bool Any() {
+    return Get().any.load(std::memory_order_acquire);
+}
+
+/// Whether [addr, addr + size) overlaps an ahead write.
+inline bool Hits(u64 addr, u64 size) {
+    State& s = Get();
+    if (size == 0 || !s.any.load(std::memory_order_acquire) || addr >= (PageLimit << PageBits)) {
+        return false;
+    }
+    const u64 end = (std::min)(addr + size, PageLimit << PageBits);
+    for (u64 page = addr >> PageBits; page <= (end - 1) >> PageBits; ++page) {
+        if ((s.pages[page / 64].load(std::memory_order_relaxed) & (u64{1} << (page % 64))) == 0) {
+            continue;
+        }
+        const u64 page_lo = page << PageBits;
+        const u64 lo = (std::max)(addr, page_lo) - page_lo;
+        const u64 hi = (std::min)(end, page_lo + (u64{1} << PageBits)) - page_lo;
+        u64 mask = 0;
+        for (u64 c = lo >> 6; c <= (hi - 1) >> 6; ++c) {
+            mask |= u64{1} << c;
+        }
+        std::scoped_lock lk{s.mutex};
+        const auto it = s.chunks.find(static_cast<u32>(page));
+        if (it != s.chunks.end() && (it->second & mask) != 0) {
+            return true;
+        }
+    }
+    return false;
+}
+
+inline void First(std::atomic<u64>& first, std::atomic<u64>& count, u64 addr) {
+    if (count.fetch_add(1, std::memory_order_relaxed) == 0) {
+        first.store(addr, std::memory_order_relaxed);
+    }
+}
+
+inline void NoteTexture(u64 addr, u64 size) {
+    if (On() && Hits(addr, size)) {
+        State& s = Get();
+        First(s.frame.tex_first, s.frame.tex, addr);
+        s.frame.tex_bytes.fetch_add(size, std::memory_order_relaxed);
+    }
+}
+
+inline void NoteDescriptor(u64 addr, u64 size, bool changed) {
+    if (Hits(addr, size)) {
+        State& s = Get();
+        First(s.frame.desc_first, s.frame.desc, addr);
+        if (changed) {
+            s.frame.desc_changed.fetch_add(1, std::memory_order_relaxed);
+        }
+    }
+}
+
+inline void NoteHandle(u64 addr, u64 size) {
+    if (Hits(addr, size)) {
+        State& s = Get();
+        First(s.frame.handle_first, s.frame.handle, addr);
+    }
+}
+
+inline void NoteCpuRead(u64 addr, bool frame_in_flight) {
+    State& s = Get();
+    s.frame.cpuread.fetch_add(1, std::memory_order_relaxed);
+    if (frame_in_flight) {
+        First(s.frame.cpuread_first, s.frame.cpuread_ahead, addr);
+    }
+}
+
+/// From BufferCache::OverwriteCloseWindow on the thread that applies guest writes.
+/// `buffer_ahead_reads`: the buffer cache's own ahead reads in the same CPU frame.
+inline void CloseWindow(u64 present_number, u64 buffer_ahead_reads, s64 wall_ms) {
+    State& s = Get();
+    Counters& f = s.frame;
+    const u64 tex = f.tex.exchange(0), tex_bytes = f.tex_bytes.exchange(0);
+    const u64 desc = f.desc.exchange(0), desc_changed = f.desc_changed.exchange(0);
+    const u64 handle = f.handle.exchange(0);
+    const u64 cpuread = f.cpuread.exchange(0), cpuread_ahead = f.cpuread_ahead.exchange(0);
+    const u64 tex_first = f.tex_first.load(), desc_first = f.desc_first.load(),
+              handle_first = f.handle_first.load(), cpuread_first = f.cpuread_first.load();
+    const auto now = std::chrono::steady_clock::now();
+    if (s.start == std::chrono::steady_clock::time_point{}) {
+        s.start = now;
+    }
+    if (present_number != ~u64{0}) {
+        const bool behind = s.behind[present_number & 1023].load(std::memory_order_relaxed) != 0;
+        const bool any = buffer_ahead_reads + tex + desc + handle + cpuread_ahead != 0;
+        ++s.frames;
+        s.behind_frames += behind ? 1 : 0;
+        s.frames_with_any += any ? 1 : 0;
+        s.behind_with_any += behind && any ? 1 : 0;
+        s.totals[0] += tex;
+        s.totals[1] += desc;
+        s.totals[2] += handle;
+        s.totals[3] += cpuread_ahead;
+        s.totals[4] += buffer_ahead_reads;
+        if (tex + desc + handle + cpuread_ahead != 0 && s.lines < 20000) {
+            ++s.lines;
+            LOG_INFO(HW_GPU,
+                     "GbbAheadAudit present #{} wall {}{}: tex {} ({} KiB, first {:#x}), desc {} "
+                     "({} changed, first {:#x}), handle {} (first {:#x}), cpu reads of GPU data "
+                     "{} with the frame in flight of {} (first {:#x}); buffer ahead reads {}",
+                     present_number, wall_ms, behind ? " behind" : "", tex, tex_bytes >> 10,
+                     tex_first, desc, desc_changed, desc_first, handle, handle_first,
+                     cpuread_ahead, cpuread, cpuread_first, buffer_ahead_reads);
+        }
+    }
+    if (now - s.start >= std::chrono::seconds{5}) {
+        LOG_INFO(HW_GPU,
+                 "GbbAheadAudit 5 s: {} frames ({} ran ahead with the GPU behind), {} with a "
+                 "stale read ({} of the behind ones); tex {}, desc {}, handle {}, cpu reads in "
+                 "flight {}, buffer ahead reads {}",
+                 s.frames, s.behind_frames, s.frames_with_any, s.behind_with_any, s.totals[0],
+                 s.totals[1], s.totals[2], s.totals[3], s.totals[4]);
+        s.frames = s.behind_frames = s.frames_with_any = s.behind_with_any = 0;
+        s.totals = {};
+        s.start = now;
+    }
+}
+
+} // namespace VideoCore::GbbAheadAudit
