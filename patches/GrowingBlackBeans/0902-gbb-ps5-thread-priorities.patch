From: GrowingBlackBeans <gbb@local>
Subject: [PATCH] EDEN_GBB_PS5_PRIO=1: thread priorities through libkernel pthread_setprio on the PS5 (no POSIX range there), relative to each thread default, off by default

---
diff --git a/src/common/thread.cpp b/src/common/thread.cpp
index 0108d7c493..28c69def54 100644
--- a/src/common/thread.cpp
+++ b/src/common/thread.cpp
@@ -447,6 +447,12 @@ void RememberCurrentThreadNice(pid_t tid, s32 nice_value) {
 #include "common/x64/rdtsc.h"
 #endif
 
+#if defined(__FreeBSD__)
+// libkernel (PS5): a thread's priority, 256 (runs first) to 767.
+extern "C" int pthread_setprio(pthread_t thread, int priority);
+extern "C" int pthread_getprio(pthread_t thread);
+#endif
+
 namespace Common {
 
 void SetCurrentThreadPriority(ThreadPriority new_priority) {
@@ -518,6 +524,40 @@ void SetCurrentThreadPriority(ThreadPriority new_priority) {
         if (!logged.exchange(true)) {
             std::fprintf(stderr, "EDEN_THREAD_PRIO none: min=%d max=%d\n", min_prio, max_prio);
         }
+#if defined(__FreeBSD__)
+        // EDEN_GBB_PS5_PRIO=1 (GrowingBlackBeans; unset: nothing, as before). The PS5 has no
+        // POSIX priority range (both calls above fail), so no thread's priority was ever set.
+        // libkernel's own pthread_setprio takes 256 (first) to 767 (last). Each level moves the
+        // thread from its own default by EDEN_GBB_PS5_PRIO_STEP (default 32) per level from
+        // Normal: Low +1 step (later), High -1, VeryHigh -2, Critical -3 (earlier), clamped.
+        static const int step = [] {
+            const char* on = std::getenv("EDEN_GBB_PS5_PRIO");
+            if (on == nullptr || on[0] != '1') {
+                return 0;
+            }
+            const char* value = std::getenv("EDEN_GBB_PS5_PRIO_STEP");
+            const int asked = value != nullptr ? std::atoi(value) : 32;
+            return asked > 0 ? asked : 32;
+        }();
+        if (step != 0) {
+            const pthread_t self = pthread_self();
+            // The thread default, read at its first call: a second call does not move it twice.
+            static thread_local int original = -1;
+            if (original < 0) {
+                original = pthread_getprio(self);
+            }
+            const int before = original;
+            const int level = static_cast<int>((std::min)(static_cast<u32>(new_priority), 4U));
+            const int target = (std::clamp)(before - (level - 1) * step, 256, 767);
+            const int set_rc = pthread_setprio(self, target);
+            static std::atomic<u32> ps5_logged{0};
+            if (const u32 bit = 1U << level; (ps5_logged.fetch_or(bit) & bit) == 0) {
+                std::fprintf(stderr,
+                             "EDEN_THREAD_PRIO ps5 level=%d before=%d asked=%d set_rc=%d got=%d\n",
+                             level, before, target, set_rc, pthread_getprio(self));
+            }
+        }
+#endif
     }
 #endif
 }
