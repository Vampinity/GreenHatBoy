+                                 ms_s(t.call_ticks[at]),
+                                 static_cast<u64>(static_cast<double>(t.call_count[at]) / seconds),
+                                 static_cast<double>(t.call_ticks[at]) / tsc_per_ms * 1000.0 /
+                                     (std::max)(t.call_count[at], 1U));
+        }
+        LOG_INFO(HW_GPU, "EDEN_GBB_BACK calls (thunk - anchor, ms per s): {}", parts);
+    }
+    {
+        std::vector<u32> order;
+        for (u32 i = 0; i < MethodSlots * MethodRange; ++i) {
+            if (t.method_count[i] != 0) {
+                order.push_back(i);
+            }
+        }
+        std::partial_sort(order.begin(), order.begin() + (std::min<size_t>)(order.size(), 24),
+                          order.end(),
