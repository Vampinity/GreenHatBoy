+    t.kind_count = {};
+    std::fill(t.method_ticks.begin(), t.method_ticks.end(), 0);
+    std::fill(t.method_count.begin(), t.method_count.end(), 0);
+    t.call_key = {};
+    t.call_ticks = {};
+    t.call_count = {};
+    t.wait_ticks = t.hook_ticks = t.hook_count = t.busy_ticks = 0;
+    t.window_start = now;
+    t.window_tsc = __rdtsc();
+}
