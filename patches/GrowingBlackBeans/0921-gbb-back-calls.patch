+// GrowingBlackBeans 0921, EDEN_GBB_BACK_CALLS=1: where the split's back thread spends its time,
+// without the per-zone clock reads of EDEN_NX2_GPU_PROFILE (which slowed the game ~20%). Every
+// ring entry the back executes is timed with the TSC and charged, inclusive, to its kind and to
+// the method (by engine) or the call thunk it carries; the idle hook (deferred submits) and the
+// waits for work are timed apart. Every 5 s: busy/wait/hook ms per second, the kinds, the top
+// call thunks (address minus an anchor function's, for the ELF) and the top methods.
+namespace GbbBackCalls {
+[[gnu::noinline]] void Anchor() {
+    asm volatile("" ::: "memory");
+}
+inline bool On() {
+    static const bool on = [] {
+        const char* value = std::getenv("EDEN_GBB_BACK_CALLS");
+        return value != nullptr && value[0] == '1' && value[1] == '\0';
+    }();
+    return on;
+}
+constexpr u32 MethodSlots = 8;
+constexpr u32 MethodRange = 0x2000;
+struct Table {
+    // kinds: 0 wrap, 1 engine, 2 method, 3 multi, 4 call, 5 regs, 6 cbdata
+    std::array<u64, 8> kind_ticks{};
+    std::array<u64, 8> kind_count{};
+    std::array<const void*, MethodSlots> engines{};
+    std::vector<u64> method_ticks = std::vector<u64>(MethodSlots * MethodRange);
+    std::vector<u32> method_count = std::vector<u32>(MethodSlots * MethodRange);
+    std::array<u64, 1024> call_key{};
+    std::array<u64, 1024> call_ticks{};
+    std::array<u32, 1024> call_count{};
+    u64 wait_ticks{}, hook_ticks{}, hook_count{}, busy_ticks{};
+    u64 window_tsc{};
+    std::chrono::steady_clock::time_point window_start{};
+};
+inline Table& T() {
+    static thread_local Table* table = new Table{};
+    return *table;
+}
+inline u32 EngineSlot(const void* engine) {
+    Table& t = T();
+    for (u32 i = 0; i < MethodSlots; ++i) {
+        if (t.engines[i] == engine) {
+            return i;
+        }
+        if (t.engines[i] == nullptr) {
+            t.engines[i] = engine;
+            return i;
+        }
+    }
+    return MethodSlots - 1;
+}
+inline void Charge(u32 kind, const u64* entry, const void* engine, u64 ticks) {
+    Table& t = T();
+    t.kind_ticks[kind] += ticks;
+    ++t.kind_count[kind];
+    t.busy_ticks += ticks;
+    const u64 head = entry[0];
+    if (kind == 2 || kind == 3) {
+        const u32 method = (std::min)(static_cast<u32>((head >> 8) & 0xffff), MethodRange - 1);
+        const u32 index = EngineSlot(engine) * MethodRange + method;
+        t.method_ticks[index] += ticks;
+        ++t.method_count[index];
+    } else if (kind == 4) {
+        const u64 key = entry[1];
+        size_t at = (key * 0x9E3779B97F4A7C15ULL >> 54) & 1023;
+        for (u32 probe = 0; probe < 1024; ++probe, at = (at + 1) & 1023) {
+            if (t.call_key[at] == key || t.call_key[at] == 0) {
+                t.call_key[at] = key;
+                t.call_ticks[at] += ticks;
+                ++t.call_count[at];
+                break;
+            }
+        }
+    }
+}
+inline void MaybeReport() {
+    Table& t = T();
+    const auto now = std::chrono::steady_clock::now();
+    if (t.window_start == std::chrono::steady_clock::time_point{}) {
+        t.window_start = now;
+        t.window_tsc = __rdtsc();
+        return;
+    }
