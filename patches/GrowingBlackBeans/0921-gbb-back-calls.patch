+        std::string parts;
+        for (size_t i = 0; i < order.size() && i < 24; ++i) {
+            const u32 at = order[i];
+            parts += fmt::format("{}e{}:{:#x} {:.1f} ({}/s, {:.2f} us)", parts.empty() ? "" : ", ",
+                                 at / MethodRange, at % MethodRange, ms_s(t.method_ticks[at]),
+                                 static_cast<u64>(static_cast<double>(t.method_count[at]) / seconds),
+                                 static_cast<double>(t.method_ticks[at]) / tsc_per_ms * 1000.0 /
+                                     (std::max)(t.method_count[at], 1U));
+        }
+        LOG_INFO(HW_GPU, "EDEN_GBB_BACK methods (engine:method, inclusive ms per s): {}", parts);
+    }
