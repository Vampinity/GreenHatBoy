diff --git a/src/core/gbb_cost.h b/src/core/gbb_cost.h
new file mode 100644
index 0000000..c78a04a
--- /dev/null
+++ b/src/core/gbb_cost.h
@@ -0,0 +1,96 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// EDEN_GBB_COST=1 (GrowingBlackBeans, patch 0917): where a guest thread's time outside its SVCs goes
+// besides its own translated code. For the guest threads EDEN_GBB_SVC_PROFILE names, host time in:
+// guest writes to GPU-tracked pages (Memory::HandleRasterizerWrite, all of it), the buffer cache
+// lock those writes wait for (RasterizerVulkan::OnCPUWrite, part of the former), guest reads of
+// GPU-tracked pages (HandleRasterizerDownload), the JIT's memory callbacks (DynarmicCallbacks64
+// Read/Write, which contain the above when they reach such pages) and JIT compilation. Counted
+// in TSC ticks on the host thread that runs the guest thread (the slot is chosen at EnterContext),
+// reported in the 0913 line every 5 s.
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <cstdlib>
+#include <string>
+#include <x86intrin.h>
+#include "common/common_types.h"
+
+namespace Core::GbbCost {
+
+enum Cat : u32 { WriteCb, WriteLock, ReadCb, MemCb, JitCompile, Count };
+inline constexpr const char* Names[Count] = {"guest writes to GPU pages", "of which buffer cache lock",
+                                             "guest reads of GPU pages", "JIT memory callbacks",
+                                             "JIT compile"};
+
+struct Slot {
+    u64 tid{~u64{}};
+    std::array<std::atomic<u64>, Count> ticks{};
+    std::array<std::atomic<u64>, Count> calls{};
+};
+
+inline bool Enabled() {
+    static const bool on = [] {
+        const char* const value = std::getenv("EDEN_GBB_COST");
+        return value != nullptr && value[0] == '1';
+    }();
+    return on;
+}
+
+inline std::array<Slot, 16>& Slots() {
+    // Built in place: a slot holds atomics, which can't be copied.
+    static std::array<Slot, 16> slots;
+    static const bool filled = [] {
+        const char* text = std::getenv("EDEN_GBB_SVC_PROFILE");
+        size_t n = 0;
+        for (const char* at = text; at != nullptr && *at != 0 && n < slots.size();) {
+            char* end = nullptr;
+            const u64 id = std::strtoull(at, &end, 10);
+            if (end == at) break;
+            slots[n++].tid = id;
+            at = (*end == ',') ? end + 1 : nullptr;
+        }
+        return true;
+    }();
+    (void)filled;
+    return slots;
+}
+
+inline Slot* Find(u64 tid) {
+    for (auto& slot : Slots()) {
+        if (slot.tid == tid) return &slot;
+    }
+    return nullptr;
+}
+
+/// The slot of the guest thread the calling host thread runs now (null: not counted).
+inline thread_local Slot* current = nullptr;
+
+/// PhysicalCore::EnterContext.
+inline void OnEnter(u64 tid) {
+    if (Enabled()) current = Find(tid);
+}
+
+inline void Add(Cat cat, u64 ticks) {
+    if (Slot* const slot = current) {
+        slot->ticks[cat].fetch_add(ticks, std::memory_order_relaxed);
+        slot->calls[cat].fetch_add(1, std::memory_order_relaxed);
+    }
+}
+
+struct Scope {
+    Slot* slot;
+    Cat cat;
+    u64 start{};
+    explicit Scope(Cat cat_) : slot{current}, cat{cat_} {
+        if (slot) start = __rdtsc();
+    }
+    ~Scope() {
+        if (slot) {
+            slot->ticks[cat].fetch_add(__rdtsc() - start, std::memory_order_relaxed);
+            slot->calls[cat].fetch_add(1, std::memory_order_relaxed);
+        }
+    }
+};
+
+} // namespace Core::GbbCost
