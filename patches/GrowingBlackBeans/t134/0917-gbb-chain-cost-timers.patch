+        // 0917: the same window's host time in emulator work for this thread.
+        if (Core::GbbCost::Slot* const slot = Core::GbbCost::Find(profile.id)) {
+            const u64 tsc_now = __rdtsc();
+            const double tsc_per_ms = wall_ms > 0 ? (tsc_now - profile.window_tsc) / wall_ms : 1.0;
+            std::string parts;
+            for (u32 c = 0; c < Core::GbbCost::Count; ++c) {
+                const u64 ticks = slot->ticks[c].exchange(0, std::memory_order_relaxed);
+                const u64 calls = slot->calls[c].exchange(0, std::memory_order_relaxed);
+                parts += fmt::format("{}{} {:.2f}/frame ({} calls)", parts.empty() ? "" : "; ",
+                                     Core::GbbCost::Names[c], ticks / tsc_per_ms * per, calls);
+            }
+            LOG_INFO(Kernel_SVC, "EDEN_GBB_COST t{} ms per frame: {}", profile.id, parts);
+        }
+    }
     const u64 id = profile.id;
     profile = {};
     profile.id = id;
     profile.window_start = now;
     profile.window_presents = presents;
+    profile.window_tsc = __rdtsc();
 }
