+// Module main load address (core.cpp, EDEN_GBB_DUMP_GUEST); used by EDEN_GBB_THREADS.
+extern std::atomic<u64> eden_gbb_main_base;
+
 namespace Kernel::Svc {
 namespace {
 
+// EDEN_GBB_THREADS=1 (GrowingBlackBeans): log each guest thread the game creates (id, entry, arg,
+// priority, core) and every priority change. EDEN_GBB_THREAD_PRIO=<id>:<priority>[,...] gives
+// those thread ids that priority from creation on, whatever the game asks for later.
+bool GbbThreadLog() {
+    static const bool on = [] {
+        const char* v = std::getenv("EDEN_GBB_THREADS");
+        return v != nullptr && v[0] == '1';
+    }();
+    return on;
+}
+s32 GbbThreadPriority(u64 id, s32 priority) {
+    static const char* list = std::getenv("EDEN_GBB_THREAD_PRIO");
+    for (const char* at = list; at != nullptr && *at != 0;) {
+        char* end = nullptr;
+        const u64 want = std::strtoull(at, &end, 10);
+        if (end == nullptr || *end != ':') {
+            break;
+        }
+        const long value = std::strtol(end + 1, &end, 10);
+        if (want == id && value >= HighestThreadPriority && value <= LowestThreadPriority) {
+            return static_cast<s32>(value);
+        }
+        at = (end != nullptr && *end == ',') ? end + 1 : nullptr;
+    }
+    return priority;
+}
+
 constexpr bool IsValidVirtualCoreId(int32_t core_id) {
     return (0 <= core_id && core_id < static_cast<int32_t>(Core::Hardware::NUM_CPU_CORES));
