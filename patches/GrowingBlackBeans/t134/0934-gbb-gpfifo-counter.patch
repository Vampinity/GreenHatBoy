 // env.txt is applied in main, after the globals.
 static bool RecordParsedEntries() {
@@ -2689,6 +2768,18 @@ void DmaPusher::NoteDroppedWord(u32 word, size_t position) {
 
 void DmaPusher::RecordParsedEntry(const CommandListHeader& header,
                                   std::span<const CommandHeader> commands) {
+    // 0934: count what the game submitted, before anything expands it.
+    if (GpfifoCountEnabled()) [[unlikely]] {
+        const s32 bind_id = channel_state.bind_id;
+        const u32 channel = (bind_id >= 0 && static_cast<u32>(bind_id) < GpfifoChannels)
+                                ? static_cast<u32>(bind_id)
+                                : (GpfifoChannels - 1);
+        GpfifoCounters& c = gpfifo_counters[channel];
+        c.entries.fetch_add(1, std::memory_order_relaxed);
+        c.words.fetch_add(static_cast<u64>(header.size), std::memory_order_relaxed);
+        c.headers.fetch_add(commands.size(), std::memory_order_relaxed);
+        GpfifoMaybeReport();
+    }
     if (FetchCountMode() != 0) {
         CountFetchedEntry(header, commands);
     }
