+/// One read read sync waited on (GPU::ReadAheadSync, with the check on). `changed`: the check found
+/// changed bytes in the read's window.
+inline void NoteCensus(u64 device_addr, u64 size, u64 present, bool fence_waited, u64 fence_ns,
+                       u64 flush_ns, bool changed) {
+    Census& c = TheCensus();
+    const u64 now = NowNs();
+    const int b = AgeBucket(WriteAgeNs(device_addr, size, now));
+    c.reads.fetch_add(1, std::memory_order_relaxed);
+    if (fence_waited) c.fence_waited.fetch_add(1, std::memory_order_relaxed);
+    c.fence_ns.fetch_add(fence_ns, std::memory_order_relaxed);
+    c.flush_ns.fetch_add(flush_ns, std::memory_order_relaxed);
+    c.by_age[b].fetch_add(1, std::memory_order_relaxed);
+    if (changed) c.changed_by_age[b].fetch_add(1, std::memory_order_relaxed);
+    const u64 g = device_addr >> GranuleBits;
+    ReadSlot& r = ReadTable()[(g * 0x9E3779B97F4A7C15ULL) >> (64 - TableBits)];
+    const bool repeat = r.granule.load(std::memory_order_acquire) == g &&
+                        r.present.load(std::memory_order_relaxed) + 1 == present;
+    if (r.granule.load(std::memory_order_relaxed) != g ||
+        r.present.load(std::memory_order_relaxed) != present) {
+        r.present.store(present, std::memory_order_relaxed);
+        r.granule.store(g, std::memory_order_release);
+    }
+    (repeat ? c.repeat : c.fresh).fetch_add(1, std::memory_order_relaxed);
+    if (changed) (repeat ? c.repeat_changed : c.fresh_changed).fetch_add(1, std::memory_order_relaxed);
+    u64 last = c.report_ns.load(std::memory_order_relaxed);
+    if (last == 0) {
+        c.report_ns.compare_exchange_strong(last, now, std::memory_order_relaxed);
+        return;
+    }
+    if (now - last < 10'000'000'000ULL ||
+        !c.report_ns.compare_exchange_strong(last, now, std::memory_order_relaxed)) {
+        return;
+    }
+    u64 ch[Census::Buckets], all[Census::Buckets];
+    for (int i = 0; i < Census::Buckets; ++i) {
+        ch[i] = c.changed_by_age[i].exchange(0, std::memory_order_relaxed);
+        all[i] = c.by_age[i].exchange(0, std::memory_order_relaxed);
+    }
+    LOG_INFO(HW_GPU,
+             "EDEN_GBB_READ_SYNC_CENSUS: reads {}, fence waited {} ({} ms), flush {} ms; by age of the "
+             "last GPU write (changed/all): <50ms {}/{} <100ms {}/{} <200ms {}/{} <500ms {}/{} <2s {}/{} "
+             "older {}/{} none {}/{}; read last present: changed {}/{}, not read last present: "
+             "changed {}/{}",
+             c.reads.exchange(0, std::memory_order_relaxed),
+             c.fence_waited.exchange(0, std::memory_order_relaxed),
+             c.fence_ns.exchange(0, std::memory_order_relaxed) / 1'000'000,
+             c.flush_ns.exchange(0, std::memory_order_relaxed) / 1'000'000, ch[0], all[0], ch[1],
+             all[1], ch[2], all[2], ch[3], all[3], ch[4], all[4], ch[5], all[5], ch[6], all[6],
+             c.repeat_changed.exchange(0, std::memory_order_relaxed),
+             c.repeat.exchange(0, std::memory_order_relaxed),
+             c.fresh_changed.exchange(0, std::memory_order_relaxed),
+             c.fresh.exchange(0, std::memory_order_relaxed));
+}
+
+// ---- 0930: once per present ----
