+inline int AgeBucket(u64 age_ns) {
+    if (age_ns == ~u64{0}) return 6;
+    const u64 ms = age_ns / 1'000'000;
+    return ms < 50 ? 0 : ms < 100 ? 1 : ms < 200 ? 2 : ms < 500 ? 3 : ms < 2000 ? 4 : 5;
+}
