+}
+
+inline void OnceMaybeReport() {
+    OnceCounters& c = Once();
+    const u64 now = NowNs();
+    u64 last = c.report_ns.load(std::memory_order_relaxed);
+    if (last == 0) {
+        c.report_ns.compare_exchange_strong(last, now, std::memory_order_relaxed);
+        return;
+    }
+    if (now - last < 10'000'000'000ULL ||
+        !c.report_ns.compare_exchange_strong(last, now, std::memory_order_relaxed)) {
+        return;
+    }
+    LOG_INFO(HW_GPU,
+             "EDEN_GBB_READ_SYNC_ONCE: last 10 s presents {}, batch ranges {}, covered {}, synced {}",
+             c.presents.exchange(0, std::memory_order_relaxed),
+             c.batch_ranges.exchange(0, std::memory_order_relaxed),
+             c.covered.exchange(0, std::memory_order_relaxed),
+             c.synced.exchange(0, std::memory_order_relaxed));
+}
+
 } // namespace VideoCore::GbbReadSyncPending
