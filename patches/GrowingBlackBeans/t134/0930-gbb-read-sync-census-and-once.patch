+struct Census {
+    static constexpr int Buckets = 7; // <50, <100, <200, <500, <2000 ms, older, none
+    std::atomic<u64> reads{0}, fence_waited{0}, fence_ns{0}, flush_ns{0};
+    std::atomic<u64> by_age[Buckets]{}, changed_by_age[Buckets]{};
+    std::atomic<u64> repeat{0}, repeat_changed{0}, fresh{0}, fresh_changed{0};
+    std::atomic<u64> report_ns{0};
+};
