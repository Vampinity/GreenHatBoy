+// ---- 0930: census ----
+
+/// Age in ns of the newest GPU write noted for [device_addr, device_addr + size); ~0 when none.
+inline u64 WriteAgeNs(u64 device_addr, u64 size, u64 now) {
+    u64 best = ~u64{0};
+    const u64 first = device_addr >> GranuleBits;
+    const u64 last = (device_addr + (size ? size : 1) - 1) >> GranuleBits;
+    for (u64 g = first; g <= last; ++g) {
+        const Slot& s = SlotFor(g);
+        if (s.granule.load(std::memory_order_acquire) != g) {
+            continue;
+        }
+        const u64 written = s.written_ns.load(std::memory_order_relaxed);
+        const u64 age = written >= now ? 0 : now - written;
+        best = age < best ? age : best;
+    }
+    return best;
+}
