diff --git a/src/video_core/gbb_read_sync_pending.h b/src/video_core/gbb_read_sync_pending.h
new file mode 100644
index 0000000..139d188
--- /dev/null
+++ b/src/video_core/gbb_read_sync_pending.h
@@ -0,0 +1,145 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+/// GrowingBlackBeans 0929: a narrow read sync.
+///
+/// EDEN_GBB_READ_SYNC_PENDING=1 (or =<ms>, 20-2000; 1 = 200): with EDEN_UP_AHEAD_READ_SYNC=1 on,
+///   a read that read sync would make wait (GPU::OnCPURead, a fence-downloaded range while the
+///   latest present ran ahead) waits only when the GPU wrote that range recently: within the last
+///   <ms>. Every other such read takes guest memory as it is, as without read sync.
+///
+/// Why (12 Nov 2026, run DV1, EDEN_UP_AHEAD_READ_SYNC_VERIFY=1): read sync removed every flash with
+///   one and two frames ahead, but waited on ~76 reads a frame for ~25% fps, and the bytes around a
+///   read had new data in about one of those a hundred: records the GPU rewrites every frame. A read
+///   at the start of frame C+1 can come before the back has recorded frame C, so frame C's writes
+///   are not queued yet; the test is therefore history: did a GPU write queued for download at a
+///   fence (BufferCache::QueueGpuWrite) touch this range in the last <ms>? A range the GPU rewrites
+///   each frame always did; one it wrote once long ago did not.
+///
+/// How: a direct-mapped table of 65,536 entries, one per 64 KiB granule of device address space
+///   (hash of the granule number), holding the granule and when it was last written. Lock-free:
+///   QueueGpuWrite (GPU thread) stores, OnCPURead (guest core threads) loads. A collision drops the
+///   older granule's entry, which can only turn a sync into a skip for a granule written long ago.
+///
+/// Every 10 s while on: "EDEN_GBB_READ_SYNC_PENDING: last 10 s synced <n> skipped <n> (window <ms>
+///   ms, <n> granules noted)".
+
+#include <atomic>
+#include <chrono>
+#include <cstdlib>
+
+#include "common/common_types.h"
+#include "common/logging.h"
+
+namespace VideoCore::GbbReadSyncPending {
+
+constexpr u32 GranuleBits = 16;
+constexpr u32 TableBits = 16;
+
+inline u64 ParseWindowNs(const char* v) {
+    if (v == nullptr || v[0] == '\0' || v[0] == '0') return 0;
+    const long ms = std::strtol(v, nullptr, 10);
+    if (ms == 1) return 200'000'000ULL;
+    if (ms < 20 || ms > 2000) return 0;
+    return static_cast<u64>(ms) * 1'000'000ULL;
+}
+
+inline u64 WindowNs() {
+    static const u64 window = ParseWindowNs(std::getenv("EDEN_GBB_READ_SYNC_PENDING"));
+    return window;
+}
+
+inline bool On() {
+    return WindowNs() != 0;
+}
+
+inline u64 NowNs() {
+    return static_cast<u64>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                std::chrono::steady_clock::now().time_since_epoch())
+                                .count());
+}
+
+struct Slot {
+    std::atomic<u64> granule{~u64{0}};
+    std::atomic<u64> written_ns{0};
+};
+
+inline Slot* Table() {
+    static Slot* table = new Slot[size_t{1} << TableBits]; // never freed: lives with the process
+    return table;
+}
+
+inline Slot& SlotFor(u64 granule) {
+    return Table()[(granule * 0x9E3779B97F4A7C15ULL) >> (64 - TableBits)];
+}
+
+struct Counters {
+    std::atomic<u64> synced{0}, skipped{0}, noted{0};
+    std::atomic<u64> report_ns{0};
+};
+
+inline Counters& Count() {
+    static Counters c;
+    return c;
+}
+
+/// A GPU write queued for download at the next fence (BufferCache::QueueGpuWrite, GPU thread).
+inline void NoteGpuWrite(u64 device_addr, u64 size) {
+    if (!On() || size == 0) [[likely]] {
+        return;
+    }
+    const u64 now = NowNs();
+    const u64 first = device_addr >> GranuleBits;
+    const u64 last = (device_addr + size - 1) >> GranuleBits;
+    for (u64 g = first; g <= last; ++g) {
+        Slot& s = SlotFor(g);
+        s.written_ns.store(now, std::memory_order_relaxed);
+        s.granule.store(g, std::memory_order_release);
+    }
+    Count().noted.fetch_add(last - first + 1, std::memory_order_relaxed);
+}
+
+inline void MaybeReport(u64 now) {
+    Counters& c = Count();
+    u64 last = c.report_ns.load(std::memory_order_relaxed);
+    if (last == 0) {
+        c.report_ns.compare_exchange_strong(last, now, std::memory_order_relaxed);
+        return;
+    }
+    if (now - last < 10'000'000'000ULL ||
+        !c.report_ns.compare_exchange_strong(last, now, std::memory_order_relaxed)) {
+        return;
+    }
+    LOG_INFO(HW_GPU,
+             "EDEN_GBB_READ_SYNC_PENDING: last 10 s synced {} skipped {} (window {} ms, {} granules "
+             "noted)",
+             c.synced.exchange(0, std::memory_order_relaxed),
+             c.skipped.exchange(0, std::memory_order_relaxed), WindowNs() / 1'000'000,
+             c.noted.exchange(0, std::memory_order_relaxed));
+}
+
+/// Whether a read read sync would make wait should wait (GPU::OnCPURead, guest core thread).
+inline bool ShouldSync(u64 device_addr, u64 size) {
+    const u64 now = NowNs();
+    const u64 window = WindowNs();
+    const u64 first = device_addr >> GranuleBits;
+    const u64 last = (device_addr + (size ? size : 1) - 1) >> GranuleBits;
+    bool recent = false;
+    for (u64 g = first; g <= last && !recent; ++g) {
+        const Slot& s = SlotFor(g);
+        if (s.granule.load(std::memory_order_acquire) != g) {
+            continue;
+        }
+        const u64 written = s.written_ns.load(std::memory_order_relaxed);
+        if (written >= now || now - written <= window) { // written after `now` was taken: recent
+            recent = true;
+        }
+    }
+    (recent ? Count().synced : Count().skipped).fetch_add(1, std::memory_order_relaxed);
+    MaybeReport(now);
+    return recent;
+}
+
+} // namespace VideoCore::GbbReadSyncPending
