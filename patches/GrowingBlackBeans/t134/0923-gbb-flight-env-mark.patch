+/// Flight recorder: the events of the last 2 s, oldest first, to their own file.
+inline void DumpFlight(u64 now_ns, u64 interval_ns) {
+    State& s = Get();
+    const u64 total = s.next.load(std::memory_order_relaxed);
+    const u64 have = (std::min)(total, State::Capacity);
+    std::vector<Event> out;
+    out.reserve(4096);
+    for (u64 k = total - have; k < total; ++k) {
+        const Event& e = s.ring[k & (State::Capacity - 1)];
+        if (e.ns + 2'000'000'000ULL >= now_ns && e.ns <= now_ns) {
+            out.push_back(e);
+        }
+    }
+    char path[128];
+    std::snprintf(path, sizeof(path), "/data/eglantineps5/logs/gbb-flight-%u-%u.bin", unsigned(getpid()),
+                  s.flight_dumps);
+    bool ok = false;
+    if (std::FILE* f = std::fopen(path, "wb")) {
+        const char magic[8] = {'G', 'B', 'B', 'T', 'L', '1', 0, 0};
+        const u64 header[4] = {out.size(), s.first_present_ns, now_ns - 2'000'000'000ULL, now_ns};
+        ok = std::fwrite(magic, 1, 8, f) == 8 && std::fwrite(header, sizeof(u64), 4, f) == 4 &&
+             std::fwrite(out.data(), sizeof(Event), out.size(), f) == out.size();
+        std::fclose(f);
+    }
+    LOG_INFO(HW_GPU, "EDEN_GBB_FLIGHT: frame of {:.1f} ms at {:.1f} s; last 2 s ({} events) {} {}",
+             static_cast<double>(interval_ns) / 1e6, static_cast<double>(now_ns - s.first_present_ns) / 1e9,
+             out.size(), ok ? "written to" : "FAILED to write", path);
+}
