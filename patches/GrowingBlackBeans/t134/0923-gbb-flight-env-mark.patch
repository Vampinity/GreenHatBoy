+/// Touchpad + R3 on the controller (headless pad.cpp).
+inline void Mark() {
+    const u32 n = Get().marks.fetch_add(1, std::memory_order_relaxed) + 1;
+    LOG_INFO(HW_GPU, "EDEN_GBB_MARK n={}", n);
+    Record(Ev::Mark, n, 0, Now());
