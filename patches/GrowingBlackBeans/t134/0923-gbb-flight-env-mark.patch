+
+inline void LogEnv() {
+    std::vector<std::string> vars;
+    for (char** e = environ; e != nullptr && *e != nullptr; ++e) {
+        const std::string v{*e};
+        if (v.rfind("EDEN_", 0) == 0 || v.rfind("RADV_", 0) == 0 || v.rfind("MESA_", 0) == 0 ||
+            v.rfind("ACO_", 0) == 0) {
+            vars.push_back(v);
+        }
+    }
+    std::sort(vars.begin(), vars.end());
+    std::string line;
+    for (const auto& v : vars) {
+        line += ' ';
+        line += v;
+    }
+    LOG_INFO(HW_GPU, "EDEN_GBB_ENV count={}{}", vars.size(), line);
+}
