+struct FlightConfig {
+    u64 threshold_ns{0};
+    u32 dumps{8};
+};
+inline const FlightConfig& Flight() {
+    static const FlightConfig cfg = [] {
+        FlightConfig c;
+        if (const char* v = std::getenv("EDEN_GBB_FLIGHT"); v != nullptr) {
+            double ms = 0;
+            unsigned dumps = 8;
+            const int n = std::sscanf(v, "%lf,%u", &ms, &dumps);
+            if (n >= 1 && ms >= 34 && ms <= 5000) {
+                c.threshold_ns = static_cast<u64>(ms * 1e6);
+                c.dumps = n == 2 ? (std::min)(dumps, 64u) : 8u;
+            }
+        }
+        return c;
+    }();
+    return cfg;
+}
