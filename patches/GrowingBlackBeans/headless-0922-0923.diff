diff --git a/headless/gpu_time_probe.inc b/headless/gpu_time_probe.inc
index ebc1132..329a7f5 100644
--- a/headless/gpu_time_probe.inc
+++ b/headless/gpu_time_probe.inc
@@ -1,3 +1,6 @@
+// 0922: host GPU time into EDEN_GBB_VITALS (defined in video_core/gpu_split.cpp; a C symbol, because this file is
+// included inside namespace Vulkan).
+extern "C" void eden_gbb_trace_gpu_busy(unsigned long long ns);
 namespace {
 // Development GPU execution time (dev_vulkan.h gpu_time): timestamps at the start and end
 // of each upload+graphics submission, summed once the GPU has run it and printed every
@@ -86,6 +89,7 @@ void GpuTimeCollect(const Device& device) {
         const u64 mask = gpu_time.valid_bits == 64 ? ~u64{0} : (u64{1} << gpu_time.valid_bits) - 1;
         const u64 ns = static_cast<u64>(double((stamps[1] - stamps[0]) & mask) * gpu_time.period_ns);
         gpu_time.busy_ns += ns;
+        eden_gbb_trace_gpu_busy(ns);
         gpu_time.total_ns += ns;
         ++gpu_time.total_submissions;
         gpu_time.max_ns = (std::max)(gpu_time.max_ns, ns);
