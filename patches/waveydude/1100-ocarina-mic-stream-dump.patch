+// EDEN_UP_MIC_DUMP=1: what an input stream's ring looks like, to learn where a mic's samples go.
+// Ocarina of Time opens "InputStream-1<=1ch48kQ15<=TrueRawAudioIn" (kind 1, 4800 frames, mono Q15,
+// a 0xd000-byte buffer) to play the ocarina from a hum; only the two indices are known (read at
+// +0x44, write at +0x1004), and 0xd000 is far more than 4801 16-bit frames. At open and at each
+// engage: every non-zero 32-bit word of the first 0x3000 bytes (at most 64); while open, both
+// indices about once a second. At most 200 lines a session.
+inline bool Nx2MicDump() {
+    static const bool on = Common::PeSwitch("EDEN_UP_MIC_DUMP");
+    return on;
+}
+inline std::atomic<u32> nx2_mic_dump_lines{0};
+inline void Nx2MicDumpStream(Core::System& system, const Nx2SysmixStream& stream, const char* why) {
+    if (!Nx2MicDump() || stream.kind != 1 || !stream.buffer || nx2_mic_dump_lines.fetch_add(1) >= 200) {
+        return;
+    }
+    auto& memory = system.ApplicationMemory();
+    std::string words;
+    u32 found = 0;
+    const u64 span = (std::min<u64>)(stream.size, 0x3000);
+    for (u64 offset = 0; offset + 4 <= span && found < 64; offset += 4) {
+        const u32 value = memory.Read32(stream.buffer + offset);
+        if (value != 0) {
+            words += fmt::format(" {:#x}={:#x}", offset, value);
+            ++found;
+        }
+    }
+    LOG_INFO(Service_Audio,
+             "EDEN_MIC_DUMP stream {} {}: size {:#x}, {} frames, {} ch, {} Hz, type {}, engaged {}, "
+             "non-zero words in the first {:#x} bytes:{}",
+             stream.id, why, stream.size, stream.frames, stream.channels, stream.sample_rate,
+             stream.sample_type, stream.engaged, span, found == 0 ? std::string(" none") : words);
+}
+
 // Switch 2 virtual output devices (nn::audio::ListVirtualOutputDevices and friends), reached through
 // the object auddmg:u command 0 returns. Eden plays everything through one stereo 48 kHz output, so
 // there is one virtual device. The nx2: name keeps the other commands auto-stubbed and logged.
