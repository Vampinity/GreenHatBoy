@@ -0,0 +1,195 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// EDEN_UP_MIC_NOTES=1 (mic_capture.cpp, pad.cpp): a hum into the PS5 controller's mic plays the
+// ocarina. W-14 showed Ocarina of Time never attaches its raw mic input stream under Eden (indices
+// 0/0 with the ocarina out), so instead of feeding that stream the hum's pitch is turned into the
+// ocarina's five buttons, which the game reads as if they were pressed: low D, F, A, B, high D on
+// the Switch 2's L, R, A, Y, X.
+//
+// Pure functions, no platform calls (tools/test-hum-notes.cpp tests them on the host):
+// - DetectPitch: the fundamental of one window of 16 kHz mono samples (YIN), 0 when the window is
+//   too quiet or has no clear pitch.
+// - Classify: which of the five notes a pitch is. Octaves do not matter (people hum where their
+//   voice sits), only the note's name: D, F, A or B within KeepCents of it, nothing between them.
+//   A D is the high one when it is above the last other note hummed in the last few seconds (the
+//   songs that go up to it: B-D in Zelda's Lullaby), the low one otherwise.
+// - Tracker: which note is held now. A note starts after two windows in a row agree (a stray
+//   window of noise presses nothing), stays while windows keep agreeing, and ends at the first
+//   window that does not; a new note always needs two windows, so the game sees a release between
+//   two notes. Nothing is held unless armed; arming ends after IdleDisarmMs without a note.
+#pragma once
+
+#include <array>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+
+namespace Eden::Hum {
+
+constexpr unsigned Rate = 16000;     ///< DetectPitch's sample rate
+constexpr std::size_t Window = 1024; ///< samples per detection (64 ms)
+constexpr float MinHz = 70.0f;       ///< a low male hum
+constexpr float MaxHz = 1100.0f;     ///< above a high whistle's fundamental
+constexpr float MinRms = 300.0f;     ///< about -40 dBFS: quieter windows are silence
+constexpr float YinThreshold = 0.15f;
+constexpr float KeepCents = 75.0f;   ///< how far off a note's name a pitch may be and count
+constexpr std::int64_t HighDContextMs = 3000;
+constexpr std::int64_t IdleDisarmMs = 20000;
+
+enum Note : int { None = -1, LowD = 0, F = 1, A = 2, B = 3, HighD = 4 };
+
+/// The fundamental frequency of `n` samples at `rate` Hz, or 0 for silence or no clear pitch.
+inline float DetectPitch(const std::int16_t* samples, std::size_t n, unsigned rate = Rate) {
+    if (samples == nullptr || rate == 0) return 0.0f;
+    const std::size_t min_lag = static_cast<std::size_t>(static_cast<float>(rate) / MaxHz);
+    const std::size_t max_lag = static_cast<std::size_t>(static_cast<float>(rate) / MinHz) + 1;
+    if (n < 2 * max_lag + 2 || min_lag < 2) return 0.0f;
+    double energy = 0;
+    double mean = 0;
+    for (std::size_t i = 0; i < n; ++i) mean += samples[i];
+    mean /= static_cast<double>(n);
+    for (std::size_t i = 0; i < n; ++i) {
+        const double s = samples[i] - mean;
+        energy += s * s;
+    }
+    if (std::sqrt(energy / static_cast<double>(n)) < MinRms) return 0.0f;
+
+    // YIN: d(tau) = sum (x[i] - x[i + tau])^2 over a fixed span, then the cumulative mean
+    // normalised difference; the first tau under the threshold, at its local minimum.
+    const std::size_t span = n - max_lag - 1;
+    std::array<float, 1024> cmnd{};
+    if (max_lag + 2 > cmnd.size()) return 0.0f;
+    double running = 0;
+    cmnd[0] = 1.0f;
+    for (std::size_t tau = 1; tau <= max_lag + 1; ++tau) {
+        double d = 0;
+        for (std::size_t i = 0; i < span; ++i) {
+            const double diff = static_cast<double>(samples[i]) - samples[i + tau];
+            d += diff * diff;
+        }
+        running += d;
+        cmnd[tau] = running > 0 ? static_cast<float>(d * static_cast<double>(tau) / running) : 1.0f;
+    }
+    std::size_t best = 0;
+    for (std::size_t tau = min_lag; tau <= max_lag; ++tau) {
+        if (cmnd[tau] < YinThreshold) {
+            while (tau + 1 <= max_lag && cmnd[tau + 1] < cmnd[tau]) ++tau;
+            best = tau;
+            break;
+        }
+    }
+    if (best == 0) return 0.0f;
+    // Parabolic interpolation between the neighbours for a fractional lag.
+    float lag = static_cast<float>(best);
+    const float a = cmnd[best - 1], b = cmnd[best], c = cmnd[best + 1];
+    const float denom = a - 2 * b + c;
+    if (denom > 1e-6f) lag += 0.5f * (a - c) / denom;
+    const float hz = static_cast<float>(rate) / lag;
+    return hz >= MinHz && hz <= MaxHz ? hz : 0.0f;
+}
+
+/// A pitch as a MIDI note number (69 = A4 = 440 Hz), fractional.
+inline float Midi(float hz) {
+    return 69.0f + 12.0f * std::log2(hz / 440.0f);
+}
+
+/// Which note `hz` is; `last_other_midi` is the last F, A or B hummed lately (NaN for none).
+inline Note Classify(float hz, float last_other_midi) {
+    if (!(hz > 0.0f)) return None;
+    const float midi = Midi(hz);
+    float pc = std::fmod(midi, 12.0f);
+    if (pc < 0) pc += 12.0f;
+    struct Name {
+        float pc;
+        Note note;
+    };
+    static constexpr std::array<Name, 4> names{{{2.0f, LowD}, {5.0f, F}, {9.0f, A}, {11.0f, B}}};
+    Note found = None;
+    float closest = 12.0f;
+    for (const auto& name : names) {
+        float d = std::fabs(pc - name.pc);
+        d = std::fmin(d, 12.0f - d);
+        if (d < closest) {
+            closest = d;
+            found = name.note;
+        }
+    }
+    if (closest * 100.0f > KeepCents) return None;
+    if (found == LowD && !std::isnan(last_other_midi) && midi > last_other_midi) return HighD;
+    return found;
+}
+
+class Tracker {
+public:
+    void Arm(std::int64_t now_ms) {
+        armed = true;
+        last_activity_ms = now_ms;
+        Reset();
+    }
+    void Disarm() {
+        armed = false;
+        Reset();
+    }
+    bool Armed() const {
+        return armed;
+    }
+    Note Held() const {
+        return armed ? held : None;
+    }
+
+    /// One window's pitch (0 for none) at `now_ms`; returns the note held after it.
+    Note Feed(float hz, std::int64_t now_ms) {
+        if (!armed) return None;
+        if (now_ms - last_activity_ms > IdleDisarmMs) {
+            Disarm();
+            return None;
+        }
+        const float context =
+            now_ms - last_other_ms <= HighDContextMs ? last_other_midi : std::nanf("");
+        const Note note = Classify(hz, context);
+        if (note == F || note == A || note == B) {
+            last_other_midi = Midi(hz);
+            last_other_ms = now_ms;
+        }
+        if (note == None) {
+            held = None;
+            candidate = None;
+            run = 0;
+            return held;
+        }
+        last_activity_ms = now_ms;
+        if (held != None && note == held) return held;
+        // Anything else ends the held note; a new one needs two windows in a row.
+        held = None;
+        if (note == candidate) {
+            ++run;
+        } else {
+            candidate = note;
+            run = 1;
+        }
+        if (run >= 2) {
+            held = note;
+            candidate = None;
+            run = 0;
+        }
+        return held;
+    }
+
+private:
+    void Reset() {
+        held = None;
+        candidate = None;
+        run = 0;
+        last_other_midi = std::nanf("");
+        last_other_ms = -HighDContextMs - 1;
+    }
+
+    bool armed = false;
+    Note held = None;
+    Note candidate = None;
+    int run = 0;
+    float last_other_midi = std::nanf("");
+    std::int64_t last_other_ms = -HighDContextMs - 1;
+    std::int64_t last_activity_ms = 0;
+};
+
+} // namespace Eden::Hum
