+++ b/tools/build-audio-in-stub.sh
@@ -0,0 +1,17 @@
+#!/usr/bin/env bash
+# SPDX-License-Identifier: GPL-3.0-or-later
+# Builds build/stubs/libSceAudioIn.so, the libSceAudioIn import facade the controller mic
+# capture links against (tools/stubs/libSceAudioIn.c), with the Payload SDK's compiler.
+set -euo pipefail
+root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
+sdk="$root/../ps5-native-app-boilerplate/.deps/native/ps5-payload-sdk"
+source="$root/tools/stubs/libSceAudioIn.c"
+out="$root/build/stubs/libSceAudioIn.so"
+[[ -f $out && $out -nt $source ]] && exit 0
+test -x "$sdk/bin/prospero-clang" || { echo "Missing the Payload SDK; run make deps" >&2; exit 1; }
+mkdir -p "$root/build/stubs"
+work=$(mktemp -d)
+trap 'rm -rf "$work"' EXIT
+PS5_PAYLOAD_SDK="$sdk" "$sdk/bin/prospero-clang" -fPIC -c "$source" -o "$work/libSceAudioIn.o"
+"$sdk/bin/prospero-lld" --shared -soname libSceAudioIn.sprx -o "$work/libSceAudioIn.so" "$work/libSceAudioIn.o"
+mv "$work/libSceAudioIn.so" "$out"
diff --git a/tools/test-hum-notes.cpp b/tools/test-hum-notes.cpp
new file mode 100644
index 0000000..90ca487
--- /dev/null
+++ b/tools/test-hum-notes.cpp
@@ -0,0 +1,163 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Host test for headless/hum_notes.h (EDEN_UP_MIC_NOTES).
+//   c++ -std=c++20 -O1 -fsanitize=address,undefined -Iheadless tools/test-hum-notes.cpp -o /tmp/t && /tmp/t
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <numbers>
+#include <random>
+#include <vector>
+
+#include "hum_notes.h"
+
+namespace H = Eden::Hum;
+static int failures = 0;
+#define CHECK(cond)                                                                                \
+    do {                                                                                           \
+        if (!(cond)) {                                                                             \
+            std::printf("FAIL %s:%d: %s\n", __FILE__, __LINE__, #cond);                            \
+            ++failures;                                                                            \
+        }                                                                                          \
+    } while (0)
+
+static float Hz(float midi) {
+    return 440.0f * std::pow(2.0f, (midi - 69.0f) / 12.0f);
+}
+
+// A hum: the fundamental with two weaker harmonics, as a voice has, plus a little noise.
+static std::vector<std::int16_t> Tone(float hz, float amplitude, unsigned seed = 1) {
+    std::vector<std::int16_t> out(H::Window);
+    std::mt19937 rng{seed};
+    std::normal_distribution<float> noise{0.0f, amplitude * 0.03f};
+    for (std::size_t i = 0; i < out.size(); ++i) {
+        const float t = static_cast<float>(i) / H::Rate;
+        const float w = 2 * std::numbers::pi_v<float> * hz * t;
+        const float s = amplitude * (std::sin(w) + 0.5f * std::sin(2 * w) + 0.25f * std::sin(3 * w)) / 1.75f;
+        out[i] = static_cast<std::int16_t>(std::lround(std::fmax(-32768.0f, std::fmin(32767.0f, s + noise(rng)))));
+    }
+    return out;
+}
+
+static float Detect(const std::vector<std::int16_t>& s) {
+    return H::DetectPitch(s.data(), s.size());
+}
+
+// Pitches across the hummed range come back within a few cents, harmonics or not.
+static void PitchAccuracy() {
+    for (float midi = 40.0f; midi <= 84.0f; midi += 1.0f) { // E2 .. C6
+        const float hz = Hz(midi);
+        const float found = Detect(Tone(hz, 8000.0f, static_cast<unsigned>(midi)));
+        const float cents = found > 0 ? 1200.0f * std::log2(found / hz) : 9999.0f;
+        if (std::fabs(cents) > 20.0f) std::printf("  midi %.0f: %.1f Hz -> %.1f Hz (%.0f cents)\n", midi, hz, found, cents);
+        CHECK(std::fabs(cents) <= 20.0f);
+    }
+}
+
+// Silence, a quiet room and white noise have no pitch; a window shorter than two of the longest
+// periods is refused rather than read past.
+static void NoPitch() {
+    CHECK(Detect(std::vector<std::int16_t>(H::Window, 0)) == 0.0f);
+    CHECK(Detect(Tone(220.0f, 150.0f)) == 0.0f); // under MinRms
+    std::vector<std::int16_t> noise(H::Window);
+    std::mt19937 rng{7};
+    std::uniform_int_distribution<int> any{-12000, 12000};
+    for (auto& s : noise) s = static_cast<std::int16_t>(any(rng));
+    CHECK(Detect(noise) == 0.0f);
+    const auto tone = Tone(220.0f, 8000.0f);
+    CHECK(H::DetectPitch(tone.data(), 300) == 0.0f);
+    CHECK(H::DetectPitch(nullptr, H::Window) == 0.0f);
+    CHECK(Detect(Tone(40.0f, 8000.0f)) == 0.0f); // below MinHz
+}
+
+// Note names in any octave; between two notes nothing; the D goes high only above a recent note.
+static void Classify() {
+    const float none = std::nanf("");
+    CHECK(H::Classify(Hz(62), none) == H::LowD); // D4
+    CHECK(H::Classify(Hz(50), none) == H::LowD); // D3, an octave down
+    CHECK(H::Classify(Hz(53), none) == H::F);
+    CHECK(H::Classify(Hz(57), none) == H::A);
+    CHECK(H::Classify(Hz(59), none) == H::B);
+    CHECK(H::Classify(Hz(71), none) == H::B);    // B4
+    CHECK(H::Classify(Hz(60), none) == H::None); // C: a whole tone from D and from B
+    CHECK(H::Classify(Hz(55), none) == H::None); // G
+    CHECK(H::Classify(Hz(62.7f), none) == H::LowD);  // 70 cents sharp still counts
+    CHECK(H::Classify(Hz(62.8f), none) == H::None);  // 80 cents is too far
+    CHECK(H::Classify(Hz(52.25f), none) == H::F);    // 75 cents flat of F counts
+    CHECK(H::Classify(0.0f, none) == H::None);
+    CHECK(H::Classify(Hz(62), 59.0f) == H::HighD);   // D4 above a B3
+    CHECK(H::Classify(Hz(50), 59.0f) == H::LowD);    // D3 below it
+}
+
+// Two agreeing windows start a note; a different note releases first; silence releases; nothing
+// unarmed; the idle limit disarms.
+static void Tracker() {
+    H::Tracker t;
+    std::int64_t now = 0;
+    const auto feed = [&](float hz) { now += 32; return t.Feed(hz, now); };
+    CHECK(feed(Hz(57)) == H::None); // not armed
+    t.Arm(now);
+    CHECK(feed(Hz(57)) == H::None); // one window
+    CHECK(feed(Hz(57)) == H::A);    // two in a row
+    CHECK(feed(Hz(57)) == H::A);
+    CHECK(feed(Hz(53)) == H::None); // a different note releases A first
+    CHECK(feed(Hz(53)) == H::F);
+    CHECK(feed(0.0f) == H::None);   // silence releases
+    CHECK(feed(Hz(62)) == H::None);
+    CHECK(feed(0.0f) == H::None);   // one stray window never presses
+    CHECK(feed(Hz(62)) == H::None);
+    // Zelda's Lullaby goes B up to D: the D after a B is the high one.
+    CHECK(feed(Hz(59)) == H::None);
+    CHECK(feed(Hz(59)) == H::B);
+    CHECK(feed(Hz(62)) == H::None);
+    CHECK(feed(Hz(62)) == H::HighD);
+    // Song of Time goes A down to D: low.
+    CHECK(feed(Hz(57)) == H::None);
+    CHECK(feed(Hz(57)) == H::A);
+    CHECK(feed(Hz(50)) == H::None);
+    CHECK(feed(Hz(50)) == H::LowD);
+    CHECK(t.Held() == H::LowD);
+    t.Disarm();
+    CHECK(t.Held() == H::None);
+    CHECK(feed(Hz(57)) == H::None);
+    // Idle: after IdleDisarmMs without a note, arming ends; a note just before keeps it.
+    t.Arm(now);
+    now += H::IdleDisarmMs - 100;
+    CHECK(t.Feed(Hz(57), now) == H::None && t.Armed());
+    now += H::IdleDisarmMs + 1;
+    CHECK(t.Feed(0.0f, now) == H::None);
+    CHECK(!t.Armed());
+    // The high-D context expires.
+    t.Arm(now);
+    feed(Hz(59));
+    feed(Hz(59));
+    now += H::HighDContextMs + 100;
+    feed(0.0f);
+    feed(Hz(62));
+    CHECK(feed(Hz(62)) == H::LowD);
+}
+
+// End to end: tones through DetectPitch into the tracker.
+static void EndToEnd() {
+    H::Tracker t;
+    t.Arm(0);
+    std::int64_t now = 0;
+    H::Note last = H::None;
+    for (int i = 0; i < 4; ++i) last = t.Feed(Detect(Tone(Hz(53), 6000.0f, i)), now += 32);
+    CHECK(last == H::F);
+    last = t.Feed(Detect(std::vector<std::int16_t>(H::Window, 0)), now += 32);
+    CHECK(last == H::None);
+}
+
+int main() {
+    PitchAccuracy();
+    NoPitch();
+    Classify();
+    Tracker();
+    EndToEnd();
+    if (failures) {
+        std::printf("%d failure(s)\n", failures);
+        return 1;
+    }
+    std::puts("hum notes PASS");
+    return 0;
+}
diff --git a/tools/test-mic-log.cpp b/tools/test-mic-log.cpp
new file mode 100644
index 0000000..5c1ece6
--- /dev/null
+++ b/tools/test-mic-log.cpp
@@ -0,0 +1,52 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Host test for Eglantine's src/common/nx2_mic_log.h (patch 1107): the EDEN_MIC_FEED / EDEN_MIC_DUMP
+// index lines are written for the whole session, not only the first 200.
+//   c++ -std=c++20 -O1 -fsanitize=address,undefined -I<patched Eglantine>/src tools/test-mic-log.cpp
+#include <cstdio>
+#include "common/nx2_mic_log.h"
+using namespace Common::Nx2MicLog;
+static int failures = 0;
+#define CHECK(c) do { if (!(c)) { std::fprintf(stderr, "FAIL %s:%d: %s\n", __FILE__, __LINE__, #c); ++failures; } } while (0)
+// Runs `seconds` seconds of 200 drains each with the indices `idx(second)`; returns lines written.
+template <class F> static int Run(Pacer& p, u32& shared, int seconds, F idx) {
+    int lines = 0;
+    for (int s = 0; s < seconds; ++s)
+        for (int d = 0; d < 200; ++d)
+            lines += Due(p, idx(s), shared);
+    return lines;
+}
+int main() {
+    { // Indices never move: 200 lines, then one every 10 s; never more than one a second.
+        Pacer p; u32 shared = 0;
+        CHECK(Run(p, shared, 200, [](int) { return u64{4800}; }) == 200);
+        CHECK(Run(p, shared, 100, [](int) { return u64{4800}; }) == 10);
+    }
+    { // The bug this replaced: past the cap the old code re-checked every drain. 3600 s: at most 3600 lines.
+        Pacer p; u32 shared = 0;
+        const int lines = Run(p, shared, 3600, [](int s) { return u64(s % 2); }); // moves every second
+        CHECK(lines == 3600);
+        Pacer q; u32 shared2 = 0;
+        CHECK(Run(q, shared2, 3600, [](int) { return u64{7}; }) == 200 + (3600 - 200) / 10);
+    }
+    { // A move after the cap is reported at the next chance, and only once.
+        Pacer p; u32 shared = 0;
+        (void)Run(p, shared, 250, [](int) { return u64{0}; });
+        int lines = Run(p, shared, 3, [](int s) { return s == 0 ? u64{1} : u64{1}; });
+        CHECK(lines == 1);
+    }
+    { // No line between chances: exactly one chance per 200 drains.
+        Pacer p; u32 shared = 0;
+        for (int d = 0; d < 199; ++d) CHECK(!Due(p, d, shared));
+        CHECK(Due(p, 0, shared));
+        CHECK(shared == 1);
+    }
+    { // The count is shared between streams: the early lines are 200 in all, not per stream.
+        Pacer a, b; u32 shared = 0;
+        int la = 0, lb = 0;
+        for (int s = 0; s < 150; ++s) for (int d = 0; d < 200; ++d) { la += Due(a, 5, shared); lb += Due(b, 5, shared); }
+        CHECK(la + lb >= 200 && la + lb <= 200 + 2 * 5);
+    }
+    CHECK(Pack(1, 2) != Pack(2, 1) && Pack(0, 4800) != Pack(4800, 0));
+    if (failures == 0) std::puts("PASS");
+    return failures != 0;
+}
