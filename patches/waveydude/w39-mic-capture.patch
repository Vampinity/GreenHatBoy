+/* SPDX-License-Identifier: GPL-3.0-or-later
+ *
+ * Link-time facade of the PS5 libSceAudioIn module, which the Payload SDK has no import library
+ * for: the three functions the controller's mic capture calls (headless/mic_capture.cpp). The
+ * native packaging tool turns the symbols into imports of the firmware module (by NID, as a
+ * game's are); nothing here is linked into the application or ever runs. W-14/W-15 looked the
+ * functions up at run time instead and the module refused every name and NID (0x80020003).
+ */
+int sceAudioInOpen(int user, unsigned type, unsigned index, unsigned length, unsigned rate, unsigned param) {
+    (void)user; (void)type; (void)index; (void)length; (void)rate; (void)param;
+    return -1;
+}
+int sceAudioInInput(int handle, void* samples) {
+    (void)handle; (void)samples;
+    return -1;
+}
+int sceAudioInClose(int handle) {
+    (void)handle;
+    return -1;
+}
