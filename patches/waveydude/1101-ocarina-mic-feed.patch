+// EDEN_UP_MIC_FEED=1 (or auto, or <data>,<system index>,<game index> in hex): the PS5 controller's
+// microphone (EDEN_UP_MIC_PROBE, headless/mic_capture.cpp, eden_mic_read) goes into every raw mic
+// input stream ("...TrueRawAudioIn", 1 channel, Q15). Every drain (5 ms) while the stream is open,
+// the frames due at its rate are written at <data> + 2 * index (mono 16-bit, ring capacity being
+// frames + 1), as many as the ring has room for, and the system's index is moved past them; the
+// game's index is only read. With no mic sample to hand, silence is written, as a quiet mic would
+// give. Default layout: data +0x2000, system index +0x44, game index +0x1004. Lines: EDEN_MIC_FEED.
+struct Nx2MicFeed {
+    bool on{};
+    u64 data{}, system_index{}, game_index{};
+};
+inline const Nx2MicFeed& Nx2MicFeedLayout() {
+    static const Nx2MicFeed layout = [] {
+        Nx2MicFeed feed;
+        const char* value = std::getenv("EDEN_UP_MIC_FEED");
+        if (value == nullptr || value[0] == 0 || std::strcmp(value, "0") == 0 ||
+            std::strcmp(value, "off") == 0) {
+            return feed;
+        }
+        if (std::strcmp(value, "1") == 0 || std::strcmp(value, "auto") == 0 ||
+            std::strcmp(value, "true") == 0 || std::strcmp(value, "on") == 0) {
+            feed = {true, 0x2000, 0x44, 0x1004};
+            LOG_INFO(Service_Audio,
+                     "EDEN_UP_MIC_FEED: auto layout enabled: controller mic goes into raw mic streams: "
+                     "data at +0x2000, system index at +0x44, game index at +0x1004");
+            return feed;
+        }
+        unsigned long long data = 0, system_index = 0, game_index = 0;
+        if (std::sscanf(value, "%llx,%llx,%llx", &data, &system_index, &game_index) == 3 &&
+            data >= 0x10 && system_index + 4 <= 0x10000 && game_index + 4 <= 0x10000) {
+            feed = {true, data, system_index, game_index};
+            LOG_INFO(Service_Audio,
+                     "EDEN_UP_MIC_FEED: custom layout: data at +{:#x}, system index at +{:#x}, "
+                     "game index at +{:#x}",
+                     data, system_index, game_index);
+        } else {
+            LOG_WARNING(Service_Audio,
+                        "EDEN_UP_MIC_FEED={}: expected '1'/'auto' or '<data>,<system index>,<game index>' in hex; off",
+                        value);
+        }
+        return feed;
+    }();
+    return layout;
+}
