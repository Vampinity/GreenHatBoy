diff --git a/headless/refusal_fit.h b/headless/refusal_fit.h
new file mode 100644
index 0000000..c8c37cd
--- /dev/null
+++ b/headless/refusal_fit.h
@@ -0,0 +1,49 @@
+#pragma once
+
+#include <cstdint>
+#include <cstdlib>
+#include <limits>
+
+namespace Eden::RefusalFit {
+
+inline constexpr std::uint64_t SlotBytes = std::uint64_t{2} << 20;
+inline constexpr std::uint64_t MinimumBytes = std::uint64_t{8} << 20;
+inline constexpr std::uint64_t FollowUpBytes = std::uint64_t{64} << 20;
+
+constexpr std::uint64_t RoundedAsk(std::uint64_t refused) noexcept {
+    constexpr auto largest_aligned = std::numeric_limits<std::uint64_t>::max() & ~(SlotBytes - 1);
+    if (refused > largest_aligned / 2) {
+        return largest_aligned;
+    }
+    const auto twice = refused * 2;
+    const auto wanted = twice < MinimumBytes ? MinimumBytes : twice;
+    return (wanted + SlotBytes - 1) & ~(SlotBytes - 1);
+}
+
+inline bool Enabled() noexcept {
+    static const bool enabled = [] {
+        const char* value = std::getenv("EDEN_UP_PACK_REFUSAL_FIT");
+        return value && value[0] == '1' && value[1] == '\0';
+    }();
+    return enabled;
+}
+
+struct Attempt {
+    bool packed_small{};
+    bool follow_up{};
+};
+
+inline thread_local Attempt* current{};
+
+class AttemptScope {
+public:
+    explicit AttemptScope(Attempt& attempt) noexcept : previous{current} { current = &attempt; }
+    ~AttemptScope() { current = previous; }
+    AttemptScope(const AttemptScope&) = delete;
+    AttemptScope& operator=(const AttemptScope&) = delete;
+
+private:
+    Attempt* previous;
+};
+
+} // namespace Eden::RefusalFit
diff --git a/headless/refusal_trace.h b/headless/refusal_trace.h
new file mode 100644
index 0000000..f2bd398
--- /dev/null
+++ b/headless/refusal_trace.h
@@ -0,0 +1,81 @@
+#pragma once
+
+#include <cstdint>
+#include <cstdio>
+#include <ctime>
+
+namespace Eden::RefusalTrace {
+struct PackScan {
+    std::size_t tried{};
+    std::size_t went{};
+    std::size_t limit{};
+    unsigned reasons{};
+    std::uint64_t local_failures{};
+    std::uint64_t other_failures{};
+    const char* stop{"no_pack"};
+    std::size_t spare_uses{};
+    std::size_t spare_taken{};
+    std::size_t spare_refilled{};
+};
+struct Allocation {
+    const char* kind{};
+    std::uint64_t resource_bytes{};
+    unsigned width{}, height{}, depth{}, format{};
+    unsigned layers{}, levels{};
+    std::uint64_t refused_bytes{};
+    const char* source{};
+    bool fit_pack{};
+    bool follow_up{};
+    PackScan* scan{};
+};
+
+inline thread_local Allocation active{};
+
+class Scope {
+public:
+    explicit Scope(Allocation allocation) noexcept : previous{active} {
+        active = allocation;
+    }
+    ~Scope() { active = previous; }
+    Scope(const Scope&) = delete;
+    Scope& operator=(const Scope&) = delete;
+
+private:
+    Allocation previous;
+};
+
+inline Allocation Refused(std::uint64_t bytes, const char* source, const char* fallback) noexcept {
+    auto refusal = active;
+    if (!refusal.kind) {
+        refusal.kind = fallback;
+    }
+    if (!refusal.source) {
+        refusal.refused_bytes = bytes;
+        refusal.source = source;
+    }
+    return refusal;
+}
+inline long long NowNs() noexcept {
+    timespec time{};
+    clock_gettime(CLOCK_MONOTONIC, &time);
+    return static_cast<long long>(time.tv_sec) * 1'000'000'000 + time.tv_nsec;
+}
+
+inline void LogAttempt(const Allocation& refusal, std::uint64_t ask, std::uint64_t freed,
+                       long long start_ns, long long end_ns) noexcept {
+    std::fprintf(stderr,
+                 "EDEN_UP_PACK_REFUSAL_FIT source=%s kind=%s start_ms=%lld refused=%llu "
+                 "asked=%llu freed=%llu took_us=%lld follow_up=%u tried=%zu went=%zu try_limit=%zu"
+                 " failure_mask=%x local_failures=%llu other_failures=%llu stop=%s"
+                 " spare_used=%u spare_takes=%zu spare_refilled=%zu\n",
+                 refusal.source, refusal.kind, start_ns / 1'000'000,
+                 static_cast<unsigned long long>(refusal.refused_bytes),
+                 static_cast<unsigned long long>(ask), static_cast<unsigned long long>(freed),
+                 (end_ns - start_ns) / 1'000, unsigned(refusal.follow_up),
+                 refusal.scan->tried, refusal.scan->went, refusal.scan->limit, refusal.scan->reasons,
+                 static_cast<unsigned long long>(refusal.scan->local_failures),
+                 static_cast<unsigned long long>(refusal.scan->other_failures), refusal.scan->stop,
+                 unsigned(refusal.scan->spare_uses != 0), refusal.scan->spare_taken,
+                 refusal.scan->spare_refilled);
+}
+} // namespace Eden::RefusalTrace
