diff --git a/src/common/nx2_mic_log.h b/src/common/nx2_mic_log.h
new file mode 100644
--- /dev/null
+++ b/src/common/nx2_mic_log.h
@@ -0,0 +1,43 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include "common/common_types.h"
+
+/// EDEN_MIC_FEED / EDEN_MIC_DUMP index lines (W-32): one chance about every second (every 200
+/// drains of 5 ms). The first `first_lines` lines of the session are all written; after that a line
+/// is written when the indices moved since the last line, and every `every_seconds` chances
+/// otherwise, so a long session shows when the game starts reading its raw mic stream.
+namespace Common::Nx2MicLog {
+
+struct Pacer {
+    u32 ticks{};
+    u32 seconds{};
+    u64 last{~u64{0}}; ///< the indices at the last line written (packed by the caller)
+};
+
+/// Called once per drain. True when a line is due now; then `last` already holds `now`.
+/// `lines_so_far` is the session's shared count of chances taken, incremented here.
+[[nodiscard]] constexpr bool Due(Pacer& p, u64 now, u32& lines_so_far, u32 first_lines = 200,
+                                 u32 every_seconds = 10, u32 drains_a_second = 200) noexcept {
+    if (++p.ticks < drains_a_second) {
+        return false;
+    }
+    p.ticks = 0;
+    const bool early = lines_so_far < first_lines;
+    ++lines_so_far;
+    const bool moved = now != p.last;
+    const bool periodic = every_seconds != 0 && ++p.seconds % every_seconds == 0;
+    if (early || moved || periodic) {
+        p.last = now;
+        return true;
+    }
+    return false;
+}
+
+[[nodiscard]] constexpr u64 Pack(u32 a, u32 b) noexcept {
+    return (u64{a} << 32) | b;
+}
+
+} // namespace Common::Nx2MicLog
