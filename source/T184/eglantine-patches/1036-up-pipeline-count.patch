diff --git a/src/video_core/renderer_vulkan/vk_pipeline_count.h b/src/video_core/renderer_vulkan/vk_pipeline_count.h
new file mode 100644
index 0000000000..4d26fee2cf
--- /dev/null
+++ b/src/video_core/renderer_vulkan/vk_pipeline_count.h
@@ -0,0 +1,167 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// EDEN_UP_PIPELINE_COUNT=1 (exactly "1", off by default): log only.
+// Every 60 s one line: the built graphics, mesh and compute pipelines alive, built since start,
+// destroyed since start, and built after the boot preload ("warm": built once the pipeline
+// cache's LoadDiskResources has returned, so during play).
+// Idea: the BC-250 notes' ACT item (a pipeline count over a long session, to see whether the set of
+// pipelines grows without end or is evicted). The count is ours.
+//
+// What counts: a GraphicsPipeline or ComputePipeline object whose driver pipeline was made
+// (vk_graphics_pipeline.cpp after MakePipeline, vk_compute_pipeline.cpp after the driver call);
+// "mesh" is a GraphicsPipeline whose first stage is a task or mesh program (IsMeshPipeline), once,
+// also when its programs run as compute. Destroyed: such an object's destructor while its driver
+// pipeline is held. A failed build counts in neither. Alive = built - destroyed.
+//
+// Not an input of the translation id (gen-translation-id.py): only vk_graphics_pipeline.*,
+// vk_compute_pipeline.* and vk_rasterizer.cpp include this; nothing under src/shader_recompiler
+// does, and vk_pipeline_cache.* is untouched. Off: one cached flag load per build and destructor.
+#pragma once
+
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <mutex>
+#include <string>
+#include <thread>
+
+#include "common/common_types.h"
+#include "common/logging.h"
+#include "common/pe_switch.h"
+
+namespace Vulkan::PipelineCount {
+
+enum Kind : int { Graphics = 0, Mesh = 1, Compute = 2 };
+
+inline bool On() {
+    static const bool on = Common::PeSwitch("EDEN_UP_PIPELINE_COUNT");
+    return on;
+}
+
+struct Counters {
+    std::atomic<u64> built[3]{};
+    std::atomic<u64> destroyed[3]{};
+    std::atomic<u64> warm[3]{};
+    std::atomic<bool> preload_done{false};
+    std::atomic<s64> preload_done_ms{-1};
+};
+
+inline Counters& Get() {
+    static Counters counters;
+    return counters;
+}
+
+inline void Built(Kind kind) {
+    if (!On()) {
+        return;
+    }
+    Counters& c = Get();
+    c.built[kind].fetch_add(1, std::memory_order_relaxed);
+    if (c.preload_done.load(std::memory_order_relaxed)) {
+        c.warm[kind].fetch_add(1, std::memory_order_relaxed);
+    }
+}
+
+inline void Destroyed(Kind kind) {
+    if (!On()) {
+        return;
+    }
+    Get().destroyed[kind].fetch_add(1, std::memory_order_relaxed);
+}
+
+// The logger thread: started by the first LoadDiskResources, stopped by the rasterizer's
+// destructor. Heap-held and never freed while running, so a process exit without the stop does
+// not destroy a joinable std::thread.
+struct Logger {
+    std::mutex mutex;
+    std::condition_variable cv;
+    bool stop{false};
+    std::thread* thread{};
+    std::chrono::steady_clock::time_point start{};
+};
+
+inline Logger& GetLogger() {
+    static Logger* logger = new Logger;
+    return *logger;
+}
+
+inline s64 MsSinceStart() {
+    return std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() -
+                                                                 GetLogger().start)
+        .count();
+}
+
+inline void LogLine(const char* why) {
+    Counters& c = Get();
+    u64 built[3], destroyed[3], warm[3], alive[3];
+    for (int k = 0; k < 3; ++k) {
+        built[k] = c.built[k].load(std::memory_order_relaxed);
+        destroyed[k] = c.destroyed[k].load(std::memory_order_relaxed);
+        warm[k] = c.warm[k].load(std::memory_order_relaxed);
+        alive[k] = built[k] >= destroyed[k] ? built[k] - destroyed[k] : 0;
+    }
+    const s64 preload_ms = c.preload_done_ms.load(std::memory_order_relaxed);
+    LOG_INFO(Render_Vulkan,
+             "EDEN_UP_PIPELINE_COUNT: t={} s ({}): graphics/mesh/compute alive {}/{}/{} (total "
+             "{}), built {}/{}/{}, destroyed {}/{}/{}, warm (after preload) {}/{}/{}; preload {}",
+             MsSinceStart() / 1000, why, alive[0], alive[1], alive[2],
+             alive[0] + alive[1] + alive[2], built[0], built[1], built[2], destroyed[0],
+             destroyed[1], destroyed[2], warm[0], warm[1], warm[2],
+             preload_ms < 0 ? std::string{"not ended"}
+                            : "ended at t=" + std::to_string(preload_ms / 1000) + " s");
+}
+
+inline void StartLogger() {
+    if (!On()) {
+        return;
+    }
+    Logger& logger = GetLogger();
+    std::scoped_lock lock{logger.mutex};
+    if (logger.thread != nullptr) {
+        return;
+    }
+    logger.stop = false;
+    logger.start = std::chrono::steady_clock::now();
+    LOG_INFO(Render_Vulkan, "EDEN_UP_PIPELINE_COUNT=1: a pipeline count line every 60 s");
+    logger.thread = new std::thread([&logger] {
+        std::unique_lock wait_lock{logger.mutex};
+        while (!logger.cv.wait_for(wait_lock, std::chrono::seconds{60},
+                                   [&logger] { return logger.stop; })) {
+            wait_lock.unlock();
+            LogLine("60 s");
+            wait_lock.lock();
+        }
+    });
+}
+
+inline void MarkPreloadDone() {
+    if (!On()) {
+        return;
+    }
+    Counters& c = Get();
+    if (!c.preload_done.exchange(true)) {
+        c.preload_done_ms.store(MsSinceStart(), std::memory_order_relaxed);
+        LogLine("preload ended");
+    }
+}
+
+inline void StopLogger() {
+    if (!On()) {
+        return;
+    }
+    Logger& logger = GetLogger();
+    std::thread* thread;
+    {
+        std::scoped_lock lock{logger.mutex};
+        thread = logger.thread;
+        logger.thread = nullptr;
+        logger.stop = true;
+    }
+    logger.cv.notify_all();
+    if (thread != nullptr) {
+        thread->join();
+        delete thread;
+        LogLine("end");
+    }
+}
+
+} // namespace Vulkan::PipelineCount
