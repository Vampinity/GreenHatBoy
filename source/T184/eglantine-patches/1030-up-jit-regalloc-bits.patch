+    // EDEN_UP_JIT_REGALLOC_BITS bookkeeping (Lichii PR #1517). The masks are kept up to date in
+    // both modes (a few ORs per allocation); only bits_on reads them, so with the switch off the
+    // allocator decides exactly as before.
+    //  dirty:    locations changed since the last EndOfAllocScope (a lock, an argument reference,
+    //            a new value, a move or exchange);
+    //  occupied: locations whose value list is not empty, exactly;
+    //  touched:  locations whose lru_counter may be non-zero (picked by SelectARegister, or the
+    //            target of a move or exchange): Reset zeroes only these.
+    inline void EndOfAllocScopeWord(size_t base, u64 bits) noexcept {
+        for (; bits != 0; bits &= bits - 1) {
+            const size_t idx = base + size_t(std::countr_zero(bits));
+            if (!hostloc_info[idx].IsReleased())
