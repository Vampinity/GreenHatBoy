index 3711b53450..be64ea6c78 100644
--- a/src/core/arm/dynarmic/arm_dynarmic_64.cpp
+++ b/src/core/arm/dynarmic/arm_dynarmic_64.cpp
@@ -5,6 +5,7 @@
 // SPDX-License-Identifier: GPL-2.0-or-later
 
 #include <atomic>
+#include <cstdio>
 #include <cstdlib>
 #if defined(_M_X64) || defined(__x86_64__)
 #include <immintrin.h>
@@ -407,6 +408,30 @@ void ArmDynarmic64::MakeJit(Common::PageTable* page_table, std::size_t address_s
         config.fastmem_pointer = std::nullopt;
         config.fastmem_exclusive_access = false;
     }
+    // EDEN_UP_JIT_X64_OPT=1 (off by default, read once): x64 code generation options ported from
+    // Lichii PR #1531 (zortos293/Lichii aab5393019, from #831 / #717 by stephenjayakar). Paranoid
+    // keeps dynarmic's defaults. Line "EDEN_UP_JIT_X64_OPT core=..." per JIT, and the
+    // emitter's "EDEN_UP_JIT_X64_OPT blocks=..." count line.
+    static const bool x64_opt = [] {
+        const char* const value = std::getenv("EDEN_UP_JIT_X64_OPT");
+        return value != nullptr && value[0] == '1';
+    }();
+    if (x64_opt && Settings::values.cpu_accuracy.GetValue() != Settings::CpuAccuracy::Paranoid) {
+        // An operand that is overwritten but still needed is copied to a free register instead of
+        // being evicted (often to the stack).
+        config.scratch_copy_to_free_reg = true;
+        // W-register writes and zero-extends of values a 32-bit instruction produced skip the
+        // second `mov r32, r32`.
+        config.elide_redundant_zext = true;
+        // The per-block %rbp frame is three instructions per block that nothing reads.
+        config.omit_block_frame = true;
+        // B.cond and CSEL read the host flags left by the Add/Sub before them instead of reloading
+        // NZCV from the guest state (no cycle counter only).
+        config.reuse_host_flags = !config.enable_cycle_counting;
+        std::printf("EDEN_UP_JIT_X64_OPT core=%zu scratch_copy=1 zext=1 no_frame=1 flags=%d\n",
+                    static_cast<std::size_t>(m_core_index), config.reuse_host_flags ? 1 : 0);
+        std::fflush(stdout);
+    }
     m_jit.emplace(config);
 }
 
