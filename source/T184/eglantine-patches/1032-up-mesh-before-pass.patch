+    /// EDEN_UP_MESH_BEFORE_PASS (idea: zortos293/Lichii issue #1431, ronaldpena007-ops): a task/
+    /// mesh draw run as compute inside the open render pass records its compute passes into a
+    /// prelude the pass's begin runs before it begins, instead of ending the pass and beginning
+    /// it again. 0 off (default), 1 on (the rasterizer's periodic dispatch waits while the pass
+    /// can still take commands), 2 on without that wait.
+    [[nodiscard]] static int MeshBeforePassMode();
+
+    /// Where a draw's compute passes go before the open pass. offset: bytes into the mesh scratch
+    /// region, past what the prelude and a draw not yet read hold. restore_chunk: the descriptor
+    /// buffer chunk bound when the pass began, to bind again after the commands.
+    struct BeforePassSlot {
+        bool ok{};
+        VkDeviceSize offset{};
+        bool chunk_bound{};
+        u32 chunk{};
+    };
+
+    /// Recording thread: a slot when the open pass draws into `framebuffer`, its begin has not
+    /// gone to the worker, no draw in it wrote storage, no upload waits, its rescaling matches
+    /// and `bytes` fit in `capacity` after the slots taken; `draw_blocks` (the draw writes
+    /// storage or samples a target of the pass) refuses. !ok: the caller ends the pass as before.
+    BeforePassSlot ReserveBeforePass(const Framebuffer* framebuffer, u64 bytes, u64 capacity,
+                                     bool is_rescaling, bool draw_blocks);
+
+    /// Records `command` into the open pass's prelude at `slot` (from ReserveBeforePass).
+    void RecordBeforePass(const BeforePassSlot& slot, u64 bytes,
+                          std::function<void(vk::CommandBuffer)>&& command);
+
+    /// EDEN_UP_MESH_BEFORE_PASS: a mesh draw's compute passes wrote the scratch region up to
+    /// `end` bytes and its readback draw is not recorded yet: a pass begun before it is keeps its
+    /// prelude's slots past `end`.
+    void NoteMeshScratchWritten(u64 end) noexcept {
+        mesh_scratch_unread_end = end;
+    }
+    /// The readback draw of the last mesh draw was recorded.
+    void NoteMeshScratchRead() noexcept {
+        mesh_scratch_unread_end = 0;
+    }
