+int Scheduler::MeshBeforePassMode() {
+    static const int mode = [] {
+        const char* const value = std::getenv("EDEN_UP_MESH_BEFORE_PASS");
+        const int on = value == nullptr ? 0 : value[0] == '1' ? 1 : value[0] == '2' ? 2 : 0;
+        if (on != 0) {
+            LOG_INFO(Render_Vulkan,
+                     "EDEN_UP_MESH_BEFORE_PASS={}: mesh draws run as compute record their compute "
+                     "passes before the render pass they draw in{}",
+                     on, on == 1 ? " (periodic dispatch waits while a pass can take them)" : "");
+        }
+        return on;
+    }();
+    return mode;
+}
+
+namespace {
+// EDEN_UP_MESH_BEFORE_PASS count line (recording thread only).
+struct MeshBeforePassCounts {
+    enum Reason : size_t { Begun, NoPass, Draw, Stores, Target, Uploads, Rescaling, Room, Count };
+    u64 before{};
+    std::array<u64, Count> refused{};
+    u64 events{};
+
+    void Log() {
+        if (++events; (events & (events - 1)) != 0) {
+            return;
+        }
+        LOG_INFO(Render_Vulkan,
+                 "EDEN_UP_MESH_BEFORE_PASS: {} mesh draws ran before their pass, {} did not (begin "
+                 "sent {}, no pass {}, draw writes storage or samples a target {}, pass wrote "
+                 "storage {}, other target {}, uploads {}, rescaling {}, no room {})",
+                 before,
+                 refused[Begun] + refused[NoPass] + refused[Draw] + refused[Stores] +
+                     refused[Target] + refused[Uploads] + refused[Rescaling] + refused[Room],
+                 refused[Begun], refused[NoPass], refused[Draw], refused[Stores], refused[Target],
+                 refused[Uploads], refused[Rescaling], refused[Room]);
+    }
+};
+MeshBeforePassCounts mesh_before_pass_counts;
+} // Anonymous namespace
+
+Scheduler::BeforePassSlot Scheduler::ReserveBeforePass(const Framebuffer* framebuffer, u64 bytes,
+                                                       u64 capacity, bool is_rescaling,
+                                                       bool draw_blocks) {
+    using Counts = MeshBeforePassCounts;
+    const auto refuse = [](Counts::Reason reason) {
+        ++mesh_before_pass_counts.refused[reason];
+        mesh_before_pass_counts.Log();
+        return BeforePassSlot{};
+    };
+    if (!state.renderpass) {
+        return refuse(Counts::NoPass);
+    }
+    if (!pass_prelude) {
+        return refuse(Counts::Begun);
+    }
+    if (draw_blocks) {
+        return refuse(Counts::Draw);
+    }
+    if (render_pass_has_stores) {
+        return refuse(Counts::Stores);
+    }
+    if (framebuffer == nullptr || state.framebuffer != framebuffer->Handle() ||
+        state.render_area.width != framebuffer->RenderArea().width ||
+        state.render_area.height != framebuffer->RenderArea().height) {
+        return refuse(Counts::Target);
+    }
+    if (uploads_pending) {
+        // A batched upload is recorded after this point; the passes would run before it.
+        return refuse(Counts::Uploads);
+    }
+    if (pass_prelude->rescaling_defined && pass_prelude->is_rescaling != is_rescaling) {
+        // The passes push the down factor; the pass's draws that did not push it read it.
+        return refuse(Counts::Rescaling);
+    }
+    // Device addresses of storage reached through the region: keep each slot 256-byte aligned.
+    const u64 offset = Common::AlignUp(pass_prelude->scratch_next, u64{256});
+    if (offset + bytes > capacity) {
+        return refuse(Counts::Room);
+    }
+    return BeforePassSlot{
+        .ok = true,
+        .offset = offset,
+        .chunk_bound = pass_prelude->chunk_bound,
+        .chunk = pass_prelude->chunk,
+    };
+}
+
+void Scheduler::RecordBeforePass(const BeforePassSlot& slot, u64 bytes,
+                                 std::function<void(vk::CommandBuffer)>&& command) {
+    if (VideoCommon::GpuSplit::check_owner) [[unlikely]] {
+        VideoCommon::GpuSplit::CheckOwner("Scheduler::RecordBeforePass");
+    }
+    pass_prelude->commands.push_back(std::move(command));
+    pass_prelude->scratch_next = slot.offset + bytes;
+    ++record_serial; // patch 0750: RecordedSinceSubmit
+    ++mesh_before_pass_counts.before;
+    mesh_before_pass_counts.Log();
+}
