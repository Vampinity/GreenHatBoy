++#include <cstdio>
++#include <new>
+ #include <chrono>
+ #include <climits>
+ #include <cstdlib>
+@@ -54,6 +56,14 @@ struct Entry {
+ 
+ namespace {
+ 
++/// Log lines dropped because formatting them ran out of memory (Lichii PR #1475). Printed at exit.
++std::atomic<u64> lost_lines{0};
++std::atomic<u64> lost_lines_shown{0};
++
++void CountLostLine() noexcept {
++    lost_lines.fetch_add(1, std::memory_order_relaxed);
++}
++
+ /// @brief Returns the name of the passed log class as a C-string. Subclasses are separated by periods
+ /// instead of underscores as in the enumeration.
+ /// @note GetClassName is a macro defined by Windows.h, grrr...
+@@ -90,7 +100,14 @@ std::string FormatLogMessage(const Entry& entry) noexcept {
+     auto const time_fractional = uint32_t(entry.timestamp.count() % 1000000);
+     auto const class_name = GetLogClassName(entry.log_class);
+     auto const level_name = GetLevelName(entry.log_level);
+-    return fmt::format("[{:4d}.{:06d}] {} <{}> {}:{}:{}: {}\n", time_seconds, time_fractional, class_name, level_name, entry.filename, entry.line_num, entry.function, entry.message);
++    // This function is noexcept: a std::bad_alloc from fmt::format here called std::terminate.
++    // Under memory pressure the line is lost (and counted) instead.
++    try {
++        return fmt::format("[{:4d}.{:06d}] {} <{}> {}:{}:{}: {}\n", time_seconds, time_fractional, class_name, level_name, entry.filename, entry.line_num, entry.function, entry.message);
++    } catch (const std::bad_alloc&) {
++        CountLostLine();
++        return {};
++    }
+ }
+ 
+ template <typename It>
+@@ -255,6 +272,8 @@ struct FileBackend final : public Backend {
+             return;
+ 
+         auto message = FormatLogMessage(entry);
++        if (message.empty() && entry.filename != nullptr)
++            return; // lost to out-of-memory, counted in FormatLogMessage
+ #ifndef __ANDROID__
+         if (Settings::values.censor_username.GetValue()) {
+             // This must be a static otherwise it would get checked on EVERY
+@@ -268,8 +287,15 @@ struct FileBackend final : public Backend {
+                         return std::string{s};
+                 return std::string{};
+             }();
+-            if (!username.empty())
