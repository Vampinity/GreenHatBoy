+                 return device.GetLogical().CreateComputePipeline(compute_ci, *pipeline_cache);
+             });
+             if (burst_job) burst_job->Success();
++            // EDEN_UP_PIPELINE_COUNT (vk_pipeline_count.h): the driver pipeline exists.
++            PipelineCount::Built(PipelineCount::Compute);
+         } catch (const vk::Exception& exception) {
+             LOG_CRITICAL(Render_Vulkan, "Adreno rejected compute shader {:016X}: {}", shader_hash,
+                          exception.what());
+@@ -198,6 +201,13 @@ ComputePipeline::ComputePipeline(const Device& device_, Scheduler& scheduler, vk
