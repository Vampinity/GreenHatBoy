++// Instead of constructing the allocator again for each block (zeroing all 102 locations), put it
++// back the way a new one starts. At a block's end every location is released and empty
++// (AssertNoMoreUses), and a released empty location equals a new one except for lru_counter, so
++// only the touched ones are zeroed. A block that did not end cleanly (a location still holds a
++// value or was changed after the last scope end) gets every location rebuilt: full_resets.
++void RegAlloc::Reset(std::bitset<32> new_gpr_order, std::bitset<32> new_xmm_order) noexcept {
++    static std::atomic<u64> blocks{0};
++    static std::atomic<u64> full_resets{0};
++    if ((occupied_lo | occupied_hi | dirty_lo | dirty_hi) != 0) {
++        for (auto& info : hostloc_info)
++            info = HostLocInfo{};
++        full_resets.fetch_add(1, std::memory_order_relaxed);
++    } else {
++        for (u64 bits = touched_lo; bits != 0; bits &= bits - 1)
++            hostloc_info[size_t(std::countr_zero(bits))].lru_counter = 0;
++        for (u64 bits = touched_hi; bits != 0; bits &= bits - 1)
++            hostloc_info[64 + size_t(std::countr_zero(bits))].lru_counter = 0;
++    }
++    DEBUG_ASSERT(std::all_of(hostloc_info.begin(), hostloc_info.end(), [](const auto& h) noexcept {
++        return h.IsEmpty() && h.IsReleased() && h.lru_counter == 0;
++    }));
++    gpr_order = new_gpr_order;
++    xmm_order = new_xmm_order;
++    reserved_stack_space = 0;
++    dirty_lo = dirty_hi = 0;
++    occupied_lo = occupied_hi = 0;
++    touched_lo = touched_hi = 0;
++    bits_on = true;
++    const u64 n = blocks.fetch_add(1, std::memory_order_relaxed) + 1;
++    if ((n & 0xFFFF) == 0)
++        std::printf("EDEN_UP_JIT_REGALLOC_BITS blocks=%llu full_resets=%llu (all emitters, since start)\n",
++                    (unsigned long long)n, (unsigned long long)full_resets.load(std::memory_order_relaxed));
++}
