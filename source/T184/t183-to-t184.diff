++        LOG_INFO(Render_Vulkan,
++                 "EDEN_UP_COMPUTE_WAIT_LOG totals: {} compute dispatch waits for a pipeline, {:.1f} ms "
++                 "in all, longest {:.1f} ms, {} logged (>= {:.1f} ms)",
++                 s.waits.load(), static_cast<double>(s.total_us.load()) / 1000.0,
