diff --git a/tools/eglantine-patches/1041-up-jit-regalloc-bits-x64-opt-merge.patch b/tools/eglantine-patches/1041-up-jit-regalloc-bits-x64-opt-merge.patch
new file mode 100644
index 0000000000000000000000000000000000000000..fee94ab1b4d33d8e7eb4e4a060ae2e39707ffa11
--- /dev/null
+++ b/tools/eglantine-patches/1041-up-jit-regalloc-bits-x64-opt-merge.patch
@@ -0,0 +1,36 @@
+From: EglantinePS5
+Subject: [PATCH] up: T184 merge of 1030 (EDEN_UP_JIT_REGALLOC_BITS) and 1040 (EDEN_UP_JIT_X64_OPT)
+
+1030 keeps bitmasks of the allocator locations changed since the last scope end (dirty), of those
+holding values (occupied) and of those whose lru_counter moved (touched); with
+EDEN_UP_JIT_REGALLOC_BITS=1 the scope end releases only the dirty ones and Reset clears only the
+touched counters. 1040's scratch_copy_to_free_reg path (EDEN_UP_JIT_X64_OPT=1) write-locks a new
+location, copy_location, without marking it dirty. With both switches on that lock would never be
+released: the next instruction would see a locked register and the next block's Reset would not
+notice it (its full-reset fallback only checks the masks).
+
+Fix (as upstream Lichii has it): MarkDirty(copy_location) after the WriteLock. The other masks are
+already right on that path: SelectARegister marks copy_location touched, and copy_location holds no
+value (it must be empty), so occupied stays clear. Every other mutation of HostLocInfo that 1040
+adds goes through existing allocator calls (DefineValue with an argument, UseGpr), which 1030
+already marks. Nothing outside reg_alloc.cpp reaches hostloc_info.
+
+Each switch alone: unchanged. With EDEN_UP_JIT_REGALLOC_BITS unset nothing reads the masks; with
+EDEN_UP_JIT_X64_OPT unset the scratch-copy branch is never taken.
+
+Not in the kept-store stamp: dynarmic only. KEEPS THE STORE.
+---
+diff --git a/src/dynarmic/src/dynarmic/backend/x64/reg_alloc.cpp b/src/dynarmic/src/dynarmic/backend/x64/reg_alloc.cpp
+index 99cf8d0bda..a56f90b0e4 100644
+--- a/src/dynarmic/src/dynarmic/backend/x64/reg_alloc.cpp
++++ b/src/dynarmic/src/dynarmic/backend/x64/reg_alloc.cpp
+@@ -363,6 +363,9 @@ HostLoc RegAlloc::UseScratchImpl(BlockOfCode& code, IR::Value use_value, std::bi
+                 if (LocInfo(copy_location).IsEmpty()) {
+                     CopyToScratch(code, bit_width, copy_location, current_location);
+                     LocInfo(copy_location).WriteLock();
++                    // T184 (1030 + 1040): a lock is a change, so the scope end must release it.
++                    // SelectARegister already marked copy_location touched, and it holds no value.
++                    MarkDirty(copy_location);
+                     eden_x64_opt_scratch_copies.fetch_add(1, std::memory_order_relaxed);
+                     return copy_location;
+                 }
diff --git a/tools/eglantine-patches/1055-up-tex-share-lichii823-948.patch b/tools/eglantine-patches/1055-up-tex-share-lichii823-948.patch
new file mode 100644
index 0000000000000000000000000000000000000000..a3a40e574177e682835af2551dd93558b87c0411
--- /dev/null
+++ b/tools/eglantine-patches/1055-up-tex-share-lichii823-948.patch
@@ -0,0 +1,53 @@
+From: EglantinePS5
+Subject: [PATCH] up: EDEN_UP_TEX_SHARE=1, the #948 half (uneven-mip ASTC kept as BC), off unless set
+
+Upstream: zortos293/Lichii PR #948 by danieljesus (5fe989125a, open), the partner of PR #823 by
+janvitos (661cf0eb66, merged). Steam Deck, RADV, Ocarina handheld: camera pan 11 -> 14.5 fps with both.
+
+Why: #948 keeps ASTC with uneven BC block mips as BC1/BC3 on integrated GPUs and cards under 6 GiB
+instead of the GPU decoder's RGBA8 (4-16x the size). In this core the RGBA8 rule is already off unless
+EDEN_NX2_UNEVEN_MIPS_RGBA8 is set (0289), so with that unset (the play settings) this changes nothing.
+
+What: with EDEN_UP_TEX_SHARE=1, IsUnevenMipRgba8Astc returns false on an integrated GPU or one with
+under 6 GiB device-local memory (GetDeviceLocalMemory(); #948's own heap-size accessor in vulkan_device
+is left out), even with EDEN_NX2_UNEVEN_MIPS_RGBA8 set. One line at the first evaluation:
+"EDEN_UP_TEX_SHARE: uneven-mip ASTC kept as BC (#948) (integrated ..., device-local ... MiB)".
+The #823 half (the share itself) is the front's tools/prepare-vulkan-port.py PoolPressure.
+
+Unset: as T181. vk_texture_cache.cpp is not a translation id input and no name is added to
+TranslationSwitches: KEEPS THE STORE.
+
+---
+diff --git a/src/video_core/renderer_vulkan/vk_texture_cache.cpp b/src/video_core/renderer_vulkan/vk_texture_cache.cpp
+index f97e337147..1c8f0fcd2c 100644
+--- a/src/video_core/renderer_vulkan/vk_texture_cache.cpp
++++ b/src/video_core/renderer_vulkan/vk_texture_cache.cpp
+@@ -297,6 +297,28 @@ constexpr VkBorderColor ConvertBorderColor(const std::array<float, 4>& color) {
+         id != VK_DRIVER_ID_MESA_RADV) {
+         return false;
+     }
++    // EDEN_UP_TEX_SHARE=1 (zortos293/Lichii PR #948 by danieljesus, 5fe9891, the half of the
++    // texture share pair): RGBA8 is 4-16x the BC size (Ocarina's uneven ASTC 8x8 images took ~3.4 GB
++    // instead of ~0.6 GB at area loads on a Steam Deck, where VRAM and system RAM are one memory).
++    // Integrated GPUs and cards under 6 GiB keep BC even with EDEN_NX2_UNEVEN_MIPS_RGBA8 set.
++    // Device-local memory is GetDeviceLocalMemory() here (#948 adds a heap size to vulkan_device).
++    static const bool tex_share = [] {
++        const char* const value = std::getenv("EDEN_UP_TEX_SHARE");
++        return value != nullptr && value[0] != '\0' && value[0] != '0';
++    }();
++    if (tex_share) {
++        static const bool keep_bc = [&device] {
++            const bool keep = device.IsIntegrated() || device.GetDeviceLocalMemory() < (u64{6} << 30);
++            LOG_INFO(Render_Vulkan,
++                     "EDEN_UP_TEX_SHARE: uneven-mip ASTC {} (integrated {}, device-local {} MiB)",
++                     keep ? "kept as BC (#948)" : "stays RGBA8 (6 GiB or more, discrete)",
++                     device.IsIntegrated(), device.GetDeviceLocalMemory() >> 20);
++            return keep;
++        }();
++        if (keep_bc) {
++            return false;
++        }
++    }
+     return HasUnevenBlockMips(info) && !IsHugeAstcArray(device, info);
+ }
