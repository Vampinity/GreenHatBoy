++unsigned
++radv_mesh_compute_points(void)
++{
++   static int points = -1;
++   if (points < 0) {
++      const char *const asked = getenv("EDEN_UP_RADV_MESH_POINTS");
++      int value = asked && (asked[0] == '1' || asked[0] == '2') && asked[1] == '\0' ? asked[0] - '0' : 0;
++      if (value && !radv_mesh_compute_enabled())
++         value = 0;
++      if (value)
++         fprintf(stderr,
++                 "radv/ps5: EDEN_UP_RADV_MESH_POINTS=%d: mesh shaders of points and lines run as compute%s\n", value,
++                 value == 2 ? ", and triangles that write a point size" : "");
++      p_atomic_set(&points, value);
++   }
++   return points;
++}
++
++void
++radv_mesh_compute_note_points_draw(uint32_t prim_vertices)
++{
++   static uint32_t draws, point_draws, line_draws;
++   if (prim_vertices == 1)
++      p_atomic_inc(&point_draws);
++   else
++      p_atomic_inc(&line_draws);
++   const uint32_t n = p_atomic_inc_return(&draws);
++   if (util_is_power_of_two_nonzero(n))
++      fprintf(stderr, "radv/ps5: EDEN_UP_RADV_MESH_POINTS draws=%u (points %u, lines %u)\n", n,
++              p_atomic_read(&point_draws), p_atomic_read(&line_draws));
++}
++
+ VkResult
