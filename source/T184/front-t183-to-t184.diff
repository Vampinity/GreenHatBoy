++ * switch's value: a point program compiled before was refused and its draws dropped, and a cached
++ * copy of that must not be used. Unset, no hash changes. */
++#define RADV_MESH_COMPUTE_POINTS_REVISION 1u
++
++/* The copy draw's primitive: 1 vertex (points), 2 (lines) or 3 (triangles). A pipeline keeps it in
++ * mesh_compute_prim_vertices, 0 meaning 3; the pipeline cache keeps it in the top byte of the
++ * vertex count (radv_pipeline_cache.c), 0 for triangles, so cached triangle pipelines read as
++ * before. */
