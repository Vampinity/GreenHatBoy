+-   if ((written & ~per_prim) & ~allowed_vertex_outputs) {
++   const bool size_allowed = (prim == MESA_PRIM_POINTS && points) || points == 2;
++   const uint64_t allowed = allowed_vertex_outputs | (size_allowed ? VARYING_BIT_PSIZ : 0);
++   if ((written & ~per_prim) & ~allowed) {
+       mesh_compute_refused(mesh, "a vertex output other than position and generics");
+       return false;
+    }
+@@ -231,6 +270,18 @@ radv_mesh_compute_wanted(const struct radv_graphics_state_key *gfx_state, const
+          }
+       }
+    }
++   /* The line that shows EDEN_UP_RADV_MESH_POINTS took a program the path refused before. */
++   if (point_or_line || (written & VARYING_BIT_PSIZ)) {
++      static uint32_t told;
++      if (told < 32 && p_atomic_inc_return(&told) <= 32)
++         fprintf(stderr,
++                 "radv/ps5: EDEN_UP_RADV_MESH_POINTS: mesh shader of %s runs as compute (vertices %u, primitives %u, "
++                 "outputs 0x%" PRIx64 "%s)\n",
++                 prim == MESA_PRIM_POINTS ? "points" : prim == MESA_PRIM_LINES ? "lines" : "triangles",
++                 mesh->info.mesh.max_vertices_out, mesh->info.mesh.max_primitives_out, written,
++                 (written & VARYING_BIT_PSIZ) ? (prim == MESA_PRIM_POINTS ? ", its point size" : ", point size left out")
++                                              : "");
++   }
+    return true;
+ }
+ 
+@@ -253,13 +304,15 @@ build_copy_vs(const nir_shader_compiler_options *options, const struct mesh_comp
+    b.shader->info.min_subgroup_size = wave_size;
+    b.shader->info.max_subgroup_size = wave_size;
+    b.shader->info.api_subgroup_size = wave_size;
+-   const unsigned vpw = l->max_primitives * 3;
++   /* EDEN_UP_RADV_MESH_POINTS: k = 1 (points) or 2 (lines) instead of 3; corner v % k. */
++   const unsigned k = l->prim_vertices;
++   const unsigned vpw = l->max_primitives * k;
+ 
+    nir_def *v = nir_load_vertex_id_zero_base(&b);
+    nir_def *wg = nir_udiv_imm(&b, v, vpw);
+    nir_def *rem = nir_umod_imm(&b, v, vpw);
+-   nir_def *prim = nir_udiv_imm(&b, rem, 3);
+-   nir_def *corner = nir_umod_imm(&b, rem, 3);
++   nir_def *prim = nir_udiv_imm(&b, rem, k);
++   nir_def *corner = nir_umod_imm(&b, rem, k);
+    nir_def *in_buffer = nir_ult_imm(&b, wg, l->capacity);
+    wg = nir_umin(&b, wg, nir_imm_int(&b, l->capacity - 1));
+ 
+@@ -284,10 +337,23 @@ build_copy_vs(const nir_shader_compiler_options *options, const struct mesh_comp
+       nir_def *addr = nir_iadd(
+          &b, slot,
+          nir_u2u64(&b, nir_iadd_imm(&b, nir_imul_imm(&b, nir_iadd_imm(&b, nir_imul_imm(&b, index, l->num_vtx_slots), s), 16), 16)));
++      if (location == VARYING_SLOT_PSIZ) {
++         /* A point's size (EDEN_UP_RADV_MESH_POINTS): one float, 0 for an unused slot. */
++         nir_def *size = nir_build_load_global(&b, 1, 32, addr, .align_mul = 16);
++         size = nir_bcsel(&b, valid, size, nir_imm_float(&b, 0.0));
++         nir_variable *var = nir_variable_create(b.shader, nir_var_shader_out, glsl_float_type(), "mesh_point_size");
++         var->data.location = VARYING_SLOT_PSIZ;
++         nir_store_var(&b, var, size, 0x1);
