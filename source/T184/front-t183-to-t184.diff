+-   if (mesh->info.mesh.primitive_type != MESA_PRIM_TRIANGLES || gfx_state->has_multiview_view_index) {
++    * per-primitive outputs but the indices, no multiview. EDEN_UP_RADV_MESH_POINTS adds points and
++    * lines, and a point size (copied for points; left out of triangles with =2). */
++   const unsigned points = radv_mesh_compute_points();
++   const unsigned prim = mesh->info.mesh.primitive_type;
++   const bool point_or_line = points && (prim == MESA_PRIM_POINTS || prim == MESA_PRIM_LINES);
++   if ((prim != MESA_PRIM_TRIANGLES && !point_or_line) || gfx_state->has_multiview_view_index) {
+       mesh_compute_refused(mesh, "not triangles, or multiview");
+       return false;
+    }
+@@ -209,7 +246,9 @@ radv_mesh_compute_wanted(const struct radv_graphics_state_key *gfx_state, const
+ 
+    const uint64_t written = mesh->info.outputs_written;
