++        if (on) {
++            NoteRecorderWait(NowNs() - start);
++            SetReaderState(previous);
++        }
++    }
++    RecorderWaitScope(const RecorderWaitScope&) = delete;
++    RecorderWaitScope& operator=(const RecorderWaitScope&) = delete;
++
++private:
++    bool on;
++    ReaderState previous{};
++    u64 start{};
++};
