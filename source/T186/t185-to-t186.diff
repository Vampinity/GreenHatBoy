++// EDEN_UP_LISTWAIT_STATS (item 6): marks on the recorder the parse of one list entry read from a
++// chip-written copy (2: all macro data, 1: with commands, 0: done), in order with what the entry
++// sends; nothing unless the switch is on.
++static void ListWaitMarkRecorder(u8 value) {
++    auto& split = VideoCommon::GpuSplit::Get();
++    if (split.Active()) {
++        split.Defer(
++            [value] {
++                VideoCommon::ListWait::g_recorder_in_list.store(value, std::memory_order_relaxed);
++            },
++            VideoCommon::GpuSplit::FastDrawNeutral);
++    } else {
++        VideoCommon::ListWait::g_recorder_in_list.store(value, std::memory_order_relaxed);
++    }
++}
