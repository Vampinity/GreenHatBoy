++/// The kind of thread a chip wait runs on.
++enum class Thread : u8 { Other, Reader, Recorder, Fencing, Count };
++inline constexpr std::size_t ThreadCount = static_cast<std::size_t>(Thread::Count);
++inline constexpr std::array<const char*, ThreadCount> ThreadNames{"other", "reader", "recorder",
++                                                                  "fencing thread"};
++/// Set where those threads start (only with the switch on); every other thread stays Other.
++inline thread_local Thread this_thread = Thread::Other;
++inline void MarkThread(Thread kind) {
++    if (Enabled()) {
++        this_thread = kind;
++    }
++}
++
++/// What the reader does now (stored by the reader, read by the recorder at its gaps).
++enum class ReaderState : u8 { Idle, Working, Recorder, Chip, Count };
++inline constexpr std::size_t ReaderStateCount = static_cast<std::size_t>(ReaderState::Count);
++inline std::atomic<u8> g_reader_state{0};
++inline void SetReaderState(ReaderState state) {
++    g_reader_state.store(static_cast<u8>(state), std::memory_order_relaxed);
++}
++[[nodiscard]] inline ReaderState GetReaderState() {
++    return static_cast<ReaderState>(g_reader_state.load(std::memory_order_relaxed));
++}
++
++/// Bins of a blocking list copy read's wait: under 0.1 ms, 0.1-1, 1-5, 5-20, 20 ms and more.
++inline constexpr std::size_t WaitBins = 5;
++[[nodiscard]] inline std::size_t WaitBin(u64 ns) {
++    return ns < 100'000 ? 0 : ns < 1'000'000 ? 1 : ns < 5'000'000 ? 2 : ns < 20'000'000 ? 3 : 4;
++}
++/// Bins of the recorder's out-of-work gaps: under 0.1 ms, 0.1-1, 1-5, 5 ms and more.
++inline constexpr std::size_t GapBins = 4;
++[[nodiscard]] inline std::size_t GapBin(u64 ns) {
++    return ns < 100'000 ? 0 : ns < 1'000'000 ? 1 : ns < 5'000'000 ? 2 : 3;
++}
