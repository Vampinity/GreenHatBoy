+/// EDEN_UP_BIG_UPLOAD_CHUNK_RELEASE=1 (exact "1", read once; unset or anything else: off, as
+/// before). TextureCache::UploadInChunks uploads an image of over 64 MiB (Ocarina's 12288x12288
+/// D16 shadow map, 288 MiB, at the load past the field) in 32 MiB chunks, each from a staging
+/// buffer of its own handed out in the same tick: all nine are held until the GPU is past that
+/// tick, which in the load frame is the next drain (276 MiB of staging in one drain, run1545).
+/// With the switch, every chunk but the last takes its staging buffer as a deferred one, and once
+/// its copy is recorded the runtime submits, waits for the GPU (TextureCacheRuntime::Finish), keeps
+/// what this tick handed out busy one tick more (StagingBufferPool::CarryTick, as the transcode
+/// wait does) and gives the buffer back as finished, so the next chunk takes the same buffer. The
+/// copies, their order and their barriers are the same; only the submissions between them are new.
+/// Where the pool has no deferred buffer for a chunk, that chunk goes the old way. Lines: one at
+/// boot, and one EDEN_UP_BIG_UPLOAD_CHUNK_RELEASE line per such upload (the first 32, then every
+/// 32nd) with the staging it held at most against what the old way held.
+constexpr u64 BigUploadChunkReleaseMinBytes = u64{64} << 20;
+[[nodiscard]] inline bool BigUploadChunkRelease() {
+    static const bool enabled = [] {
+        const bool on = Common::PeSwitch("EDEN_UP_BIG_UPLOAD_CHUNK_RELEASE");
+        if (on) {
+            std::fprintf(stderr,
+                         "EDEN_UP_BIG_UPLOAD_CHUNK_RELEASE on: an image upload of over %llu MiB "
+                         "in chunks submits and waits after each chunk but the last, and the next "
+                         "chunk takes the same staging buffer\n",
+                         static_cast<unsigned long long>(BigUploadChunkReleaseMinBytes >> 20));
+        }
+        return on;
+    }();
+    return enabled;
+}
+
+/// EDEN_UP_BIG_UPLOAD_CHUNK_RELEASE: the uploads and the staging they did not hold, for the lines.
+struct BigUploadChunkCounts {
+    u64 uploads = 0;
+    u64 saved_bytes = 0;
+};
+inline BigUploadChunkCounts g_big_upload_chunks{};
+
+/// EDEN_UP_BIG_UPLOAD_CHUNK_RELEASE: a chunk's staging buffer, deferred when `release` and the
+/// runtime can give it back after the chunk (second: true then), else UploadStagingNow's.
+template <typename Runtime>
+[[nodiscard]] auto UploadStagingForChunk(Runtime& runtime, size_t size, bool release) {
+    if constexpr (requires { runtime.FinishChunkUpload(*runtime.TryUploadStagingBuffer(size, true)); }) {
+        if (release) {
+            if (auto staging = runtime.TryUploadStagingBuffer(size, true)) {
+                return std::pair{std::move(staging), true};
+            }
+        }
+    }
+    return std::pair{UploadStagingNow(runtime, size), false};
+}
+
+/// EDEN_UP_BIG_UPLOAD_CHUNK_RELEASE: gives a deferred chunk buffer back if the chunk did not get
+/// to FinishChunkUpload (an exception on the way); ref is cleared once it did.
+template <typename Runtime, typename Ref>
+struct ChunkGiveBack {
+    Runtime& runtime;
+    Ref* ref;
+    ~ChunkGiveBack() {
+        if constexpr (requires { runtime.FreeDeferredStagingBuffer(*ref); }) {
+            if (ref != nullptr) {
+                runtime.FreeDeferredStagingBuffer(*ref);
+            }
+        }
+    }
+};
