+void TextureCacheRuntime::FinishChunkUpload(StagingBufferRef& ref) {
+    // As the transcode wait: the draw being set up reads in the next tick what this one handed
+    // out. The chunk's buffer is deferred, so CarryTick leaves it, and its copy is done.
+    const u64 old_tick = scheduler.CurrentTick();
+    Finish();
+    staging_buffer_pool.CarryTick(old_tick, scheduler.CurrentTick());
+    staging_buffer_pool.FreeDeferred(ref, true);
+}
