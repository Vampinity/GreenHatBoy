 // or anything else: off, the tables grow by doubling as before). The texture cache's slot tables
 // start at that size instead of growing 1, 2, 4, ... slots: each doubling is one allocation of the
@@ -560,6 +625,7 @@ inline size_t ReserveScratchBytes() {
 
 template <class P>
 void TextureCache<P>::ReserveTables() {
+    static_cast<void>(BigUploadChunkRelease()); // its boot line (EDEN_UP_BIG_UPLOAD_CHUNK_RELEASE)
     const u32 slots = ReserveTableSlots();
     if (slots == 0) {
         return;
@@ -5978,6 +6044,12 @@ bool TextureCache<P>::UploadInChunks(Image& image, u64 min_size) {
         MapSizeBytes(image) < min_size) {
         return false;
     }
+    // EDEN_UP_BIG_UPLOAD_CHUNK_RELEASE (BigUploadChunkRelease): each chunk but the last gives its
+    // staging buffer back once its copy is done. Unset: one compare.
+    const bool chunk_release = BigUploadChunkRelease() &&
+                               MapSizeBytes(image) > BigUploadChunkReleaseMinBytes;
+    u64 chunk_held = 0, chunk_peak = 0, chunk_total = 0, chunk_wait_us = 0;
+    u32 chunks = 0, chunks_given_back = 0;
     for (u64 offset = 0; offset < image.guest_size_bytes;) {
         const u64 end = std::min<u64>(offset + chunk_size, image.guest_size_bytes);
         const std::array range{std::pair<u64, u64>{offset, end}};
@@ -5993,7 +6065,8 @@ bool TextureCache<P>::UploadInChunks(Image& image, u64 min_size) {
             offset = end;
             continue; // padding between levels or layers
         }
-        auto staging = UploadStagingNow(runtime, plan.total_host_bytes);
+        auto [staging, give_back] = UploadStagingForChunk(
+            runtime, plan.total_host_bytes, chunk_release && end < image.guest_size_bytes);
         if (!staging) {
             // A chunk of a few MiB fits a stream region, which is never refused.
             if (chunk_size > min_chunk_size) {
@@ -6003,14 +6076,62 @@ bool TextureCache<P>::UploadInChunks(Image& image, u64 min_size) {
             UploadLater(image);
             break;
         }
+        ChunkGiveBack<Runtime, std::remove_reference_t<decltype(*staging)>> unwind{
+            runtime, give_back ? &*staging : nullptr};
         // UploadMemory marks the image initialized at its first call, and each call's barrier
         // covers its chunk: later chunks would claim GENERAL on levels still UNDEFINED.
         runtime.TransitionImageLayout(image);
         ExecuteUnswizzlePlan(*gpu_memory, plan, staging->mapped_span);
         image.UploadMemory(*staging, plan.copies);
+        if (chunk_release) [[unlikely]] {
+            const u64 bytes = plan.total_host_bytes;
+            ++chunks;
+            chunk_total += bytes;
+            chunk_peak = (std::max)(chunk_peak, chunk_held + bytes);
+            bool given_back = false;
+            if constexpr (requires { runtime.FinishChunkUpload(*staging); }) {
+                if (give_back) {
+                    const auto wait_start = std::chrono::steady_clock::now();
+                    runtime.FinishChunkUpload(*staging);
+                    unwind.ref = nullptr;
+                    given_back = true;
+                    chunk_wait_us += static_cast<u64>(
+                        std::chrono::duration_cast<std::chrono::microseconds>(
+                            std::chrono::steady_clock::now() - wait_start)
+                            .count());
+                    ++chunks_given_back;
+                }
+            }
+            if (!given_back) {
+                chunk_held += bytes; // held until the GPU is past this tick, as before
+            }
+        }
         offset = end;
     }
     runtime.InsertUploadMemoryBarrier();
+    if (chunk_release && chunks != 0) [[unlikely]] {
+        BigUploadChunkCounts& counts = g_big_upload_chunks;
+        const u64 saved = chunk_total - (std::min)(chunk_total, chunk_peak);
+        counts.saved_bytes += saved;
+        if (++counts.uploads <= 32 || counts.uploads % 32 == 0) {
+            std::fprintf(stderr,
+                         "EDEN_UP_BIG_UPLOAD_CHUNK_RELEASE upload %llu: gpu=%#llx %ux%u %llu MiB "
+                         "in %u chunks, %u given back after their copy (%llu ms in those "
+                         "submits and waits), %u the old way; staging held at most %llu MiB "
+                         "instead of %llu MiB (%llu MiB less); %llu MiB less so far; frame=%llu\n",
+                         static_cast<unsigned long long>(counts.uploads),
+                         static_cast<unsigned long long>(image.gpu_addr), image.info.size.width,
+                         image.info.size.height,
+                         static_cast<unsigned long long>(MapSizeBytes(image) >> 20), chunks,
+                         chunks_given_back, static_cast<unsigned long long>(chunk_wait_us / 1000),
+                         chunks - chunks_given_back,
+                         static_cast<unsigned long long>(chunk_peak >> 20),
+                         static_cast<unsigned long long>(chunk_total >> 20),
+                         static_cast<unsigned long long>(saved >> 20),
+                         static_cast<unsigned long long>(counts.saved_bytes >> 20),
+                         static_cast<unsigned long long>(frame_tick));
+        }
+    }
     return true;
 }
 
