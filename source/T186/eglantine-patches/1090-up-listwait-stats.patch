diff --git a/src/video_core/listwait_stats.h b/src/video_core/listwait_stats.h
new file mode 100644
index 0000000000..3a210f9a7d
--- /dev/null
+++ b/src/video_core/listwait_stats.h
@@ -0,0 +1,314 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstddef>
+
+#include "common/common_types.h"
+#include "common/pe_switch.h"
+
+// EDEN_UP_LISTWAIT_STATS=1 (exact "1", read once; T186a, thread-decouple PLAN stage 0b): counts
+// and logs, every 10 s, where the command reader (the GPU thread, the split's front) waits for
+// the command lists the chip's own culling jobs write (BufferCache::Nx2ReadListCopy), what reads
+// those words, how the reader's time splits, how the recorder (the split's back) runs out of
+// work, which thread every chip wait (MasterSemaphore::Wait, SubmitStats::WaitTimer) runs on, and
+// how many mesh draws run inside such lists. Log only: nothing is sent, waited for or drawn
+// differently, except one deferred marker before and after each list entry read from a copy (the
+// mesh count) and one fence refresh before each blocking copy wait (the chip's backlog). Off,
+// every site tests the cached flag and does nothing. Counters are fixed-size; nothing allocates.
+// GpuSplit::ReportListWait prints them (the GPU thread's loop, GpuSplit::MaybeStart).
+namespace VideoCommon::ListWait {
+
+[[nodiscard]] inline bool Enabled() {
+    static const bool enabled = Common::PeSwitch("EDEN_UP_LISTWAIT_STATS");
+    return enabled;
+}
+
+/// The kind of thread a chip wait runs on.
+enum class Thread : u8 { Other, Reader, Recorder, Fencing, Count };
+inline constexpr std::size_t ThreadCount = static_cast<std::size_t>(Thread::Count);
+inline constexpr std::array<const char*, ThreadCount> ThreadNames{"other", "reader", "recorder",
+                                                                  "fencing thread"};
+/// Set where those threads start (only with the switch on); every other thread stays Other.
+inline thread_local Thread this_thread = Thread::Other;
+inline void MarkThread(Thread kind) {
+    if (Enabled()) {
+        this_thread = kind;
+    }
+}
+
+/// What the reader does now (stored by the reader, read by the recorder at its gaps).
+enum class ReaderState : u8 { Idle, Working, Recorder, Chip, Count };
+inline constexpr std::size_t ReaderStateCount = static_cast<std::size_t>(ReaderState::Count);
+inline std::atomic<u8> g_reader_state{0};
+inline void SetReaderState(ReaderState state) {
+    g_reader_state.store(static_cast<u8>(state), std::memory_order_relaxed);
+}
+[[nodiscard]] inline ReaderState GetReaderState() {
+    return static_cast<ReaderState>(g_reader_state.load(std::memory_order_relaxed));
+}
+
+/// Bins of a blocking list copy read's wait: under 0.1 ms, 0.1-1, 1-5, 5-20, 20 ms and more.
+inline constexpr std::size_t WaitBins = 5;
+[[nodiscard]] inline std::size_t WaitBin(u64 ns) {
+    return ns < 100'000 ? 0 : ns < 1'000'000 ? 1 : ns < 5'000'000 ? 2 : ns < 20'000'000 ? 3 : 4;
+}
+/// Bins of the recorder's out-of-work gaps: under 0.1 ms, 0.1-1, 1-5, 5 ms and more.
+inline constexpr std::size_t GapBins = 4;
+[[nodiscard]] inline std::size_t GapBin(u64 ns) {
+    return ns < 100'000 ? 0 : ns < 1'000'000 ? 1 : ns < 5'000'000 ? 2 : 3;
+}
+
+/// The list copy waits of one entry, left by Nx2ReadListCopy for DmaPusher::Step (reader only;
+/// an entry can span two pages, so they add up).
+struct EntryWait {
+    u64 waits{};
+    u64 ns{};
+    u64 backlog{}; ///< At the longest wait's start: submitted ticks the chip had not finished
+    u64 ahead{};   ///< ...and of those, the ones up to and with the copy's own
+    u64 longest{};
+    u64 since_present{~u64{0}}; ///< ns from the last present to its start (~0: none seen)
+};
+inline thread_local EntryWait t_entry_wait{};
+
+/// The consumer key of an entry that starts with commands and whose words were never read (its
+/// copy changed while it waited: flushed instead).
+inline constexpr u32 UnreadKey = 0xfff00000;
+
+/// The kind of what reads a list's words: the method the entry continues (its data), or the first
+/// header's method when it starts with commands. Grid lists are macro 0xe74's data, mesh count
+/// lists macro 0xe62's (by the PLAN; the table below gives every id as seen).
+enum class Kind : u8 { Grid, Mesh, Other, Count };
+inline constexpr std::size_t KindCount = static_cast<std::size_t>(Kind::Count);
+/// How the entry relates to that method.
+enum class Shape : u8 { WholeData, DataThenCommands, Commands, Count };
+inline constexpr std::array<const char*, 3> ShapeNames{"all its data", "its data, then commands",
+                                                       "commands, first"};
+
+/// One consumer: engine type, method (macros by their entry's even method) and shape.
+struct Consumer {
+    u32 key{~0U}; ///< (engine << 20) | (shape << 16) | method; ~0: free slot
+    u64 reads{};
+    u64 waits{};
+    u64 wait_ns{};
+};
+inline constexpr std::size_t ConsumerSlots = 16;
+
+/// Reader-only counters (the reader also prints them): plain words.
+struct ReaderStats {
+    // (1) list copy reads and their waits.
+    u64 entries{};      ///< Entries read from a list copy (or that waited for one)
+    u64 entry_waits{};  ///< ...of those, entries that waited
+    u64 copy_waits{};   ///< ...their blocking copy reads (one or two an entry: '#1094' copy waits)
+    std::array<u64, WaitBins> bin_waits{};
+    std::array<u64, WaitBins> bin_ns{};
+    std::array<u64, KindCount> kind_reads{};
+    std::array<u64, KindCount> kind_waits{};
+    std::array<u64, KindCount> kind_ns{};
+    std::array<Consumer, ConsumerSlots> consumers{};
+    u64 consumer_overflow{}; ///< Reads whose consumer found no free slot
+    // The window's longest entry wait.
+    u64 longest_ns{};
+    u32 longest_key{};
+    u32 longest_words{};
+    u64 longest_position{}; ///< Its list copy entry's number since the last present
+    u64 longest_since_present_ns{~u64{0}};
+    u64 longest_backlog{};
+    u64 longest_ahead{};
+    bool longest_fell_back{}; ///< The copy changed during the wait: the entry was flushed instead
+    // (2) the reader clock.
+    u64 dispatch_ns{};      ///< Inside DmaPusher::DispatchCalls (list parsing and its waits)
+    u64 recorder_in_ns{};   ///< Waits for the recorder inside it (GpuSplit::WaitFor, DrainAt)
+    u64 recorder_out_ns{};  ///< ...outside it (maps, flushes and other commands)
+    u64 recorder_waits{};
+    u64 chip_ns{};          ///< Blocking list copy waits (inside it)
+};
+inline ReaderStats g_reader{};
+
+/// Reader-only state that outlives a report window.
+struct ReaderKeep {
+    u64 window_start{};
+    u32 report_calls{};
+    u64 frames_reported{}; ///< g_shared.frames at the last report
+    // Position counting.
+    u64 frame_seen{};
+    u64 reads_in_frame{};
+    // The reader clock's open DispatchCalls.
+    u32 dispatch_depth{};
+    u64 dispatch_start{};
+    // (5) the macros whose code was logged, by engine (0: 3D, 1: compute) and entry.
+    std::array<std::array<bool, 0x80>, 2> dumped{};
+    u32 macros_logged{};   ///< ...of those, the ones besides 0xe62 and 0xe74 (MacroLogCap)
+    bool macro_cap_said{}; ///< The one line saying the cap was reached is out
+};
+/// (5) macros logged in a session besides 0xe62 and 0xe74 (12 lines each, once): no more after.
+inline constexpr u32 MacroLogCap = 8;
+inline ReaderKeep g_reader_keep{};
+
+/// Atomics: written by the recorder, the fencing thread and others.
+struct SharedStats {
+    // (3) the recorder's out-of-work gaps, by length and the reader's state when they began.
+    std::array<std::array<std::atomic<u64>, ReaderStateCount>, GapBins> gaps{};
+    std::array<std::array<std::atomic<u64>, ReaderStateCount>, GapBins> gap_ns{};
+    // (4) chip waits by waiting thread and by the origin SubmitStats gives the waited tick.
+    static constexpr std::size_t Origins = 11; ///< SubmitStats::OriginCount
+    std::array<std::array<std::atomic<u64>, Origins>, ThreadCount> chip_waits{};
+    std::array<std::array<std::atomic<u64>, Origins>, ThreadCount> chip_wait_ns{};
+    // (6) mesh draws inside list entries read from a copy: [whole data?][lone?], and all of them.
+    std::array<std::array<std::atomic<u64>, 2>, 2> list_mesh{};
+    std::atomic<u64> mesh_draws{};
+    // Presents (SubmitStats::NoteFrame, with EDEN_UP_SUBMIT_STATS=1) and the last one's time.
+    std::atomic<u64> frames{};
+    std::atomic<u64> last_present_ns{};
+};
+inline SharedStats g_shared{};
+
+/// On the recorder (or the only GPU thread), set by deferred markers around each list entry the
+/// reader took from a copy: 0 outside one, 1 inside an entry with commands, 2 inside an entry that
+/// is all macro data.
+inline std::atomic<u8> g_recorder_in_list{0};
+
+[[nodiscard]] inline u64 NowNs() {
+    return static_cast<u64>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                std::chrono::steady_clock::now().time_since_epoch())
+                                .count());
+}
+
+inline void Add(std::atomic<u64>& counter, u64 amount = 1) {
+    counter.fetch_add(amount, std::memory_order_relaxed);
+}
+
+/// The reader: entered or left a wait for the recorder (GpuSplit::WaitFor, DrainAt).
+inline void NoteRecorderWait(u64 ns) {
+    auto& stats = g_reader;
+    ++stats.recorder_waits;
+    (g_reader_keep.dispatch_depth != 0 ? stats.recorder_in_ns : stats.recorder_out_ns) += ns;
+}
+
+/// Times one wait of the reader for the recorder; nothing unless the switch is on and this is
+/// the reader.
+class RecorderWaitScope {
+public:
+    RecorderWaitScope() : on{Enabled() && this_thread == Thread::Reader} {
+        if (on) {
+            previous = GetReaderState();
+            SetReaderState(ReaderState::Recorder);
+            start = NowNs();
+        }
+    }
+    ~RecorderWaitScope() {
+        if (on) {
+            NoteRecorderWait(NowNs() - start);
+            SetReaderState(previous);
+        }
+    }
+    RecorderWaitScope(const RecorderWaitScope&) = delete;
+    RecorderWaitScope& operator=(const RecorderWaitScope&) = delete;
+
+private:
+    bool on;
+    ReaderState previous{};
+    u64 start{};
+};
+
+/// DmaPusher::DispatchCalls: the reader parses lists. Nothing unless the switch is on and this
+/// is the reader (the depth and the clock are the reader's plain words).
+class DispatchScope {
+public:
+    DispatchScope() : on{Enabled() && this_thread == Thread::Reader} {
+        if (on && g_reader_keep.dispatch_depth++ == 0) {
+            g_reader_keep.dispatch_start = NowNs();
+            SetReaderState(ReaderState::Working);
+        }
+    }
+    ~DispatchScope() {
+        if (on && --g_reader_keep.dispatch_depth == 0) {
+            g_reader.dispatch_ns += NowNs() - g_reader_keep.dispatch_start;
+            SetReaderState(ReaderState::Idle);
+        }
+    }
+    DispatchScope(const DispatchScope&) = delete;
+    DispatchScope& operator=(const DispatchScope&) = delete;
+
+private:
+    bool on;
+};
+
+[[nodiscard]] inline Kind KindOf(u32 key) {
+    const u32 method = key & 0xffff;
+    return method == 0xe74 ? Kind::Grid : method == 0xe62 ? Kind::Mesh : Kind::Other;
+}
+
+/// The reader, after an entry on a GPU-written list page went through the copy path: what read
+/// its words (`key`), its size, and the copy waits Nx2ReadListCopy left in t_entry_wait.
+/// `copied`: the words came from a copy (false: the read fell back to a flush).
+inline void NoteEntry(u32 key, u32 words, bool copied) {
+    auto& stats = g_reader;
+    EntryWait& wait = t_entry_wait;
+    if (!copied && wait.waits == 0) {
+        return; // a flush without a copy wait: not this path
+    }
+    ++stats.entries;
+    auto& keep = g_reader_keep;
+    const u64 frames = g_shared.frames.load(std::memory_order_relaxed);
+    if (frames != keep.frame_seen) {
+        keep.frame_seen = frames;
+        keep.reads_in_frame = 0;
+    }
+    const u64 position = ++keep.reads_in_frame;
+    const auto kind = static_cast<std::size_t>(KindOf(key));
+    ++stats.kind_reads[kind];
+    Consumer* slot = nullptr;
+    for (Consumer& consumer : stats.consumers) {
+        if (consumer.key == key || consumer.key == ~0U) {
+            consumer.key = key;
+            slot = &consumer;
+            break;
+        }
+    }
+    if (slot != nullptr) {
+        ++slot->reads;
+    } else {
+        ++stats.consumer_overflow;
+    }
+    if (wait.waits == 0) {
+        return;
+    }
+    ++stats.entry_waits;
+    stats.copy_waits += wait.waits;
+    stats.chip_ns += wait.ns;
+    const std::size_t bin = WaitBin(wait.ns);
+    ++stats.bin_waits[bin];
+    stats.bin_ns[bin] += wait.ns;
+    ++stats.kind_waits[kind];
+    stats.kind_ns[kind] += wait.ns;
+    if (slot != nullptr) {
+        ++slot->waits;
+        slot->wait_ns += wait.ns;
+    }
+    if (wait.ns > stats.longest_ns) {
+        stats.longest_ns = wait.ns;
+        stats.longest_key = key;
+        stats.longest_words = words;
+        stats.longest_position = position;
+        stats.longest_since_present_ns = wait.since_present;
+        stats.longest_backlog = wait.backlog;
+        stats.longest_ahead = wait.ahead;
+        stats.longest_fell_back = !copied;
+    }
+}
+
+/// The recorder (or the only GPU thread): a mesh draw (RasterizerVulkan, after its pipeline).
+inline void NoteMeshDraw(bool lone) {
+    Add(g_shared.mesh_draws);
+    const u8 in_list = g_recorder_in_list.load(std::memory_order_relaxed);
+    if (in_list != 0) {
+        Add(g_shared.list_mesh[in_list == 2 ? 1 : 0][lone ? 1 : 0]);
+    }
+}
+
+} // namespace VideoCommon::ListWait
