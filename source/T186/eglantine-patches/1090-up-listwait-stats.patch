+void GpuSplit::ReportListWait() {
+    auto& stats = ListWait::g_reader;
+    auto& keep = ListWait::g_reader_keep;
+    // MaybeStart runs once per GPU thread loop: read the clock every 256th call only.
+    if (++keep.report_calls % 256 != 0) {
+        return;
+    }
+    const u64 now = ListWait::NowNs();
+    auto& shared = ListWait::g_shared;
+    if (keep.window_start == 0) {
+        keep.window_start = now;
+        keep.frames_reported = shared.frames.load(std::memory_order_relaxed);
+        stats = ListWait::ReaderStats{};
+        return;
+    }
+    const u64 window = now - keep.window_start;
+    if (window < 10'000'000'000ULL) {
+        return;
+    }
+    keep.window_start = now;
+    const u64 frames_now = shared.frames.load(std::memory_order_relaxed);
+    const u64 presents = frames_now - keep.frames_reported;
+    keep.frames_reported = frames_now;
+    const auto take = [](std::atomic<u64>& counter) {
+        return counter.exchange(0, std::memory_order_relaxed);
+    };
