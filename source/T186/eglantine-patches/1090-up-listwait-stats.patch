+// EDEN_UP_LISTWAIT_STATS (listwait_stats.h, item 5): the code of a macro that reads words of a
+// chip-written command list, logged once per engine and macro entry at its first such read: 85
+// instructions (255 words) from its start, or to the RAM's end, in the RAM's order (three words an
+// instruction; the end bit is bit 0 of the third, macro_turing.h). Not cut at the first end bit: a
+// branch can cancel it and branch targets can lie past it, so the line names that instruction and
+// the reader of the log decides where the macro ends. At most MacroLogCap macros besides 0xe62 and
+// 0xe74, then one line. A 3D macro runs from the 3D engine's RAM; a compute macro from the RAM the
+// compute engine picks now (the 3D one, shared on Switch 2 channels, until the compute class loads
+// its own: KeplerCompute::ListWaitMacroRam). Read only where the reader owns it: with the split's
+// macros on the front (the front loads them), or without the split.
+static void ListWaitLogMacro(Engines::Maxwell3D* maxwell3d, Engines::KeplerCompute* compute,
+                             u32 key) {
+    const u32 method = key & 0xffff;
+    const bool on_compute =
+        (key >> 20) == static_cast<u32>(Engines::EngineTypes::KeplerCompute);
+    const bool on_3d = (key >> 20) == static_cast<u32>(Engines::EngineTypes::Maxwell3D);
+    if (key == VideoCommon::ListWait::UnreadKey || (!on_3d && !on_compute) ||
+        method < MacroRegistersStart || method >= 0x1000) {
+        return;
+    }
+    // As the engines look a macro up: entries wrap at the table's size.
+    const u32 entry = (method - MacroRegistersStart) >> 1;
+    auto& keep = VideoCommon::ListWait::g_reader_keep;
+    auto& dumped = keep.dumped[on_compute ? 1 : 0];
+    if (std::exchange(dumped[entry % dumped.size()], true)) {
+        return;
+    }
+    if (method != 0xe62 && method != 0xe74) {
+        if (keep.macros_logged >= VideoCommon::ListWait::MacroLogCap) {
+            if (!std::exchange(keep.macro_cap_said, true)) {
+                LOG_INFO(HW_GPU,
+                         "EDEN_UP_LISTWAIT_STATS more macros read chip-written list words; only "
+                         "0xe62, 0xe74 and the first {} others are logged",
+                         VideoCommon::ListWait::MacroLogCap);
+            }
+            return;
+        }
+        ++keep.macros_logged;
+    }
+    const char* const engine_name = on_compute ? "compute" : "3D";
+    // With the macros on the recorder neither engine's macro state is the reader's to read.
+    const auto& split = VideoCommon::GpuSplit::Get();
+    const bool recorder_macros = split.Active() && !split.FrontMacros();
+    std::span<const u32> positions;
+    const MacroEngine* engine = nullptr;
+    if (recorder_macros) {
+        // Not logged (below).
+    } else if (on_compute && compute != nullptr) {
+        engine = compute->ListWaitMacroRam(positions);
+    } else if (on_3d && maxwell3d != nullptr) {
+        engine = &maxwell3d->GetNativeMacroEngine();
+        positions = maxwell3d->GetNativeMacroPositions();
+    }
+    if (engine == nullptr || !engine->native_turing || positions.empty()) {
+        LOG_INFO(HW_GPU,
+                 "EDEN_UP_LISTWAIT_STATS {} macro {:#x} (entry {:#x}) reads chip-written list "
+                 "words; its code is not logged: {}",
+                 engine_name, method, entry,
+                 recorder_macros                          ? "the macros run on the recorder"
+                 : engine == nullptr || positions.empty() ? "no macro RAM known"
+                                                          : "not a native macro");
+        return;
+    }
+    const u32 start = positions[entry % positions.size()];
+    const auto& code = engine->native_code;
+    std::array<u32, 255> words{};
+    size_t count = 0;
+    size_t first_end = words.size(); // the first instruction with the end bit, from the start
+    for (size_t pc = start; count + 3 <= words.size() && pc * 3 + 2 < code.size(); ++pc) {
+        std::copy_n(code.begin() + static_cast<std::ptrdiff_t>(pc * 3), 3, words.begin() + count);
+        if (first_end == words.size() && (code[pc * 3 + 2] & 1) != 0) {
+            first_end = count / 3;
+        }
+        count += 3;
+    }
+    LOG_INFO(HW_GPU,
+             "EDEN_UP_LISTWAIT_STATS {} macro {:#x} (entry {:#x}, start {:#x}) reads "
+             "chip-written list words: {} instructions, {} words{}",
+             engine_name, method, entry, start, count / 3, count,
+             first_end == words.size()
+                 ? std::string{" (no end bit in them)"}
+                 : fmt::format(" (first end bit at instruction {}, words {}-{}; its delay slot "
+                               "follows; what comes after may be another macro's)",
+                               first_end, first_end * 3, first_end * 3 + 2));
+    for (size_t first = 0; first < count; first += 24) {
+        const size_t last = (std::min)(count, first + 24);
+        LOG_INFO(HW_GPU, "EDEN_UP_LISTWAIT_STATS {} macro {:#x} words {}-{}: {:08x}", engine_name,
+                 method, first, last - 1, fmt::join(words.begin() + static_cast<std::ptrdiff_t>(first),
+                                     words.begin() + static_cast<std::ptrdiff_t>(last), " "));
+    }
+}
+
+// EDEN_UP_LISTWAIT_STATS (item 6): marks on the recorder the parse of one list entry read from a
+// chip-written copy (2: all macro data, 1: with commands, 0: done), in order with what the entry
+// sends; nothing unless the switch is on.
+static void ListWaitMarkRecorder(u8 value) {
+    auto& split = VideoCommon::GpuSplit::Get();
+    if (split.Active()) {
+        split.Defer(
+            [value] {
+                VideoCommon::ListWait::g_recorder_in_list.store(value, std::memory_order_relaxed);
+            },
+            VideoCommon::GpuSplit::FastDrawNeutral);
+    } else {
+        VideoCommon::ListWait::g_recorder_in_list.store(value, std::memory_order_relaxed);
+    }
+}
