+/// EDEN_UP_DRAIN_ON_GROWTH=1 or =<MiB> (off unless set; "1" is 256 MiB, other digits 32 to 65535
+/// MiB; anything else off; read once). Two things, both for the load into a new area, where one
+/// frame takes seconds and everything deleted in it waits for that frame's end and 7 more:
+///   - renderer_vulkan/pressure_drain.h: the pressure drain runs as soon as the allocator's use has
+///     grown by this much over its lowest point since the last drain, looked at every 16th draw or
+///     dispatch, not only every 256 draws and 50 ms apart (needs EDEN_UP_PRESSURE_DRAIN=1).
+///   - here, BufferCache::DeleteBuffer: a deleted buffer goes into a TickedDestroyList instead of
+///     the DelayedDestructionRing, and is destroyed once the GPU is past the tick stamped on it,
+///     instead of TICKS_TO_DESTROY (8) frame ends after its deletion; at the latest, when it could
+///     not be stamped or released (conditional rendering on), at those 8 frame ends, as the ring.
+/// Returns the growth in bytes, 0 when off. The boot line is the rasterizer's first call.
+[[nodiscard]] inline std::uint64_t DrainOnGrowthBytes() {
+    static const std::uint64_t bytes = [] {
+        const char* const value = std::getenv("EDEN_UP_DRAIN_ON_GROWTH");
+        if (value == nullptr || value[0] < '0' || value[0] > '9') {
+            return std::uint64_t{0};
+        }
+        std::uint64_t mib = 256;
+        if (std::strcmp(value, "1") != 0) {
+            char* end = nullptr;
+            const unsigned long long number = std::strtoull(value, &end, 10);
+            if (end == value || *end != '\0' || number == 0) {
+                return std::uint64_t{0};
+            }
+            mib = number < 32 ? 32 : number > 65535 ? 65535 : number;
+        }
+        const char* const drain = std::getenv("EDEN_UP_PRESSURE_DRAIN");
+        const bool in_frame = drain != nullptr && std::strcmp(drain, "1") == 0;
+        const bool frame_end = drain != nullptr && std::strcmp(drain, "2") == 0;
+        std::fprintf(stderr,
+                     "EDEN_UP_DRAIN_ON_GROWTH on: a drain once the allocator has grown %llu MiB "
+                     "over its low since the last drain (%s); deleted buffers go once the GPU is "
+                     "past the tick stamped on them at a frame end, a 16-draw look or a drain, at "
+                     "the latest 8 frame ends later as before\n",
+                     static_cast<unsigned long long>(mib),
+                     in_frame    ? "looked at every 16th draw or dispatch"
+                     : frame_end ? "looked at frame ends only: EDEN_UP_PRESSURE_DRAIN=2"
+                                 : "no drains: EDEN_UP_PRESSURE_DRAIN is not 1 or 2");
+        return mib << 20;
+    }();
+    return bytes;
+}
+
+/// EDEN_UP_DRAIN_ON_GROWTH: what TickedDestroyList::ReleasePassed destroyed (by the GPU's tick),
+/// and what ReleaseAged destroyed at the ring's own age, for the lines.
+struct TickedDestroyCounts {
+    std::atomic<std::uint64_t> buffers{0};
+    std::atomic<std::uint64_t> bytes{0};
+    std::atomic<std::uint64_t> aged_buffers{0};
+    std::atomic<std::uint64_t> aged_bytes{0};
+};
+inline TickedDestroyCounts g_ticked_destroyed{};
+
+/// EDEN_UP_DRAIN_ON_GROWTH: deleted objects that wait for the GPU, not for frame ends. Push leaves
+/// an object unstamped (tick 0). Stamp, at a safe point of the recording thread (a frame end, or a
+/// drain before anything of a draw is set up), gives every unstamped object the tick being
+/// recorded then: every command that used one was recorded by then, in that tick or an earlier one
+/// (the reasoning of the pressure drain, which destroys every deleted buffer once the GPU is past
+/// that tick). ReleasePassed destroys, oldest first, the stamped objects the GPU is past.
+/// ReleaseAged destroys, stamped or not, those pushed `ticks` frame ends ago or more: the ring's
+/// own delay, so nothing waits longer than it did in the ring. The caller holds the owner's lock
+/// for all of it.
+template <typename T>
+class TickedDestroyList {
+public:
+    void Push(std::uint64_t bytes, std::uint64_t frame, T&& object) {
+        entries.push_back(Entry{0, bytes, frame, std::move(object)});
+        total_bytes += bytes;
+    }
+
+    void Stamp(std::uint64_t tick) noexcept {
+        for (; stamped < entries.size(); ++stamped) {
+            entries[stamped].tick = tick;
+        }
+    }
+
+    /// is_free(tick): whether the GPU is past it. Stops at the first stamped object it is not past
+    /// (ticks are stamped in order), and at the unstamped ones.
+    template <typename IsFree>
+    void ReleasePassed(IsFree&& is_free) {
+        std::uint64_t buffers = 0;
+        std::uint64_t bytes = 0;
+        while (stamped != 0 && is_free(entries.front().tick)) {
+            bytes += entries.front().bytes;
+            ++buffers;
+            total_bytes -= entries.front().bytes;
+            entries.pop_front();
+            --stamped;
+        }
+        if (buffers != 0) {
+            g_ticked_destroyed.buffers.fetch_add(buffers, std::memory_order_relaxed);
+            g_ticked_destroyed.bytes.fetch_add(bytes, std::memory_order_relaxed);
+        }
+    }
+
+    /// `frame`: the owner's frame count after its frame end (Push took it before).
+    void ReleaseAged(std::uint64_t frame, std::uint64_t ticks) {
+        std::uint64_t buffers = 0;
+        std::uint64_t bytes = 0;
+        while (!entries.empty() && frame - entries.front().frame >= ticks) {
+            bytes += entries.front().bytes;
+            ++buffers;
+            total_bytes -= entries.front().bytes;
+            entries.pop_front();
+            if (stamped != 0) {
+                --stamped;
+            }
+        }
+        if (buffers != 0) {
+            g_ticked_destroyed.aged_buffers.fetch_add(buffers, std::memory_order_relaxed);
+            g_ticked_destroyed.aged_bytes.fetch_add(bytes, std::memory_order_relaxed);
+        }
+    }
+
+    /// Destroys everything now. The caller has waited for the GPU.
+    void Clear() noexcept {
+        entries.clear();
+        stamped = 0;
+        total_bytes = 0;
+    }
+
+    /// The oldest stamped tick, 0 when none is stamped.
+    [[nodiscard]] std::uint64_t OldestTick() const noexcept {
+        return stamped != 0 ? entries.front().tick : 0;
+    }
+
+    template <typename F>
+    void ForEach(F&& f) const {
+        for (const Entry& entry : entries) {
+            f(entry.object);
+        }
+    }
+
+    [[nodiscard]] std::uint64_t Bytes() const noexcept {
+        return total_bytes;
+    }
+    [[nodiscard]] std::size_t Size() const noexcept {
+        return entries.size();
+    }
+
+private:
+    struct Entry {
+        std::uint64_t tick;
+        std::uint64_t bytes;
+        std::uint64_t frame; ///< The owner's frame count at Push
+        T object;
+    };
+    std::deque<Entry> entries;
+    std::size_t stamped = 0; ///< Entries [0, stamped) have their tick
+    std::uint64_t total_bytes = 0;
+};
+
 } // namespace VideoCommon
