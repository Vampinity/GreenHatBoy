+/// EDEN_UP_DRAIN_ON_GROWTH=1 or =<MiB> (video_core/buffer_cache/pending_destroy.h,
+/// DrainOnGrowthBytes; off unless set). With EDEN_UP_PRESSURE_DRAIN=1, every 16th draw or
+/// dispatch between the 256-draw looks reads the allocator's use; once it is the switch's amount
+/// (256 MiB for "1") over its lowest since the last drain, the look comes at once (not 50 ms after
+/// the last one) and drains at once, whatever waits and however much room the pool has, at most
+/// every EDEN_UP_DRAIN_AT_AREA_GAP_MS (100). The drain is the pressure drain's own; its wait, its
+/// GPU-behind rule and its conditional-rendering rule are unchanged. A drain whose wait runs out
+/// still destroys the deleted buffers the GPU is past (BufferCache::ReleaseDeletedPassed).
+/// Line: EDEN_UP_DRAIN_ON_GROWTH drain N (each growth drain: the first 64, then every 16th).
+struct GrowthState {
+    u64 low{};       ///< The allocator's lowest use seen since the last drain (0: none yet)
+    u64 drains{};
+    u64 freed{};
+    std::chrono::steady_clock::time_point last_try{}; ///< The last look growth asked for
+};
+
+/// The recording thread's only.
+inline GrowthState g_growth{};
+
+[[nodiscard]] inline u64 GrowthBytes() {
+    return VideoCommon::DrainOnGrowthBytes();
+}
+
+/// Whether `used` is `grow` over the low since the last drain (which it lowers first).
+[[nodiscard]] inline bool GrowthDue(u64 used, u64 grow) {
+    GrowthState& g = g_growth;
+    if (g.low == 0 || used < g.low) {
+        g.low = used;
+    }
+    return used >= g.low + grow;
+}
+
 /// The pool's largest free piece (the front's kernel query), 0 where it is not known.
 [[nodiscard]] inline u64 LargestFree() {
     return VideoCommon::MemoryCensus::FreeLargest();
