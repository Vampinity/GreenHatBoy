From: EglantinePS5
Subject: [PATCH] up: EDEN_UP_GFX_SCALE_TIER=<n> answers the game's graphics scale tier question with tier n (off by default: 10, as today)

What: nx2:IGraphicsScaleController command 10 (nn::oe::GetCurrentGraphicsScale) answered 10
(tier 0, the whole GPU) always. Switch 2 games size their picture by this tier: seedds/nxnative
(docs/reference/services.md, "The graphics scale does not follow the operation mode", DM_GFX_SCALE)
found Ocarina of Time's output 0.8 times smaller at tier 1: docked 3D 1920x1080 -> 1536x864,
output 2560x1440 -> 2048x1152, GPU p50 15.0 -> 12.9-14.0 ms on an M4 Pro. The game renders smaller
by itself and upscales with its own upscaler.

With EDEN_UP_GFX_SCALE_TIER=0, 1 or 2 (exact), the answer is 10, 20 or 30, read each time the game
asks (Ocarina asks once, at boot: a change after boot is not seen). Each ask logs
"EDEN_UP_GFX_SCALE_TIER: GetCurrentGraphicsScale ask N answered A (tier T; ...)"; another value
answers 10 and says so. SetGraphicsScaleChangedNotificationEnabled logs its flag when set. The
texture cache logs each new size and format of 2D render target 640 or more wide that it makes
("EDEN_UP_GFX_SCALE_TIER rt: new render target size WxH fmt=F ...", at most 48 lines), so a run
shows the 3D size the game took. Unset: the same answer and the same "(STUBBED) called, returning
10" line as before, no other line.

Store: neither file is a translation input (translation_inputs list: no hle/service, no
texture_cache), the name is not in TranslationSwitches, no Settings value changes. KEEPS THE STORE.
---
diff --git a/src/core/hle/service/am/service/graphics_scale_controller.h b/src/core/hle/service/am/service/graphics_scale_controller.h
index 14c3cb0604..a739035c65 100644
--- a/src/core/hle/service/am/service/graphics_scale_controller.h
+++ b/src/core/hle/service/am/service/graphics_scale_controller.h
@@ -3,6 +3,9 @@
 
 #pragma once
 
+#include <atomic>
+#include <cstdlib>
+
 #include "core/hle/service/cmif_types.h"
 #include "core/hle/service/nx2_stub_interface.h"
 #include "core/hle/service/service.h"
@@ -28,9 +31,44 @@ public:
 private:
     // The reply is 12 bytes; only the first word (the scale) is known. The other two used to be
     // left to the message buffer's leftovers.
+    //
+    // EDEN_UP_GFX_SCALE_TIER=<n> (exact "0", "1" or "2"; unset: off, today's answer and line
+    // exactly): the tier answered is n, as 10 + 10 * n (10 = tier 0, the whole GPU; 20 = tier 1;
+    // 30 = tier 2). Ocarina of Time renders its 3D and its output 0.8 times smaller at tier 1
+    // (seedds/nxnative docs/reference/services.md "The graphics scale does not follow the
+    // operation mode": docked 3D 1920x1080 -> 1536x864, output 2560x1440 -> 2048x1152), by itself,
+    // with its own upscaler. Read here, each time the game asks; Ocarina asks once, at boot
+    // (one line per eden_log in the 13 Nov logs), so a change after boot is not seen. Any other
+    // value: answered 10, with a line saying the value was not understood. With the switch set,
+    // every ask logs one EDEN_UP_GFX_SCALE_TIER line (the answer); texture_cache.h then also logs
+    // the render target sizes. Not a translation input, not a Settings value: the store is the same.
     Result GetCurrentGraphicsScale(Out<u32> out_scale, Out<u32> out_unknown1, Out<u32> out_unknown2) {
-        LOG_WARNING(Service_AM, "(STUBBED) called, returning 10");
-        *out_scale = 10;
+        const char* const value = std::getenv("EDEN_UP_GFX_SCALE_TIER");
+        if (value == nullptr) {
+            LOG_WARNING(Service_AM, "(STUBBED) called, returning 10");
+            *out_scale = 10;
+            *out_unknown1 = 0;
+            *out_unknown2 = 0;
+            R_SUCCEED();
+        }
+        static std::atomic<u32> asks{0};
+        const u32 ask = asks.fetch_add(1, std::memory_order_relaxed) + 1;
+        const bool understood =
+            (value[0] == '0' || value[0] == '1' || value[0] == '2') && value[1] == '\0';
+        const u32 tier = understood ? static_cast<u32>(value[0] - '0') : 0;
+        const u32 answer = 10 + 10 * tier;
+        if (understood) {
+            LOG_WARNING(Service_AM,
+                        "EDEN_UP_GFX_SCALE_TIER: GetCurrentGraphicsScale ask {} answered {} "
+                        "(tier {}; 10 = tier 0 full, 20 = tier 1 0.8x, 30 = tier 2)",
+                        ask, answer, tier);
+        } else {
+            LOG_WARNING(Service_AM,
+                        "EDEN_UP_GFX_SCALE_TIER: \"{}\" is not 0, 1 or 2: GetCurrentGraphicsScale "
+                        "ask {} answered 10 (tier 0, as unset)",
+                        value, ask);
+        }
+        *out_scale = answer;
         *out_unknown1 = 0;
         *out_unknown2 = 0;
         R_SUCCEED();
@@ -39,7 +77,15 @@ private:
     // nn::oe::SetGraphicsScaleChangedNotificationEnabled(bool): proxy slot 10, a u8 in and only a
     // result out. The scale never changes here, so there is no notification to enable.
     Result SetGraphicsScaleChangedNotificationEnabled(bool enabled) {
-        LOG_DEBUG(Service_AM, "called, enabled={}", enabled);
+        if (std::getenv("EDEN_UP_GFX_SCALE_TIER") != nullptr) {
+            // With the switch set: whether the game listens for a scale change (it would ask
+            // again only after a change notification, which this service never sends).
+            LOG_WARNING(Service_AM, "EDEN_UP_GFX_SCALE_TIER: game set the scale-changed "
+                                    "notification enabled={}",
+                        enabled);
+        } else {
+            LOG_DEBUG(Service_AM, "called, enabled={}", enabled);
+        }
         R_SUCCEED();
     }
 };
diff --git a/src/video_core/texture_cache/texture_cache.h b/src/video_core/texture_cache/texture_cache.h
index 7262dc0fc2..774c136aaf 100644
--- a/src/video_core/texture_cache/texture_cache.h
+++ b/src/video_core/texture_cache/texture_cache.h
@@ -231,6 +231,19 @@ constexpr u64 BigImageLogBytes = u64{128} << 20;
     return enabled;
 }
 
+/// EDEN_UP_GFX_SCALE_TIER set to anything (read once; the answer itself is in
+/// am/service/graphics_scale_controller.h): one HW_GPU line for each new size and format of 2D
+/// render target at least GfxScaleRtMinWidth wide that InsertImage makes, at most
+/// GfxScaleRtMaxLines lines, so a run shows the size the game draws its 3D at (1920x1080 at
+/// tier 0, 1536x864 expected at tier 1) and its output. Count only; nothing else changes. Unset:
+/// no line.
+constexpr u32 GfxScaleRtMinWidth = 640;
+constexpr u32 GfxScaleRtMaxLines = 48;
+[[nodiscard]] inline bool GfxScaleRtLog() {
+    static const bool enabled = std::getenv("EDEN_UP_GFX_SCALE_TIER") != nullptr;
+    return enabled;
+}
+
 /// EDEN_UP_BIG_DEPTH_NO_UPLOAD=<MiB> (digits only, 1..65536, read once; unset, 0 or anything
 /// else: off, exactly as before). Ocarina's 12288x12288 D16 shadow map (288 MiB) is first seen as
 /// a texture (EDEN_UP_BIG_IMAGE_LOG "made ... rt=0"), not as a cleared or drawn target, so
@@ -7365,6 +7378,27 @@ ImageId TextureCache<P>::InsertImage(const ImageInfo& info, GPUVAddr gpu_addr,
                     True(image.flags & ImageFlagBits::CpuModified) ? 1 : 0,
                     True(image.flags & ImageFlagBits::Unbacked) ? 1 : 0, frame_tick, big_made);
     }
+    if (GfxScaleRtLog() && render_target && image.info.type == ImageType::e2D &&
+        image.info.size.width >= GfxScaleRtMinWidth) {
+        // Under the texture cache lock, as big_made above.
+        struct SeenSize {
+            u32 width, height, format;
+        };
+        static std::vector<SeenSize> seen_sizes;
+        const u32 width = image.info.size.width, height = image.info.size.height;
+        const u32 format = static_cast<u32>(image.info.format);
+        const bool known = std::ranges::any_of(seen_sizes, [&](const SeenSize& s) {
+            return s.width == width && s.height == height && s.format == format;
+        });
+        if (!known && seen_sizes.size() < GfxScaleRtMaxLines) {
+            seen_sizes.push_back({width, height, format});
+            LOG_WARNING(HW_GPU,
+                        "EDEN_UP_GFX_SCALE_TIER rt: new render target size {}x{} fmt={} ly={} "
+                        "id={} gpu={:#x} frame={} ({} sizes so far)",
+                        width, height, format, image.info.resources.layers, image_id.index,
+                        image.gpu_addr, frame_tick, seen_sizes.size());
+        }
+    }
     if (TcTrace() && image.guest_size_bytes >= TcTraceMinBytes()) {
         const double ms = std::chrono::duration<double, std::milli>(
                               std::chrono::steady_clock::now() - trace_start)
