+    /// EDEN_UP_L1436_ENGINE_TRACKED (zortos293/Lichii #1436): as MarkRegionAsCpuModified, for
+    /// data the GPU's own engines wrote to guest memory (inline constant buffer data): the pages
+    /// stay tracked, as no guest CPU write needs to be let through, and the next upload has
+    /// nothing to track again. Returns the pages that stayed tracked (pages a CPU mark would have
+    /// untracked).
+    u64 MarkRegionAsWrittenTracked(VAddr dirty_cpu_addr, u64 query_size) {
+        u64 kept = 0;
+        IteratePages<true>(dirty_cpu_addr, query_size,
+                           [&kept](Manager* manager, u64 offset, size_t size) {
+                               kept += manager->MarkWrittenTracked(manager->cpu_addr + offset, size);
+                           });
+        return kept;
+    }
