index 0000000000000000000000000000000000000000..c6650427571aca0dd20cbdfeb085f9b6f5fafd27
--- /dev/null
+++ b/src/video_core/up_backx.h
@@ -0,0 +1,120 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <atomic>
+#include <chrono>
+#include <cstdlib>
+#include <mutex>
+#include <utility>
+
+#include "common/common_types.h"
+#include "common/logging.h"
+#include "common/pe_switch.h"
+
+/// The rest of zortos293/Lichii #1586 (5e428570d2, Zortos with capy-ai; from jpkto/Lichii
+/// 7a5e5357cb, f5edeabdbb, e7581fa9f6, DahBard/Lichii b95617b80f, skolvolt/Lichii 9267908a3d and
+/// lucastaonline's 865afaa4f3 of #1161): back micro-cuts. The page split of the same PR is 0835.
+///
+/// EDEN_UP_BACKX=1 (exact "1", 1004): the GPU back skips locks and passes that change nothing:
+///  - GPU::InvalidateGPUCache gathers only when a core's dirty memory manager shows a write
+///    (MayHavePending), with the page split on, EDEN_UP_HELD_VS_DOWNLOAD off and, with
+///    EDEN_UP_AHEAD_GUARD, no write gathered at a present, held or re-dirtied waiting;
+///  - AccelerateInlineToMemory skips the buffer cache's lock when no written page was ever
+///    GPU-written or is a command list page (Ampere, deferred inline path);
+///  - UsageTracker::Reset clears only the words tracked since the last reset;
+///  - OnCacheInvalidations takes each cache's lock once for all the writes.
+/// EDEN_UP_BACKX_DRAW=1 (exact "1", 1005): the draw side:
+///  - dynamic vertex input states kept in a 256-entry cache keyed by their registers;
+///  - the fast-draw prepare clock read only when its times are logged;
+///  - a uniform slot whose bytes changed 8 binds in a row binds its next 64 without the compare;
+///  - the drawing thread's fast-draw breaks skip the locked add once the serial moved.
+/// EDEN_UP_BACKX_VERIFY=1 (exact "1", with EDEN_UP_BACKX): every skip of 1004 also runs the work
+/// it replaces and logs "EDEN_UP_BACKX verify mismatch" where that work would have done
+/// something; the gather check tells a write collected after the check (a race the next call
+/// covers) from a missed one.
+/// Unset: as before. Read in VideoCore::CreateGPU (env.txt is read in main).
+namespace VideoCommon::UpBackX {
+
+inline bool g_back{};
+inline bool g_draw{};
+inline bool g_verify{};
+
+/// Counters. Most are kept by one thread (the back): a plain load and store, no locked add.
+struct Counts {
+    std::atomic<u64> gathers{};          ///< InvalidateGPUCache calls (switch on)
+    std::atomic<u64> gathers_skipped{};
+    std::atomic<u64> gather_blocked{};   ///< nothing pending, but a guard kept the gather
+    std::atomic<u64> inline_writes{};
+    std::atomic<u64> inline_lock_skips{};
+    std::atomic<u64> tracker_resets{};
+    std::atomic<u64> tracker_words_cleared{};
+    std::atomic<u64> tracker_words_spared{};
+    std::atomic<u64> invalidation_batches{};
+    std::atomic<u64> invalidation_writes{};
+    std::atomic<u64> vertex_input_builds{};
+    std::atomic<u64> vertex_input_hits{};
+    std::atomic<u64> draw_clock_skips{};
+    std::atomic<u64> uniform_streaks{};
+    std::atomic<u64> uniform_direct_binds{};
+    std::atomic<u64> break_add_skips{};
+    std::atomic<u64> verify_races{};
+    std::atomic<u64> verify_misses{};
+};
+
+inline Counts g_counts;
+
+inline void Add(std::atomic<u64>& counter, u64 value = 1) noexcept {
+    counter.store(counter.load(std::memory_order_relaxed) + value, std::memory_order_relaxed);
+}
+
+inline void ReadSwitches() {
+    g_back = Common::PeSwitch("EDEN_UP_BACKX");
+    g_draw = Common::PeSwitch("EDEN_UP_BACKX_DRAW");
+    g_verify = g_back && Common::PeSwitch("EDEN_UP_BACKX_VERIFY");
+    if (g_back || g_draw) {
+        LOG_INFO(HW_GPU, "EDEN_UP_BACKX: back cuts {}, draw cuts {}, verify {}", g_back ? "on" : "off",
+                 g_draw ? "on" : "off", g_verify ? "on" : "off");
+    }
+}
+
+/// Verify: a skip the locked work contradicts (logged 64 times at most).
+inline void Mismatch(const char* what, u64 address, u64 size) {
+    static std::atomic<u32> logged{};
+    if (logged.fetch_add(1, std::memory_order_relaxed) < 64) {
+        LOG_ERROR(HW_GPU, "EDEN_UP_BACKX verify mismatch: {} at {:#x}+{:#x}", what, address, size);
+    }
+}
+
+/// One line every 10 s while a switch is on, looked at every 4096 gathers (InvalidateGPUCache,
+/// ~900 a frame).
+inline void MaybeLog() {
+    static std::mutex mutex;
+    static auto last = std::chrono::steady_clock::now();
+    std::scoped_lock lock{mutex};
+    const auto now = std::chrono::steady_clock::now();
+    if (now - last < std::chrono::seconds{10}) {
+        return;
+    }
+    last = now;
+    Counts& c = g_counts;
+    const auto take = [](std::atomic<u64>& counter) {
+        return counter.exchange(0, std::memory_order_relaxed);
+    };
+    LOG_INFO(HW_GPU,
+             "EDEN_UP_BACKX in 10 s: gathers {} skipped {} (kept by a guard {}), inline writes {} "
+             "lock skips {}, tracker resets {} words cleared {} spared {}, invalidation batches {} "
+             "writes {} | draw: vertex input builds {} cache hits {}, clock skips {}, uniform "
+             "streaks {} direct binds {}, break adds skipped {} | verify races {} misses {} (must "
+             "stay 0)",
+             take(c.gathers), take(c.gathers_skipped), take(c.gather_blocked),
+             take(c.inline_writes), take(c.inline_lock_skips), take(c.tracker_resets),
+             take(c.tracker_words_cleared), take(c.tracker_words_spared),
+             take(c.invalidation_batches), take(c.invalidation_writes),
+             take(c.vertex_input_builds), take(c.vertex_input_hits), take(c.draw_clock_skips),
+             take(c.uniform_streaks), take(c.uniform_direct_binds), take(c.break_add_skips),
+             take(c.verify_races), take(c.verify_misses));
+}
+
+} // namespace VideoCommon::UpBackX
