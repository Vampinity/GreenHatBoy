+/// Which reader met a copy in Overlay (EDEN_UP_AHEAD_GUARD_ALL_READS).
+enum class AnyReader : u32 { DeviceBlock = 0, GpuBlock = 1, Span = 2 };
+
+/// EDEN_UP_AHEAD_GUARD_ALL_READS: [device_addr, device_addr + size) of guest memory was just read
+/// into `out` (null: only asks, for a span). Bytes of a page copied for a frame the back still
+/// records are put over it from the copy, as Read does for buffers, and noted to be handed back
+/// as a guest write when that frame is passed or lifted. Returns whether a copy met the range.
+/// Lock-free and false while no copy is up (one atomic and the range's bits).
+inline bool Overlay(u64 device_addr, void* out, u64 size, AnyReader reader) {
+    constexpr u64 limit = u64{1} << AddressBits;
+    if (!AllReads() || Detail::own_reads != 0 || size == 0 || device_addr >= limit) {
+        return false;
+    }
+    State& s = Get();
+    if (!s.active.load(std::memory_order_acquire) || !HasCopy(device_addr, size)) {
+        return false;
+    }
+    std::scoped_lock lk{s.mutex};
+    std::array<u32, MaxSlots> order{};
+    const u32 count = s.copies_used == 0 ? 0 : Detail::ReadOrderLocked(s, order);
+    if (count == 0) {
+        return false;
+    }
+    const u64 end = (std::min)(device_addr + size, limit);
+    bool met = false;
+    for (u64 at = device_addr; at < end;) {
+        const u64 page = at >> PageBits;
+        const u64 piece_end = (std::min)(end, (page + 1) << PageBits);
+        const auto [copy, rank] = Detail::CopyForRead(s, page, order, count);
+        if (copy != NoSlot) {
+            met = true;
+            if (out != nullptr) {
+                std::memcpy(static_cast<u8*>(out) + (at - device_addr),
+                            s.copy_bytes.get() + u64{copy} * PageSize + (at & (PageSize - 1)),
+                            piece_end - at);
+                s.stats.any_read_bytes += piece_end - at;
+                auto& served = s.slots[order[rank]].served;
+                const std::pair<u64, u32> range{at, static_cast<u32>(piece_end - at)};
+                if (served.empty() || served.back() != range) {
+                    served.push_back(range);
+                }
+            } else {
+                break; // a span: one copy is enough to refuse it
+            }
+        }
+        at = piece_end;
+    }
+    if (met) {
+        ++s.stats.any_reads[static_cast<u32>(reader)];
+    }
+    return met;
+}
