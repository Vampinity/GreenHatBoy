    struct radv_shader_part *shader_part;
@@ -3209,6 +3224,16 @@ fail:
    return NULL;
 }
 
+/* lead-mesh-42: a shader part (prolog, epilog) is kept in the device's cache: a long-lived scope. */
+struct radv_shader_part *
+radv_shader_part_create(struct radv_device *device, struct radv_shader_part_binary *binary, unsigned wave_size)
+{
+   u_eden_long_lived_enter();
+   struct radv_shader_part *shader_part = radv_shader_part_create_kept(device, binary, wave_size);
+   u_eden_long_lived_leave();
+   return shader_part;
+}
