--- a/src/amd/vulkan/radv_descriptor_set.c
+++ b/src/amd/vulkan/radv_descriptor_set.c
@@ -12,6 +12,7 @@
 #include "radv_entrypoints.h"
 #include "radv_sampler.h"
 #include "vk_descriptors.h"
+#include "util/u_eden_long_lived.h" /* lead-mesh-42 */
 
