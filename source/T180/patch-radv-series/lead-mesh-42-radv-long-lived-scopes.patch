 radv_shader_part_cache_init(struct radv_shader_part_cache *cache, struct radv_shader_part_cache_ops *ops)
 {
diff --git a/src/util/u_eden_long_lived.h b/src/util/u_eden_long_lived.h
new file mode 100644
index 0000000..c2b0232
--- /dev/null
+++ b/src/util/u_eden_long_lived.h
@@ -0,0 +1,44 @@
+/*
+ * Copyright © 2026 EglantinePS5
+ * SPDX-License-Identifier: MIT
+ */
+
+/* lead-mesh-42 (EglantinePS5 T175b): the objects the driver keeps after a build (a shader, its
+ * code copy and debug info, cache objects, pipelines, descriptor set layouts) are made inside a
+ * long-lived scope. The app's heap (EglantinePS5 headless/heap_arenas.inc) then gives their small
+ * blocks from one shared set of arenas instead of the compile thread's own, so the compile threads'
+ * arenas empty after each build (RADV_PS5_LONGLIVED_ARENA=1, read by the app; unset or 0: the scope
+ * is a load and a return in the app). The two functions are the app's, weak here: a program without
+ * them links, and the scopes then do nothing. After heydemoura/EglantinePS5 PR 104 (branch
+ * perf/heap-memory, commit 0a5efdc, docs/HEAP-MEMORY-RESEARCH.md, "next steps" 1), which found
+ * these objects pinning the compile threads' arenas and proposed this; the code is ours.
+ */
+#ifndef U_EDEN_LONG_LIVED_H
+#define U_EDEN_LONG_LIVED_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+void eden_heap_long_lived_enter(void) __attribute__((weak));
+void eden_heap_long_lived_leave(void) __attribute__((weak));
+
+static inline void
+u_eden_long_lived_enter(void)
+{
+   if (eden_heap_long_lived_enter)
+      eden_heap_long_lived_enter();
+}
+
+static inline void
+u_eden_long_lived_leave(void)
+{
+   if (eden_heap_long_lived_leave)
+      eden_heap_long_lived_leave();
+}
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* U_EDEN_LONG_LIVED_H */
diff --git a/src/vulkan/runtime/vk_pipeline_cache.c b/src/vulkan/runtime/vk_pipeline_cache.c
index a0a7fc9..6b1d250 100644
--- a/src/vulkan/runtime/vk_pipeline_cache.c
+++ b/src/vulkan/runtime/vk_pipeline_cache.c
@@ -34,6 +34,7 @@
 #include "util/blob.h"
 #include "util/u_debug.h"
 #include "util/disk_cache.h"
+#include "util/u_eden_long_lived.h" /* lead-mesh-42 */
 #include "util/hash_table.h"
 #include "util/set.h"
 #include "util/u_atomic.h"
@@ -299,8 +300,13 @@ vk_pipeline_cache_object_deserialize(struct vk_pipeline_cache *cache,
    struct blob_reader reader;
    blob_reader_init(&reader, data, data_size);
 
+   /* lead-mesh-42: the object is kept (in the cache, by a pipeline); its blocks go to the app's
+    * long-lived arenas with RADV_PS5_LONGLIVED_ARENA=1. Only the object: the blob it is read from is
+    * the caller's. */
+   u_eden_long_lived_enter();
    struct vk_pipeline_cache_object *object =
       ops->deserialize(cache, key_data, key_size, &reader);
+   u_eden_long_lived_leave();
 
    if (object == NULL)
       return NULL;
