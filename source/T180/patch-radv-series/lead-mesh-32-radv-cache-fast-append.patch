From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: EglantinePS5
Date: Fri, 13 Nov 2026 18:00:00 +0100
Subject: [PATCH] util/mesa_cache_db: owned parts append through a buffer, index in batches (RADV_PS5_CACHE_FAST)

The PS5 port opens every database part exclusively ("exclusive by default",
mesa_cache_db_multipart.c EXCLUSIVE_DEFAULT): files open and flocked for the
process's life, index in memory. What is left per put upstream is the write
itself: fseek to the end of the .db and of the .idx (each a stdio flush and an
lseek), fwrite of the 28-byte entry header and the blob, fwrite of the 28-byte
index entry, then fflush of both: two write(2) calls that grow two files, per
put, under the part's lock. mesa_cache_db_has_space, called first for every
put, seeks to the end once more.

With RADV_PS5_CACHE_FAST=1 (read once per process; owned parts only):
- the .db stream gets a 1.06 MiB stdio buffer (setvbuf after every open);
- the stream stays at the end between puts: its end is known
  (db->cache_end) and a seek is made only when a read moved the stream;
- the index entries wait in memory, up to 64 or 1 MiB of entries, and are
  written in one write after the .db bytes are flushed (mesa_db_fast_flush),
  so an index on disk never points past the data;
- has_space uses the known end: no seek, so no flush.
The held-back entries are written before anything reads the index file
(write_times, so also before every compaction and at close), and a read hit
on a held-back entry first seeks, which writes the stdio buffer out.

Same files, same format, same keys and same cache UUID: entries written
either way are read either way. Off: one branch per put, upstream otherwise.
Ours. Touches nothing lead-mesh-01..28 touch.

T172 rebase onto lead-mesh-29..31 (13 Nov 2026): the fast path now lives in
lead-mesh-30's mesa_cache_db_entry_write_ex, not in mesa_cache_db_entry_write
(which lead-mesh-30 made a wrapper). Changed there: the key is looked up before
the room check (a known key returns MESA_CACHE_DB_WRITE_EXISTS and costs no
compaction), and with compact_if_full=false (RADV_PS5_DISK_CACHE_SKIP_KNOWN) a
part with no room returns MESA_CACHE_DB_WRITE_NO_SPACE so the next part is
tried. mesa_db_compact: lead-mesh-31 already takes the start time; the fast
counts use it at the end (upstream's early returns no longer leave a negative
time in compact_ns). The duplicate u_atomic.h include is dropped.

Co-Authored-By: Claude Opus 5.5
---
diff --git a/src/util/mesa_cache_db.c b/src/util/mesa_cache_db.c
index 16092ab..ce1fcd8 100644
--- a/src/util/mesa_cache_db.c
+++ b/src/util/mesa_cache_db.c
@@ -62,6 +62,38 @@ struct mesa_index_db_hash_entry {
    bool time_dirty;
 };
 
+/* RADV_PS5_CACHE_FAST (lead-mesh-32): an owned database appends through a
+ * stdio buffer of this size and writes its index entries in batches of up to
+ * MESA_DB_FAST_PENDING, or sooner when MESA_DB_FAST_FLUSH_BYTES of entries
+ * wait. Upstream hands every entry to the OS at once: two write calls that
+ * grow two files, and two seeks, per put. */
+#define MESA_DB_FAST_BUFFER      (1024 * 1024 + 64 * 1024)
+#define MESA_DB_FAST_FLUSH_BYTES (1024 * 1024)
+#define MESA_DB_FAST_PENDING     64
+
+static struct mesa_cache_db_ps5_counts mesa_db_ps5_counts;
+
+bool
+mesa_cache_db_ps5_fast(void)
+{
+   static int fast = -1;
+
+   if (fast < 0)
+      fast = debug_get_bool_option("RADV_PS5_CACHE_FAST", false);
+
+   return fast;
+}
+
+void
+mesa_cache_db_ps5_get_counts(struct mesa_cache_db_ps5_counts *counts)
+{
+   counts->flushes = p_atomic_read(&mesa_db_ps5_counts.flushes);
+   counts->flush_ns = p_atomic_read(&mesa_db_ps5_counts.flush_ns);
+   counts->deferred = p_atomic_read(&mesa_db_ps5_counts.deferred);
+   counts->compactions = p_atomic_read(&mesa_db_ps5_counts.compactions);
+   counts->compact_ns = p_atomic_read(&mesa_db_ps5_counts.compact_ns);
+}
+
 static inline bool mesa_db_seek_end(FILE *file)
 {
    return !fseek(file, 0, SEEK_END);
@@ -246,6 +278,68 @@ mesa_db_write_header(struct mesa_cache_db_file *db_file,
    return true;
 }
 
+/* A fast database's streams get their large buffer: before their first use,
+ * so after every (re)open. */
+static void
+mesa_db_fast_buffers(struct mesa_cache_db *db)
+{
+   if (db->fast && db->cache.file)
+      setvbuf(db->cache.file, NULL, _IOFBF, MESA_DB_FAST_BUFFER);
+}
+
+/* Writes what a fast database holds back: the .db bytes first, then the
+ * index entries that point at them, so an index on disk never points past
+ * the data, whatever the process does next. Under the lock. */
+static bool
+mesa_db_fast_flush(struct mesa_cache_db *db)
+{
+   if (!db->fast || (!db->pending && !db->pending_bytes))
+      return true;
+
+   int64_t start = os_time_get_nano();
+
+   if (fflush(db->cache.file))
+      return false;
+
+   if (db->pending) {
+      size_t size = db->pending * sizeof(struct mesa_index_db_file_entry);
+
+      if (ftell(db->index.file) != db->index.offset &&
+          !mesa_db_seek(db->index.file, db->index.offset))
+         return false;
+
+      if (!mesa_db_write_data(db->index.file, db->pending_index, size) ||
+          fflush(db->index.file))
+         return false;
+
+      db->index.offset += size;
+      db->pending = 0;
+   }
+   db->pending_bytes = 0;
+
+   p_atomic_inc(&mesa_db_ps5_counts.flushes);
+   p_atomic_add(&mesa_db_ps5_counts.flush_ns, os_time_get_nano() - start);
+
+   return true;
+}
+
+/* Puts a fast database's .db stream at the file's end and knows that end
+ * (db->cache_end). A seek writes the stdio buffer out, so it is made only when
+ * a read moved the stream. Under the lock. */
+static bool
+mesa_db_fast_seek_end(struct mesa_cache_db *db)
+{
+   if (db->cache_end >= 0 && ftell(db->cache.file) == db->cache_end)
+      return true;
+
+   if (!mesa_db_seek_end(db->cache.file))
+      return false;
+
+   db->cache_end = ftell(db->cache.file);
+
+   return db->cache_end >= 0;
+}
+
 /* Wipe out all database cache files.
  *
  * Whenever we get an unmanageable error on reading or writing to the
@@ -261,6 +355,15 @@ mesa_db_zap(struct mesa_cache_db *db)
    /* Disable cache to prevent the recurring faults */
    db->alive = false;
 
+   /* A fast database's held-back bytes go out before the cut, not after it
+    * at their old offsets; its held-back index entries are dropped. */
+   if (db->fast) {
+      fflush(db->cache.file);
+      db->pending = 0;
+      db->pending_bytes = 0;
+      db->cache_end = -1;
+   }
+
    /* Zap corrupted database files to start over from a clean slate */
    if (!mesa_db_truncate(db->cache.file, 0) ||
        !mesa_db_truncate(db->index.file, 0))
@@ -372,6 +475,8 @@ mesa_db_load(struct mesa_cache_db *db, bool reload)
          return false;
    }
 
+   db->cache_end = -1;
+
    /* If file headers are invalid, then zap database files and start over */
    if (!mesa_db_load_header(&db->cache) ||
        !mesa_db_load_header(&db->index) ||
@@ -444,6 +549,10 @@ mesa_db_write_times(struct mesa_cache_db *db)
    struct mesa_index_db_file_entry index_entry;
    bool success = true;
 
+   /* The entries rewritten here may still be held back. */
+   if (!mesa_db_fast_flush(db))
+      return false;
+
    if (!db->dirty_times)
       return true;
 
@@ -764,12 +873,22 @@ cleanup:
       mesa_db_close_file(&db->index);
       if (!mesa_db_reopen_file(&db->cache) || !mesa_db_reopen_file(&db->index))
          success = false;
+      else
+         mesa_db_fast_buffers(db);
    }
+   db->cache_end = -1;
 
    /* reload compacted index */
    if (success && !mesa_db_reload(db))
       success = false;
 
+   /* RADV_PS5_CACHE_FAST: the RADV_PS5_CACHE line's count (lead-mesh-31's
+    * start time; T172). */
+   if (db->fast) {
+      p_atomic_inc(&mesa_db_ps5_counts.compactions);
+      p_atomic_add(&mesa_db_ps5_counts.compact_ns, os_time_get_nano() - compact_start);
+   }
+
    p_atomic_inc(&mesa_cache_db_stat_compactions);
    p_atomic_add(&mesa_cache_db_stat_compact_ns, os_time_get_nano() - compact_start);
 
@@ -800,6 +919,21 @@ mesa_cache_db_open_impl(struct mesa_cache_db *db, const char *cache_path, bool o
       db->owned = true;
    }
 
+   /* RADV_PS5_CACHE_FAST: owned databases only, as another process could
+    * not see what this one holds back. */
+   db->cache_end = -1;
+   db->pending = 0;
+   db->pending_bytes = 0;
+   db->pending_index = NULL;
+   db->fast = db->owned && mesa_cache_db_ps5_fast();
+   if (db->fast) {
+      db->pending_index = malloc(MESA_DB_FAST_PENDING *
+                                 sizeof(struct mesa_index_db_file_entry));
+      if (!db->pending_index)
+         db->fast = false;
+   }
+   mesa_db_fast_buffers(db);
+
    db->mem_ctx = ralloc_context(NULL);
    if (!db->mem_ctx)
       goto close_locks;
@@ -828,6 +962,9 @@ close_locks:
       db->lock_fds[i] = -1;
    }
    db->owned = false;
+   db->fast = false;
+   free(db->pending_index);
+   db->pending_index = NULL;
    mesa_db_free_file(&db->index);
 close_cache:
    mesa_db_free_file(&db->cache);
@@ -868,9 +1005,12 @@ mesa_cache_db_close(struct mesa_cache_db *db)
 {
    if (db->owned && db->alive) {
       simple_mtx_lock(&db->flock_mtx);
+      /* Writes a fast database's held-back entries first. */
       mesa_db_write_times(db);
       simple_mtx_unlock(&db->flock_mtx);
    }
+   free(db->pending_index);
+   db->pending_index = NULL;
 
    _mesa_hash_table_u64_destroy(db->index_db);
    simple_mtx_destroy(&db->flock_mtx);
@@ -996,6 +1136,14 @@ mesa_cache_db_eviction_size(struct mesa_cache_db *db)
    return db->max_cache_size / 2 - sizeof(struct mesa_db_file_header);
 }
 
+/* Whether a fast database takes blob_size more bytes (db->cache_end known). */
+static bool
+mesa_cache_db_fast_room(struct mesa_cache_db *db, size_t blob_size)
+{
+   return db->cache_end + blob_file_size(blob_size) -
+          sizeof(struct mesa_db_file_header) <= db->max_cache_size;
+}
+
 enum mesa_cache_db_write_result
 mesa_cache_db_entry_write_ex(struct mesa_cache_db *db,
                              const uint8_t *cache_key_160bit,
@@ -1014,6 +1162,9 @@ mesa_cache_db_entry_write_ex(struct mesa_cache_db *db,
    if (!db->alive)
       goto fail;
 
+   if (db->fast)
+      goto fast;
+
    if (!db->owned && mesa_db_uuid_changed(db) && !mesa_db_reload(db))
       goto fail_fatal;
 
@@ -1087,6 +1238,79 @@ mesa_cache_db_entry_write_ex(struct mesa_cache_db *db,
 
    return MESA_CACHE_DB_WRITE_WRITTEN;
 
+fast:
+   /* RADV_PS5_CACHE_FAST: the stream stays at the end between puts, the
+    * entry goes into the stdio buffer and its index entry into the batch;
+    * both reach the files in mesa_db_fast_flush. A read that hits this entry
+    * first seeks, which writes the buffer out. */
+   if (!mesa_db_fast_seek_end(db))
+      goto fail_fatal;
+
+   /* T172: the key is looked up before the space check (lead-mesh-30 does
+    * the same): a known key costs no compaction. Only this process writes an
+    * owned database, so its index in memory is complete. */
+   if (_mesa_hash_table_u64_search(db->index_db, hash)) {
+      result = MESA_CACHE_DB_WRITE_EXISTS;
+      goto fail;
+   }
+
+   if (!mesa_cache_db_fast_room(db, blob_size)) {
+      /* lead-mesh-30 (RADV_PS5_DISK_CACHE_SKIP_KNOWN): a full part is left
+       * for the caller to try the next one. */
+      if (!compact_if_full) {
+         result = MESA_CACHE_DB_WRITE_NO_SPACE;
+         goto fail;
+      }
+      if (!mesa_db_compact(db, MAX2(blob_size, mesa_cache_db_eviction_size(db)),
+                           NULL))
+         goto fail_fatal;
+      if (!mesa_db_fast_seek_end(db))
+         goto fail_fatal;
+   }
+
+   memcpy(cache_entry.key, cache_key_160bit, sizeof(cache_entry.key));
+   cache_entry.crc = util_hash_crc32(blob, blob_size);
+   cache_entry.size = blob_size;
+
+   index_entry.hash = hash;
+   index_entry.size = blob_size;
+   index_entry.last_access_time = os_time_get_nano();
+   index_entry.cache_db_file_offset = db->cache_end;
+
+   hash_entry = ralloc(db->mem_ctx, struct mesa_index_db_hash_entry);
+   if (!hash_entry)
+      goto fail;
+
+   hash_entry->cache_db_file_offset = index_entry.cache_db_file_offset;
+   hash_entry->index_db_file_offset = db->index.offset +
+      db->pending * sizeof(index_entry);
+   hash_entry->last_access_time = index_entry.last_access_time;
+   hash_entry->size = index_entry.size;
+   hash_entry->evicted = false;
+   hash_entry->time_dirty = false;
+
+   if (!mesa_db_write(db->cache.file, &cache_entry) ||
+       !mesa_db_write_data(db->cache.file, blob, blob_size))
+      goto fail_fatal;
+
+   memcpy((uint8_t *)db->pending_index + db->pending * sizeof(index_entry),
+          &index_entry, sizeof(index_entry));
+   db->pending++;
+   db->cache_end += blob_file_size(blob_size);
+   db->pending_bytes += blob_file_size(blob_size);
+
+   _mesa_hash_table_u64_insert(db->index_db, hash, hash_entry);
+   hash_entry = NULL;
+
+   if ((db->pending >= MESA_DB_FAST_PENDING ||
+        db->pending_bytes >= MESA_DB_FAST_FLUSH_BYTES) &&
+       !mesa_db_fast_flush(db))
+      goto fail_fatal;
+
+   mesa_db_unlock(db);
+
+   return MESA_CACHE_DB_WRITE_WRITTEN;
+
 fail_fatal:
    mesa_db_zap(db);
    result = MESA_CACHE_DB_WRITE_FAILED;
@@ -1127,6 +1351,24 @@ mesa_cache_db_has_entry(struct mesa_cache_db *db,
    return found;
 }
 
+bool
+mesa_cache_db_flush(struct mesa_cache_db *db)
+{
+   bool ok = true;
+
+   if (!db->fast)
+      return true;
+
+   simple_mtx_lock(&db->flock_mtx);
+   if (db->alive && !mesa_db_fast_flush(db)) {
+      mesa_db_zap(db);
+      ok = false;
+   }
+   simple_mtx_unlock(&db->flock_mtx);
+
+   return ok;
+}
+
 bool
 mesa_cache_db_entry_remove(struct mesa_cache_db *db,
                            const uint8_t *cache_key_160bit)
@@ -1179,6 +1421,16 @@ mesa_cache_db_has_space(struct mesa_cache_db *db, size_t blob_size)
    if (!mesa_db_lock(db))
       return false;
 
+   if (db->fast) {
+      /* The known end: a seek would write the held-back bytes out. */
+      if (db->cache_end < 0 && !mesa_db_fast_seek_end(db))
+         goto fail_fatal;
+      has_space = db->cache_end + blob_file_size(blob_size) -
+                  sizeof(struct mesa_db_file_header) <= db->max_cache_size;
+      mesa_db_unlock(db);
+      return has_space;
+   }
+
    if (!mesa_db_seek_end(db->cache.file))
       goto fail_fatal;
 
diff --git a/src/util/mesa_cache_db.h b/src/util/mesa_cache_db.h
index d7d3137..03fcd12 100644
--- a/src/util/mesa_cache_db.h
+++ b/src/util/mesa_cache_db.h
@@ -62,6 +62,27 @@ struct mesa_cache_db {
    int lock_fds[2];
    /* Access times read hits changed in memory but not yet in the index file. */
    unsigned dirty_times;
+   /* RADV_PS5_CACHE_FAST=1, owned databases only: entries are appended
+    * through a large stdio buffer and their index entries are held here, then
+    * written in batches, the data first (mesa_db_fast_flush). */
+   bool fast;
+   /* The .db file's end, bytes still in the stdio buffer included; -1 when
+    * not known. Only this process writes an owned database. */
+   int64_t cache_end;
+   /* Index entries not yet in the .idx file, and .db bytes since the last
+    * flush. */
+   void *pending_index;
+   unsigned pending;
+   uint64_t pending_bytes;
+};
+
+/* Counts since the process started, for the RADV_PS5_CACHE line. */
+struct mesa_cache_db_ps5_counts {
+   uint64_t flushes;
+   uint64_t flush_ns;
+   uint64_t deferred;
+   uint64_t compactions;
+   uint64_t compact_ns;
 };
 
 #if DETECT_OS_WINDOWS == 0
@@ -120,6 +141,17 @@ mesa_cache_db_has_space(struct mesa_cache_db *db, size_t blob_size);
 
 double
 mesa_cache_db_eviction_score(struct mesa_cache_db *db);
+
+/* RADV_PS5_CACHE_FAST=1, read once per process. */
+bool
+mesa_cache_db_ps5_fast(void);
+
+/* Writes what a fast database holds back (no-op otherwise). */
+bool
+mesa_cache_db_flush(struct mesa_cache_db *db);
+
+void
+mesa_cache_db_ps5_get_counts(struct mesa_cache_db_ps5_counts *counts);
 #else
 static inline bool
 mesa_cache_db_open(struct mesa_cache_db *db, const char *cache_path)
@@ -206,6 +238,18 @@ mesa_cache_db_eviction_score(struct mesa_cache_db *db)
 {
    return 0;
 }
+
+static inline bool
+mesa_cache_db_ps5_fast(void)
+{
+   return false;
+}
+
+static inline bool
+mesa_cache_db_flush(struct mesa_cache_db *db)
+{
+   return true;
+}
 #endif /* DETECT_OS_WINDOWS */
 
 #ifdef __cplusplus
