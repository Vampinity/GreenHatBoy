+      disk_cache_ps5_note_write(cache_blob.size, os_time_get_nano() - start, r);
 
    blob_finish(&cache_blob);
    return r;
diff --git a/src/util/disk_cache_os.h b/src/util/disk_cache_os.h
index 9de16ce..57d81f8 100644
--- a/src/util/disk_cache_os.h
+++ b/src/util/disk_cache_os.h
@@ -105,8 +105,19 @@ struct disk_cache {
 
    /* Internal RO FOZ cache for combined use of RO and RW caches. */
    struct disk_cache *foz_ro_cache;
+
+   /* RADV_PS5_CACHE_FAST=1 (lead-mesh-34): an owned database cache, counted
+    * for the RADV_PS5_CACHE line and the drain (lead-mesh-35). */
+   bool ps5_fast;
+   uint32_t ps5_added;
+   uint32_t ps5_done;
 };
 
+/* lead-mesh-34: a database write's bytes and time, for the RADV_PS5_CACHE
+ * line. */
+void
+disk_cache_ps5_note_write(size_t bytes, uint64_t ns, bool ok);
+
 struct cache_entry_file_data {
    uint32_t crc32;
    uint32_t uncompressed_size;
