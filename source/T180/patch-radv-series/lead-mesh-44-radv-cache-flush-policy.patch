 }
@@ -421,6 +430,10 @@ ps5_cache_report(void)
    db_delta.deferred = db.deferred - ps5_db_last.deferred;
    db_delta.compactions = db.compactions - ps5_db_last.compactions;
    db_delta.compact_ns = db.compact_ns - ps5_db_last.compact_ns;
+   db_delta.flush_bytes = db.flush_bytes - ps5_db_last.flush_bytes;
+   db_delta.flush_max_ns = db.flush_max_ns; /* since the last line already */
+   db_delta.mem_hits = db.mem_hits - ps5_db_last.mem_hits;
