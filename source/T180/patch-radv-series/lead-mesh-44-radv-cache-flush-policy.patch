    ps5_db_last = db;
 #endif
 
@@ -435,6 +448,9 @@ ps5_cache_report(void)
    }
    simple_mtx_unlock(&ps5_caches_lock);
 
+   /* lead-mesh-44: read and reset each 10 s, like the database's longest flush. */
+   const uint64_t get_max_ns = p_atomic_xchg(&ps5_counts.get_max_ns, 0);
+
    uint64_t done = PS5_DELTA(done);
    if (PS5_DELTA(added) || done || queued || PS5_DELTA(gets) ||
        db_delta.flushes || db_delta.compactions) {
@@ -446,7 +462,9 @@ ps5_cache_report(void)
               " flushes=%" PRIu64 " flush_ms=%" PRIu64 " deferred=%" PRIu64
               " compactions=%" PRIu64 " compact_ms=%" PRIu64
               " known=%" PRIu64 " known_mib=%.1f%s"
-              " total_written=%" PRIu64 " total_written_mib=%.1f\n",
+              " total_written=%" PRIu64 " total_written_mib=%.1f"
+              " flush_kib=%.1f flush_max_ms=%.0f get_max_ms=%.0f mem_hits=%" PRIu64
+              " flush_wait_ms=%" PRIu64 "\n",
               (uint64_t)((now - ps5_start_ns) / 1000000000ull), queued,
               queued_bytes / (1024.0 * 1024.0), PS5_DELTA(added),
               PS5_DELTA(added_bytes) / (1024.0 * 1024.0), PS5_DELTA(written), done,
@@ -459,7 +477,9 @@ ps5_cache_report(void)
               db_delta.compactions, db_delta.compact_ns / 1000000,
               PS5_DELTA(known), PS5_DELTA(known_bytes) / (1024.0 * 1024.0),
               compress_text,
-              now_counts.written, now_counts.written_bytes / (1024.0 * 1024.0));
+              now_counts.written, now_counts.written_bytes / (1024.0 * 1024.0),
+              db_delta.flush_bytes / 1024.0, db_delta.flush_max_ns / 1e6,
+              get_max_ns / 1e6, db_delta.mem_hits, db_delta.put_wait_ns / 1000000);
    }
    ps5_last = now_counts;
 }
@@ -1218,8 +1238,17 @@ disk_cache_get(struct disk_cache *cache, const cache_key key, size_t *size)
 
          buf = disk_cache_db_load_item(cache, key, size);
          if (cache->ps5_fast) {
+            const uint64_t took = os_time_get_nano() - start;
             p_atomic_inc(&ps5_counts.gets);
-            p_atomic_add(&ps5_counts.get_ns, os_time_get_nano() - start);
+            p_atomic_add(&ps5_counts.get_ns, took);
+            /* lead-mesh-44: the RADV_PS5_CACHE line's get_max_ms. */
+            uint64_t cur = p_atomic_read(&ps5_counts.get_max_ns);
+            while (took > cur) {
+               uint64_t prev = p_atomic_cmpxchg(&ps5_counts.get_max_ns, cur, took);
+               if (prev == cur)
+                  break;
+               cur = prev;
+            }
          }
       } else if (cache->type == DISK_CACHE_MULTI_FILE) {
          char *filename = disk_cache_get_cache_filename(cache, key);
diff --git a/src/util/mesa_cache_db.c b/src/util/mesa_cache_db.c
index 8be8b82..3e59da0 100644
--- a/src/util/mesa_cache_db.c
+++ b/src/util/mesa_cache_db.c
@@ -94,6 +94,107 @@ mesa_cache_db_ps5_get_counts(struct mesa_cache_db_ps5_counts *counts)
    counts->deferred = p_atomic_read(&mesa_db_ps5_counts.deferred);
    counts->compactions = p_atomic_read(&mesa_db_ps5_counts.compactions);
    counts->compact_ns = p_atomic_read(&mesa_db_ps5_counts.compact_ns);
+   counts->flush_bytes = p_atomic_read(&mesa_db_ps5_counts.flush_bytes);
+   /* lead-mesh-44: the longest since the last call (the line's 10 s). */
+   counts->flush_max_ns = p_atomic_xchg(&mesa_db_ps5_counts.flush_max_ns, 0);
+   counts->mem_hits = p_atomic_read(&mesa_db_ps5_counts.mem_hits);
+   counts->put_wait_ns = p_atomic_read(&mesa_db_ps5_counts.put_wait_ns);
+}
+
+/* lead-mesh-44: the flush policy of fast databases (RADV_PS5_CACHE_FAST=1),
+ * read once per process. Unset, each is as before:
+ *   RADV_PS5_CACHE_FLUSH_MIB=<1-256>: write the held-back entries once this
+ *     many MiB of them wait (1 before). With the stdio buffer (no _MEM_PENDING)
+ *     the .db bytes still go out whenever its 1 MiB fills; only the index
+ *     lines wait longer.
+ *   RADV_PS5_CACHE_FLUSH_N=<0-1000000>: ... or once this many entries wait
+ *     (64 before; 0: no count limit). With _FLUSH_MIB set and _FLUSH_N unset,
+ *     no count limit.
+ *   RADV_PS5_CACHE_FLUSH_S=<1-3600>: ... or, at a put, once the oldest
+ *     waiting entry is this many seconds old (none before).
+ *   RADV_PS5_CACHE_MEM_PENDING=1: the held-back bytes are kept in memory of
+ *     the database's own, and a flush writes them with pwrite after letting go
+ *     of the lock, so gets and other puts of the part never wait for the disk;
+ *     a get of a held-back or in-flight entry is served from memory. Access
+ *     times (LRU) are then written at compaction and close only (before: every
+ *     256 hits).
+ * No fsync anywhere: the database is a cache. What a kill or crash leaves is
+ * repaired at the next open (lead-mesh-39): a torn index line is cut, index
+ * lines pointing past the data are cut, data no index line points at is cut.
+ * Held-back entries are lost then, and are compiled again. */
+struct mesa_db_policy {
+   uint64_t flush_bytes;
+   unsigned flush_n;
+   int64_t flush_ns;
+   bool mem;
+   char line[160];
+};
+
+static struct mesa_db_policy mesa_db_policy_value;
+static int mesa_db_policy_state; /* 0 unread, 1 reading, 2 read */
+
+static long
+mesa_db_env_num(const char *name, long min, long max, long unset)
+{
+   const char *text = getenv(name);
+   if (!text || !*text)
+      return unset;
+   char *end = NULL;
+   long value = strtol(text, &end, 10);
+   if (end == text || *end)
+      return unset;
+   return value < min ? min : value > max ? max : value;
+}
+
+static const struct mesa_db_policy *
+mesa_db_policy(void)
+{
+   if (p_atomic_read(&mesa_db_policy_state) == 2)
+      return &mesa_db_policy_value;
+   if (p_atomic_cmpxchg(&mesa_db_policy_state, 0, 1) != 0) {
+      while (p_atomic_read(&mesa_db_policy_state) != 2)
+         os_time_sleep(100);
+      return &mesa_db_policy_value;
+   }
+
+   struct mesa_db_policy *p = &mesa_db_policy_value;
+   long mib = mesa_db_env_num("RADV_PS5_CACHE_FLUSH_MIB", 1, 256, 0);
+   long n = mesa_db_env_num("RADV_PS5_CACHE_FLUSH_N", 0, 1000000, -1);
+   long s = mesa_db_env_num("RADV_PS5_CACHE_FLUSH_S", 1, 3600, 0);
+   const char *mem = getenv("RADV_PS5_CACHE_MEM_PENDING");
+
+   p->flush_bytes = mib ? (uint64_t)mib * 1024 * 1024 : MESA_DB_FAST_FLUSH_BYTES;
+   p->flush_n = n >= 0 ? (unsigned)n : mib ? 0 : MESA_DB_FAST_PENDING;
+   p->flush_ns = (int64_t)s * 1000000000ll;
+   p->mem = mem && mem[0] == '1' && mem[1] == '\0';
+   p->line[0] = '\0';
+   if (mib || n >= 0 || s || p->mem)
+      snprintf(p->line, sizeof(p->line),
+               " flush_mib=%.1f flush_n=%u flush_s=%ld mem_pending=%d",
+               p->flush_bytes / (1024.0 * 1024.0), p->flush_n, s, p->mem ? 1 : 0);
+   p_atomic_set(&mesa_db_policy_state, 2);
+   return p;
+}
+
+const char *
+mesa_cache_db_ps5_policy(void)
+{
+   return mesa_db_policy()->line;
+}
+
+static void
+mesa_db_note_flush(uint64_t bytes, int64_t ns)
+{
+   p_atomic_inc(&mesa_db_ps5_counts.flushes);
+   p_atomic_add(&mesa_db_ps5_counts.flush_ns, ns);
+   p_atomic_add(&mesa_db_ps5_counts.flush_bytes, bytes);
+   uint64_t cur = p_atomic_read(&mesa_db_ps5_counts.flush_max_ns);
+   while ((uint64_t)ns > cur) {
+      uint64_t prev = p_atomic_cmpxchg(&mesa_db_ps5_counts.flush_max_ns, cur, (uint64_t)ns);
+      if (prev == cur)
+         break;
+      cur = prev;
+   }
 }
 
 static inline bool mesa_db_seek_end(FILE *file)
@@ -315,13 +416,22 @@ mesa_db_fast_free_buffers(struct mesa_cache_db *db)
 /* Writes what a fast database holds back: the .db bytes first, then the
  * index entries that point at them, so an index on disk never points past
  * the data, whatever the process does next. Under the lock. */
+static bool
+mesa_db_mem_flush_locked(struct mesa_cache_db *db);
+
 static bool
 mesa_db_fast_flush(struct mesa_cache_db *db)
 {
    if (!db->fast || (!db->pending && !db->pending_bytes))
       return true;
 
+   /* lead-mesh-44: held back in memory, written under the lock here (the
+    * callers are compaction and close, which need it all in the files). */
+   if (db->mem)
+      return mesa_db_mem_flush_locked(db);
+
    int64_t start = os_time_get_nano();
+   uint64_t bytes = db->pending_bytes;
 
    if (fflush(db->cache.file))
       return false;
@@ -339,15 +449,220 @@ mesa_db_fast_flush(struct mesa_cache_db *db)
 
       db->index.offset += size;
       db->pending = 0;
+      bytes += size;
    }
    db->pending_bytes = 0;
+   db->pending_since_ns = 0;
 
-   p_atomic_inc(&mesa_db_ps5_counts.flushes);
-   p_atomic_add(&mesa_db_ps5_counts.flush_ns, os_time_get_nano() - start);
+   mesa_db_note_flush(bytes, os_time_get_nano() - start);
+
+   return true;
+}
+
+/* lead-mesh-44 (RADV_PS5_CACHE_MEM_PENDING): the whole of size at offset,
+ * with pwrite, which leaves the streams' positions and buffers alone. */
+static bool
+mesa_db_pwrite_all(int fd, const void *data, uint64_t size, int64_t offset)
+{
+   const uint8_t *p = data;
+
+   while (size) {
+      ssize_t done = pwrite(fd, p, size, offset);
+      if (done < 0 && errno == EINTR)
+         continue;
+      if (done <= 0)
+         return false;
+      p += done;
+      size -= done;
+      offset += done;
+   }
+   return true;
+}
+
+/* Waits, with the lock let go meanwhile, until no flush of this database is
+ * in flight. Under the lock; returns with it held. */
+static void
+mesa_db_mem_wait(struct mesa_cache_db *db)
+{
+   if (!db->inflight)
+      return;
+
+   int64_t start = os_time_get_nano();
+   while (db->inflight) {
+      simple_mtx_unlock(&db->flock_mtx);
+      os_time_sleep(200);
+      simple_mtx_lock(&db->flock_mtx);
+   }
+   p_atomic_add(&mesa_db_ps5_counts.put_wait_ns, os_time_get_nano() - start);
+}
+
+/* Room for one more entry's bytes (size) and index line in a fast database's
+ * held-back batch. */
+static bool
+mesa_db_pending_room(struct mesa_cache_db *db, uint64_t size)
+{
+   if (db->pending >= db->pending_cap) {
+      unsigned cap = db->pending_cap ? db->pending_cap * 2 : MESA_DB_FAST_PENDING;
+      void *index = realloc(db->pending_index,
+                            (size_t)cap * sizeof(struct mesa_index_db_file_entry));
+      if (!index)
+         return false;
+      db->pending_index = index;
+      db->pending_cap = cap;
+   }
+
+   if (db->mem && db->mem_len + size > db->mem_cap) {
+      uint64_t cap = MAX2(db->mem_cap ? db->mem_cap * 2 : 256 * 1024, db->mem_len + size);
+      uint8_t *data = realloc(db->mem_data, cap);
+      if (!data)
+         return false;
+      db->mem_data = data;
+      db->mem_cap = cap;
+   }
+   return true;
+}
+
+/* Writes the held-back batch under the lock (compaction, close): nothing
+ * may be in flight. */
+static bool
+mesa_db_mem_flush_locked(struct mesa_cache_db *db)
+{
+   mesa_db_mem_wait(db);
+
+   if (!db->pending && !db->mem_len)
+      return true;
+
+   int64_t start = os_time_get_nano();
+   uint64_t index_size = (uint64_t)db->pending * sizeof(struct mesa_index_db_file_entry);
+
+   if (!mesa_db_pwrite_all(fileno(db->cache.file), db->mem_data, db->mem_len,
+                           db->cache_end - (int64_t)db->mem_len) ||
+       !mesa_db_pwrite_all(fileno(db->index.file), db->pending_index, index_size,
+                           db->index.offset))
+      return false;
+
+   db->index.offset += index_size;
+   mesa_db_note_flush(db->mem_len + index_size, os_time_get_nano() - start);
+   db->pending = 0;
+   db->pending_bytes = 0;
+   db->mem_len = 0;
+   db->pending_since_ns = 0;
 
    return true;
 }
 
+/* Writes the held-back batch with the lock let go: the batch moves to the
+ * in-flight buffers (still readable by gets), the lock is released for the
+ * two pwrite calls (data first, then the index lines that point at it), and
+ * taken again. One flush at a time: wait=false returns at once when one is in
+ * flight (the batch keeps growing), wait=true waits for it first. Under the
+ * lock; returns with it held; false when a write failed (the caller zaps). */
+static bool
+mesa_db_mem_flush(struct mesa_cache_db *db, bool wait)
+{
+   if (db->inflight) {
+      if (!wait)
+         return true;
+      mesa_db_mem_wait(db);
+   }
+
+   if (!db->alive || (!db->pending && !db->mem_len))
+      return true;
+
+   uint8_t *data = db->mem_data;
+   uint64_t data_len = db->mem_len;
+   int64_t data_off = db->cache_end - (int64_t)db->mem_len;
+   void *index = db->pending_index;
+   uint64_t index_len = (uint64_t)db->pending * sizeof(struct mesa_index_db_file_entry);
+   int64_t index_off = db->index.offset;
+   int fd_data = fileno(db->cache.file);
+   int fd_index = fileno(db->index.file);
+
+   db->flight_data = data;
+   db->flight_cap = db->mem_cap;
+   db->flight_len = data_len;
+   db->flight_off = data_off;
+   db->flight_index = index;
+   db->flight_index_cap = db->pending_cap;
+   db->inflight = true;
+
+   db->mem_data = db->spare_data;
+   db->mem_cap = db->spare_cap;
+   db->pending_index = db->spare_index;
+   db->pending_cap = db->spare_index_cap;
+   db->spare_data = NULL;
+   db->spare_cap = 0;
+   db->spare_index = NULL;
+   db->spare_index_cap = 0;
+   db->mem_len = 0;
+   db->pending = 0;
+   db->pending_bytes = 0;
+   db->pending_since_ns = 0;
+   /* The index lines' place is taken now: the next batch goes after them. */
+   db->index.offset += index_len;
+
+   simple_mtx_unlock(&db->flock_mtx);
+
+   int64_t start = os_time_get_nano();
+   bool ok = mesa_db_pwrite_all(fd_data, data, data_len, data_off) &&
+             mesa_db_pwrite_all(fd_index, index, index_len, index_off);
+   int64_t took = os_time_get_nano() - start;
+
+   simple_mtx_lock(&db->flock_mtx);
+
+   db->inflight = false;
+   if (!db->spare_data) {
+      db->spare_data = db->flight_data;
+      db->spare_cap = db->flight_cap;
+   } else {
+      free(db->flight_data);
+   }
+   if (!db->spare_index) {
+      db->spare_index = db->flight_index;
+      db->spare_index_cap = db->flight_index_cap;
+   } else {
+      free(db->flight_index);
+   }
+   db->flight_data = NULL;
+   db->flight_index = NULL;
+   db->flight_len = 0;
+
+   if (ok)
+      mesa_db_note_flush(data_len + index_len, took);
+
+   return ok;
+}
+
+/* Whether a fast database's held-back batch is due (the policy). */
+static bool
+mesa_db_flush_due(struct mesa_cache_db *db)
+{
+   const struct mesa_db_policy *p = mesa_db_policy();
+
+   if (!db->pending)
+      return db->pending_bytes >= p->flush_bytes;
+   if ((p->flush_n && db->pending >= p->flush_n) || db->pending_bytes >= p->flush_bytes)
+      return true;
+   return p->flush_ns && os_time_get_nano() - db->pending_since_ns >= p->flush_ns;
+}
+
+/* (Re)opens a memory-pending database's streams: pwrite went past their
+ * buffers, so a stream that read before may hold old bytes. Before
+ * compaction and the access times' write, with nothing held back. */
+static bool
+mesa_db_mem_fresh_streams(struct mesa_cache_db *db)
+{
+   if (!db->mem)
+      return true;
+
+   mesa_db_close_file(&db->cache);
+   mesa_db_close_file(&db->index);
+   if (!mesa_db_reopen_file(&db->cache) || !mesa_db_reopen_file(&db->index))
+      return false;
+   mesa_db_fast_buffers(db);
+   return true;
+}
+
 /* Puts a fast database's .db stream at the file's end and knows that end
  * (db->cache_end). A seek writes the stdio buffer out, so it is made only when
  * a read moved the stream. Under the lock. */
@@ -357,6 +672,12 @@ mesa_db_fast_seek_end(struct mesa_cache_db *db)
