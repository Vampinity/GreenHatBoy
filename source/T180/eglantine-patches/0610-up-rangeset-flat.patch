 template <typename AddressType>
 struct RangeSet<AddressType>::RangeSetImpl {
     using IntervalSet = boost::icl::interval_set<
@@ -33,23 +52,181 @@ struct RangeSet<AddressType>::RangeSetImpl {
         RangeSetsAllocator>;
     using IntervalType = typename IntervalSet::interval_type;
 
+    // EDEN_UP_RANGESET_FLAT: sorted, disjoint, non-touching ranges in one array. The buffer cache
+    // looks these up tens of thousands of times a frame and most lookups miss; sets stay small
+    // (Ocarina of Time: ~200 ranges at a subtract, 763 at most), so moving a few hundred bytes on
+    // an insert costs less than tree nodes from a locked pool. Same semantics as the interval
+    // set, including the joining of touching ranges.
+    struct Range {
+        AddressType lower;
+        AddressType upper;
+    };
+    using Iterator = typename std::vector<Range>::iterator;
+    using ConstIterator = typename std::vector<Range>::const_iterator;
+
     RangeSetImpl() = default;
     ~RangeSetImpl() = default;
 
+    bool IsEmpty() const {
+        return flat ? m_ranges.empty() : m_ranges_set.empty();
+    }
+
+    void ClearAll() {
+        if (flat) {
+            m_ranges.clear();
+        } else {
+            m_ranges_set.clear();
+        }
+    }
+
+    /// Takes other's ranges and leaves it empty.
+    void TakeFrom(RangeSetImpl& other) {
+        if (flat && other.flat) {
+            m_ranges = std::move(other.m_ranges);
+            other.m_ranges.clear();
+        } else if (!flat && !other.flat) {
+            m_ranges_set = std::move(other.m_ranges_set);
+            other.m_ranges_set.clear();
+        } else {
+            // Not reached: the switch is read once for the process. Kept correct anyway.
+            ClearAll();
+            other.ForEach([this](AddressType lower, AddressType upper) {
+                Add(lower, static_cast<size_t>(upper - lower));
+            });
+            other.ClearAll();
+        }
+    }
+
+    /// Flat: the first range ending after `address`, the first that could overlap what starts
+    /// there.
+    ConstIterator FirstEndingAfter(AddressType address) const {
+        return std::upper_bound(
+            m_ranges.begin(), m_ranges.end(), address,
+            [](AddressType value, const Range& range) { return value < range.upper; });
+    }
+
     void Add(AddressType base_address, size_t size) {
         AddressType end_address = base_address + static_cast<AddressType>(size);
+        if (flat) {
+            FlatAdd(base_address, end_address);
+            return;
+        }
         IntervalType interval{base_address, end_address};
         m_ranges_set.add(interval);
     }
 
     void Subtract(AddressType base_address, size_t size) {
         AddressType end_address = base_address + static_cast<AddressType>(size);
+        if (flat) {
+            FlatSubtract(base_address, end_address);
+            return;
+        }
         IntervalType interval{base_address, end_address};
         m_ranges_set.subtract(interval);
     }
 
+    void FlatAdd(AddressType base_address, AddressType end_address) {
+        if (end_address <= base_address) {
+            return;
+        }
+        // Ranges that touch the new one join it: the first ending at or after its start...
+        auto first = std::lower_bound(
+            m_ranges.begin(), m_ranges.end(), base_address,
+            [](const Range& range, AddressType value) { return range.upper < value; });
+        if (first == m_ranges.end()) {
+            m_ranges.push_back(Range{base_address, end_address});
+            return;
+        }
+        // ...up to the first starting after its end.
+        const auto last = std::upper_bound(
+            first, m_ranges.end(), end_address,
+            [](AddressType value, const Range& range) { return value < range.lower; });
+        if (first == last) {
+            m_ranges.insert(first, Range{base_address, end_address});
+            return;
+        }
+        first->lower = (std::min)(first->lower, base_address);
+        first->upper = (std::max)((last - 1)->upper, end_address);
+        m_ranges.erase(first + 1, last);
+    }
+
+    void FlatSubtract(AddressType base_address, AddressType end_address) {
+        if (end_address <= base_address) {
+            return;
+        }
+        const auto first = m_ranges.begin() + (FirstEndingAfter(base_address) - m_ranges.cbegin());
+        const auto last = std::lower_bound(
+            first, m_ranges.end(), end_address,
+            [](const Range& range, AddressType value) { return range.lower < value; });
+        if (first == last) {
+            return;
+        }
+        const AddressType left_lower = first->lower;
+        const AddressType right_upper = (last - 1)->upper;
+        const bool keep_left = left_lower < base_address;
+        const bool keep_right = end_address < right_upper;
+        if (keep_left && keep_right && last - first == 1) {
+            // Cut out of the middle of one range: it becomes two.
+            first->upper = base_address;
+            m_ranges.insert(last, Range{end_address, right_upper});
+            return;
+        }
+        Iterator erase_from = first;
+        Iterator erase_to = last;
+        if (keep_left) {
+            first->upper = base_address;
+            ++erase_from;
+        }
+        if (keep_right) {
+            --erase_to;
+            erase_to->lower = end_address;
+        }
+        m_ranges.erase(erase_from, erase_to);
+    }
+
+    bool Contains(AddressType base_address, size_t size) const {
+        const AddressType end_address = base_address + static_cast<AddressType>(size);
+        if (flat) {
+            if (m_ranges.empty() || size == 0) {
+                return false;
+            }
+            const auto it = FirstEndingAfter(base_address);
+            return it != m_ranges.end() && it->lower <= base_address && it->upper >= end_address;
+        }
+        const auto& set = m_ranges_set;
+        if (set.empty() || size == 0) {
+            return false;
+        }
+        const auto it = set.find(base_address);
+        return it != set.end() && it->lower() <= base_address && it->upper() >= end_address;
+    }
+
+    bool Intersects(AddressType base_address, size_t size) const {
+        const AddressType end_address = base_address + static_cast<AddressType>(size);
+        if (flat) {
+            if (m_ranges.empty() || size == 0) {
+                return false;
+            }
+            const auto it = FirstEndingAfter(base_address);
+            return it != m_ranges.end() && it->lower < end_address;
+        }
+        const auto& set = m_ranges_set;
+        if (set.empty() || size == 0) {
+            return false;
+        }
+        // The first range not entirely below the query; it overlaps when it starts before its end.
+        const auto it = set.lower_bound(IntervalType{base_address, end_address});
+        return it != set.end() && it->lower() < end_address;
+    }
+
     template <typename Func>
     void ForEach(Func&& func) const {
+        if (flat) {
+            for (const Range& range : m_ranges) {
+                func(range.lower, range.upper);
+            }
+            return;
+        }
         if (m_ranges_set.empty()) {
             return;
         }
@@ -64,6 +241,17 @@ struct RangeSet<AddressType>::RangeSetImpl {
 
     template <typename Func>
     void ForEachInRange(AddressType base_addr, size_t size, Func&& func) const {
+        if (flat) {
+            // No early return for an empty query (#481 has one): the interval set's search below
+            // calls func(start, start) for a range strictly around start, and so does this loop.
+            const AddressType start_address = base_addr;
+            const AddressType end_address = start_address + static_cast<AddressType>(size);
+            for (auto it = FirstEndingAfter(start_address);
+                 it != m_ranges.end() && it->lower < end_address; ++it) {
+                func((std::max)(it->lower, start_address), (std::min)(it->upper, end_address));
+            }
+            return;
+        }
         if (m_ranges_set.empty()) {
             return;
         }
@@ -88,7 +276,9 @@ struct RangeSet<AddressType>::RangeSetImpl {
         }
     }
 
+    const bool flat{RangeSetFlat()};
     IntervalSet m_ranges_set;
+    std::vector<Range> m_ranges;
 };
 
