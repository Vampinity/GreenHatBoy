+// EDEN_UP_RANGESET_FLAT=1 (zortos293/Lichii #481, Marc Stampfli): RangeSet keeps its ranges in
+// one sorted array searched by binary search instead of the boost interval set (pooled tree nodes
+// behind a mutex). Read once, at the first RangeSet made; anything but exact "1" is off. Off, every
+// RangeSet call takes the interval set's code as before, after one test of a bool in the set.
+inline bool RangeSetFlat() noexcept {
+    static const bool on = [] {
+        const bool value = ::Common::PeSwitch("EDEN_UP_RANGESET_FLAT");
+        if (value) {
+            std::fputs("EDEN_UP_RANGESET_FLAT on: RangeSet is a sorted array\n", stderr);
+        }
+        return value;
+    }();
+    return on;
+}
