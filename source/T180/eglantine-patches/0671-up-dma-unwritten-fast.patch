@@ -221,6 +221,10 @@ enum class Id : u8 {
     /// and each run of the method sink: a state register write takes the inlined path or the full
     /// one, and both leave the same registers, shadow registers and dirty flags.
     RegWriteOneCall,
+    /// EDEN_UP_DMA_UNWRITTEN_FAST (0671, Frizti/Fritchii PR #35). Read by each plain drained
+    /// macro DMA read (Maxwell3D::FrontDmaRead); each read chooses on its own, both ways give the
+    /// words guest memory holds after the work that may write them.
+    DmaUnwrittenFast,
     Count,
 };
 
@@ -362,6 +366,7 @@ inline constexpr std::array<Def, NumSwitches> kDefs{{
     {"EDEN_UP_EMPTY_DRAW_STATS", ParseExactOne, false, -1},
     {"EDEN_NX2_UBO_INPLACE", ParseLeadingOne, false, -1},
     {"EDEN_UP_REG_WRITE_ONE_CALL", ParseExactOne, false, -1},
+    {"EDEN_UP_DMA_UNWRITTEN_FAST", ParseExactOne, false, -1},
 }};
 
 static_assert(kDefs[static_cast<size_t>(Id::PollBackoffUs)].needs ==
