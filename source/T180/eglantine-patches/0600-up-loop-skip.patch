 }
 
+// EDEN_UP_LOOP_SKIP (zortos293/Lichii #178, Thibaut LÉAUX): the draw manager's mode on the back,
+// as the methods that change it set it there (DrawBegin, SetInlineIndexBuffer). A loop the front
+// does not see (DrawArrayInstanced, a macro run on the back) only means no draw.end is skipped.
+void Maxwell3D::FrontTrackInstanceLoop(FrontState& fs, u32 method, u32 value) {
+    switch (method) {
+    case MAXWELL3D_REG_INDEX(draw.begin):
+        // Instance id, bits 27:26: First leaves an instance loop, Subsequent enters one.
+        if (((value >> 26) & 3) == 0) {
+            fs.instance_loop = false;
+        } else if (((value >> 26) & 3) == 1) {
+            fs.instance_loop = true;
+        }
+        break;
+    case MAXWELL3D_REG_INDEX(draw_inline_index):
+    case MAXWELL3D_REG_INDEX(inline_index_2x16.even):
+    case MAXWELL3D_REG_INDEX(inline_index_4x8.index0):
+        fs.instance_loop = false; // DrawMode::InlineIndex: draw.end draws
+        break;
+    default:
+        break;
+    }
+}
+
+// EDEN_UP_LOOP_SKIP: whether an executable write (`value` with the shadow RAM applied) is one the
+// back would ignore. Instance loop methods flush no deferred draw (ProcessDirtyRegisters), and
+// the draw manager ignores these: DrawEnd draws nothing in an instance loop, and it only reads
+// the vertex buffer first and count. index_buffer writes also mark the index buffer dirty, so
+// they are always sent. With Marc Stampfli's fix (#488): never while the back's sink holds state
+// writes (its next executable method consumes them, and a changed one ends a deferred draw that
+// must issue before the next engine's work), and never with a copy made in another split session.
+bool Maxwell3D::FrontSkipsLoopWrite(VideoCommon::GpuSplit& split, FrontState& fs, u32 method,
+                                    u32 value, bool shadow_kept) {
+    FrontTrackInstanceLoop(fs, method, value);
+    switch (method) {
+    case MAXWELL3D_REG_INDEX(draw.end):
+    case MAXWELL3D_REG_INDEX(vertex_buffer.first):
+    case MAXWELL3D_REG_INDEX(vertex_buffer.count):
+        break;
+    default:
+        return false;
+    }
+    if (!shadow_kept || fs.regs[method] != value) {
+        return false;
+    }
+    const bool end = method == MAXWELL3D_REG_INDEX(draw.end);
+    if (end && !fs.instance_loop) {
+        return false;
+    }
+    if (fs.sink_pending || fs.loop_generation != split.SessionGeneration()) {
+        ++fs.loop_kept_sink;
+        return false;
+    }
+    ++(end ? fs.loop_skipped_end : fs.loop_skipped_vb);
+    if (fs.loop_skipped_end + fs.loop_skipped_vb >= fs.loop_report_at) [[unlikely]] {
+        FrontReportLoopSkip(fs);
+    }
+    return true;
+}
+
+// EDEN_UP_LOOP_SKIP: at the first skip, then every 4 Mi skipped writes (a few seconds at the
+// rates upstream counted). Never on a write that is sent.
+void Maxwell3D::FrontReportLoopSkip(FrontState& fs) {
+    const auto now = std::chrono::steady_clock::now();
+    const double seconds = std::chrono::duration<double>(now - fs.loop_report_time).count();
+    const u64 skipped = fs.loop_skipped_end + fs.loop_skipped_vb;
+    const u64 since = skipped - fs.loop_reported;
+    LOG_INFO(HW_GPU,
+             "EDEN_UP_LOOP_SKIP: {} writes not sent ({} draw.end in an instance loop, {} "
+             "vertex_buffer.first/count), {} same-value ones sent because the back's sink held "
+             "state writes; {:.0f} a second since the last line",
+             skipped, fs.loop_skipped_end, fs.loop_skipped_vb, fs.loop_kept_sink,
+             seconds > 0.0 ? static_cast<double>(since) / seconds : 0.0);
+    fs.loop_reported = skipped;
+    fs.loop_report_at = skipped + (u64{1} << 22);
+    fs.loop_report_time = now;
+}
+
 void Maxwell3D::FrontVerify(VideoCommon::GpuSplit& split, FrontState& fs) {
     split.Drain(VideoCommon::DrainSite::FrontVerify);
     static u64 checks{};
