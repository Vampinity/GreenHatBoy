 [[nodiscard]] const MemoryInfo& GetMemInfo();
 
+/// Physical memory the host can hand out now without paging anything out (0 when unknown).
+/// EDEN_UP_COLD_HINT_GATE (0755, zortos293/Lichii #1581 e633e165f7).
+[[nodiscard]] u64 GetAvailablePhysicalMemory();
+
+/// Whether the host is short of RAM: less than a quarter of it, and less than 4 GiB, free.
+[[nodiscard]] constexpr bool IsLowOnMemory(u64 available, u64 total) {
+    return available != 0 && available < (std::min<u64>)(total / 4, u64{4} << 30);
+}
+
+/// IsLowOnMemory for this host, read again at most once a second. Always false where the host
+/// gives no available-memory figure (the PS5 build).
+[[nodiscard]] bool IsHostLowOnMemory();
+
+/// EDEN_UP_COLD_HINT_GATE=1 (exact "1", read once): cold hints only while the host is short of
+/// RAM (Lichii #1581). Off: every upload is hinted cold as before.
+[[nodiscard]] bool ColdHintGate();
+
+/// Whether the texture and buffer caches should note uploads for a later cold hint. False only
+/// with EDEN_UP_COLD_HINT_GATE=1 on a host whose HostMemory::HintCold does nothing (the PS5
+/// build: neither VirtualUnlock nor MADV_PAGEOUT), where the note could never be used.
+[[nodiscard]] bool ColdHintRecord();
+
 } // namespace Common
