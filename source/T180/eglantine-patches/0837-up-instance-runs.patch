+        // each runs CallMethod as before. `words` stops at the ring's end and at what the front
+        // published, so the run is whole entries the back owns.
+        using Tegra::Engines::Maxwell3D;
+        if (engine->repeat_draw_begin && method == MAXWELL3D_REG_INDEX(draw.begin) &&
