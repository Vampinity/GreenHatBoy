+++ b/src/video_core/engines/maxwell_3d.cpp
@@ -85,6 +85,22 @@ Maxwell3D::Maxwell3D(MemoryManager& memory_manager_)
     }();
     batch_constant_words = batch_words && !record_write_history &&
                            !g_trace_first_method_writes && !VideoCommon::Nx2Profile::Enabled();
+    // EDEN_UP_INSTANCE_RUNS=1 (exact "1"; zortos293/Lichii PR #1597): off with the write history,
+    // which wants to see each write.
+    static const bool instance_runs = [] {
+        const bool on = Common::PeSwitch("EDEN_UP_INSTANCE_RUNS");
+        if (on) {
+            const char* const loop_skip = std::getenv("EDEN_UP_LOOP_SKIP");
+            const bool skip_on = loop_skip != nullptr && loop_skip[0] == '1' && loop_skip[1] == '\0';
+            LOG_INFO(HW_GPU,
+                     "EDEN_UP_INSTANCE_RUNS=1: the split's back runs a run of identical draw.begin "
+                     "entries in an instance loop as one{}",
+                     skip_on ? "" : " (EDEN_UP_LOOP_SKIP is not 1: the front sends draw.end "
+                                    "between them, so runs will be rare)");
+        }
+        return on;
+    }();
+    repeat_draw_begin = instance_runs && !record_write_history;
     // EDEN_UP_REG_WRITE_ONE_CALL: its first read here, so that CallMethod and the sink can Peek.
     static_cast<void>(Common::LiveSwitch::Value<Common::LiveSwitch::Id::RegWriteOneCall>());
     one_call_plain = !record_write_history && !g_trace_first_method_writes;
@@ -946,6 +962,32 @@ void Maxwell3D::CallConstBufferWords(Core::System& system, const u32* methods, c
     regs.const_buffer.offset += static_cast<u32>(bytes);
 }
 
+// EDEN_UP_INSTANCE_RUNS (zortos293/Lichii PR #1597, sanchodecuba11-del): what CallMethod does for
+// a draw.begin written with the value the first of the run just left. RecordWrite is off
+// (repeat_draw_begin needs no write history); the shadow RAM gives the same value again (Track
+// stores the same argument, Replay reads the same shadow word); WriteDirtyRegister flushes no
+// deferred draw for an instance loop method, breaks no fast draw for an unchanged value and
+// sets flags the first call set; ProcessMethodCall breaks no fast draw for an instance loop
+// method and hands draw.begin to DrawBegin, which for a subsequent instance adds one instance
+// and sets the mode (Instance) and the shape type (regs.draw.topology, unchanged) again.
+bool Maxwell3D::RepeatDrawBegin(u32 count, u32 method_argument) {
+    if (executing_macro != 0 ||
+        regs.draw.instance_id != Regs::Draw::InstanceId::Subsequent ||
+        draw_manager.draw_state.draw_mode != DrawManager::DrawMode::Instance) {
+        return false;
+    }
+    if (VideoCommon::Nx2Profile::Enabled()) [[unlikely]] {
+        // As CallMethod counts each write.
+        VideoCommon::Nx2Profile::Add(VideoCommon::Nx2Profile::Counter::MethodWrites, count);
+        if (regs.reg_array[MAXWELL3D_REG_INDEX(draw.begin)] == method_argument) {
+            VideoCommon::Nx2Profile::Add(VideoCommon::Nx2Profile::Counter::SameValueWrites,
+                                         count);
+        }
+    }
+    draw_manager.draw_state.instance_count += count;
+    return true;
+}
