--- a/src/video_core/gpu_split.cpp
+++ b/src/video_core/gpu_split.cpp
@@ -969,6 +969,31 @@ size_t GpuSplit::Execute(const u64* entry, size_t words) {
                 }
             }
         }
+        // EDEN_UP_INSTANCE_RUNS=1 (zortos293/Lichii PR #1597, sanchodecuba11-del): with
+        // EDEN_UP_LOOP_SKIP the front sends no draw.end inside an instance loop, so the loop's
+        // draw.begin writes arrive as runs of identical one-word entries. The first runs as
