 }
 
+template <class P>
+void TextureCache<P>::CollectStaleReferences() {
+    stale_references.clear();
+    const auto collect_downloads = [&](const auto& downloads) {
+        for (const auto& download : downloads) {
+            if (download.is_swizzle && !download.retired_image) {
+                stale_references.insert(download.object_id);
+            }
+        }
+    };
+    collect_downloads(uncommitted_downloads);
+    for (const auto& batch : committed_downloads) {
+        collect_downloads(batch);
+    }
+    for (const auto& decode : async_decodes) {
+        stale_references.insert(decode->image_id);
+    }
+    for (const auto& entry : unswizzle_queue) {
+        stale_references.insert(entry.image_id);
+    }
+    const auto bound_view = [&](ImageViewId view_id) {
+        if (PreparesImage(slot_image_views, view_id)) {
+            stale_references.insert(slot_image_views[view_id].image_id);
+        }
+    };
+    for (const ImageViewId view_id : render_targets.color_buffer_ids) {
+        bound_view(view_id);
+    }
+    bound_view(render_targets.depth_buffer_id);
+    // Ours (review of 0650): what the last presents showed, which the LRU does not see.
+    for (const ImageId presented : stale_presented) {
+        if (presented) {
+            stale_references.insert(presented);
+        }
+    }
+}
+
+/// EDEN_UP_STALE_TARGETS=1 (StaleTargetFrames; jpkto, zortos293/Lichii #1571 48761a3 + 9a3a759 +
+/// fab2816). Ocarina of Time makes its render targets (shadow maps among them) anew every frame,
+/// at addresses that shift as the camera moves, so each frame's targets land over older ones and
+/// the old ones get BadOverlap. The collector deletes such an image without a copy back, but in
+/// our tree only once it is 50 frames old outside the memory thresholds (25 / 10 above them) and
+/// at most about 10 images a frame, so they pile up. This pass deletes them every frame once they
+/// are n frames old (default 10, the collector's age in its critical mode), with the collector's
+/// own deletion: MarkStale, untrack, unregister, DeleteImage (deferred: gpu_sentenced_images keeps
+/// the VkImage and its memory until the GPU has passed every command recorded with it).
+/// A candidate is BadOverlap, made for a render target binding (RenderTargetOrigin), GPU-written
+/// and not CPU-written, single-sample, backed, not sparse, rescaled, remapped or trimmed, and made
+/// of whole 4 KiB pages. It is kept while anything still needs it: a queued download, an
+/// asynchronous decode or unswizzle, a bound render target, one of the last four presented images
+/// (ours: a present does not touch the LRU), IsDecoding, an alias or a subresource-compatible
+/// overlap used within the n frames; and (ours, the cold sweep's and the
+/// RT evict's rule) while the guest has read its contents back (forced_flushed, dma_downloaded, a
+/// relocation guard). A sampled twin (BadOverlap alias of it with no other alias, not a render
+/// target, not CPU-written) goes with it. At most 512 deletions a frame; a scan examines at most
+/// 4,096 candidates and the next one resumes behind them (RomainROCH's review point on #1571:
+/// kept candidates at the old end of the LRU must not hold every scan in front of them).
+template <class P>
+void TextureCache<P>::RetireStaleTargets() {
+    const u64 age = StaleTargetFrames();
+    if (age == 0) {
+        return;
+    }
+    [&] {
+        if (!Tegra::g_nx2_ampere.load(std::memory_order_relaxed) || frame_tick <= age) {
+            return;
+        }
+        constexpr size_t MaxPerFrame = 512;
+        constexpr size_t MaxExaminedPerFrame = 8 * MaxPerFrame;
+        constexpr u64 page_mask = StalePages::STALE_PAGE_SIZE - 1;
+        constexpr ImageFlagBits excluded =
+            ImageFlagBits::CpuModified | ImageFlagBits::Sparse | ImageFlagBits::SparseLayers |
+            ImageFlagBits::SparseTiles | ImageFlagBits::UnwrittenSparse | ImageFlagBits::Unbacked |
+            ImageFlagBits::Rescaled | ImageFlagBits::Remapped | ImageFlagBits::TrimmedLevels;
+        const u64 cutoff = frame_tick - age;
+        // MarkStale keeps whole pages only: an image with a partial edge page is left to the
+        // collector (upstream's StaleMarkerCovers).
+        const auto whole_pages = [](const ImageBase& image) {
+            return image.guest_size_bytes != 0 && (image.cpu_addr & page_mask) == 0 &&
+                   (image.guest_size_bytes & page_mask) == 0;
+        };
+        const auto gpu_written_target = [&](const ImageBase& image) {
+            return True(image.flags & ImageFlagBits::RenderTargetOrigin) &&
+                   True(image.flags & ImageFlagBits::GpuModified) && False(image.flags & excluded) &&
+                   image.info.num_samples == 1 && !image.info.is_sparse && !image.HasScaled();
+        };
+        const auto read_back = [](const ImageBase& image) {
+            return image.info.forced_flushed || image.info.dma_downloaded ||
+                   image.relocation_guard_noted != 0;
+        };
+        // Not unused: registered and touched after the cutoff, or not registered (no LRU entry
+        // to read; such a partner protects).
+        const auto unused = [&](ImageId image_id) {
+            const Image& image = slot_images[image_id];
+            return True(image.flags & ImageFlagBits::Registered) && image.lru_index != SIZE_MAX &&
+                   lru_cache.Tick(image.lru_index) <= cutoff;
+        };
+        const auto kept = [&](ImageId image_id, const Image& image) {
+            if (True(image.flags & ImageFlagBits::IsDecoding) ||
+                stale_references.contains(image_id)) {
+                return true;
+            }
+            // Old alias pairs age out together; only recent partners protect an image.
+            for (const AliasedImage& alias : image.aliased_images) {
+                if (!unused(alias.id)) {
+                    return true;
+                }
+            }
+            constexpr auto options = RelaxedOptions::Size | RelaxedOptions::Format;
+            for (const ImageId other_id : image.overlapping_images) {
+                if (unused(other_id)) {
+                    continue;
+                }
+                const Image& other = slot_images[other_id];
+                if (IsSubresource(image.info, other, image.gpu_addr, options, false, true) ||
+                    IsSubresource(other.info, image, other.gpu_addr, options, false, true)) {
+                    return true;
+                }
+            }
+            return false;
+        };
+        boost::container::small_vector<ImageId, 64> aged;
+        bool references_collected = false;
+        const size_t resume_from = stale_retire_resume;
+        size_t matched = 0;
+        size_t examined = 0;
+        bool stopped = false;
+        lru_cache.ForEachItemBelow(cutoff, [&](ImageId image_id) {
+            const Image& image = slot_images[image_id];
+            if (False(image.flags & ImageFlagBits::BadOverlap) || !gpu_written_target(image) ||
+                !whole_pages(image)) {
+                return false;
+            }
+            if (matched++ < resume_from) {
+                return false; // examined by an earlier scan of this round
+            }
+            if (!references_collected) {
+                CollectStaleReferences();
+                references_collected = true;
+            }
+            ++examined;
+            if (read_back(image)) {
+                ++stale_kept_read;
+            } else if (kept(image_id, image)) {
+                ++stale_kept_used;
+            } else {
+                aged.push_back(image_id);
+            }
+            stopped = aged.size() >= MaxPerFrame || examined >= MaxExaminedPerFrame;
+            return stopped;
+        });
+        // A scan that reaches the end of the old candidates starts the next round at the oldest.
+        stale_retire_resume = stopped ? resume_from + examined : 0;
+        stale_scan_resumes += stopped ? 1 : 0;
+        if (aged.empty()) {
+            return;
+        }
+        const auto retire = [&](ImageId image_id) {
+            Image& image = slot_images[image_id];
+            const u64 bytes = ImageMemoryBytes(image);
+            MarkStale(image); // before UntrackImage (see MarkStale), as the collector does
+            if (True(image.flags & ImageFlagBits::Tracked)) {
+                UntrackImage(image, image_id);
+            }
+            UnregisterImage(image_id);
+            trace_delete_reason = "stale-target";
+            DeleteImage(image_id);
+            stale_retired_bytes += bytes;
+            stale_retired_total_bytes += bytes;
+            ++stale_retired_total;
+        };
+        boost::container::small_vector<ImageId, 8> partners;
+        size_t remaining = MaxPerFrame;
+        for (const ImageId image_id : aged) {
+            if (remaining == 0) {
+                break;
+            }
+            const Image& image = slot_images[image_id];
+            // Deleting the images before this one only removes partners and overlaps, so it cannot
+            // make this one kept; it can clear its BadOverlap once no overlap is left.
+            if (False(image.flags & ImageFlagBits::BadOverlap)) {
+                continue;
+            }
+            // A sampled twin with no other alias goes with its target when both are unused.
+            partners.clear();
+            for (const AliasedImage& alias : image.aliased_images) {
+                const Image& partner = slot_images[alias.id];
+                if (True(partner.flags & ImageFlagBits::Registered) &&
+                    True(partner.flags & ImageFlagBits::BadOverlap) &&
+                    False(partner.flags &
+                          (excluded | ImageFlagBits::CostlyLoad | ImageFlagBits::Converted |
+                           ImageFlagBits::AsynchronousDecode)) &&
+                    !gpu_written_target(partner) && whole_pages(partner) &&
+                    partner.aliased_images.size() == 1 && !read_back(partner) &&
+                    !kept(alias.id, partner)) {
+                    partners.push_back(alias.id);
+                }
+            }
+            if (partners.size() + 1 > remaining) {
+                continue;
+            }
+            retire(image_id);
+            ++stale_retired;
+            --remaining;
+            if (stopped && stale_retire_resume != 0) {
+                --stale_retire_resume; // left the LRU: no longer in front of the resume point
+            }
+            for (const ImageId partner_id : partners) {
+                retire(partner_id);
+                ++stale_retired_partners;
+                --remaining;
+            }
+        }
+    }();
+    const auto now = std::chrono::steady_clock::now();
+    if (stale_log_time == std::chrono::steady_clock::time_point{}) {
+        stale_log_time = now; // the first window starts with the first frame
+    } else if (now - stale_log_time >= std::chrono::seconds{10}) {
+        LOG_INFO(HW_GPU,
+                 "EDEN_UP_STALE_TARGETS: {} stale render targets deleted in the last {} s "
+                 "({} MiB, {} of them sampled twins); kept {} checks as in use, {} as read "
+                 "back; {} scans resumed; {} deleted so far ({} MiB); {} images, texture "
+                 "memory {} MiB",
+                 stale_retired + stale_retired_partners,
+                 std::chrono::duration_cast<std::chrono::seconds>(now - stale_log_time).count(),
+                 stale_retired_bytes >> 20, stale_retired_partners, stale_kept_used,
+                 stale_kept_read, stale_scan_resumes, stale_retired_total,
+                 stale_retired_total_bytes >> 20, slot_images.size(),
+                 total_used_memory >> 20);
+        stale_log_time = now;
+        stale_retired = stale_retired_partners = stale_retired_bytes = 0;
+        stale_kept_used = stale_kept_read = stale_scan_resumes = 0;
+    }
+}
