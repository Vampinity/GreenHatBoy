+/// EDEN_UP_STALE_TARGETS=1 (exact 1; off unless set; jpkto, zortos293/Lichii #1571, head fab2816):
+/// a render target the game has drawn over is deleted once it has gone unused for
+/// EDEN_UP_STALE_TARGETS_FRAMES=<n> frames (digits only, 3 to 3600; unset or anything else: 10,
+/// upstream's constant STALE_TARGET_AGE), every frame, before the other collectors and whatever
+/// the memory use (TextureCache::RetireStaleTargets). 0 when the switch is off: nothing runs but
+/// this cached test.
+[[nodiscard]] inline u64 StaleTargetFrames() {
+    static const u64 frames = [] {
+        if (!Common::PeSwitch("EDEN_UP_STALE_TARGETS")) {
+            return u64{0};
+        }
+        u64 value = 10;
+        if (const char* const raw = std::getenv("EDEN_UP_STALE_TARGETS_FRAMES"); raw != nullptr) {
+            u64 parsed = 0;
+            bool digits = raw[0] != '\0';
+            for (const char* c = raw; digits && *c != '\0'; ++c) {
+                digits = *c >= '0' && *c <= '9' && parsed <= 100000;
+                parsed = parsed * 10 + static_cast<u64>(*c - '0');
+            }
+            if (digits && parsed >= 3 && parsed <= 3600) {
+                value = parsed;
+            } else {
+                LOG_WARNING(HW_GPU, "EDEN_UP_STALE_TARGETS_FRAMES={} is not 3 to 3600: 10 frames",
+                            raw);
+            }
+        }
+        LOG_INFO(HW_GPU,
+                 "EDEN_UP_STALE_TARGETS=1: render targets drawn over (BadOverlap, GPU-written) are "
+                 "deleted once unused for {} frames, at most 512 a frame",
+                 value);
+        return value;
+    }();
+    return frames;
+}
