+/// Words in a MacroEngine's native macro RAM (native_code). EDEN_UP_MACRO_RAM_WIDE=1 (0743,
+/// zortos293/Lichii #439, from Djihads80/Eglantine#663): 0x8000, so entries past instruction
+/// 0x1000 are uploaded and run; unset: 0x3000 as before. Read once, at the first engine.
+[[nodiscard]] inline std::size_t NativeMacroRamWords() noexcept {
+    static const std::size_t words = Common::PeSwitch("EDEN_UP_MACRO_RAM_WIDE") ? 0x8000 : 0x3000;
+    return words;
+}
