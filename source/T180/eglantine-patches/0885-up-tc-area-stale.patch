+                area_stale_deleted.erase(deleted);
+            }
+        }
         // EDEN_UP_AREA_BUDGET: what it holds, and whether AreaEvict deleted it a moment ago.
         if (Common::LiveSwitch::Peek<Common::LiveSwitch::Id::AreaBudget>() != 0) {
             const u64 new_bytes = ImageMemoryBytes(new_image);
diff --git a/src/video_core/texture_cache/texture_cache_base.h b/src/video_core/texture_cache/texture_cache_base.h
index 88afd7d3737c4e62e5f0d3ae02a04e655cb0fccc..3cd51ba89778ae343722257bfdf5518f078c95cb 100644
--- a/src/video_core/texture_cache/texture_cache_base.h
+++ b/src/video_core/texture_cache/texture_cache_base.h
@@ -348,6 +348,29 @@ class TextureCache : public VideoCommon::ChannelSetupCaches<TextureCacheChannelI
     u64 short_collect_images{};  ///< Images it deleted
     u64 short_collect_bytes{};   ///< What they held
     u64 short_collect_logged{};  ///< frame_tick of the last line
+    /// EDEN_UP_TC_AREA_STALE (AreaStaleDrop): the area-change window, its signals and the
+    /// counts for its lines. area_stale_deleted: GPU address -> frame of each image it deleted
+    /// (at most AreaStaleRemember), so an image made again at that address is counted.
+    u64 area_stale_until{};          ///< frame_tick the window closes (0: never opened)
+    u64 area_stale_burst_frame{};    ///< Start of the 30-frame count of new images
+    u64 area_stale_burst_created{};  ///< New images in that count
+    u64 area_stale_created_seen{};   ///< area_images_created at the last frame
+    u64 area_stale_wave_frame{};     ///< Start of the 120-frame count of the wave
+    u64 area_stale_wave_bytes{};     ///< Image bytes the unmap, AreaEvict and 0730 deleted in it
+    u64 area_stale_sample_frame{};
+    u64 area_stale_largest{};
+    bool area_stale_short{};
+    u64 area_stale_window_images{};  ///< Deleted in the window that is open (or last open)
+    u64 area_stale_window_bytes{};
+    u64 area_stale_opened_burst{};   ///< Windows opened (or extended) by a burst of new images
+    u64 area_stale_opened_wave{};    ///< ... by a wave of deletes (unmap, AreaEvict, 0730)
+    u64 area_stale_frames{};         ///< Frames in a window with the pool short
+    u64 area_stale_images[4]{};      ///< Deleted: CPU-decoded, other costly, kept as re-made, cheap
+    u64 area_stale_bytes[4]{};
+    u64 area_stale_remade_images{};  ///< Made again at a deleted image's address in time
+    u64 area_stale_remade_bytes{};
