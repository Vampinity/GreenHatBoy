+            NoteAreaStaleWave(ImageMemoryBytes(image) +
+                              (image.HasScaled() ? GetScaledImageSizeBytes(image) : 0));
+        }
         trace_delete_reason = "unmap";
         DeleteImage(id);
     }
@@ -7101,6 +7360,17 @@ ImageId TextureCache<P>::JoinImages(const ImageInfo& info, GPUVAddr gpu_addr, DA
         ++images_created;
         ++area_images_created;
         Churn::Add(Churn::ImagesCreated);
+        // EDEN_UP_TC_AREA_STALE: an image made again where AreaStaleDrop deleted one (its cost).
+        if (AreaStaleLimit() != 0 && !area_stale_deleted.empty()) [[unlikely]] {
+            if (const auto deleted = area_stale_deleted.find(new_image.gpu_addr);
