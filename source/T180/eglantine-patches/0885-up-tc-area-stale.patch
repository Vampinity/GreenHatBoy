     area_kept_last = kept;
     if (budget_stop) {
         area_budget_left -= (std::min)(bytes, area_budget_left);
@@ -2362,6 +2615,7 @@ void TextureCache<P>::TickFrame() {
     DeleteSupersededImages(); // EDEN_NX2_TC_SUPERSEDED
