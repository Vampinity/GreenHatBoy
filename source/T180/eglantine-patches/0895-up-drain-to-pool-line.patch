+/// EDEN_UP_DRAIN_TO_POOL=1|2 (vulkan_common/drain_to_pool.h): one drain's way to the pool.
+struct ToPool {
+    u64 device_before{};  ///< VMA's device memory (blocks and allocations of their own)
+    u64 objects_before{};
+    u64 device_after{};
+    u64 objects_after{};
+    u64 used_after{};
+    u64 buffer_pool_blocks{}; ///< The DeviceBuffers pool after the drain
+    u64 buffer_pool_used{};
+    u64 other_pools_blocks{}; ///< SparsePages and TrimmedImages after the drain
+    u64 other_pools_used{};
+    u64 waited_small{};  ///< Deleted buffers waiting, under 1 MiB
+    u64 waited_shared{}; ///< 1 MiB up to half a separate-pool block: the pool's blocks by size
+    u64 waited_own{};    ///< Over half a block: memory of their own by VMA's rule
+    u64 largest_after{};
+};
+
+/// The recording thread's: drains so far with the line on, and the own-memory counts at the last
+/// line.
+struct ToPoolState {
+    u64 lines{};
+    u64 made_seen{};
+    u64 made_bytes_seen{};
+    u64 refused_seen{};
+};
+
+inline ToPoolState g_to_pool{};
+
+/// The line, for the first 32 drains and every 16th.
+inline void ToPoolLine(u64 drain, u64 freed, u64 largest_before, const ToPool& p) {
+    ToPoolState& s = g_to_pool;
+    ++s.lines;
+    if (s.lines > 32 && s.lines % 16 != 0) {
+        return;
+    }
+    const u64 made = DrainToPool::g_shared.made.load(std::memory_order_relaxed);
+    const u64 made_bytes = DrainToPool::g_shared.made_bytes.load(std::memory_order_relaxed);
+    const u64 refused = DrainToPool::g_shared.refused.load(std::memory_order_relaxed);
+    const u64 back = p.device_before > p.device_after ? p.device_before - p.device_after : 0;
+    const u64 slack = p.device_after > p.used_after ? p.device_after - p.used_after : 0;
+    const u64 buffer_slack =
+        p.buffer_pool_blocks > p.buffer_pool_used ? p.buffer_pool_blocks - p.buffer_pool_used : 0;
+    const u64 other_slack =
+        p.other_pools_blocks > p.other_pools_used ? p.other_pools_blocks - p.other_pools_used : 0;
+    const u64 default_slack = slack > buffer_slack + other_slack ? slack - buffer_slack - other_slack
+                                                                 : 0;
+    std::fprintf(stderr,
+                 "EDEN_UP_DRAIN_TO_POOL drain %llu: %llu MiB freed, %llu MiB of it back to the "
+                 "driver (device memory %llu -> %llu MiB, objects %llu -> %llu); room left inside "
+                 "the blocks %llu MiB (buffer pool %llu of %llu MiB blocks, sparse/trim pools %llu, "
+                 "default blocks %llu); largest free piece %llu -> %llu MiB; deleted buffers that "
+                 "waited by size: under 1 MiB %llu, 1 MiB to half a pool block %llu, larger %llu "
+                 "MiB; memory of their own since the last line: %llu buffers %llu MiB, %llu went to "
+                 "the pool after all\n",
+                 static_cast<unsigned long long>(drain), Mib(freed), Mib(back),
+                 Mib(p.device_before), Mib(p.device_after),
+                 static_cast<unsigned long long>(p.objects_before),
+                 static_cast<unsigned long long>(p.objects_after), Mib(slack), Mib(buffer_slack),
+                 Mib(p.buffer_pool_blocks), Mib(other_slack), Mib(default_slack),
+                 Mib(largest_before), Mib(p.largest_after), Mib(p.waited_small),
+                 Mib(p.waited_shared), Mib(p.waited_own),
+                 static_cast<unsigned long long>(made - s.made_seen), Mib(made_bytes - s.made_bytes_seen),
+                 static_cast<unsigned long long>(refused - s.refused_seen));
+    s.made_seen = made;
+    s.made_bytes_seen = made_bytes;
+    s.refused_seen = refused;
+}
+
 } // namespace Vulkan::PressureDrain
