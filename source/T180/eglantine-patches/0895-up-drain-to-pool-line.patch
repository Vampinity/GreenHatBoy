diff --git a/src/video_core/vulkan_common/drain_to_pool.h b/src/video_core/vulkan_common/drain_to_pool.h
new file mode 100644
index 0000000000..e5a71209a4
--- /dev/null
+++ b/src/video_core/vulkan_common/drain_to_pool.h
@@ -0,0 +1,130 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstdlib>
+#include <cstring>
+
+#include "common/common_types.h"
+
+/// EDEN_UP_DRAIN_TO_POOL (off unless set; acts only with EDEN_UP_PRESSURE_DRAIN=1 or 2, whose look
+/// arms it: RasterizerVulkan::PressureDrainLook).
+///
+/// A drain (renderer_vulkan/pressure_drain.h) frees the deleted buffers at once, but a buffer of
+/// half a separate-pool block or less (8 MiB) sits in one of the DeviceBuffers pool's 16 MiB blocks
+/// (Device::SeparatePool), and a block goes back to the driver only when its last buffer goes. At
+/// the load past the field the new area's buffers were made and deleted side by side in the same
+/// blocks, so after a 934-1,268 MiB drain 720-782 MiB stayed as empty room inside the blocks
+/// (census vma_slack), which only buffers can use: the heap and the big images could not.
+///
+///   EDEN_UP_DRAIN_TO_POOL=2       one line per drain (EDEN_UP_DRAIN_TO_POOL ...): the allocator's
+///                                 device memory before and after (what went back to the driver),
+///                                 the room left inside the blocks by kind, the pool's largest free
+///                                 piece before and after, and what waited by size. Nothing else
+///                                 changes.
+///   EDEN_UP_DRAIN_TO_POOL=1       the line, and: while the pool is short (the drain's own mark,
+///                                 EDEN_UP_PRESSURE_DRAIN_MIB) or an area loads (EDEN_UP_DRAIN_AT_AREA's
+///                                 window), a device-local buffer of _KIB or more that would go to
+///                                 the DeviceBuffers pool gets memory of its own instead, so a drain
+///                                 that deletes it gives its bytes back to the driver.
+///   EDEN_UP_DRAIN_TO_POOL_KIB=<KiB>  the smallest buffer given memory of its own (unset: 2048; 64
+///                                 to 8192). Smaller ones stay in the pool's blocks: many small
+///                                 objects of their own would split the pool into pieces under the
+///                                 2 MiB the heap grows by.
+///
+/// Off: one test of a static per buffer the DeviceBuffers pool would take, nothing else.
+namespace Vulkan::DrainToPool {
+
+enum class Mode : u8 {
+    Off,
+    OwnMemory, ///< The line, and buffers of their own while the pool is short or an area loads
+    LineOnly,  ///< The line only
+};
+
+[[nodiscard]] inline Mode GetMode() {
+    static const Mode mode = [] {
+        const char* const value = std::getenv("EDEN_UP_DRAIN_TO_POOL");
+        if (value != nullptr && std::strcmp(value, "1") == 0) {
+            return Mode::OwnMemory;
+        }
+        if (value != nullptr && std::strcmp(value, "2") == 0) {
+            return Mode::LineOnly;
+        }
+        return Mode::Off;
+    }();
+    return mode;
+}
+
+[[nodiscard]] inline bool On() {
+    return GetMode() != Mode::Off;
+}
+
+[[nodiscard]] inline bool OwnMemoryOn() {
+    return GetMode() == Mode::OwnMemory;
+}
+
+/// Bytes: the smallest buffer given memory of its own.
+[[nodiscard]] inline u64 OwnMemoryMin() {
+    static const u64 bytes = [] {
+        u64 kib = 2048;
+        if (const char* const value = std::getenv("EDEN_UP_DRAIN_TO_POOL_KIB");
+            value != nullptr && value[0] >= '0' && value[0] <= '9') {
+            char* end = nullptr;
+            const unsigned long long number = std::strtoull(value, &end, 10);
+            if (end != value && *end == '\0' && number != 0) {
+                kib = std::clamp<u64>(number, 64, 8192);
+            }
+        }
+        return kib << 10;
+    }();
+    return bytes;
+}
+
+/// Shared between the drain's look (the recording thread) and the allocator (any thread).
+struct Shared {
+    /// steady_clock nanoseconds: buffers get memory of their own until then
+    std::atomic<s64> until_ns{0};
+    std::atomic<u64> made{};       ///< Buffers given memory of their own
+    std::atomic<u64> made_bytes{};
+    std::atomic<u64> refused{};    ///< Asked for memory of their own and went to the pool after all
+};
+
+inline Shared g_shared{};
+
+[[nodiscard]] inline s64 NowNs() {
+    return static_cast<s64>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                std::chrono::steady_clock::now().time_since_epoch())
+                                .count());
+}
+
+/// The look: buffers get memory of their own for the next `ms` (never shortens an armed window).
+inline void Arm(s64 ms) {
+    const s64 until = NowNs() + ms * 1'000'000LL;
+    s64 current = g_shared.until_ns.load(std::memory_order_relaxed);
+    while (current < until &&
+           !g_shared.until_ns.compare_exchange_weak(current, until, std::memory_order_relaxed)) {
+    }
+}
+
+/// The allocator, for a buffer the DeviceBuffers pool would take: memory of its own now?
+[[nodiscard]] inline bool OwnMemoryFor(u64 size) {
+    if (!OwnMemoryOn() || size < OwnMemoryMin()) {
+        return false;
+    }
+    return NowNs() < g_shared.until_ns.load(std::memory_order_relaxed);
+}
+
+inline void CountMade(u64 size) {
+    g_shared.made.fetch_add(1, std::memory_order_relaxed);
+    g_shared.made_bytes.fetch_add(size, std::memory_order_relaxed);
+}
+
+inline void CountRefused() {
+    g_shared.refused.fetch_add(1, std::memory_order_relaxed);
+}
+
+} // namespace Vulkan::DrainToPool
