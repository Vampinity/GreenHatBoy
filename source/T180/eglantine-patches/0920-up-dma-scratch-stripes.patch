 using namespace Texture;
 
+namespace {
+
+// 0920 EDEN_UP_DMA_SCRATCH_MIB=<MiB> (1 to 256; unset, 0 or anything else: off). The copy engine's
+// read and write scratch grow to the largest copy seen and stay (resize_destructive only grows).
+// Their growth at the load from the field asked the heap for 8,294,400 bytes (T175 C3, which
+// died: std::bad_alloc on GPUBack in CopyBlockLinearToPitch) and 10,616,832 bytes (C1, which
+// lived). Set, each engine that launches a copy reserves both at its first launch, early in the
+// session while the pool has room: 11 covers one 2304x1152 surface of 32-bit pixels (10,616,832
+// bytes). Off by default: it costs 2 x the size per DMA engine that copies (one per channel) from
+// the first launch on, where today a scratch only takes what the copies have asked for so far.
+std::size_t DmaScratchReserveBytes() {
+    static const std::size_t bytes = [] {
+        const char* const value = std::getenv("EDEN_UP_DMA_SCRATCH_MIB");
+        if (value == nullptr || value[0] == '\0') {
+            return std::size_t{0};
+        }
+        char* end = nullptr;
+        const unsigned long mib = std::strtoul(value, &end, 10);
+        if (end == nullptr || *end != '\0' || mib == 0 || mib > 256) {
+            return std::size_t{0};
+        }
+        return static_cast<std::size_t>(mib) << 20;
+    }();
+    return bytes;
+}
+
+// 0920, always on (a pure crash fix: it runs only where a std::bad_alloc used to end the
+// session). When a copy's scratch cannot grow, the copy is done again in stripes through fixed
+// buffers: per GOB row (8 lines) of each block-linear side, each of its GOBs (512 bytes) read into
+// a compact copy laid out as a one-GOB-tall surface of the same width, the same Swizzle/Unswizzle
+// code run on that, and the GOBs written back. The pitch side goes through in the same lines. Same
+// reads (ReadBlock where the copy read Safe, ReadBlockUnsafe where Unsafe) and the same cached
+// writes, so the bytes that land are the bytes the whole copy would have written, except where
+// the source and the destination overlap (the whole copy read all of the source first). Shapes it
+// does not cover (more than one slice in use, a row wider than 16 KiB, a row past the surface,
+// a pitch under a row) rethrow: the session ends as before. Fixed buffers: 3 x 128 KiB in .bss,
+// taken by one copy at a time.
+constexpr std::size_t StripeBytes = 128 * 1024;
+constexpr u32 GobBytes = 1U << GOB_SIZE_SHIFT;
+
+struct StripeSpace {
+    std::mutex lock;
+    alignas(64) std::array<u8, StripeBytes> block_a;
+    alignas(64) std::array<u8, StripeBytes> linear;
+    alignas(64) std::array<u8, StripeBytes> block_b;
+};
+
+StripeSpace& Stripes() {
+    static StripeSpace space;
+    return space;
+}
+
+/// One block-linear side of a copy, with the bytes per pixel and width the copy uses.
+struct BlockSide {
+    GPUVAddr address;
+    u32 width;
+    u32 bytes_per_pixel;
+    u32 block_height;
+    u32 block_depth;
+    u32 gobs_in_x;
+    u32 x_shift;
+    u64 block_size;
+
+    BlockSide(GPUVAddr address_, u32 width_, u32 bytes_per_pixel_, u32 block_height_,
+              u32 block_depth_)
+        : address{address_}, width{width_}, bytes_per_pixel{bytes_per_pixel_},
+          block_height{block_height_}, block_depth{block_depth_} {
+        // As SwizzleSubrectImpl works them out.
+        const u32 stride = Common::AlignUpLog2(width * bytes_per_pixel, GOB_SIZE_X_SHIFT);
+        gobs_in_x = stride >> GOB_SIZE_X_SHIFT; // stride is a whole number of GOBs
+        x_shift = GOB_SIZE_SHIFT + block_height + block_depth;
+        block_size = u64{gobs_in_x} << x_shift;
+    }
+
+    /// Where GOB (gob_x, gob_y) of slice 0 lies, from the surface's start.
+    [[nodiscard]] u64 GobOffset(u32 gob_y, u32 gob_x) const {
+        const u32 block_height_mask = (1U << block_height) - 1;
+        return u64{gob_y >> block_height} * block_size +
+               (u64{gob_y & block_height_mask} << GOB_SIZE_SHIFT) + (u64{gob_x} << x_shift);
+    }
+
+    /// The GOB columns pixels [x, x + count) touch, or false when the compact copy cannot hold
+    /// them (a row past the surface's GOBs, or wider than a stripe).
+    [[nodiscard]] bool Columns(u32 x, u32 count, u32& first, u32& end) const {
+        if (u64{gobs_in_x} * GobBytes > StripeBytes) {
+            return false;
+        }
+        const u64 begin_byte = u64{x} * bytes_per_pixel;
+        const u64 end_byte = u64{x + count} * bytes_per_pixel;
+        first = static_cast<u32>(begin_byte >> GOB_SIZE_X_SHIFT);
+        end = static_cast<u32>((end_byte + (1U << GOB_SIZE_X_SHIFT) - 1) >> GOB_SIZE_X_SHIFT);
+        return end <= gobs_in_x && first <= end;
+    }
+
+    void ReadGobRow(Tegra::MemoryManager& memory, u32 gob_y, u32 first, u32 end, u8* compact,
+                    bool safe) const {
+        for (u32 gob_x = first; gob_x < end; ++gob_x) {
+            const GPUVAddr gob = address + GobOffset(gob_y, gob_x);
+            if (safe) {
+                memory.ReadBlock(gob, compact + std::size_t{gob_x} * GobBytes, GobBytes);
+            } else {
+                memory.ReadBlockUnsafe(gob, compact + std::size_t{gob_x} * GobBytes, GobBytes);
+            }
+        }
+    }
+
+    void WriteGobRow(Tegra::MemoryManager& memory, u32 gob_y, u32 first, u32 end,
+                     const u8* compact) const {
+        for (u32 gob_x = first; gob_x < end; ++gob_x) {
+            memory.WriteBlockCached(address + GobOffset(gob_y, gob_x),
+                                    compact + std::size_t{gob_x} * GobBytes, GobBytes);
+        }
+    }
+
+    [[nodiscard]] std::span<u8> Compact(std::array<u8, StripeBytes>& space) const {
+        return std::span<u8>(space.data(), std::size_t{gobs_in_x} * GobBytes);
+    }
+};
+
+/// The lines a subrect copy of `line_count` lines from row `origin_y` touches, as
+/// SwizzleSubrectImpl counts them, when they all lie in slice 0; false otherwise.
+bool SliceZeroLines(u32 height, u32 depth, u32 origin_y, u32 line_count, u32& lines) {
+    if (origin_y > height) {
+        return false;
+    }
+    const u32 room = height - origin_y;
+    if (line_count > room && depth != 1) {
+        return false; // the subrect would go on in the next slice
+    }
+    lines = (std::min)(line_count, room);
+    return true;
+}
+
+/// Lines per stripe of a pitch side: all of a GOB row's that fit the linear buffer.
+u32 PitchLines(u64 pitch, u32 row_bytes) {
+    if (pitch == 0 || pitch < row_bytes || pitch > StripeBytes) {
+        return 0;
+    }
+    return static_cast<u32>((std::min<u64>)(u64{1} << GOB_SIZE_Y_SHIFT, StripeBytes / pitch));
+}
+
+enum class StripeKind : u32 { BlockToPitch, PitchToBlock, BlockToBlock };
+
+/// The EDEN_UP_DMA_STRIPE line: the first 8, then at most one a second (with the counts).
+void NoteStripe(StripeKind kind, bool done, std::size_t wanted, u32 lines, u32 width) {
+    static std::atomic<u64> copies{0};
+    static std::atomic<u64> refused{0};
+    static std::atomic<s64> last_line_ms{0};
+    const u64 total = (done ? copies : refused).fetch_add(1, std::memory_order_relaxed) + 1;
+    const s64 now_ms = std::chrono::duration_cast<std::chrono::milliseconds>(
+                           std::chrono::steady_clock::now().time_since_epoch())
+                           .count();
+    const u64 all = copies.load(std::memory_order_relaxed) + refused.load(std::memory_order_relaxed);
+    s64 last = last_line_ms.load(std::memory_order_relaxed);
+    if (all > 8 && done && now_ms - last < 1000) {
+        return;
+    }
+    if (!last_line_ms.compare_exchange_strong(last, now_ms, std::memory_order_relaxed) &&
+        all > 8 && done) {
+        return;
+    }
+    static constexpr const char* names[] = {"block_to_pitch", "pitch_to_block", "block_to_block"};
+    std::fprintf(stderr,
+                 "EDEN_UP_DMA_STRIPE %s: the copy's scratch could not grow to %llu bytes; %s "
+                 "(lines=%u width=%u) striped=%llu refused=%llu\n",
+                 names[static_cast<u32>(kind)], static_cast<unsigned long long>(wanted),
+                 done ? "copied in stripes" : "shape not covered, rethrown", lines, width,
+                 static_cast<unsigned long long>(done ? total : copies.load()),
+                 static_cast<unsigned long long>(done ? refused.load() : total));
+}
+
+/// Block linear to pitch in stripes (CopyBlockLinearToPitch's copy). False: not covered.
+bool StripeBlockToPitch(Tegra::MemoryManager& memory, const BlockSide& src, u32 height, u32 depth,
+                        u32 x_offset, u32 origin_y, u32 x_elements, u32 line_count,
+                        GPUVAddr dst_address, u32 pitch, bool native_tiling) {
+    u32 lines = 0;
+    u32 first = 0;
+    u32 end = 0;
+    const u32 row_bytes = x_elements * src.bytes_per_pixel;
+    const u32 most = PitchLines(pitch, row_bytes);
+    if (most == 0 || !SliceZeroLines(height, depth, origin_y, line_count, lines) ||
+        !src.Columns(x_offset, x_elements, first, end)) {
+        return false;
+    }
+    StripeSpace& space = Stripes();
+    std::scoped_lock lock{space.lock};
+    const std::span<u8> compact = src.Compact(space.block_a);
+    for (u32 line = 0; line < lines;) {
+        const u32 y = origin_y + line;
+        const u32 in_gob = y & ((1U << GOB_SIZE_Y_SHIFT) - 1);
+        const u32 count = (std::min)({(1U << GOB_SIZE_Y_SHIFT) - in_gob, lines - line, most});
+        const std::size_t bytes = std::size_t{count} * pitch;
+        const GPUVAddr out = dst_address + std::size_t{line} * pitch;
+        src.ReadGobRow(memory, y >> GOB_SIZE_Y_SHIFT, first, end, compact.data(), true);
+        memory.ReadBlockUnsafe(out, space.linear.data(), bytes);
+        UnswizzleSubrect(std::span<u8>(space.linear.data(), bytes), compact, src.bytes_per_pixel,
+                         src.width, 1U << GOB_SIZE_Y_SHIFT, 1, x_offset, in_gob, x_elements, count,
+                         0, 0, pitch, native_tiling);
+        memory.WriteBlockCached(out, space.linear.data(), bytes);
+        line += count;
+    }
+    return true;
+}
+
+/// Pitch to block linear in stripes (CopyPitchToBlockLinear's copy). False: not covered.
+bool StripePitchToBlock(Tegra::MemoryManager& memory, const BlockSide& dst, u32 height, u32 depth,
+                        u32 x_offset, u32 origin_y, u32 x_elements, u32 line_count,
+                        GPUVAddr src_address, u32 pitch, bool native_tiling) {
+    u32 lines = 0;
+    u32 first = 0;
+    u32 end = 0;
+    const u32 row_bytes = x_elements * dst.bytes_per_pixel;
+    const u32 most = PitchLines(pitch, row_bytes);
+    if (most == 0 || !SliceZeroLines(height, depth, origin_y, line_count, lines) ||
+        !dst.Columns(x_offset, x_elements, first, end)) {
+        return false;
+    }
+    StripeSpace& space = Stripes();
+    std::scoped_lock lock{space.lock};
+    const std::span<u8> compact = dst.Compact(space.block_a);
+    for (u32 line = 0; line < lines;) {
+        const u32 y = origin_y + line;
+        const u32 in_gob = y & ((1U << GOB_SIZE_Y_SHIFT) - 1);
+        const u32 count = (std::min)({(1U << GOB_SIZE_Y_SHIFT) - in_gob, lines - line, most});
+        const std::size_t bytes = std::size_t{count} * pitch;
+        dst.ReadGobRow(memory, y >> GOB_SIZE_Y_SHIFT, first, end, compact.data(), false);
+        memory.ReadBlock(src_address + std::size_t{line} * pitch, space.linear.data(), bytes);
+        SwizzleSubrect(compact, std::span<u8>(space.linear.data(), bytes), dst.bytes_per_pixel,
+                       dst.width, 1U << GOB_SIZE_Y_SHIFT, 1, x_offset, in_gob, x_elements, count, 0,
+                       0, pitch, native_tiling);
+        dst.WriteGobRow(memory, y >> GOB_SIZE_Y_SHIFT, first, end, compact.data());
+        line += count;
+    }
+    return true;
+}
+
+/// Block linear to block linear in stripes (CopyBlockLinearToBlockLinear's copy): each stripe
+/// stays within one GOB row of either side. False: not covered.
+bool StripeBlockToBlock(Tegra::MemoryManager& memory, const BlockSide& src, u32 src_height,
+                        u32 src_depth, u32 src_x, u32 src_y, const BlockSide& dst, u32 dst_height,
+                        u32 dst_depth, u32 dst_x, u32 dst_y, u32 x_elements, u32 line_count,
+                        bool native_tiling) {
+    u32 src_lines = 0;
+    u32 dst_lines = 0;
+    u32 src_first = 0;
+    u32 src_end = 0;
+    u32 dst_first = 0;
+    u32 dst_end = 0;
+    const u32 pitch = x_elements * src.bytes_per_pixel;
+    const u32 most = PitchLines(pitch, pitch);
+    // The whole copy swizzles dst_lines lines out of the src_lines it unswizzled; with fewer
+    // source lines it would write the scratch's old bytes, which stripes cannot repeat.
+    if (most == 0 || !SliceZeroLines(src_height, src_depth, src_y, line_count, src_lines) ||
+        !SliceZeroLines(dst_height, dst_depth, dst_y, line_count, dst_lines) ||
+        src_lines < dst_lines || !src.Columns(src_x, x_elements, src_first, src_end) ||
+        !dst.Columns(dst_x, x_elements, dst_first, dst_end)) {
+        return false;
+    }
+    constexpr u32 gob_lines = 1U << GOB_SIZE_Y_SHIFT;
+    StripeSpace& space = Stripes();
+    std::scoped_lock lock{space.lock};
+    const std::span<u8> src_compact = src.Compact(space.block_a);
+    const std::span<u8> dst_compact = dst.Compact(space.block_b);
+    for (u32 line = 0; line < dst_lines;) {
+        const u32 sy = src_y + line;
+        const u32 dy = dst_y + line;
+        const u32 s_in = sy & (gob_lines - 1);
+        const u32 d_in = dy & (gob_lines - 1);
+        const u32 count =
+            (std::min)({gob_lines - s_in, gob_lines - d_in, dst_lines - line, most});
+        const std::span<u8> linear(space.linear.data(), std::size_t{count} * pitch);
+        src.ReadGobRow(memory, sy >> GOB_SIZE_Y_SHIFT, src_first, src_end, src_compact.data(),
+                       true);
+        UnswizzleSubrect(linear, src_compact, src.bytes_per_pixel, src.width, gob_lines, 1, src_x,
+                         s_in, x_elements, count, 0, 0, pitch, native_tiling);
+        dst.ReadGobRow(memory, dy >> GOB_SIZE_Y_SHIFT, dst_first, dst_end, dst_compact.data(),
+                       true);
+        SwizzleSubrect(dst_compact, linear, dst.bytes_per_pixel, dst.width, gob_lines, 1, dst_x,
+                       d_in, x_elements, count, 0, 0, pitch, native_tiling);
+        dst.WriteGobRow(memory, dy >> GOB_SIZE_Y_SHIFT, dst_first, dst_end, dst_compact.data());
+        line += count;
+    }
+    return true;
+}
+
