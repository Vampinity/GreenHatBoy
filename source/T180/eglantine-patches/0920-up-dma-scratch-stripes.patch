+void MaxwellDMA::ReserveScratch() {
+    scratch_reserve_tried = true;
+    const std::size_t bytes = DmaScratchReserveBytes();
+    try {
+        // resize_destructive only grows: the copies then use these without asking the heap.
+        read_buffer.resize_destructive(bytes);
+        write_buffer.resize_destructive(bytes);
+        std::fprintf(stderr, "EDEN_UP_DMA_SCRATCH_MIB: read and write scratch hold %zu MiB each\n",
+                     bytes >> 20);
+    } catch (const std::bad_alloc&) {
+        std::fprintf(stderr,
+                     "EDEN_UP_DMA_SCRATCH_MIB: no memory to reserve %zu MiB; the scratch grows "
+                     "as before\n",
+                     bytes >> 20);
+    }
+}
+
 void MaxwellDMA::Launch() {
+    if (!scratch_reserve_tried && DmaScratchReserveBytes() != 0) [[unlikely]] {
+        ReserveScratch();
+    }
+    LaunchCopy();
+}
