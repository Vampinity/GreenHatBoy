+// SPDX-License-Identifier: GPL-3.0-or-later
+
+// 0833: the shader set's progress while it is made, apart from shader_set.h so the PS5 front
+// (headless/main.cpp) can set the boot screen's hook without the video core's engine headers.
+
+#pragma once
+
+#include <functional>
+
+#include "common/common_types.h"
+
+namespace VideoCommon::ShaderSet {
+
+/// 0832: the parts of making the file that take more than a few seconds, for a boot screen.
+enum class Part : u32 {
+    Files,   ///< the game's files read: files done / total
+    Records, ///< records converted and written: records done / total
+    Save,    ///< the facts and the programs written: MB of program code done / total
+};
+/// 0832: called on Prepare's thread when a part begins, about twice a second while it runs, and
+/// once when it ends (done == total). Never called when the file is reused.
+using OnProgress = std::function<void(Part part, u64 done, u64 total)>;
+
+/// 0833: the boot screen's hook. While set, a Prepare called without `on_progress` sends its
+/// parts here (on Prepare's thread) and logs one line every 10 s per part. The front sets it only
+/// around the before-play pass (EDEN_UP_SHADER_SET_PREPASS=1) and clears it ({}) after; a cleared
+/// hook is never called again. Not set: Prepare is as before.
+void SetBootProgress(OnProgress hook);
+
+} // namespace VideoCommon::ShaderSet
