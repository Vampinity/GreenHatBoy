+namespace {
+// 0833: the boot screen's hook (SetBootProgress). Called under the mutex, so a hook the front
+// clears is never called after SetBootProgress({}) returns.
+std::mutex boot_progress_mutex;
+OnProgress boot_progress;
+std::atomic<bool> boot_progress_set{false};
+
+bool BootProgressSet() {
+    return boot_progress_set.load(std::memory_order_acquire);
+}
+
+void CallBootProgress(Part part, u64 done, u64 total) {
+    std::scoped_lock lock{boot_progress_mutex};
+    if (boot_progress) boot_progress(part, done, total);
+}
+} // namespace
+
+void SetBootProgress(OnProgress hook) {
+    std::scoped_lock lock{boot_progress_mutex};
+    boot_progress_set.store(static_cast<bool>(hook), std::memory_order_release);
+    boot_progress = std::move(hook);
+}
