+/// 0780: the same for a compute fact: the live compute environment starts at its zero header's
+/// end (start address 80, ComputeEnvironment), and the fact ends with the workgroup size and the
+/// shared memory size (16 bytes, FileEnvironment::Serialize).
+bool ComputeFactOk(const Facts& f, const Lowered& p) {
+    if (f.bytes.size() < 76 || f.tables_end < 76 || f.tables_end + 16 != f.bytes.size() ||
+        p.code.size() < 10) {
+        return false;
+    }
+    if (Load<u32>(f.bytes, 72) != 5 || Load<u32>(f.bytes, 56) != 80 || Load<u32>(f.bytes, 60) != 0)
+        return false;
+    return p.bound == ~0U || Load<u32>(f.bytes, 52) == p.bound;
+}
+
+/// What a records file keeps of a fact: graphics facts up to their tables' end (nothing follows
+/// them for the vertex and pixel stages), compute facts whole (0780: workgroup and shared memory).
+size_t StoredFactBytes(const Facts& f) {
+    return f.bytes.size() >= 76 && Load<u32>(f.bytes, 72) == 5 ? f.bytes.size() : f.tables_end;
+}
+
 /// One environment as FileEnvironment::Deserialize reads it: the fact's bytes (up to its tables'
