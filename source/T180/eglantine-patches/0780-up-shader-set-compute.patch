 void AppendEnvironment(std::vector<char>& out, std::span<const char> fact,
@@ -358,10 +388,18 @@ void AppendEnvironment(std::vector<char>& out, std::span<const char> fact,
     std::memcpy(out.data() + at + 64, &last, sizeof(last));
     out.insert(out.end(), code.begin(), code.end());
     out.insert(out.end(), fact.begin() + 76, fact.end());
+    u32 stage{};
+    std::memcpy(&stage, fact.data() + 72, sizeof(stage));
+    if (stage == 5) {
+        return; // 0780: compute: the fact's workgroup and shared memory end it, no program header
+    }
