+    /// Patch 0751 (after zortos293/Lichii #465 PipelineBuild::WaitFor): waits at most `timeout`
+    /// for the driver build, asking the builder for it first (BuildFirst, with its switch).
+    /// Returns whether it is built. The builds wake every waiter (notify_all), so this wait never
+    /// takes the scheduler worker's wake-up.
+    [[nodiscard]] bool WaitBuiltFor(std::chrono::microseconds timeout) {
+        if (IsBuilt()) {
+            return true;
+        }
+        BuildFirst();
+        std::unique_lock lock{build_mutex};
+        return build_condvar.wait_for(
+            lock, timeout, [this] { return is_built.load(std::memory_order::relaxed); });
+    }
