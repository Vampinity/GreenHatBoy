+namespace {
+// Patch 0751 (after zortos293/Lichii #465 "Bounded" native async draws, Mario Matheus Pombal):
+// the GPU thread's per-frame budget for waiting on driver builds, and its 10 s report.
+struct BoundedBuildWaitState {
+    u64 frame{~u64{0}};
+    std::chrono::microseconds left{};
+    u32 ready{};   ///< Built within the budget (or already built when looked at again)
+    u32 skipped{}; ///< Not built when the budget ran out: the draw was skipped
+    std::chrono::steady_clock::duration waited{};
+    std::chrono::steady_clock::time_point window{std::chrono::steady_clock::now()};
+};
+
+bool WaitBuiltWithinBudget(GraphicsPipeline* pipeline, s64 budget_ms, u64 frame) {
+    static BoundedBuildWaitState state; // the GPU thread only, as the rest of BuiltPipeline
+    if (state.frame != frame) {
+        state.frame = frame;
+        state.left = std::chrono::milliseconds{budget_ms};
+    }
+    bool built = false;
+    if (state.left.count() > 0) {
+        const auto begin = std::chrono::steady_clock::now();
+        built = pipeline->WaitBuiltFor(state.left);
+        const auto spent = std::chrono::steady_clock::now() - begin;
+        state.left -= std::min(state.left,
+                               std::chrono::duration_cast<std::chrono::microseconds>(spent));
+        state.waited += spent;
+    } else {
+        built = pipeline->IsBuilt();
+    }
+    ++(built ? state.ready : state.skipped);
+    const auto now = std::chrono::steady_clock::now();
+    if (now - state.window >= std::chrono::seconds{10}) {
+        LOG_INFO(Render_Vulkan,
+                 "Bounded build wait (0751) in the last 10 s: {:.1f} ms waited, {} draws got "
+                 "their pipeline in time, {} skipped (budget {} ms a frame)",
+                 std::chrono::duration<double, std::milli>(state.waited).count(), state.ready,
+                 state.skipped, budget_ms);
+        state.waited = {};
+        state.ready = 0;
+        state.skipped = 0;
+        state.window = now;
+    }
+    return built;
+}
+} // Anonymous namespace
+
 GraphicsPipeline* PipelineCache::BuiltPipeline(GraphicsPipeline* pipeline) const noexcept {
     if (pipeline->IsBuilt()) {
         return pipeline;
     }
     if (!use_asynchronous_shaders) {
-        return pipeline;
+        // Patch 0751 (live switch BoundedBuildWait, 1 to 100 ms a frame; off: one load). The
+        // asynchronous shaders setting is off on the PS5, so a draw whose driver build is not
+        // done is recorded and the scheduler worker waits for the build: the frame stalls for as
+        // long as the build takes (up to seconds on a first sight). With the budget, a Switch 2
+        // draw that may be skipped (CanSkipDraw: depth in use, or more than a full screen quad,
+        // and not kept by the async draw waits switch) waits here within what is left of this
+        // frame's budget; not built by then, it is skipped, and the build goes on.
+        const s64 budget_ms =
+            Common::LiveSwitch::Value<Common::LiveSwitch::Id::BoundedBuildWait>();
+        if (budget_ms == 0 || !Settings::CurrentProgramIsSwitch2() || !CanSkipDraw()) {
+            return pipeline;
+        }
+        if (WaitBuiltWithinBudget(pipeline, budget_ms, frame_count)) {
+            return pipeline;
+        }
+        VideoCommon::EmptyDrawStats::Building();
+        return nullptr;
     }
     // If something is using depth, we can assume that games are not rendering anything which
     // will be used one time.
