+// Patch 0940 (EDEN_UP_TC_OOM_COUNT and the switches beside it): a collector delete, before the image
+// leaves the LRU: how long it was unused, and its address and shape for the remake count.
+template <class P>
+void TextureCache<P>::OomNoteDelete(const Image& image) {
+    const u64 age = frame_tick - lru_cache.Tick(image.lru_index);
+    ++oom_delete_age[age < 25 ? 0 : age < 60 ? 1 : age < 120 ? 2 : 3];
+    const bool costly = True(image.flags & ImageFlagBits::CostlyLoad);
+    if (costly && age < 60) {
+        ++oom_delete_costly_recent;
+    }
+    if (oom_deleted.size() < 65536) {
+        oom_deleted[image.gpu_addr] = OomDeleted{frame_tick, static_cast<u32>(image.info.format),
+                                                 image.info.size.width, image.info.size.height,
+                                                 costly};
+    }
+}
+
+// Patch 0940: a new image at the address and shape of one the collector deleted in the last 600
+// frames is a remake.
+template <class P>
+void TextureCache<P>::OomNoteMade(const Image& image) {
+    const auto it = oom_deleted.find(image.gpu_addr);
+    if (it == oom_deleted.end()) {
+        return;
+    }
+    const OomDeleted& gone = it->second;
+    if (frame_tick - gone.frame <= 600 && gone.format == static_cast<u32>(image.info.format) &&
+        gone.width == image.info.size.width && gone.height == image.info.size.height) {
+        ++oom_remakes;
+        oom_remakes_costly += gone.costly ? 1 : 0;
+    }
+    oom_deleted.erase(it);
+}
