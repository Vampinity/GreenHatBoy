+// Patch 0940, the collector while the pool is short but nothing is refused (the area past the field:
+// the pool's largest block stays at 20-44 MiB whatever the collector frees, so the Vulkan port's
+// PoolPressure() is 2 every frame and every image unused for 10 frames goes, ASTC included, to be
+// made and decoded again a few frames later: ~5 deletes and ~5 creations a frame at ~15 fps).
+//
+// EDEN_UP_TC_OOM_SPARE_FRAMES=<K> (digits, 1..3600; unset, 0 or anything else: off, as before):
+// while no refusal was seen for 600 frames (the allocator's MemoryRefusalEvents, the driver's
+// graphics_refusals, an image left out) and the images are under the expected mark, the collector's
+// passes take only images unused for K frames or more, and ASTC (CostlyLoad) only after 2K. Among
+// the candidates, images unused for max(120, 2K) frames go before the emptiest-block order. Any
+// refusal turns it off for 600 frames: the next pass collects as before (10 frames unused).
+// Every other path (CollectForBuffer, RefusalEvict, AreaEvict, stale targets, the old pass) is as
+// before.
+// EDEN_UP_TC_OOM_MARGIN_MAX_MIB=<N> (digits, 1..3072): "Out of device memory: keeping N MiB more
+// free" stops at N instead of 3072. Under EDEN_NX2_TC_EXPECTED_MIB/_CRITICAL_MIB the margin only
+// moves the computed marks, which the overrides replace, so this changes the log line only there.
+// EDEN_UP_TC_OOM_COUNT=1: the count line alone (for a control run); either switch above also gives it.
+// Line, with EDEN_NX2_TC_LOG, every 600 frames: "EDEN_UP_TC_OOM 600 frames: ...".
+[[nodiscard]] inline u64 TcDigitsSwitch(const char* name, u64 max) {
+    const char* const value = std::getenv(name);
+    if (value == nullptr || value[0] == '\0') {
+        return 0;
+    }
+    u64 number = 0;
+    for (const char* digit = value; *digit != '\0'; ++digit) {
+        if (*digit < '0' || *digit > '9') {
+            return 0;
+        }
+        number = number * 10 + static_cast<u64>(*digit - '0');
+        if (number > max) {
+            return 0;
+        }
+    }
+    return number;
+}
+[[nodiscard]] inline u64 OomSpareFrames() {
+    static const u64 frames = TcDigitsSwitch("EDEN_UP_TC_OOM_SPARE_FRAMES", 3600);
+    return frames;
+}
+[[nodiscard]] inline u64 OomMarginMaxBytes() {
+    static const u64 bytes = TcDigitsSwitch("EDEN_UP_TC_OOM_MARGIN_MAX_MIB", 3072) << 20;
+    return bytes;
+}
+[[nodiscard]] inline bool OomCountLine() {
+    static const bool on = OomSpareFrames() != 0 || OomMarginMaxBytes() != 0 ||
+                           Common::PeSwitch("EDEN_UP_TC_OOM_COUNT");
+    return on;
+}
