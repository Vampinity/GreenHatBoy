+// 0900 EDEN_UP_GPU_READ_THROUGH (common/guest_read_through.h): the front's guest memory service
+// sets its copy and span check here as it starts with the switch, and clears them as it stops.
+extern "C" void eden_core_set_guest_read_through(Common::GuestReadThrough::CopyFn copy,
