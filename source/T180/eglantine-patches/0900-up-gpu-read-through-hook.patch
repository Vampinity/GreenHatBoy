+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+
+// 0900 EDEN_UP_GPU_READ_THROUGH (the front's src/guest_memory_service.inc, off unless set): the
+// GPU's reads of the guest's memory go through the guest memory service, which copies a slot that
+// is packed or in the swap file straight from its packed bytes into the read's destination, without
+// mapping a block for it. Without the switch the front sets nothing here and every read is the plain
+// memcpy it was (one relaxed load of a null pointer more).
+//
+// Also the GPU threads name themselves to the front (eden_guest_gpu_thread_mark): its fault handler
+// treats a fault on them apart (EDEN_UP_FAULT_RESERVE, EDEN_UP_FAULT_LOG). Weak: a build without the
+// front (host tests) calls nothing.
+
+#include <atomic>
+#include <cstddef>
+#include <cstring>
+
+extern "C" void eden_guest_gpu_thread_mark(int kind) __attribute__((weak));
+
+namespace Common::GuestReadThrough {
+
+/// Copies `size` bytes from guest memory at `source` (a host pointer) to `dest`. True when it did;
+/// false when the range is not the service's (the caller copies as before).
+using CopyFn = bool (*)(void* dest, const void* source, std::size_t size);
+/// False when a direct span over `source` could touch a slot without a mapping (read a copy then).
+using ReadableFn = bool (*)(const void* source, std::size_t size);
+
+inline std::atomic<CopyFn> copy_fn{nullptr};
+inline std::atomic<ReadableFn> readable_fn{nullptr};
+
+/// memcpy for a read of the guest's memory by the GPU side.
+inline void Copy(void* dest, const void* source, std::size_t size) {
+    if (const CopyFn fn = copy_fn.load(std::memory_order_acquire); fn != nullptr) [[unlikely]] {
+        if (fn(dest, source, size)) {
+            return;
+        }
+    }
+    std::memcpy(dest, source, size);
+}
+
+/// Whether a span straight over guest memory may be handed out for reading.
+inline bool SpanReadable(const void* source, std::size_t size) {
+    const ReadableFn fn = readable_fn.load(std::memory_order_acquire);
+    return fn == nullptr || fn(source, size);
+}
+
+/// 1: the GPU back thread (EDEN_NX2_SPLIT), 2: the GPU thread.
+inline void MarkGpuThread(int kind) {
+    if (eden_guest_gpu_thread_mark != nullptr) {
+        eden_guest_gpu_thread_mark(kind);
+    }
+}
+
+} // namespace Common::GuestReadThrough
+
+/// The front sets or clears the two functions (defined in video_core/memory_manager.cpp).
+extern "C" void eden_core_set_guest_read_through(Common::GuestReadThrough::CopyFn copy,
+                                                  Common::GuestReadThrough::ReadableFn readable);
