@@ -1183,6 +1183,10 @@ private:
     /// Applies EDEN_NX2_TC_EXPECTED_MIB / EDEN_NX2_TC_CRITICAL_MIB and logs the thresholds.
     void ApplyThresholdOverrides(bool log = true);
 
+    /// EDEN_UP_RESERVE_TABLES (0891, texture_cache.h ReserveTableSlots): the slot tables at their
+    /// full size at boot. Off: nothing.
+    void ReserveTables();
+
     /// EDEN_UP_NO_STALE_UPLOAD (zortos293/Lichii 451f309925, #818): a GPU-written image the
     /// collector drops without writing it back leaves its guest memory stale (the GPU's data is
     /// gone). Its whole pages are marked here and kept tracked, so CPU writes, unmaps and
