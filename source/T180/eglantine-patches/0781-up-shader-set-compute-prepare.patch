+// 0781, EDEN_UP_SHADER_SET_COMPUTE=1 ---------------------------------------------------------
+
+std::unique_ptr<ComputePipeline> PipelineCache::CreateKeptComputePipeline(
+    const ComputePipelineCacheKey& key, Shader::Environment& env) try {
+    if (!prep_store.IsOpen() || !ShaderPrep::FastPath()) {
+        return nullptr;
+    }
+    const u64 hash = KeptComputeHash(key);
+    ShaderPrep::KeptStore::Record record;
+    if (prep_rejected.contains(hash) || !prep_store.Find(hash, record) ||
+        (record.flags & ShaderPrep::KeptStore::FlagNotKeepable) != 0) {
+        return nullptr;
+    }
+    // GPU thread only: what the kept compute translations did since the last line.
+    static u32 used{}, refused{};
+    static std::map<std::string, u32> reasons;
+    static auto window = std::chrono::steady_clock::now();
+    const auto report = [&]() noexcept {
+        try {
+            const auto now = std::chrono::steady_clock::now();
+            if (now - window < std::chrono::seconds{10}) {
+                return;
+            }
+            std::string why;
+            for (const auto& [reason, count] : reasons) {
+                why += fmt::format("{}{} {}", why.empty() ? "" : ", ", count, reason);
+            }
+            LOG_INFO(Render_Vulkan,
+                     "Kept compute translations in the last 10 s: {} compute pipelines made "
+                     "without translating, {} refused{}{}{}",
+                     used, refused, why.empty() ? "" : " (", why, why.empty() ? "" : ")");
+            used = 0;
+            refused = 0;
+            reasons.clear();
+            window = now;
+        } catch (const std::exception&) {
+        }
+    };
+    const auto refuse = [&](const char* why) noexcept -> std::unique_ptr<ComputePipeline> {
+        try {
+            ++refused;
+            prep_rejected.insert(hash);
+            ++reasons[why];
+        } catch (const std::exception&) {
+        }
+        report();
+        return nullptr;
+    };
+    if (record.env_count != 1 || record.infos[0] == ShaderPrep::NoBlob ||
+        record.spirv[0] == ShaderPrep::NoBlob || record.answers[0] == ShaderPrep::NoBlob) {
+        return refuse("other stages");
+    }
+    std::vector<u8> bytes;
+    Shader::Info info{};
+    if (!prep_store.Read(record.infos[0], bytes) || !ShaderPrep::DeserializeInfo(bytes, info)) {
+        prep_store.Forget(hash);
+        return refuse("files unreadable");
+    }
+    // The words the program's descriptors read their texture handles from may hold other
+    // handles now (as CreateKeptGraphicsPipeline lists them).
+    using AnswerHandle = VideoCommon::FileEnvironment::AnswerHandle;
+    using HandleKind = VideoCommon::FileEnvironment::HandleKind;
+    std::vector<AnswerHandle> handles;
+    const auto add = [&handles](const auto& desc, bool has_secondary, u32 shift_left,
+                                u32 secondary_index, u32 secondary_offset,
+                                u32 secondary_shift_left, HandleKind kind) {
+        if (desc.handle_program != ~0U) {
+            return;
+        }
+        handles.push_back({.index = desc.cbuf_index,
+                           .offset = desc.cbuf_offset,
+                           .shift_left = shift_left,
+                           .secondary_index = secondary_index,
+                           .secondary_offset = secondary_offset,
+                           .secondary_shift_left = secondary_shift_left,
+                           .has_secondary = has_secondary,
+                           .kind = kind});
+    };
+    for (const auto& desc : info.texture_buffer_descriptors) {
+        add(desc, desc.has_secondary, desc.shift_left, desc.secondary_cbuf_index,
+            desc.secondary_cbuf_offset, desc.secondary_shift_left, HandleKind::TextureBuffer);
+    }
+    for (const auto& desc : info.texture_descriptors) {
+        add(desc, desc.has_secondary, desc.shift_left, desc.secondary_cbuf_index,
+            desc.secondary_cbuf_offset, desc.secondary_shift_left,
+            desc.is_depth ? HandleKind::DepthTexture : HandleKind::Texture);
+    }
+    for (const auto& desc : info.image_buffer_descriptors) {
+        add(desc, false, 0, 0, 0, 0, HandleKind::ImageBuffer);
+    }
+    for (const auto& desc : info.image_descriptors) {
+        add(desc, false, 0, 0, 0, 0, HandleKind::Image);
+    }
+    if (!prep_store.Read(record.answers[0], bytes)) {
+        prep_store.Forget(hash);
+        return refuse("files unreadable");
+    }
+    const char* why = "";
+    if (!VideoCommon::FileEnvironment::AnswersHoldFor(bytes, env, handles, &why, nullptr)) {
+        return refuse(why);
+    }
+    if (!prep_store.Read(record.spirv[0], bytes) || bytes.empty() ||
+        bytes.size() % sizeof(u32) != 0) {
+        prep_store.Forget(hash);
+        return refuse("files unreadable");
+    }
+    std::vector<u32> words(bytes.size() / sizeof(u32));
+    std::memcpy(words.data(), bytes.data(), bytes.size());
+    vk::ShaderModule module{BuildShader(device, words)};
+    if (NullSlotsMode() != 0 && env.IsNativeProgram()) {
+        std::scoped_lock lock{compute_null_slots_mutex};
+        compute_null_slots[key].slots = env.NullStoragePointerSlots();
+    }
+    auto pipeline = std::make_unique<ComputePipeline>(
+        device, scheduler, vulkan_pipeline_cache, descriptor_pool, guest_descriptor_queue,
+        descriptor_buffer_ring, &workers, nullptr, &shader_notify, info, std::move(module),
+        key.unique_hash);
+    ++used;
+    report();
+    return pipeline;
+} catch (const std::exception&) {
+    // No memory, or the driver refused the module: the caller translates, as before.
+    return nullptr;
+}
