+/// 0781, EDEN_UP_SHADER_SET_COMPUTE=1: compute pipelines are kept in the same store as graphics
+/// ones, under their key's hash with this mixed in (a graphics key hash and a compute key hash
+/// are hashes of other bytes; the mix keeps them apart for certain in practice).
+constexpr u64 KeptComputeMix = 0x636f6d7075746531ULL; // "compute1"
+u64 KeptComputeHash(const ComputePipelineCacheKey& key) noexcept {
+    return key.Hash() ^ KeptComputeMix;
+}
