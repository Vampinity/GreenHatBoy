+        std::array<u32, 7> bins{}; ///< EDEN_UP_GPU_PASS_TIME: frame times in 16.7 ms bins
     } m_stats{};
+    // EDEN_UP_GPU_PASS_TIME=1, Ocarina of Time with EDEN_NX2_OOT_DYNAMIC_FPS=1 (patch 0149): the
+    // dynamic-fps routine's two words (main+0x4E9FE00: the counter at its last call; +8: its
+    // smoothed frame time in counter ticks, the time since the last call capped at CNTFRQ/20 =
+    // 50 ms and smoothed by 1/8), read once per present. The routine replaces the game's step with
+    // the smoothed time when that is more than 1.03x the game's own step, so the game advances
+    // max(own, smoothed) seconds per frame. The own step is s1/s0 of the game's state, which this
+    // does not read: taken as 1/30 s (the game's 30 fps step; only presents where the smoothed time
+    // is under 34.3 ms depend on it).
+    struct GameSpeed {
+        u64 last_counter{};
+        u64 wall_ticks{};
+        double game_s{};
+        double smoothed_s{};
+        u32 calls{};
+        u32 dynamic{};
+        u32 capped{};
+        u32 skipped{};   ///< presents whose routine counter had not moved
+        u32 multi{};     ///< gaps over 1.5x the smoothed time: likely more than one call
+    } m_game_speed{};
+
+    void SampleGameSpeed() {
+        const u64 address = Common::Nx2GameSpeed::state_address.load(std::memory_order_relaxed);
+        if (address == 0) {
+            return;
+        }
+        auto& memory = system.ApplicationMemory();
+        if (!memory.IsValidVirtualAddressRange(address, 16)) {
+            return;
+        }
+        const u64 counter = memory.Read64(address);
+        const u64 smoothed = memory.Read64(address + 8);
+        auto& speed = m_game_speed;
+        if (counter == 0 || counter == speed.last_counter) {
+            ++speed.skipped;
+            return;
+        }
+        if (speed.last_counter != 0 && counter > speed.last_counter) {
+            constexpr double frequency = static_cast<double>(Core::Hardware::CNTFREQ);
+            constexpr double own_step_s = 1.0 / 30.0;
+            const u64 gap = counter - speed.last_counter;
+            const double smoothed_s = static_cast<double>(smoothed) / frequency;
+            const bool dynamic = smoothed_s > own_step_s * 1.03;
+            speed.wall_ticks += gap;
+            speed.game_s += dynamic ? smoothed_s : own_step_s;
+            speed.smoothed_s += smoothed_s;
+            ++speed.calls;
+            speed.dynamic += dynamic ? 1 : 0;
+            speed.capped += gap >= Core::Hardware::CNTFREQ / 20 ? 1 : 0;
+            speed.multi += smoothed != 0 && gap * 2 > smoothed * 3 + Core::Hardware::CNTFREQ / 20 ? 1 : 0;
+        }
+        speed.last_counter = counter;
+    }
+
+    void LogShapeAndGameSpeed() {
+        const auto& b = m_stats.bins;
+        LOG_INFO(Service,
+                 "nx2:vi2 last 600 presents shape: frames in 16.7 ms bins: <16.7 {} | <33.3 {} | "
+                 "<50 {} | <66.7 {} | <83.3 {} | <100 {} | >=100 {}",
+                 b[0], b[1], b[2], b[3], b[4], b[5], b[6]);
+        auto& speed = m_game_speed;
+        if (Common::Nx2GameSpeed::state_address.load(std::memory_order_relaxed) == 0) {
+            LOG_INFO(Service, "nx2:vi2 last 600 presents game speed: no dynamic-fps routine "
+                              "(not Ocarina of Time, or EDEN_NX2_OOT_DYNAMIC_FPS unset)");
+        } else if (speed.calls == 0 || speed.wall_ticks == 0) {
+            LOG_INFO(Service, "nx2:vi2 last 600 presents game speed: routine not seen ({} presents "
+                              "without a call)", speed.skipped);
+        } else {
+            const double wall_s =
+                static_cast<double>(speed.wall_ticks) / static_cast<double>(Core::Hardware::CNTFREQ);
+            LOG_INFO(Service,
+                     "nx2:vi2 last 600 presents game speed {:.3f}: game {:.2f} s in {:.2f} s of the "
+                     "routine's clock; {} calls seen ({} presents without one, {} gaps that look "
+                     "like more than one call), {} on the smoothed step, {} gaps capped at 50 ms, "
+                     "smoothed step mean {:.1f} ms (own step taken as 33.3 ms)",
+                     speed.game_s / wall_s, speed.game_s, wall_s, speed.calls, speed.skipped,
+                     speed.multi, speed.dynamic, speed.capped,
+                     speed.smoothed_s * 1000.0 / static_cast<double>(speed.calls));
+        }
+        speed = GameSpeed{.last_counter = speed.last_counter};
+    }
     // EDEN_GBB_FPS_5S: frame times of the current 5 s window (cleared, not freed, each window).
     struct FpsWindow {
