diff --git a/src/video_core/renderer_vulkan/vk_door_job.h b/src/video_core/renderer_vulkan/vk_door_job.h
new file mode 100644
index 0000000..ddaf116
--- /dev/null
+++ b/src/video_core/renderer_vulkan/vk_door_job.h
@@ -0,0 +1,44 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+// EglantinePS5 0597 (our own): a count of the run-time pipeline build JOBS in flight on a
+// VkPipelineBuilder thread (the whole job: render pass, the driver compile, its OOM retry and the
+// mesh compute passes), kept in the heap module (headless/heap_arenas.inc, eden_door_job) so that
+// operator new's handler (headless/main.cpp, EDEN_UP_DOOR_WAIT) and the heap's give-back
+// (EDEN_UP_BUILD_GIVE_BACK) can read it without calling into the video core.
+// On when EDEN_UP_DOOR_WAIT or EDEN_UP_BUILD_GIVE_BACK is exactly "1" and the front has the hook.
+// Off: one relaxed load of a cached state per build job (read once at the first job), no call, no
+// hash, no log line, no allocation. The scope only counts: it never waits, locks or prints.
+#include <atomic>
+#include "common/pe_switch.h"
+
+extern "C" void eden_door_job(int enter) __attribute__((weak));
+
+namespace Vulkan::DoorJob {
+// 0: not read yet, 1: off, 2: on.
+inline std::atomic<int> state{0};
+inline bool On() noexcept {
+    int value = state.load(std::memory_order_relaxed);
+    if (value == 0) [[unlikely]] {
+        value = eden_door_job != nullptr && (Common::PeSwitch("EDEN_UP_DOOR_WAIT") ||
+                                             Common::PeSwitch("EDEN_UP_BUILD_GIVE_BACK"))
+                    ? 2
+                    : 1;
+        state.store(value, std::memory_order_relaxed);
+    }
+    return value == 2;
+}
+class Scope {
+public:
+    explicit Scope(bool on) noexcept : on_{on} {
+        if (on_) eden_door_job(1);
+    }
+    ~Scope() {
+        if (on_) eden_door_job(0);
+    }
+    Scope(const Scope&) = delete;
+    Scope& operator=(const Scope&) = delete;
+
+private:
+    bool on_;
+};
+} // namespace Vulkan::DoorJob
