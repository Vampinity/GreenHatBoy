@@ -312,6 +328,7 @@ bool StripeBlockToBlock(Tegra::MemoryManager& memory, const BlockSide& src, u32
         dst.WriteGobRow(memory, dy >> GOB_SIZE_Y_SHIFT, dst_first, dst_end, dst_compact.data());
