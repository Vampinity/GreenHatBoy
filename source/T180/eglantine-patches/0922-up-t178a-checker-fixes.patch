 #include "video_core/nx2_async_readback.h"
 #include "video_core/nx2_download_landing.h"
 #include "video_core/nx2_fast_draw.h"
+#include "video_core/gpu_badalloc_backstop.h" // 0922
 #include "video_core/rasterizer_download_area.h"
 #include "video_core/renderer_base.h"
 #include "video_core/shader_notify.h"
@@ -585,7 +586,22 @@ struct GPU::Impl {
             sync_requests.pop_front();
             sync_request_mutex.unlock();
             VideoCommon::Nx2FastDraw::Break(VideoCommon::Nx2FastDraw::Reason::TickWork);
-            request();
+            if (!VideoCommon::GpuBadAllocBackstop::Enabled()) [[likely]] {
+                request();
+            } else {
+                // 0922 EDEN_UP_GPU_BADALLOC_BACKSTOP=1: TickWork runs inside draws, which the
+                // backstop catches. A request that throws still counts as done (its waiter would
+                // otherwise wait for ever, and every later waiter one request behind), and the
+                // mutex is taken again before the throw goes on (`lck` unlocks it).
+                try {
+                    request();
+                } catch (...) {
+                    current_sync_fence.fetch_add(1, std::memory_order_release);
+                    sync_request_mutex.lock();
+                    sync_request_cv.notify_all();
+                    throw;
+                }
+            }
             current_sync_fence.fetch_add(1, std::memory_order_release);
             sync_request_mutex.lock();
             sync_request_cv.notify_all();
