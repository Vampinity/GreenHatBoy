diff --git a/src/video_core/gpu_badalloc_backstop.h b/src/video_core/gpu_badalloc_backstop.h
new file mode 100644
index 0000000000000000000000000000000000000000..bbc3cbcc827591d1ecc8efb6f872e8f3aaf7fa3e
--- /dev/null
+++ b/src/video_core/gpu_badalloc_backstop.h
@@ -0,0 +1,76 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+// 0921 EDEN_UP_GPU_BADALLOC_BACKSTOP=1 (exact "1"; off without it): a std::bad_alloc that
+// escapes one engine method call on a GPU thread (the split's back, GpuSplit::BackLoop, or the
+// single-thread path, DmaPusher::CallMethod/CallMultiMethod) is caught there, counted, the heap is
+// trimmed (eden_heap_trim, the front's, weak), one stderr line is printed (EDEN_UP_GPU_BADALLOC),
+// and the next method runs. Before this, nothing caught it and std::terminate ended the session.
+//
+// What is lost: that one method's work (a copy, a draw, an upload, a macro). What can be left
+// half done: whatever the method changed before the throw (registers, dirty flags cleared for state
+// it had not yet bound, cache bookkeeping). To limit that, register writes still queued for the
+// engine (its method sink) are dropped with the call, and a Maxwell3D marks all of its state dirty,
+// so the next draw binds everything again. MaxwellDMA catches inside Launch instead and still
+// releases the copy's semaphore (a game waiting on it would otherwise wait for ever). Locks are
+// held by RAII objects and let go while the exception leaves. After EDEN_UP_GPU_BADALLOC_MAX
+// (default 64) caught throws the next one is not caught: the session ends as before, so a run
+// that keeps failing does not go on drawing garbage.
+
+#include <atomic>
+#include <cstddef>
+#include <cstdio>
+#include <cstdlib>
+#include <new>
+
+#include "common/common_types.h"
+
+extern "C" std::size_t eden_heap_trim(void) __attribute__((weak));
+
+namespace VideoCommon::GpuBadAllocBackstop {
+
+[[nodiscard]] inline bool Enabled() noexcept {
+    static const bool on = [] {
+        const char* const value = std::getenv("EDEN_UP_GPU_BADALLOC_BACKSTOP");
+        return value != nullptr && value[0] == '1' && value[1] == '\0';
+    }();
+    return on;
+}
+
+[[nodiscard]] inline u64 Limit() noexcept {
+    static const u64 limit = [] {
+        const char* const value = std::getenv("EDEN_UP_GPU_BADALLOC_MAX");
+        if (value == nullptr || value[0] == '\0') {
+            return u64{64};
+        }
+        char* end = nullptr;
+        const unsigned long long parsed = std::strtoull(value, &end, 10);
+        return end != nullptr && *end == '\0' && parsed != 0 ? u64{parsed} : u64{64};
+    }();
+    return limit;
+}
+
+/// In a catch of std::bad_alloc on a GPU thread. Counts, trims the heap, prints a line (the first
+/// 16, then each power of two, and the last). False when the limit is reached: the caller
+/// rethrows and the session ends as it did before the backstop.
+inline bool Absorb(const char* where, u32 method, u64 detail) noexcept {
+    static std::atomic<u64> count{0};
+    const u64 n = count.fetch_add(1, std::memory_order_relaxed) + 1;
+    const bool give_up = n > Limit();
+    const std::size_t trimmed = (!give_up && eden_heap_trim != nullptr) ? eden_heap_trim() : 0;
+    if (n <= 16 || (n & (n - 1)) == 0 || give_up) {
+        std::fprintf(stderr,
+                     "EDEN_UP_GPU_BADALLOC where=%s method=%#x detail=%llu count=%llu "
+                     "trimmed_kib=%llu%s\n",
+                     where, method, static_cast<unsigned long long>(detail),
+                     static_cast<unsigned long long>(n),
+                     static_cast<unsigned long long>(trimmed >> 10),
+                     give_up ? " limit reached: not caught, the session ends as before"
+                             : " dropped, going on");
+    }
+    return !give_up;
+}
+
+} // namespace VideoCommon::GpuBadAllocBackstop
