+// 0921 EDEN_UP_GPU_BADALLOC_BACKSTOP=1, the single-thread path (no split): a std::bad_alloc out
+// of one engine method call is caught, counted and the heap trimmed (gpu_badalloc_backstop.h); the
+// parser goes on with the next method. Register writes left queued go with it, and a Maxwell3D binds
+// all of its state again at the next draw. Off: the call runs bare, as before.
+template <typename Call>
+void CallEngineCaught(Engines::EngineInterface* engine, u32 method, Call&& call) {
+    if (!VideoCommon::GpuBadAllocBackstop::Enabled()) [[likely]] {
+        call();
+        return;
+    }
+    try {
+        call();
+    } catch (const std::bad_alloc&) {
+        if (!VideoCommon::GpuBadAllocBackstop::Absorb("single", method, 0)) {
+            throw;
+        }
+        engine->method_sink.clear();
+        if (engine->hang_engine_type == Engines::EngineTypes::Maxwell3D) {
+            static_cast<Engines::Maxwell3D*>(engine)->dirty.flags.set();
+        }
+    }
+}
