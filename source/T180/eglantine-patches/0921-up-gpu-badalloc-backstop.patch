+// 0921: what Execute returns for the entry, worked out from the entry alone (the same tests as
+// Execute's, in the same order), for an entry whose run a std::bad_alloc cut short.
+size_t GpuSplit::EntryWords(const u64* entry, size_t words) const {
+    const u64 head = entry[0];
+    switch (static_cast<Kind>(head & 0xf)) {
+    case Kind::Wrap:
+        return 0;
+    case Kind::Engine:
+        return 2;
+    case Kind::Method: {
+        const u32 method = static_cast<u32>((head >> 8) & 0xffff);
+        auto* const engine = back_engine;
+        if (engine != nullptr && engine->batch_constant_words && (head & HasSegment) == 0) {
+            using Tegra::Engines::Maxwell3D;
+            constexpr u32 cb_data = MAXWELL3D_REG_INDEX(const_buffer.buffer);
+            if (method - cb_data < 16) {
+                size_t count = 1;
+                while (count < 64 && count < words) {
+                    const u64 next = entry[count];
+                    const u32 next_method = static_cast<u32>((next >> 8) & 0xffff);
+                    if (static_cast<Kind>(next & 0xf) != Kind::Method ||
+                        (next & HasSegment) != 0 || next_method - cb_data >= 16) {
+                        break;
+                    }
+                    ++count;
+                }
+                if (count > 1) {
+                    return count;
+                }
+            }
+        }
+        using Tegra::Engines::Maxwell3D;
+        if (engine != nullptr && engine->repeat_draw_begin &&
+            method == MAXWELL3D_REG_INDEX(draw.begin) && (head & HasSegment) == 0 && words > 1 &&
+            entry[1] == head) {
+            size_t count = 2;
+            while (count < words && entry[count] == head) {
+                ++count;
+            }
+            return count;
+        }
+        return (head & HasSegment) != 0 ? 2 : 1;
+    }
+    case Kind::Multi: {
+        const u32 amount = static_cast<u32>(head >> 32);
+        const size_t data = (head & HasSegment) != 0 ? 3 : 2;
+        return data + (amount + 1) / 2;
+    }
+    case Kind::Regs:
+    case Kind::CbData:
+        return 1 + static_cast<size_t>((head >> 8) & 0xff);
+    case Kind::Call:
+        return 2 + static_cast<size_t>((head >> 8) & 0xffffff);
+    }
+    return 1;
+}
+
+size_t GpuSplit::ExecuteCaught(const u64* entry, size_t words) {
+    try {
+        return Execute(entry, words);
+    } catch (const std::bad_alloc&) {
+        const u64 head = entry[0];
+        const u32 kind = static_cast<u32>(head & 0xf);
+        const u32 method = kind == static_cast<u32>(Kind::Method) ||
+                                   kind == static_cast<u32>(Kind::Multi)
+                               ? static_cast<u32>((head >> 8) & 0xffff)
+                               : 0;
+        if (!GpuBadAllocBackstop::Absorb("back", method, kind)) {
+            throw;
+        }
+        // A deferred function (Call) is not the engine's: the engine is left alone then.
+        if (auto* const engine = back_engine;
+            engine != nullptr && kind != static_cast<u32>(Kind::Call)) {
+            // Register writes a throw in ConsumeSink left queued would run again with the next
+            // method: drop them with the call. A Maxwell3D binds all of its state again at the
+            // next draw (its dirty flags may have been cleared for state it never bound).
+            engine->method_sink.clear();
+            if (engine->hang_engine_type == Tegra::Engines::EngineTypes::Maxwell3D) {
+                static_cast<Tegra::Engines::Maxwell3D*>(engine)->dirty.flags.set();
+            }
+        }
+        return EntryWords(entry, words);
+    }
+}
