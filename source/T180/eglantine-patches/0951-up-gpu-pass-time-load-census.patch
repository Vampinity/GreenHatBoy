+++ b/src/common/nx2_load_census.h
@@ -0,0 +1,197 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+// EDEN_UP_GPU_PASS_TIME=1 (patch 0951, log only; read once): what the game loads, so that a
+// steady stream of loads can be told apart from the same files loaded again. Each source counts
+// its events and keeps, per file, when it was last seen; an event whose file was seen less than
+// 60 s before counts as a repeat. Files are named where a name is known (fs opens and file
+// reads), else by offset and length (storage reads) or by the size and a hash of the first 64
+// compressed bytes (zstd decodes). At most one line group per 10 s ("EDEN_UP_LOAD_CENSUS"),
+// written by whichever thread notes the first event after the 10 s, with the top 3 repeated files
+// of each source. Unset: Enabled() is one test of a static bool and nothing else runs.
+
+#include <algorithm>
+#include <array>
+#include <chrono>
+#include <cstddef>
+#include <cstring>
+#include <mutex>
+#include <string>
+#include <string_view>
+#include <unordered_map>
+#include <vector>
+
+#include "common/common_types.h"
+#include "common/logging.h"
+#include "common/pe_switch.h"
+
+namespace Common::Nx2LoadCensus {
+
+enum class Source : u8 {
+    PollLoads,   ///< loads the OoT resource request thread issued (svc 0xF3, counts only)
+    ZstdOneShot, ///< ZSTD_decompressMultiFrame calls (svc 0xF0-0xF2), by size + first bytes
+    ZstdStream,  ///< zstd streams started (svc 0xF4, phase 1), by first chunk size + first bytes
+    FsOpen,      ///< IFileSystem::OpenFile, by path
+    FsFileRead,  ///< IFile::Read, by file name + offset + length
+    StorageRead, ///< IStorage::Read, by offset + length
+    Count,
+};
+
+inline bool Enabled() noexcept {
+    static const bool enabled = Common::PeSwitch("EDEN_UP_GPU_PASS_TIME");
+    return enabled;
+}
+
+inline u64 Hash(const void* data, size_t size, u64 seed = 0xcbf29ce484222325ULL) noexcept {
+    const auto* bytes = static_cast<const u8*>(data);
+    u64 hash = seed;
+    for (size_t i = 0; i < size; ++i) {
+        hash = (hash ^ bytes[i]) * 0x100000001b3ULL;
+    }
+    return hash;
+}
+
+inline u64 Mix(u64 a, u64 b) noexcept {
+    return Hash(&b, sizeof(b), a);
+}
+
+namespace Detail {
+constexpr long long kWindowNs = 10'000'000'000LL;
+constexpr long long kRepeatNs = 60'000'000'000LL;
+constexpr size_t kMaxEntries = 32768;
+constexpr size_t kSources = static_cast<size_t>(Source::Count);
+constexpr std::array<const char*, kSources> kNames{"poll loads", "zstd one-shot", "zstd streams",
+                                                   "fs opens", "fs file reads", "storage reads"};
+
+struct Entry {
+    long long last_ns{};
+    u32 window{};  ///< events in this 10 s window
+    u32 repeats{}; ///< of those, seen again within 60 s
+    std::string name;
+};
+struct SourceState {
+    u64 events{}, count{}, repeats{}, bytes{}, untracked{};
+    std::unordered_map<u64, Entry> seen;
+};
+struct State {
+    std::mutex mutex;
+    std::array<SourceState, kSources> sources;
+    long long window_start{};
+};
+inline State& Get() {
+    static State state;
+    return state;
+}
+inline long long NowNs() {
+    return std::chrono::duration_cast<std::chrono::nanoseconds>(
+               std::chrono::steady_clock::now().time_since_epoch())
+        .count();
+}
+
+// Under the mutex.
+inline void Report(State& state, long long now) {
+    const double secs = static_cast<double>(now - state.window_start) / 1e9;
+    for (size_t s = 0; s < kSources; ++s) {
+        SourceState& source = state.sources[s];
+        if (source.events == 0) {
+            continue;
+        }
+        size_t distinct = 0, distinct_repeated = 0;
+        std::vector<std::pair<u32, const Entry*>> top;
+        for (const auto& [key, entry] : source.seen) {
+            if (entry.window == 0) {
+                continue;
+            }
+            ++distinct;
+            if (entry.repeats != 0) {
+                ++distinct_repeated;
+                top.emplace_back(entry.repeats, &entry);
+            }
+        }
+        const size_t shown = (std::min<size_t>)(top.size(), 3);
+        std::partial_sort(top.begin(), top.begin() + static_cast<std::ptrdiff_t>(shown), top.end(),
+                          [](const auto& a, const auto& b) { return a.first > b.first; });
+        std::string names;
+        for (size_t i = 0; i < shown; ++i) {
+            names += fmt::format("{}{} x{} (+{} again)", i ? "; " : "", top[i].second->name,
+                                 top[i].second->window, top[i].first);
+        }
+        if (s == static_cast<size_t>(Source::PollLoads)) {
+            LOG_INFO(Kernel_SVC,
+                     "EDEN_UP_LOAD_CENSUS {:.1f} s: {}: {} walks issued {} loads ({:.1f}/s)", secs,
+                     kNames[s], source.events, source.count,
+                     secs > 0 ? static_cast<double>(source.count) / secs : 0.0);
+        } else {
+            LOG_INFO(Kernel_SVC,
+                     "EDEN_UP_LOAD_CENSUS {:.1f} s: {}: {} ({:.1f}/s), {} MiB, {} distinct, {} seen "
+                     "again within 60 s ({} distinct), {} untracked; top: {}",
+                     secs, kNames[s], source.events,
+                     secs > 0 ? static_cast<double>(source.events) / secs : 0.0,
+                     source.bytes >> 20, distinct, source.repeats, distinct_repeated,
+                     source.untracked, names.empty() ? std::string{"none"} : names);
+        }
+        source.events = source.count = source.repeats = source.bytes = source.untracked = 0;
+        for (auto it = source.seen.begin(); it != source.seen.end();) {
+            if (now - it->second.last_ns > kRepeatNs) {
+                it = source.seen.erase(it);
+            } else {
+                it->second.window = 0;
+                it->second.repeats = 0;
+                ++it;
+            }
+        }
+    }
+    state.window_start = now;
+}
+} // namespace Detail
+
+/// One event: `key` identifies the file (0: count only), `count` adds to the source's count
+/// (loads for PollLoads), `bytes` to its bytes; `name()` (a std::string) is called and kept only
+/// the first time the key is seen.
+template <typename NameFn>
+void Note(Source which, u64 key, u64 bytes, u64 count, NameFn&& name) {
+    if (!Enabled()) {
+        return;
+    }
+    using namespace Detail;
+    State& state = Get();
+    const long long now = NowNs();
+    std::scoped_lock lock{state.mutex};
+    if (state.window_start == 0) {
+        state.window_start = now;
+    }
+    SourceState& source = state.sources[static_cast<size_t>(which)];
+    ++source.events;
+    source.count += count;
+    source.bytes += bytes;
+    if (key != 0) {
+        auto it = source.seen.find(key);
+        if (it == source.seen.end()) {
+            if (source.seen.size() >= kMaxEntries) {
+                ++source.untracked;
+            } else {
+                it = source.seen.emplace(key, Entry{.last_ns = now, .window = 0, .repeats = 0,
+                                                    .name = std::string{name()}})
+                         .first;
+            }
+        } else if (now - it->second.last_ns <= kRepeatNs) {
+            ++source.repeats;
+            ++it->second.repeats;
+        }
+        if (it != source.seen.end()) {
+            ++it->second.window;
+            it->second.last_ns = now;
+        }
+    }
+    if (now - state.window_start >= kWindowNs) {
+        try {
+            Report(state, now);
+        } catch (const std::bad_alloc&) {
+            state.window_start = now;
+        }
+    }
+}
+
+} // namespace Common::Nx2LoadCensus
