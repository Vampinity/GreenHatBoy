+// Patch 0951 (EDEN_UP_GPU_PASS_TIME=1, common/nx2_load_census.h): notes a zstd input by its size
+// and the hash of its first 64 bytes. `out_bytes` is what the census adds up (the output capacity
+// for a one-shot call, the chunk for a stream).
+void NoteCensus(Core::Memory::Memory& memory, Common::Nx2LoadCensus::Source source, u64 src,
+                u64 size, u64 out_bytes) {
+    std::array<u8, 64> head{};
+    const size_t n = static_cast<size_t>(std::min<u64>(size, head.size()));
+    if (n == 0 || !memory.IsValidVirtualAddressRange(src, n)) {
+        return;
+    }
+    memory.ReadBlock(src, head.data(), n);
+    const u64 key = Common::Nx2LoadCensus::Mix(Common::Nx2LoadCensus::Hash(head.data(), n), size);
+    try {
+        Common::Nx2LoadCensus::Note(source, key | 1, out_bytes, 1, [key, size] {
+            return fmt::format("zstd {:016x} {} B", key | 1, size);
+        });
+    } catch (const std::bad_alloc&) {
+    }
+}
