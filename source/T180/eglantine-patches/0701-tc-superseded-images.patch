+++ b/src/video_core/texture_cache/texture_cache.h
@@ -2214,6 +2214,7 @@ void TextureCache<P>::TickFrame() {
     // EDEN_UP_STALE_TARGETS: before the area evict and the collector, so they never see what it
     // deletes (each image goes once, counted once, by whichever pass deletes it).
     RetireStaleTargets();
+    DeleteSupersededImages(); // EDEN_NX2_TC_SUPERSEDED
     AreaEvict();
     if (total_used_memory > minimum_memory) {
         HitchTrace::Op collector_trace{HitchTrace::Kind::Collector, total_used_memory, {}};
@@ -2488,6 +2489,167 @@ void TextureCache<P>::CollectStaleReferences() {
 /// target, not CPU-written) goes with it. At most 512 deletions a frame; a scan examines at most
 /// 4,096 candidates and the next one resumes behind them (RomainROCH's review point on #1571:
 /// kept candidates at the old end of the LRU must not hold every scan in front of them).
+// EDEN_NX2_TC_SUPERSEDED=1 (exact "1"; sbihaiko, Lichii #1314): see DeleteSupersededImages.
+[[nodiscard]] inline bool SupersededImagesEnabled() noexcept {
+    static const bool enabled = Common::PeSwitch("EDEN_NX2_TC_SUPERSEDED");
+    return enabled;
+}
+
+// EDEN_NX2_TC_SUPERSEDED=1 (sbihaiko, after zortos293/Lichii #1314): the game moves its render
+// targets within a memory pool every frame while the camera moves (about 45 images a frame in a
+// later area's guard house). The old images stayed registered until the age-based collector
+// reached them, far slower than they arrived. Once an image's memory belongs entirely to newer
+// images (ClassifySuperseded: covered by images used after it; when it holds GPU data, by images
+// that cleared themselves whole after its last write) nothing can read it any more, and it is
+// deleted once unused for 2 frames. Ours: never an image a queued download, an asynchronous
+// decode or unswizzle, a bound render target or one of the last four presents still needs (as
+// EDEN_UP_STALE_TARGETS keeps them, CollectStaleReferences). Runs only in frames near a new bad overlap or a whole clear,
+// Switch 2 titles only. Line every 600 frames: what went, and what stayed for lack of proof.
+template <class P>
+void TextureCache<P>::DeleteSupersededImages() {
+    static constexpr u64 MinFramesUnused = 2;
+    if (!SupersededImagesEnabled() || !Tegra::g_nx2_ampere.load(std::memory_order_relaxed)) {
+        return;
+    }
+    if (frame_tick % 600 == 0 &&
+        (superseded_clean_deletes | superseded_rewritten_deletes | superseded_unproven) != 0) {
+        LOG_INFO(HW_GPU,
+                 "EDEN_NX2_TC_SUPERSEDED last 600 frames: superseded images deleted {} ({} held "
+                 "GPU data rewritten by newer images); GPU-written candidates without that proof, "
+                 "summed over frames: {}; kept as still needed (download, decode, bound, "
+                 "presented): {}",
+                 superseded_clean_deletes + superseded_rewritten_deletes,
+                 superseded_rewritten_deletes, superseded_unproven, superseded_kept_needed);
+        superseded_clean_deletes = superseded_rewritten_deletes = superseded_unproven = 0;
+        superseded_kept_needed = 0;
+    }
+    if (frame_tick <= MinFramesUnused ||
+        frame_tick - superseded_activity_frame > MinFramesUnused + 1) {
+        return;
+    }
+    superseded_ids.clear();
+    // Ours: what a queued download, an asynchronous decode or unswizzle, a bound render target or
+    // one of the last presents still needs stays (0650's CollectStaleReferences).
+    CollectStaleReferences();
+    lru_cache.ForEachItemBelow(frame_tick - MinFramesUnused, [this](ImageId image_id) {
+        const Image& image = slot_images[image_id];
+        if (image.overlapping_images.empty()) {
+            return false;
+        }
+        switch (ClassifySuperseded(slot_images, image)) {
+        case Supersession::Clean:
+        case Supersession::Rewritten:
+            if (stale_references.contains(image_id)) {
+                ++superseded_kept_needed;
+                break;
+            }
+            superseded_ids.push_back(image_id);
+            break;
+        case Supersession::Unproven:
+            ++superseded_unproven;
+            break;
+        case Supersession::None:
+            break;
+        }
+        return false;
+    });
+    for (const ImageId image_id : superseded_ids) {
+        Image& image = slot_images[image_id];
+        ++(image.IsSafeGpuCopy() ? superseded_rewritten_deletes : superseded_clean_deletes);
+        // Not marked stale (MarkStale): the covering images hold the bytes, and marking their
+        // pages would let an image made over them skip its upload without being filled.
+        if (True(image.flags & ImageFlagBits::Tracked)) {
+            UntrackImage(image, image_id);
+        }
+        UnregisterImage(image_id);
+        trace_delete_reason = "superseded";
+        DeleteImage(image_id, image.scale_tick > frame_tick + 5);
+    }
+}
+
+template <class P>
+bool TextureCache<P>::ClearOverwritesWhole(const ImageInfo& new_info, GPUVAddr gpu_addr) const {
+    if (new_info.type != ImageType::e2D || new_info.resources.levels != 1 ||
+        new_info.resources.layers != 1 || new_info.num_samples != 1) {
+        return false;
+    }
+    const auto& regs = maxwell3d->regs;
+    const auto& surface = regs.clear_surface;
+    if (surface.layer != 0) {
+        return false;
+    }
+    const u32 width = new_info.size.width;
+    const u32 height = new_info.size.height;
+    // The render area is the surface clip's size, and a scissored clear must cover the image
+    // (with a lower-left window origin the scissor is flipped around the clip's height).
+    if (regs.surface_clip.width < width || regs.surface_clip.height < height) {
+        return false;
+    }
+    if (regs.clear_control.use_scissor != 0) {
+        const auto& scissor = regs.scissor_test[0];
+        const bool lower_left = regs.window_origin.mode !=
+                                Tegra::Engines::Maxwell3D::Regs::WindowOrigin::Mode::UpperLeft;
+        const s32 clip_height = static_cast<s32>(regs.surface_clip.height.Value());
+        const s32 min_y = static_cast<s32>(scissor.min_y.Value());
+        const s32 max_y = static_cast<s32>(scissor.max_y.Value());
+        const s32 top = lower_left ? clip_height - max_y : min_y;
+        const s32 bottom = lower_left ? clip_height - min_y : max_y;
+        if (scissor.min_x != 0 || top > 0 || scissor.max_x < width ||
+            bottom < static_cast<s32>(height)) {
+            return false;
+        }
+    }
+    // The clear covers the framebuffer's render area, the smallest bound target.
+    for (u32 index = 0; index < regs.rt_control.count && index < NUM_RT; ++index) {
+        const auto& rt = regs.rt[index];
+        if (rt.Address() != 0 && rt.format != Tegra::RenderTargetFormat::NONE &&
+            (rt.width < width || rt.height < height)) {
+            return false;
+        }
+    }
+    if (regs.zeta_enable && regs.zeta.Address() != 0 &&
+        (regs.zeta_size.width < width || regs.zeta_size.height < height)) {
+        return false;
+    }
+    const bool is_depth_target = regs.zeta_enable && regs.zeta.Address() == gpu_addr;
+    const bool full_stencil = surface.S && regs.stencil_front_mask == 0xFF;
+    switch (VideoCore::Surface::GetFormatType(new_info.format)) {
+    case VideoCore::Surface::SurfaceType::ColorTexture: {
+        const u32 index = surface.RT;
+        return surface.R && surface.G && surface.B && surface.A && index < NUM_RT &&
+               index < regs.rt_control.count && regs.rt_control.Map(index) == index &&
+               regs.rt[index].Address() == gpu_addr;
+    }
+    case VideoCore::Surface::SurfaceType::Depth:
+        return is_depth_target && surface.Z;
+    case VideoCore::Surface::SurfaceType::Stencil:
+        return is_depth_target && full_stencil;
+    case VideoCore::Surface::SurfaceType::DepthStencil:
+        return is_depth_target && surface.Z && full_stencil;
+    default:
+        return false;
+    }
+}
+
+template <class P>
+void TextureCache<P>::NoteWholeClears() {
+    const auto note = [this](ImageViewId view_id) {
+        if (!PreparesImage(slot_image_views, view_id)) {
+            return;
+        }
+        Image& image = slot_images[slot_image_views[view_id].image_id];
+        if (slot_image_views[view_id].size == image.info.size &&
+            ClearOverwritesWhole(image.info, image.gpu_addr)) {
+            image.full_write_tick = image.modification_tick;
+            superseded_activity_frame = frame_tick;
+        }
+    };
+    for (const ImageViewId view_id : render_targets.color_buffer_ids) {
+        note(view_id);
+    }
+    note(render_targets.depth_buffer_id);
+}
