@@ -4113,8 +4281,9 @@ std::pair<typename P::ImageView*, bool> TextureCache<P>::TryFindFramebufferImage
     }
 
     const auto GetImageViewForFramebuffer = [&](ImageId image_id) {
-        if (StaleTargetFrames() != 0) {
-            // EDEN_UP_STALE_TARGETS: a held frame is never deleted while it is still shown.
+        if (StaleTargetFrames() != 0 || SupersededImagesEnabled()) {
+            // EDEN_UP_STALE_TARGETS / EDEN_NX2_TC_SUPERSEDED: a held frame is never deleted while
+            // it is still shown.
             stale_presented[stale_presented_next] = image_id;
             stale_presented_next = (stale_presented_next + 1) % stale_presented.size();
         }
@@ -6794,6 +6963,9 @@ ImageId TextureCache<P>::JoinImages(const ImageInfo& info, GPUVAddr gpu_addr, DA
         join_alias_indices.emplace(aliased_id, alias_index);
         new_image.flags |= ImageFlagBits::Alias;
     }
+    if (!join_bad_overlap_ids.empty() && SupersededImagesEnabled()) {
+        superseded_activity_frame = frame_tick;
+    }
     for (const ImageId aliased_id : join_bad_overlap_ids) {
         ImageBase& aliased = slot_images[aliased_id];
         aliased.overlapping_images.push_back(new_image_id);
@@ -8358,6 +8530,9 @@ void TextureCache<P>::PrepareImage(ImageId image_id, bool is_modification, bool
         MarkModification(image);
     }
     lru_cache.Touch(image.lru_index, frame_tick);
+    if (SupersededImagesEnabled()) {
+        image.last_use_frame = frame_tick;
+    }
 }
 
