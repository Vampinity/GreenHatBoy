+    /// EDEN_UP_FIRST_START_LIST_WRITE=1 (needs EDEN_UP_CANONICAL_KEYS=1; off: one bool test per
+    /// first use of a pipeline and per compute dispatch of a known one): the pipelines this
+    /// session used, in first-use order, as kind + 64-bit key hash (CityHash64 of the key; no
+    /// code, no state bytes), written to <title>/first_start.list every 30 s while it grows and
+    /// at shutdown. GPU thread only; the file is written on the serialization thread.
+    struct FirstStartRow {
+        char kind; ///< G graphics, M graphics with a task/mesh stage, C compute, T time mark
+        u64 value; ///< key hash, or for T the seconds since this cache was made
+        u64 count; ///< for T: rows before it
+    };
+    bool first_start_write{};
+    bool first_start_valid{true};
+    bool first_start_rotated{};
+    size_t first_start_written{};
+    std::vector<FirstStartRow> first_start_rows;
+    std::unordered_set<u64> first_start_graphics;
+    std::unordered_set<u64> first_start_compute;
+    std::chrono::steady_clock::time_point first_start_begin{};
+    std::chrono::steady_clock::time_point first_start_saved{};
+    void NoteFirstStartPipeline(char kind, u64 hash) noexcept;
+    void WriteFirstStartList(bool final);
+
     [[no_unique_address]] BuildBurst::Lifetime burst_lifetime;
     Common::ThreadWorker workers;
     Common::ThreadWorker serialization_thread;
