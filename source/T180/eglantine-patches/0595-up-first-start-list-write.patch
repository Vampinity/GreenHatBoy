+// EDEN_UP_FIRST_START_LIST_WRITE=1 -----------------------------------------------------------
+// Ported from a draft (12 Nov 2026), remade after two reviews: the
+// list is also written every 30 s (a start that dies at the door leaves one), the header names
+// what the hashes depend on so a reader can refuse a list of another build or key policy, mesh
+// pipelines are marked M (the set cannot prepare them), and T rows mark time so a list can be cut
+// by hand at the door. No area marks: there is no area-load event to call (S1b's
+// NotifyFirstStartAreaLoad had no caller and is not ported). The previous session's list is kept
+// as first_start.prev.list.
+
+namespace {
+constexpr size_t FirstStartMaxRows = 65536;
+} // namespace
+
+void PipelineCache::NoteFirstStartPipeline(char kind, u64 hash) noexcept {
+    if (!first_start_valid) {
+        return;
+    }
+    try {
+        auto& seen = kind == 'C' ? first_start_compute : first_start_graphics;
+        if (seen.contains(hash)) {
+            return;
+        }
+        if (first_start_rows.size() >= FirstStartMaxRows) {
+            first_start_valid = false;
+            LOG_WARNING(Render_Vulkan, "EDEN_UP_FIRST_START_LIST_WRITE: {} rows, the list stops "
+                                       "growing (what it holds is still written)",
+                        FirstStartMaxRows);
+            return;
+        }
+        seen.insert(hash);
+        first_start_rows.push_back({kind, hash, 0});
+    } catch (const std::bad_alloc&) {
+        first_start_valid = false;
+    }
+}
+
+void PipelineCache::WriteFirstStartList(bool final) try {
+    const auto now = std::chrono::steady_clock::now();
+    first_start_saved = now;
+    if (pipeline_cache_filename.empty()) {
+        return;
+    }
+    const u64 seconds = static_cast<u64>(
+        std::chrono::duration_cast<std::chrono::seconds>(now - first_start_begin).count());
+    if (first_start_rows.size() < FirstStartMaxRows + 64) {
+        first_start_rows.push_back({'T', seconds, first_start_rows.size()});
+    }
+    first_start_written = first_start_rows.size();
+    // What the hashes depend on: a list made under other values names other pipelines.
+    std::string text = fmt::format(
+        "EDEN_FIRST_START_2 cache={} driver={:x}.{:x} canonical={} static_vertex={} "
+        "title={:016x} lowering={:016x}\n"
+        "# G/M/C <CityHash64 of the pipeline key>: first use (M: task/mesh stage); "
+        "T <seconds since start> <rows before>. No code, no state bytes.\n",
+        CACHE_VERSION, static_cast<u32>(device.GetDriverID()), device.GetDriverVersion(),
+        canonical_keys ? 1 : 0, StaticVertexInputEnabled() ? 1 : 0, visual_workaround_title,
+        ShaderSetLoweringTag);
+    size_t graphics = 0, mesh = 0, compute = 0;
+    for (const FirstStartRow& row : first_start_rows) {
+        if (row.kind == 'T') {
+            text += fmt::format("T {} {}\n", row.value, row.count);
+            continue;
+        }
+        graphics += row.kind == 'G' ? 1 : 0;
+        mesh += row.kind == 'M' ? 1 : 0;
+        compute += row.kind == 'C' ? 1 : 0;
+        text += fmt::format("{} {:016x}\n", row.kind, row.value);
+    }
+    const auto path = pipeline_cache_filename.parent_path() / "first_start.list";
+    const bool rotate = !std::exchange(first_start_rotated, true);
+    serialization_thread.QueueWork([path, rotate, final, graphics, mesh, compute,
+                                    complete = first_start_valid, text = std::move(text)] {
+        std::error_code error;
+        if (rotate && std::filesystem::exists(path, error)) {
+            auto previous = path;
+            previous.replace_filename("first_start.prev.list");
+            std::filesystem::rename(path, previous, error);
+        }
+        auto partial = path;
+        partial += ".part";
+        bool written = false;
+        {
+            std::ofstream out{partial, std::ios::binary | std::ios::trunc};
+            written = static_cast<bool>(out.write(text.data(),
+                                                  static_cast<std::streamsize>(text.size()))) &&
+                      static_cast<bool>(out.flush());
+        }
+        if (written) {
+            std::filesystem::rename(partial, path, error);
+        }
+        if (!written || error) {
+            std::filesystem::remove(partial, error);
+        }
+        if (final || !written || error) {
+            LOG_INFO(Render_Vulkan,
+                     "EDEN_UP_FIRST_START_LIST_WRITE: {} graphics, {} mesh, {} compute{}{}{}",
+                     graphics, mesh, compute, final ? " (shutdown)" : "",
+                     complete ? "" : " (incomplete: the row cap or memory stopped it)",
+                     written && !error ? "" : " (NOT written)");
+        }
+    });
+} catch (const std::exception&) {
+    first_start_valid = false;
+    LOG_WARNING(Render_Vulkan, "EDEN_UP_FIRST_START_LIST_WRITE: the list could not be made");
+}
