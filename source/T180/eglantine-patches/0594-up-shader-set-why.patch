+// EDEN_UP_SHADER_SET_WHY=1 ------------------------------------------------------------------
+// Ported from a draft (12 Nov 2026), remade after two reviews: no full
+// keys are kept (per-field digests instead), near-miss candidates are capped, totals print with
+// every audit line (a start that dies at the door still leaves them), a refused record is told
+// apart from one not prepared yet, own records are not counted as the set's, and mesh keys are
+// counted on their own (the set has no mesh records, so they can never be hits).
+
+namespace {
+struct SetWhyRange {
+    const char* name;
+    size_t offset;
+    size_t size;
+};
+#define SET_WHY_FIELD(member)                                                                      \
+    SetWhyRange {                                                                                  \
+        #member, offsetof(FixedPipelineState, member), sizeof(FixedPipelineState::member)          \
+    }
+constexpr std::array<SetWhyRange, 19> SetWhyRanges{{
+    SET_WHY_FIELD(raw1), SET_WHY_FIELD(raw2), SET_WHY_FIELD(color_formats),
+    SET_WHY_FIELD(driver_id), SET_WHY_FIELD(driver_version), SET_WHY_FIELD(alpha_test_ref),
+    SET_WHY_FIELD(point_size), SET_WHY_FIELD(viewport_swizzles), SET_WHY_FIELD(attribute_types),
+    SET_WHY_FIELD(dynamic_state), SET_WHY_FIELD(attachments), SET_WHY_FIELD(attributes),
+    SET_WHY_FIELD(binding_divisors), SET_WHY_FIELD(vertex_strides), SET_WHY_FIELD(xfb_state),
+    SET_WHY_FIELD(depth_bounds_min), SET_WHY_FIELD(depth_bounds_max),
+    SET_WHY_FIELD(line_stipple_factor), SET_WHY_FIELD(line_stipple_pattern),
+}};
+#undef SET_WHY_FIELD
+constexpr bool SetWhyRangesCover() {
+    size_t at = 0;
+    for (const SetWhyRange& range : SetWhyRanges) {
+        if (range.offset != at) {
+            return false;
+        }
+        at += range.size;
+    }
+    return at == sizeof(FixedPipelineState);
+}
+// A field added to FixedPipelineState has to be listed above.
+static_assert(SetWhyRangesCover(), "FixedPipelineState changed: list its fields in SetWhyRanges");
+
+/// One digest per field, of the bytes of the field that are inside the key (0: none are).
+std::array<u16, 19> SetWhyDigests(const FixedPipelineState& state) {
+    std::array<u16, 19> out{};
+    const auto* bytes = reinterpret_cast<const char*>(&state);
+    const size_t size = state.Size();
+    for (size_t field = 0; field < SetWhyRanges.size(); ++field) {
+        const SetWhyRange& range = SetWhyRanges[field];
+        if (range.offset >= size) {
+            continue;
+        }
+        const size_t length = std::min(range.size, size - range.offset);
+        const u64 hash = Common::CityHash64(bytes + range.offset, length);
+        out[field] = static_cast<u16>((hash ^ (hash >> 16) ^ (hash >> 32) ^ (hash >> 48)) | 1);
+    }
+    return out;
+}
+
+u64 SetWhyTuple(const std::array<u64, 6>& hashes) {
+    return Common::CityHash64(reinterpret_cast<const char*>(hashes.data()),
+                              hashes.size() * sizeof(u64));
+}
+
+size_t SetWhyNumber(const char* name, size_t fallback) {
+    const char* const value = std::getenv(name);
+    if (value == nullptr || *value == '\0') {
+        return fallback;
+    }
+    char* end = nullptr;
+    const unsigned long long number = std::strtoull(value, &end, 10);
+    return end != nullptr && *end == '\0' ? static_cast<size_t>(number) : fallback;
+}
+} // namespace
+
+void PipelineCache::IndexShaderSetWhy(const std::filesystem::path& file,
+                                      std::stop_token stop) try {
+    const auto begin = std::chrono::steady_clock::now();
+    auto catalogue = std::make_shared<SetWhyCatalogue>();
+    const bool complete = VideoCommon::ShaderSet::ReadRecords(
+        file, CACHE_VERSION, [](std::ifstream&, std::vector<VideoCommon::FileEnvironment>) {},
+        {},
+        [&](std::span<const u8> bytes) {
+            if (stop.stop_requested()) {
+                throw std::runtime_error("stopped at shutdown");
+            }
+            if (bytes.size() != sizeof(GraphicsPipelineCacheKey)) {
+                throw std::runtime_error("a record's key has another size");
+            }
+            GraphicsPipelineCacheKey key;
+            std::memcpy(&key, bytes.data(), sizeof(key));
+            CanonicalizeKeyState(key.state, dynamic_features);
+            const u32 entry = static_cast<u32>(catalogue->fields.size());
+            catalogue->keys.push_back(key.Hash());
+            catalogue->tuples.emplace_back(SetWhyTuple(key.unique_hashes), entry);
+            catalogue->fields.push_back(SetWhyDigests(key.state));
+            return false; // keys only: no record's environments are built
+        });
+    if (!complete || catalogue->keys.empty()) {
+        LOG_WARNING(Render_Vulkan, "EDEN_UP_SHADER_SET_WHY: the catalogue is incomplete ({} "
+                                   "records read); no counts this session",
+                    catalogue->keys.size());
+        set_why_failed.store(true, std::memory_order_release);
+        return;
+    }
+    std::ranges::sort(catalogue->keys);
+    std::ranges::sort(catalogue->tuples);
+    catalogue->keys.shrink_to_fit();
+    catalogue->tuples.shrink_to_fit();
+    catalogue->fields.shrink_to_fit();
+    const size_t bytes = catalogue->keys.size() * sizeof(u64) +
+                         catalogue->tuples.size() * sizeof(std::pair<u64, u32>) +
+                         catalogue->fields.size() * sizeof(std::array<u16, SetWhyFieldCount>);
+    LOG_INFO(Render_Vulkan,
+             "EDEN_UP_SHADER_SET_WHY: catalogue of {} records ({} KiB) in {:.1f} s; mesh records "
+             "are not in the set, so mesh keys are counted apart",
+             catalogue->keys.size(), bytes >> 10,
+             std::chrono::duration<double>(std::chrono::steady_clock::now() - begin).count());
+    std::scoped_lock lock{shader_set_mutex};
+    set_why_catalogue = std::move(catalogue);
+} catch (const std::exception& e) {
+    LOG_WARNING(Render_Vulkan, "EDEN_UP_SHADER_SET_WHY: no catalogue ({}); no counts this session",
+                e.what());
+    set_why_failed.store(true, std::memory_order_release);
+}
+
+void PipelineCache::StopShaderSetWhyIfFailed() {
+    if (!set_why_valid || !set_why_failed.load(std::memory_order_acquire)) {
+        return;
+    }
+    // No catalogue will come this session: stop sampling and let the waiting samples go.
+    set_why_valid = false;
+    set_why.dropped += set_why_pending.size();
+    std::vector<SetWhySample>{}.swap(set_why_pending);
+}
+
+void PipelineCache::NoteShaderSetWhy(const GraphicsEnvironments& environments) {
+    ++set_why.asked;
+    StopShaderSetWhyIfFailed();
+    if (!set_why_valid) {
+        return;
+    }
+    if (set_why_pending.size() >= 4096) {
+        ++set_why.dropped;
+        return;
+    }
+    bool mesh = false;
+    for (const Shader::Environment* const env : environments.Span()) {
+        mesh = mesh || env->ShaderStage() == Shader::Stage::Task ||
+               env->ShaderStage() == Shader::Stage::Mesh;
+    }
+    try {
+        set_why_pending.push_back({graphics_key.Hash(), graphics_key.unique_hashes,
+                                   SetWhyDigests(graphics_key.state), set_why_found,
+                                   set_why_accepted, mesh});
+    } catch (const std::bad_alloc&) {
+        set_why_valid = false;
+        return;
+    }
+    DrainShaderSetWhy(false, false);
+}
+
+void PipelineCache::DrainShaderSetWhy(bool final, bool print) try {
+    static_assert(SetWhyFieldCount == SetWhyRanges.size());
+    StopShaderSetWhyIfFailed();
+    std::shared_ptr<const SetWhyCatalogue> catalogue;
+    {
+        std::scoped_lock lock{shader_set_mutex};
+        catalogue = set_why_catalogue;
+    }
+    static const size_t max_lines = SetWhyNumber("EDEN_UP_SHADER_SET_WHY_LINES", 200);
+    static const size_t max_candidates =
+        std::max<size_t>(1, SetWhyNumber("EDEN_UP_SHADER_SET_WHY_NEAR", 64));
+    std::shared_ptr<const std::unordered_set<u64>> programs;
+    if (catalogue && !set_why_pending.empty()) {
+        std::scoped_lock lock{shader_set_mutex};
+        programs = shader_set_programs;
+    }
+    for (size_t index = 0; catalogue && index < set_why_pending.size(); ++index) {
+        const SetWhySample& sample = set_why_pending[index];
+        if (sample.mesh) {
+            ++set_why.mesh;
+            continue;
+        }
+        const bool exact = std::ranges::binary_search(catalogue->keys, sample.key_hash);
+        if (sample.accepted) {
+            if (sample.found == SetWhyFound::Set) {
+                ++(exact ? set_why.hit_fair : set_why.hit_set_unlisted);
+            } else {
+                ++set_why.hit_own;
+                set_why.hit_own_in_set += exact ? 1 : 0;
+            }
+            continue;
+        }
+        if (exact) {
+            switch (sample.found) {
+            case SetWhyFound::StoreClosed:
+                ++set_why.exact_no_store;
+                break;
+            case SetWhyFound::NotStored:
+                ++set_why.exact_not_prepared;
+                break;
+            default:
+                ++set_why.exact_refused;
+                break;
+            }
+            continue;
+        }
+        const u64 tuple = SetWhyTuple(sample.programs);
+        auto range = std::ranges::equal_range(
+            catalogue->tuples, std::pair<u64, u32>{tuple, 0},
+            [](const auto& a, const auto& b) { return a.first < b.first; });
+        if (range.begin() == range.end()) {
+            bool all_known = programs != nullptr;
+            for (const u64 program : sample.programs) {
+                all_known = all_known && (program == 0 || programs->contains(program));
+            }
+            ++(all_known ? set_why.no_record_known : set_why.no_record_unknown);
+            continue;
+        }
+        ++set_why.near;
+        const auto& live = sample.fields;
+        size_t best_count = SetWhyFieldCount + 1;
+        u32 best_entry = 0;
+        size_t candidates = 0;
+        for (const auto& [ignored, entry] : range) {
+            if (candidates++ >= max_candidates) {
+                ++set_why.near_capped;
+                break;
+            }
+            const auto& other = catalogue->fields[entry];
+            size_t count = 0;
+            for (size_t field = 0; field < SetWhyFieldCount; ++field) {
+                count += live[field] != other[field] ? 1 : 0;
+            }
+            if (count < best_count) {
+                best_count = count;
+                best_entry = entry;
+            }
+        }
+        std::string names;
+        const auto& other = catalogue->fields[best_entry];
+        for (size_t field = 0; field < SetWhyFieldCount; ++field) {
+            if (live[field] != other[field]) {
+                ++set_why_fields[SetWhyRanges[field].name];
+                names += names.empty() ? "" : ",";
+                names += SetWhyRanges[field].name;
+            }
+        }
+        if (set_why.lines < max_lines) {
+            ++set_why.lines;
+            LOG_INFO(Render_Vulkan,
+                     "EDEN_UP_SHADER_SET_WHY near live={:016x} states_in_set={}{} closest differs "
+                     "in {}",
+                     sample.key_hash, std::distance(range.begin(), range.end()),
+                     candidates > max_candidates ? " (capped)" : "",
+                     names.empty() ? std::string{"nothing (digest clash)"} : names);
+        }
+    }
+    if (catalogue) {
+        set_why_pending.clear();
+    }
+    const u64 resolved = set_why.mesh + set_why.hit_fair + set_why.hit_own + set_why.hit_set_unlisted +
+                         set_why.exact_refused + set_why.exact_not_prepared +
+                         set_why.exact_no_store + set_why.near + set_why.no_record_known +
+                         set_why.no_record_unknown;
+    if (!print || (!final && set_why.asked == set_why_printed)) {
+        return;
+    }
+    set_why_printed = set_why.asked;
+    std::string fields;
+    for (const auto& [field, count] : set_why_fields) {
+        fields += fmt::format(" {}={}", field, count);
+    }
+    LOG_INFO(Render_Vulkan,
+             "EDEN_UP_SHADER_SET_WHY totals{}: asked={} resolved={} waiting={} dropped={} "
+             "mesh={} hit_fair={} hit_own={} (in set {}) hit_set_unlisted={} "
+             "exact_refused={} exact_not_prepared={} exact_no_store={} near={} (capped {}) "
+             "no_record={} (programs all in set {}, some not {}) hit_old={} catalogue={} "
+             "valid={}; near fields:{}",
+             final ? " (shutdown)" : "", set_why.asked, resolved, set_why_pending.size(),
+             set_why.dropped, set_why.mesh, set_why.hit_fair, set_why.hit_own,
+             set_why.hit_own_in_set, set_why.hit_set_unlisted, set_why.exact_refused,
+             set_why.exact_not_prepared, set_why.exact_no_store, set_why.near,
+             set_why.near_capped, set_why.no_record_known + set_why.no_record_unknown,
+             set_why.no_record_known, set_why.no_record_unknown,
+             audit_keys_hit.load(std::memory_order_relaxed), catalogue ? "ready" : "not yet",
+             set_why_valid, fields.empty() ? std::string{" none"} : fields);
+} catch (const std::exception&) {
+    set_why_valid = false;
+    LOG_WARNING(Render_Vulkan, "EDEN_UP_SHADER_SET_WHY: bookkeeping failed; counts stop here");
+}
+
 void PipelineCache::LogShaderSetAudit(bool final) {
     const auto now = std::chrono::steady_clock::now();
     if (!final && now - audit_logged < std::chrono::seconds{60}) {
@@ -5708,6 +6040,9 @@ void PipelineCache::LogShaderSetAudit(bool final) {
              audit_programs_total.load(std::memory_order_relaxed),
              audit_keys_hit.load(std::memory_order_relaxed),
              audit_keys_total.load(std::memory_order_relaxed), final ? " (shutdown)" : "");
+    if (shader_set_why) {
+        DrainShaderSetWhy(final);
+    }
     if (!final) {
         return;
     }
