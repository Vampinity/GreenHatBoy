 #include <memory>
@@ -499,6 +500,55 @@ private:
     std::atomic<u64> shader_set_live_serial{};
     std::chrono::steady_clock::time_point audit_logged{};
 
+    /// EDEN_UP_SHADER_SET_WHY=1 (needs EDEN_UP_SHADER_SET=1; off: one bool test per new graphics
+    /// pipeline, nothing allocated). A fair count of how the graphics keys the game asks for meet
+    /// the set's records, and the render-state fields that keep a near miss apart. The catalogue
+    /// keeps no keys: per record a key hash and one 16-bit digest per FixedPipelineState field
+    /// (about 64 bytes a record; 113,054 records: about 7 MiB). Made on the shader set's thread,
+    /// read under shader_set_mutex; everything else is the GPU thread's (and the destructor's).
+    static constexpr size_t SetWhyFieldCount = 19;
+    struct SetWhyCatalogue {
+        std::vector<u64> keys;                                  ///< sorted key hashes
+        std::vector<std::pair<u64, u32>> tuples;                ///< (program tuple hash, entry)
+        std::vector<std::array<u16, SetWhyFieldCount>> fields;  ///< per entry
+    };
+    /// What CreateKeptGraphicsPipeline found in the kept store for the key being made.
+    enum class SetWhyFound : u8 { StoreClosed, NotStored, Rejected, NotKeepable, Own, Set };
