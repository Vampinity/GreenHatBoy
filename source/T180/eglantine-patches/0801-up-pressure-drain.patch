--- /dev/null
+++ b/src/video_core/renderer_vulkan/pressure_drain.h
@@ -0,0 +1,213 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <algorithm>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+#include "common/common_types.h"
+#include "video_core/memory_census.h"
+
+/// EDEN_UP_PRESSURE_DRAIN (off unless set; RasterizerVulkan::PressureDrainLook and PressureDrain).
+///
+/// Deleted graphics memory does not go back at once. A deleted buffer stays in the buffer cache's
+/// DelayedDestructionRing until TICKS_TO_DESTROY (8) frame ends have passed, whatever the GPU did
+/// meanwhile; a deleted image stays in the texture cache's gpu_sentenced_images until the GPU is
+/// past it and the next frame end (or ReleaseFinished) looks; a finished staging buffer stays in
+/// the staging pool until the sweep reaches its level. At an area load a frame takes seconds, so
+/// none of it goes back during the load, at the moment memory is shortest.
+///
+///   EDEN_UP_PRESSURE_DRAIN=1      drains at the end of a frame and, inside a long frame, at the
+///                                 start of a draw or dispatch (before anything of it is set up)
+///   EDEN_UP_PRESSURE_DRAIN=2      drains at the end of a frame only
+///   EDEN_UP_PRESSURE_DRAIN_COUNT=1  counts only (what waits, the 10 s line, and a line with each
+///                                 refused-allocation report); no flush, no wait, nothing freed
+///   EDEN_UP_PRESSURE_DRAIN_MIB=<MiB>      the pool is short while its largest free piece is under
+///                                 this (unset: 256)
+///   EDEN_UP_PRESSURE_DRAIN_PENDING_MIB=<MiB>  a drain for a short pool only when at least this
+///                                 much deleted buffer memory waits (unset: 64; a refusal needs 1)
+///   EDEN_UP_PRESSURE_DRAIN_MS=<ms>        the longest wait for the GPU in one drain (unset: 80,
+///                                 at most 1000)
+///   EDEN_UP_PRESSURE_DRAIN_GAP_MS=<ms>    the shortest time between two drains (unset: 500; after a
+///                                 refusal a quarter of it)
+///
+/// A drain: the recording thread submits what it has recorded, waits at most _MS for the GPU to
+/// finish it, and when the GPU did, destroys every deleted buffer and every deleted image the GPU
+/// is past, at once (RasterizerVulkan::ReleaseFinishedMemory's work, without its unbounded wait),
+/// and lets the buffer cache ask again at once for a buffer memory refused. The staging pool's
+/// finished buffers go too, where the console's port has ReleaseCompleted. When the wait runs out,
+/// only what the GPU is already past goes, and no drain waits again until the GPU has passed that
+/// tick (so a hung GPU still reaches RADV's 10 s no-progress check).
+///
+/// Lines in stderr: EDEN_UP_PRESSURE_DRAIN (the first 16 drains and every 64th) and
+/// EDEN_UP_PRESSURE_DRAIN_10S (every 10 s while anything was counted). With the counting on, a
+/// refused allocation's report adds EDEN_REFUSED_BUFFERS_DELETED (BufferCache::ReportMemory).
+namespace Vulkan::PressureDrain {
+
+enum class Mode : u8 {
+    Off,
+    Everywhere, ///< Frame ends and the start of draws and dispatches
+    FrameEnd,   ///< Frame ends only
+    CountOnly,  ///< Nothing drained, only counted
+};
+
+[[nodiscard]] inline u64 EnvNumber(const char* name, u64 fallback, u64 low, u64 high) {
+    const char* const value = std::getenv(name);
+    if (value == nullptr || value[0] < '0' || value[0] > '9') {
+        return fallback;
+    }
+    char* end = nullptr;
+    const unsigned long long number = std::strtoull(value, &end, 10);
+    if (end == value || *end != '\0' || number == 0) {
+        return fallback;
+    }
+    return std::clamp<u64>(number, low, high);
+}
+
+[[nodiscard]] inline Mode GetMode() {
+    static const Mode mode = [] {
+        const char* const value = std::getenv("EDEN_UP_PRESSURE_DRAIN");
+        if (value != nullptr && std::strcmp(value, "1") == 0) {
+            return Mode::Everywhere;
+        }
+        if (value != nullptr && std::strcmp(value, "2") == 0) {
+            return Mode::FrameEnd;
+        }
+        const char* const count = std::getenv("EDEN_UP_PRESSURE_DRAIN_COUNT");
+        if (count != nullptr && std::strcmp(count, "1") == 0) {
+            return Mode::CountOnly;
+        }
+        return Mode::Off;
+    }();
+    return mode;
+}
+
+/// Whether anything of this runs (drains or counting).
+[[nodiscard]] inline bool On() {
+    return GetMode() != Mode::Off;
+}
+
+[[nodiscard]] inline bool Drains() {
+    const Mode mode = GetMode();
+    return mode == Mode::Everywhere || mode == Mode::FrameEnd;
+}
+
+[[nodiscard]] inline bool InFrame() {
+    return GetMode() == Mode::Everywhere || GetMode() == Mode::CountOnly;
+}
+
+struct Config {
+    u64 pool_mark;    ///< Bytes: the pool is short under this largest free piece
+    u64 pending_mark; ///< Bytes of deleted buffers that make a short pool worth a drain
+    u64 wait_ns;
+    std::chrono::milliseconds gap;
+};
+
+[[nodiscard]] inline const Config& GetConfig() {
+    static const Config config = [] {
+        Config c{};
+        c.pool_mark = EnvNumber("EDEN_UP_PRESSURE_DRAIN_MIB", 256, 1, 65535) << 20;
+        c.pending_mark = EnvNumber("EDEN_UP_PRESSURE_DRAIN_PENDING_MIB", 64, 1, 65535) << 20;
+        c.wait_ns = EnvNumber("EDEN_UP_PRESSURE_DRAIN_MS", 80, 1, 1000) * 1'000'000ULL;
+        c.gap = std::chrono::milliseconds{EnvNumber("EDEN_UP_PRESSURE_DRAIN_GAP_MS", 500, 10, 60000)};
+        if (On()) {
+            std::fprintf(stderr,
+                         "EDEN_UP_PRESSURE_DRAIN mode %d: pool short under %llu MiB, %llu MiB of "
+                         "deleted buffers worth a drain, waits at most %llu ms, %lld ms apart\n",
+                         static_cast<int>(GetMode()),
+                         static_cast<unsigned long long>(c.pool_mark >> 20),
+                         static_cast<unsigned long long>(c.pending_mark >> 20),
+                         static_cast<unsigned long long>(c.wait_ns / 1'000'000ULL),
+                         static_cast<long long>(c.gap.count()));
+        }
+        return c;
+    }();
+    return config;
+}
+
+/// The pool's largest free piece (the front's kernel query), 0 where it is not known.
+[[nodiscard]] inline u64 LargestFree() {
+    return VideoCommon::MemoryCensus::FreeLargest();
+}
+
+/// Counts for the 10 s line. The recording thread only.
+struct Counts {
+    u32 looks{};
+    u32 drains{};
+    u32 frame_end{};
+    u32 in_frame{};
+    u32 after_refusal{};
+    u32 timed_out{};
+    u32 skipped_gap{};
+    u32 skipped_behind{}; ///< The GPU still behind a tick an earlier drain gave up on
+    u32 skipped_conditional{};
+    u32 nothing{};        ///< Short, but too little waiting
+    u64 freed{};          ///< What the allocator's use fell by in drains
+    u64 waited_us{};
+    u64 longest_us{};
+    u64 peak_waiting{};   ///< Deleted buffer memory, the most seen at a look
+    size_t peak_buffers{};
+    u64 low_largest{~0ULL};
+};
+
+struct State {
+    u32 draws{};
+    u32 seen_events{};
+    bool refusal_pending{};
+    bool buffer_refusal_used{}; ///< This frame's refused buffer already led to a drain
+    u64 behind_tick{}; ///< Non-zero: a wait for this tick ran out; no wait until the GPU passes it
+    std::chrono::steady_clock::time_point last_look{};
+    std::chrono::steady_clock::time_point last_drain{};
+    std::chrono::steady_clock::time_point last_line{};
+    u64 total_drains{};
+    u64 total_freed{};
+    Counts counts{};
+};
+
+/// The recording thread's (the split's back) only.
+inline State g_state{};
+
+inline unsigned long long Mib(u64 bytes) {
+    return static_cast<unsigned long long>(bytes >> 20);
+}
+
+/// The 10 s line, when anything was counted since the last one. used() gives the allocator's use
+/// (read only when the line is written).
+template <typename UsedBytes>
+inline void MaybeLine(std::chrono::steady_clock::time_point now, size_t buffers_waiting,
+                      u64 bytes_waiting, u64 largest, UsedBytes&& used) {
+    State& s = g_state;
+    if (s.last_line == std::chrono::steady_clock::time_point{}) {
+        s.last_line = now;
+        return;
+    }
+    if (now - s.last_line < std::chrono::seconds{10}) {
+        return;
+    }
+    s.last_line = now;
+    const Counts c = s.counts;
+    s.counts = {};
+    if (c.looks == 0) {
+        return;
+    }
+    std::fprintf(stderr,
+                 "EDEN_UP_PRESSURE_DRAIN_10S %u drains (%u at a frame end, %u in a frame, %u after "
+                 "a refusal), %llu MiB freed, waited %llu ms (longest %llu ms), %u waits ran out; "
+                 "skipped: %u too soon, %u GPU behind, %u conditional rendering, %u too little "
+                 "waiting; deleted buffers waiting: peak %zu buffers %llu MiB, now %zu buffers "
+                 "%llu MiB; largest free piece: low %llu MiB, now %llu MiB; allocator use %llu MiB; "
+                 "%u looks\n",
+                 c.drains, c.frame_end, c.in_frame, c.after_refusal, Mib(c.freed),
+                 static_cast<unsigned long long>(c.waited_us / 1000),
+                 static_cast<unsigned long long>(c.longest_us / 1000), c.timed_out, c.skipped_gap,
+                 c.skipped_behind, c.skipped_conditional, c.nothing, c.peak_buffers,
+                 Mib(c.peak_waiting), buffers_waiting, Mib(bytes_waiting),
+                 c.low_largest == ~0ULL ? 0ULL : Mib(c.low_largest), Mib(largest),
+                 Mib(used()), c.looks);
+}
+
+} // namespace Vulkan::PressureDrain
diff --git a/src/video_core/renderer_vulkan/vk_rasterizer.cpp b/src/video_core/renderer_vulkan/vk_rasterizer.cpp
index 9fc3a0e9dd..f4a3d0104e 100644
