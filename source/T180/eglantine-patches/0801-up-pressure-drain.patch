 }
 
+// EDEN_UP_PRESSURE_DRAIN (pressure_drain.h). Safe points only: the end of a frame, or the start of
+// a draw or dispatch before FlushWork, so no draw is half set up. Everything deleted so far was
+// last used by commands recorded up to the current tick: once the GPU is past that tick (submitted
+// here), nothing can still use them. The deleted buffers go only then (all of the ring at once,
+// as ReleaseFinishedMemory after its Finish); the deleted images go by their own tick either way
+// (TextureCache::ReleaseFinished). No live image or buffer is touched. A delta draw
+// (EDEN_UP_FAST_DRAW) resolves in full after a drain, as after a frame end. While the guest's
+// conditional rendering is on, nothing drains: its predicate buffer may be among the deleted ones
+// (ReleaseFinishedMemory ends it instead, which draws what the guest meant to skip).
+void RasterizerVulkan::PressureDrainLook(bool frame_end) {
+    namespace PD = PressureDrain;
+    PD::State& s = PD::g_state;
+    if (!frame_end && (++s.draws & 255) != 0) {
+        return;
+    }
+    const auto now = std::chrono::steady_clock::now();
+    if (now - s.last_look < std::chrono::milliseconds{50}) {
+        return;
+    }
+    s.last_look = now;
+    const PD::Config& config = PD::GetConfig();
+    PD::Counts& c = s.counts;
+    ++c.looks;
+    // A refusal: an image the allocator refused even over the budget, or a buffer refused to the
+    // buffer cache (cleared at the frame's end by CollectRefused).
+    if (const u32 events = memory_allocator.MemoryRefusalEvents(); events != s.seen_events) {
+        s.seen_events = events;
+        s.refusal_pending = true;
+    }
+    // A refused buffer counts once per frame: RefusedBytes stays set until CollectRefused at the
+    // frame's end, and the drain after it already let the buffer cache ask again. Without this,
+    // one refusal early in a long load frame drained every quarter gap until the frame ended.
+    if (buffer_cache.RefusedBytes() == 0) {
+        s.buffer_refusal_used = false;
+    } else if (!s.buffer_refusal_used) {
+        s.refusal_pending = true;
+    }
+    const u64 largest = PD::LargestFree();
+    if (largest != 0) {
+        c.low_largest = (std::min)(c.low_largest, largest);
+    }
+    std::pair<size_t, u64> waiting;
+    {
+        std::scoped_lock lock{buffer_cache.mutex};
+        waiting = buffer_cache.DeletedWaiting();
+    }
+    if (waiting.second > c.peak_waiting) {
+        c.peak_waiting = waiting.second;
+        c.peak_buffers = waiting.first;
+    }
+    const auto line = [&] {
+        PD::MaybeLine(now, waiting.first, waiting.second, largest,
+                      [this] { return memory_allocator.UsedBytes(); });
+    };
+    if (!PD::Drains()) {
+        line();
+        return;
+    }
+    const bool refused = s.refusal_pending;
+    const bool short_pool = largest != 0 && largest < config.pool_mark;
+    if (!refused && !short_pool) {
+        line();
+        return;
+    }
+    if (!refused && waiting.second < config.pending_mark) {
+        ++c.nothing;
+        line();
+        return;
+    }
+    const auto gap = refused ? config.gap / 4 : config.gap;
+    if (s.last_drain != std::chrono::steady_clock::time_point{} && now - s.last_drain < gap) {
+        ++c.skipped_gap;
+        line();
+        return;
+    }
+    MasterSemaphore& master = scheduler.GetMasterSemaphore();
+    if (s.behind_tick != 0) {
+        // An earlier wait ran out: no new wait until the GPU has moved past that tick.
+        master.Refresh();
+        if (!master.IsFree(s.behind_tick)) {
+            ++c.skipped_behind;
+            line();
+            return;
+        }
+        s.behind_tick = 0;
+    }
+    if (query_cache_runtime.IsHostConditionalRenderingSet()) {
+        ++c.skipped_conditional;
+        line();
+        return;
+    }
+    s.last_drain = now;
+    s.refusal_pending = false;
+    if (buffer_cache.RefusedBytes() != 0) {
+        s.buffer_refusal_used = true;
+    }
+    u64 before = 0, after = 0, waited_us = 0, staging = 0;
+    bool reached = false;
+    {
+        std::scoped_lock lock{buffer_cache.mutex, texture_cache.mutex};
+        before = memory_allocator.UsedBytes();
+        if (VideoCommon::Nx2FastDraw::Enabled()) {
+            VideoCommon::Nx2FastDraw::Break(VideoCommon::Nx2FastDraw::Reason::Frame);
+        }
+        // Everything recorded so far is in this tick or an earlier one.
+        const u64 target = scheduler.CurrentTick();
+        scheduler.Flush();
+        const auto wait_start = std::chrono::steady_clock::now();
+        reached = master.WaitFor(target, config.wait_ns);
+        waited_us = static_cast<u64>(std::chrono::duration_cast<std::chrono::microseconds>(
+                                         std::chrono::steady_clock::now() - wait_start)
+                                         .count());
+        texture_cache.ReleaseFinished();
+        if (reached) {
+            buffer_cache.ReleaseFinished();
+            buffer_cache.RetryRefusedNow();
+        } else {
+            s.behind_tick = target;
+        }
+        // The console's port: the staging pool's buffers the GPU is done with (its
+        // ReleaseCompleted; nothing here where the pool has none).
+        staging = [](auto& pool) -> u64 {
+            if constexpr (requires { pool.ReleaseCompleted(); }) {
+                return static_cast<u64>(pool.ReleaseCompleted());
+            } else {
+                return 0;
+            }
+        }(staging_pool);
+        after = memory_allocator.UsedBytes();
+    }
+    const u64 freed = before > after ? before - after : 0;
+    ++c.drains;
+    ++(frame_end ? c.frame_end : c.in_frame);
+    if (refused) {
+        ++c.after_refusal;
+    }
+    if (!reached) {
+        ++c.timed_out;
+    }
+    c.freed += freed;
+    c.waited_us += waited_us;
+    c.longest_us = (std::max)(c.longest_us, waited_us);
+    ++s.total_drains;
+    s.total_freed += freed;
+    if (s.total_drains <= 16 || s.total_drains % 64 == 0) {
+        std::fprintf(stderr,
+                     "EDEN_UP_PRESSURE_DRAIN %llu %s%s: waited %llu ms, %s; %llu MiB freed "
+                     "(allocator use %llu -> %llu MiB, %llu MiB of it staging); deleted buffers "
+                     "before: %zu, %llu MiB; largest free piece %llu MiB; %llu MiB freed so far\n",
+                     static_cast<unsigned long long>(s.total_drains),
+                     frame_end ? "at a frame end" : "in a frame", refused ? " after a refusal" : "",
+                     static_cast<unsigned long long>(waited_us / 1000),
+                     reached ? "the GPU finished" : "the GPU did not finish (deleted buffers kept)",
+                     PD::Mib(freed), PD::Mib(before), PD::Mib(after), PD::Mib(staging),
+                     waiting.first, PD::Mib(waiting.second), PD::Mib(largest),
+                     PD::Mib(s.total_freed));
+    }
+    line();
+}
+
 bool RasterizerVulkan::AccelerateConditionalRendering() {
     gpu_memory->FlushCaching();
     return query_cache.AccelerateHostConditionalRendering();
