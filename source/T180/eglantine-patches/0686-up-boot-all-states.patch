             if (!used_pipelines.contains(hash)) {
@@ -2365,6 +2417,29 @@ void PipelineCache::LoadDiskResources(u64 title_id, std::stop_token stop_loading
                  canonical_rekeyed);
     }
 
+    if (BootAllStates() && !stop_loading.stop_requested()) {
+        // EDEN_UP_BOOT_ALL_STATES: the records of the other mask mode, after the boot's pass.
+        const auto skip_compute = [](std::ifstream& file, FileEnvironment) {
