+        size_t not_listed{};  // ... left out by the used list (without PRELOAD_ALL_PIPELINES)
+    } other_mask;
+    std::unordered_set<u64> other_mask_keys;
+    const auto other_state = [this](const GraphicsPipelineCacheKey& k) {
+        return (k.state.mask_components != 0) !=
+                   (MaskComponentsEnabled() && !dynamic_features.has_extended_dynamic_state_3_blend) ||
