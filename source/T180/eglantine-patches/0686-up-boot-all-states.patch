+                MaskComponentsEnabled() && !dynamic_features.has_extended_dynamic_state_3_blend;
+            GraphicsPipelineCacheKey here = key;
+            here.state.mask_components.Assign(mask_here ? 1 : 0);
+            if (other_state(here) || here.state.driver_id != dynamic_features.driver_id ||
+                here.state.driver_version != dynamic_features.driver_version) {
+                ++other_mask.other;
+                return;
+            }
+            key = here;
+        } else if (other_mask_pass) {
+            return; // the boot's own pass took it (or left it out for its own reasons)
         }
 
         const bool key_requests_provoking_last = key.state.provoking_vertex_last != 0;
@@ -2270,7 +2313,13 @@ void PipelineCache::LoadDiskResources(u64 title_id, std::stop_token stop_loading
             }
         }
         const u64 hash = key.Hash();
-        if (!disk_pipelines.insert(hash).second && canonical_keys) {
+        if (other_mask_pass) {
