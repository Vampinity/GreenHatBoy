+// EDEN_UP_BOOT_ALL_STATES=1 (exact "1"): the boot also takes the records of vulkan.bin and
+// vulkan_mesh.bin that were made with the other EDEN_NX2_MASK_COMPONENTS mode, keyed as a draw
+// here keys them now. That mode is one bit of the key (FixedPipelineState::mask_components, set
+// from the switch alone in Refresh); the rest of the key is the same, and the bit changes only the
+// colour write mask the pipeline is built with (the translation does not read it). Records that
+// differ in any other dynamic state bit, or were made for another driver, are left as before.
+// Read in a pass of its own after the boot's (so a record kept in both modes is built once, from
+// the one already in this mode), with the reader that never changes a file. The rekeyed keys are
+// not put in disk_pipelines: a draw that makes one at run time writes its record in this mode,
+// as with the switch off. Unset: as before (one load of a static per boot).
+bool BootAllStates() {
+    static const bool on = Common::PeSwitch("EDEN_UP_BOOT_ALL_STATES");
+    return on;
+}
 u64 KeepBootFloorBytes() {
     static const u64 floor = [] {
         const char* const value = std::getenv("EDEN_UP_KEEP_BOOT_PIPELINES_FLOOR_MIB");
@@ -2206,6 +2220,36 @@ void PipelineCache::LoadDiskResources(u64 title_id, std::stop_token stop_loading
         ++state.total;
     }};
     bool loading_mesh_file = false;
