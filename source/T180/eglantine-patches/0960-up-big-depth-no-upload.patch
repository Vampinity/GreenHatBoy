+bool TextureCacheRuntime::ClearDepthToZero(Image& image) {
+    const VkImageAspectFlags aspect = image.AspectMask();
+    if ((aspect & VK_IMAGE_ASPECT_DEPTH_BIT) == 0 ||
+        (image.UsageFlags() & VK_IMAGE_USAGE_TRANSFER_DST_BIT) == 0) {
+        return false;
+    }
+    // As CopyBufferToImage does for an upload: from the image's layout (undefined when nothing
+    // was written yet) to transfer, the clear, then back to general for every later use.
+    const bool was_initialized = image.ExchangeInitialization();
+    const VkImage vk_image = image.Handle();
+    const bool all_stages = UploadAllStages();
+    scheduler.RequestOutsideRenderPassOperationContext();
+    scheduler.Record([vk_image, aspect, was_initialized, all_stages](vk::CommandBuffer cmdbuf) {
+        static constexpr VkAccessFlags WRITE_ACCESS_FLAGS =
+            VK_ACCESS_SHADER_WRITE_BIT | VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT |
+            VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT;
+        static constexpr VkAccessFlags READ_ACCESS_FLAGS =
+            VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_COLOR_ATTACHMENT_READ_BIT |
+            VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_READ_BIT;
+        const VkImageSubresourceRange range{
+            .aspectMask = aspect,
+            .baseMipLevel = 0,
+            .levelCount = VK_REMAINING_MIP_LEVELS,
+            .baseArrayLayer = 0,
+            .layerCount = VK_REMAINING_ARRAY_LAYERS,
+        };
+        const VkImageMemoryBarrier to_transfer{
+            .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER,
+            .pNext = nullptr,
+            .srcAccessMask = all_stages ? (WRITE_ACCESS_FLAGS | VK_ACCESS_TRANSFER_WRITE_BIT)
+                                        : WRITE_ACCESS_FLAGS,
+            .dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT,
+            .oldLayout = was_initialized ? VK_IMAGE_LAYOUT_GENERAL : VK_IMAGE_LAYOUT_UNDEFINED,
+            .newLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+            .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+            .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+            .image = vk_image,
+            .subresourceRange = range,
+        };
+        const VkImageMemoryBarrier to_general{
+            .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER,
+            .pNext = nullptr,
+            .srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT,
+            .dstAccessMask = WRITE_ACCESS_FLAGS | READ_ACCESS_FLAGS,
+            .oldLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+            .newLayout = VK_IMAGE_LAYOUT_GENERAL,
+            .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+            .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+            .image = vk_image,
+            .subresourceRange = range,
+        };
+        const VkPipelineStageFlags use_stages =
+            all_stages ? vk::PIPELINE_STAGE_GRAPHICS_COMPUTE_TRANSFER
+                       : VkPipelineStageFlags{VK_PIPELINE_STAGE_LATE_FRAGMENT_TESTS_BIT |
+                                              VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT |
+                                              VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT};
+        cmdbuf.PipelineBarrier(use_stages, VK_PIPELINE_STAGE_TRANSFER_BIT, 0, to_transfer);
+        cmdbuf.ClearDepthStencilImage(vk_image, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+                                      VkClearDepthStencilValue{.depth = 0.0f, .stencil = 0},
+                                      range);
+        cmdbuf.PipelineBarrier(VK_PIPELINE_STAGE_TRANSFER_BIT, use_stages, 0, to_general);
+    });
+    return true;
+}
