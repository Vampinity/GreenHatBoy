+/// EDEN_UP_BIG_DEPTH_NO_UPLOAD=<MiB> (digits only, 1..65536, read once; unset, 0 or anything
+/// else: off, exactly as before). Ocarina's 12288x12288 D16 shadow map (288 MiB) is first seen as
+/// a texture (EDEN_UP_BIG_IMAGE_LOG "made ... rt=0"), not as a cleared or drawn target, so
+/// JoinImages uploads it from guest memory: a 288 MiB staging buffer and its copy, at the area
+/// load. With the switch, RefreshContents first reads the guest bytes of a depth or depth-stencil
+/// image of at least that size; when every byte is zero (or has no memory, which the upload reads
+/// as zero), the image is cleared to depth 0.0 / stencil 0 instead: the texels an upload of those
+/// bytes gives, whatever the tiling. One non-zero byte and the upload runs as before. Counted:
+/// one EDEN_UP_BIG_DEPTH line per image (the first 16, then the 32nd, 64th, ...).
+[[nodiscard]] inline u64 BigDepthNoUploadBytes() {
+    static const u64 bytes = [] {
+        const char* const value = std::getenv("EDEN_UP_BIG_DEPTH_NO_UPLOAD");
+        if (value == nullptr || *value == '\0') {
+            return u64{0};
+        }
+        u64 mib = 0;
+        for (const char* at = value; *at != '\0'; ++at) {
+            if (*at < '0' || *at > '9') {
+                return u64{0};
+            }
+            mib = mib * 10 + static_cast<u64>(*at - '0');
+            if (mib > 65536) {
+                return u64{0};
+            }
+        }
+        return mib << 20;
+    }();
+    return bytes;
+}
+
+/// Whether `size` bytes at `data` are all zero (EDEN_UP_BIG_DEPTH_NO_UPLOAD).
+[[nodiscard]] inline bool BytesAllZero(const u8* data, size_t size) {
+    u64 seen = 0;
+    size_t at = 0;
+    for (; at + 8 <= size; at += 8) {
+        u64 word;
+        std::memcpy(&word, data + at, sizeof(word));
+        seen |= word;
+    }
+    for (; at < size; ++at) {
+        seen |= data[at];
+    }
+    return seen == 0;
+}
