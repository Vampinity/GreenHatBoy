+template <class P>
+bool TextureCache<P>::ClearZeroDepthInsteadOfUpload(Image& image, ImageId image_id) {
+    if constexpr (!requires { runtime.ClearDepthToZero(image); }) {
+        return false; // no depth clear in this renderer: uploaded as before
+    } else {
+        using VideoCore::Surface::SurfaceType;
+        static u64 cleared = 0;      // under the texture cache lock
+        static u64 cleared_mib = 0;  // staging not taken
+        static u64 kept = 0;         // non-zero guest bytes: uploaded
+        static u64 not_checked = 0;  // a kind of image this does not handle: uploaded
+        const auto logs = [](u64 count) { return count <= 16 || (count & (count - 1)) == 0; };
+        const SurfaceType type = VideoCore::Surface::GetFormatType(image.info.format);
+        if (type != SurfaceType::Depth && type != SurfaceType::DepthStencil) {
+            return false; // colour: not this switch's (no line, every texture would print one)
+        }
+        // Only a plain, whole, native image: one host image the clear reaches in full, and guest
+        // bytes the upload would read in one piece. Anything else is uploaded as before.
+        constexpr ImageFlagBits not_plain =
+            ImageFlagBits::Sparse | ImageFlagBits::SparseLayers | ImageFlagBits::SparseTiles |
+            ImageFlagBits::UnwrittenSparse | ImageFlagBits::Unbacked | ImageFlagBits::Converted |
+            ImageFlagBits::Rescaled | ImageFlagBits::AsynchronousDecode |
+            ImageFlagBits::IsDecoding;
+        if (True(image.flags & not_plain) || image.info.num_samples != 1 ||
+            !image.dirty_layers.empty()) {
+            if (logs(++not_checked)) {
+                LOG_WARNING(HW_GPU,
+                            "EDEN_UP_BIG_DEPTH: not checked id={} gpu={:#x} fmt={} {}x{}x{} "
+                            "guest={}MiB flags={:#x} samples={} dirty_layers={} frame={} ({} so "
+                            "far): uploaded",
+                            image_id.index, image.gpu_addr, static_cast<u32>(image.info.format),
+                            image.info.size.width, image.info.size.height, image.info.size.depth,
+                            image.guest_size_bytes >> 20, static_cast<u32>(image.flags),
+                            image.info.num_samples, image.dirty_layers.size(), frame_tick,
+                            not_checked);
+            }
+            return false;
+        }
+        // Read the guest bytes the upload would read (MemoryManager::ReadBlockImpl): page by
+        // page; a page without memory (unmapped, reserved, no host page) reads zero there, and a
+        // page the front may not hand out as a span is copied (GuestReadThrough), as there.
+        const auto started = std::chrono::steady_clock::now();
+        constexpr u64 Page = 4096;
+        alignas(8) std::array<u8, Page> scratch;
+        u64 no_memory_pages = 0;
+        u64 nonzero_at = ~u64{0};
+        for (u64 offset = 0; offset < image.guest_size_bytes;) {
+            const GPUVAddr address = image.gpu_addr + offset;
+            const u64 count =
+                (std::min)(Page - (address & (Page - 1)), image.guest_size_bytes - offset);
+            const u8* const pointer = gpu_memory->GetPointer<u8>(address);
+            if (pointer == nullptr) {
+                ++no_memory_pages;
+            } else {
+                const u8* data = pointer;
+                if (!Common::GuestReadThrough::SpanReadable(pointer, count)) {
+                    Common::GuestReadThrough::Copy(scratch.data(), pointer, count);
+                    data = scratch.data();
+                }
+                if (!BytesAllZero(data, count)) {
+                    nonzero_at = offset;
+                    break;
+                }
+            }
+            offset += count;
+        }
+        const double scan_ms = std::chrono::duration<double, std::milli>(
+                                   std::chrono::steady_clock::now() - started)
+                                   .count();
+        if (nonzero_at != ~u64{0}) {
+            if (logs(++kept)) {
+                LOG_WARNING(HW_GPU,
+                            "EDEN_UP_BIG_DEPTH: kept the upload id={} gpu={:#x} fmt={} {}x{}x{} "
+                            "guest={}MiB: a non-zero byte at +{:#x} scan={:.1f}ms frame={} ({} "
+                            "kept so far)",
+                            image_id.index, image.gpu_addr, static_cast<u32>(image.info.format),
+                            image.info.size.width, image.info.size.height, image.info.size.depth,
+                            image.guest_size_bytes >> 20, nonzero_at, scan_ms, frame_tick, kept);
+            }
+            return false;
+        }
+        if (!runtime.ClearDepthToZero(image)) {
+            if (logs(++not_checked)) {
+                LOG_WARNING(HW_GPU,
+                            "EDEN_UP_BIG_DEPTH: not cleared id={} gpu={:#x} (no depth aspect or "
+                            "transfer use) frame={} ({} so far): uploaded",
+                            image_id.index, image.gpu_addr, frame_tick, not_checked);
+            }
+            return false;
+        }
+        // What a finished upload leaves (RefreshContents below): no retry pending, no failures.
+        image.upload_retry_frame = 0;
+        image.upload_fail_count = 0;
+        const u64 staging_mib = u64{MapSizeBytes(image)} >> 20;
+        ++cleared;
+        cleared_mib += staging_mib;
+        if (logs(cleared)) {
+            LOG_WARNING(HW_GPU,
+                        "EDEN_UP_BIG_DEPTH: cleared instead of uploaded id={} gpu={:#x} fmt={} "
+                        "{}x{}x{} lv={} ly={} guest={}MiB staging_avoided={}MiB no_memory_pages={} "
+                        "scan={:.1f}ms frame={} ({} cleared, {} MiB of staging avoided so far; "
+                        "{} kept)",
+                        image_id.index, image.gpu_addr, static_cast<u32>(image.info.format),
+                        image.info.size.width, image.info.size.height, image.info.size.depth,
+                        image.info.resources.levels, image.info.resources.layers,
+                        image.guest_size_bytes >> 20, staging_mib, no_memory_pages, scan_ms,
+                        frame_tick, cleared, cleared_mib, kept);
+        }
+        return true;
+    }
+}
