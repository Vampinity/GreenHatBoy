--- a/src/video_core/engines/maxwell_3d.cpp
+++ b/src/video_core/engines/maxwell_3d.cpp
@@ -1599,6 +1599,8 @@ struct Maxwell3D::FrontState {
     /// does not send the instance loop writes the back ignores (FrontSkipsLoopWrite). With it
