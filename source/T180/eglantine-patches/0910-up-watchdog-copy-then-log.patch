+                                                       ctx.pc, ctx.lr, ctx.sp});
+                                }
+                            }
+                            for (const Row& row : rows) {
+                                LOG_WARNING(Core,
+                                            " {} tid={} core={} state={} wait={} pc={:#x} lr={:#x} sp={:#x}",
+                                            process->GetName(), row.tid, row.core, row.state, row.wait,
+                                            row.pc, row.lr, row.sp);
+                            }
+                            continue;
+                        }
