+                    // EDEN_UP_LOG_FLUSH_MS set (the front's timed log flush): each list is copied
+                    // under the process's list lock and logged after it is let go, so a log write
+                    // that waits for the disk does not hold up the guest threads that take that
+                    // lock. Unset: logged under the lock, as before. The same lines either way.
+                    static const bool copy_first = [] {
+                        const char* const value = std::getenv("EDEN_UP_LOG_FLUSH_MS");
+                        return value != nullptr && value[0] != '\0' && value[0] != '0';
+                    }();
                     for (auto& process : processes) {
+                        if (copy_first) {
+                            struct Row {
+                                u64 tid;
+                                s32 core;
+                                unsigned state, wait;
+                                u64 pc, lr, sp;
+                            };
+                            std::vector<Row> rows;
+                            {
