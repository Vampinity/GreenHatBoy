+bool KeptStore::SameInfo(u64 key_hash, const Stages& stages) const {
+    std::array<u64, NumStages> fresh{};
+    for (size_t stage = 0; stage < NumStages; ++stage) {
+        if (stages.present[stage]) {
+            std::vector<u8> bytes;
+            SerializeInfo(stages.infos[stage], bytes);
+            fresh[stage] = HashBytes(bytes);
+        }
+    }
+    std::scoped_lock lock{mutex};
+    const auto it = records.find(key_hash);
+    if (it == records.end() || (it->second.flags & FlagNotKeepable) != 0) {
+        return false;
+    }
+    for (size_t stage = 0; stage < NumStages; ++stage) {
+        const u32 id = it->second.infos[stage];
+        if ((id != NoBlob) != stages.present[stage]) {
+            return false;
+        }
+        if (id != NoBlob && (id >= blobs.size() || blobs[id].hash != fresh[stage])) {
+            return false;
+        }
+    }
+    return true;
+}
