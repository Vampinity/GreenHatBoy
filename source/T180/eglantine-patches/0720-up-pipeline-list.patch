index 1588724..82d0400 100644
--- a/src/video_core/shader_set.cpp
+++ b/src/video_core/shader_set.cpp
@@ -1003,4 +1003,69 @@ bool ReadRecords(
         return false;
     }
 }
+
+bool ForEachProgramCode(const std::filesystem::path& path, u32 cache_version,
+                        const std::function<bool(u64)>& wanted,
+                        const std::function<void(u64, std::span<const u8>)>& on_program) {
+    // The trailer and the programs section as ReadRecords reads them: [12, where[1] records,
+    // facts_at, facts, programs_at, programs] + the magic; a program is u32 id, u64 lowered
+    // hash, u64 size, then its code.
+    try {
+        std::ifstream file(path, std::ios::binary | std::ios::ate);
+        if (!file.is_open()) return true;
+        file.exceptions(std::ifstream::failbit | std::ifstream::badbit);
+        const u64 end = static_cast<u64>(file.tellg());
+        constexpr u64 TrailerBytes = 6 * 8 + 8;
+        if (end < 12 + TrailerBytes) return true;
+        const auto get = [&file](auto& value) {
+            file.read(reinterpret_cast<char*>(&value), sizeof(value));
+        };
+        const auto seek = [&file](u64 at) { file.seekg(static_cast<std::streamoff>(at)); };
+        std::array<char, 8> magic{}, tail{};
+        u32 version{};
+        seek(0);
+        file.read(magic.data(), magic.size());
+        get(version);
+        // "edenset2" (the layout before T122, which consoles still hold): a program is u32 id,
+        // u64 size, code, with no lowered hash; every program is handed over, with hash 0, and
+        // `wanted` is not asked.
+        static constexpr char OldMagic[9] = "edenset2";
+        const bool old_layout = std::memcmp(magic.data(), OldMagic, 8) == 0;
+        if ((!old_layout && std::memcmp(magic.data(), SetMagic, 8) != 0) ||
+            version != cache_version) {
+            return true;
+        }
+        std::array<u64, 6> where{};
+        seek(end - TrailerBytes);
+        get(where);
+        file.read(tail.data(), tail.size());
+        const u64 programs_at = where[4], programs = where[5];
+        if (std::memcmp(tail.data(), old_layout ? OldMagic : SetMagic, 8) != 0 || where[0] != 12 ||
+            programs_at < where[2] || programs_at > end - TrailerBytes) {
+            return false;
+        }
+        const u64 entry_head = old_layout ? 12 : 20;
+        std::vector<u8> code;
+        u64 at = programs_at;
+        for (u64 i = 0; i < programs; ++i) {
+            u32 program{};
+            u64 hash{}, size{};
+            if (at + entry_head > end - TrailerBytes) return false;
+            seek(at);
+            get(program);
+            if (!old_layout) get(hash);
+            get(size);
+            if (size > end - TrailerBytes - (at + entry_head)) return false;
+            if (old_layout || wanted(hash)) {
+                code.resize(static_cast<size_t>(size));
+                file.read(reinterpret_cast<char*>(code.data()), static_cast<std::streamsize>(size));
+                on_program(hash, std::span<const u8>{code.data(), code.size()});
+            }
+            at += entry_head + size;
+        }
+        return true;
+    } catch (const std::exception&) {
+        return false;
+    }
+}
 } // namespace VideoCommon::ShaderSet
