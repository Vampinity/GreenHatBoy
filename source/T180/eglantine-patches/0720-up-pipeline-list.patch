+        std::getline(old, first);
+        std::getline(old, second);
+        const bool outputs_there = std::filesystem::exists(ImportedFile(job.dir, ListGraphics), ec);
+        if (outputs_there && first == base_stamp &&
+            (second == "missing 0" || second == "missing 1" + own_stamp)) {
+            LOG_INFO(Render_Vulkan,
+                     "EDEN_UP_PIPELINE_LIST_IMPORT: {} imported before, its files are used as "
+                     "they are",
