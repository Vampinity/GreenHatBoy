+    const auto pass = [&](const std::function<void(const RawRecord&, u64)>& on_valid) {
+        list.clear();
+        list.seekg(records_at);
+        u64 left = records_left;
+        std::unordered_set<u64> seen;
+        for (u32 index = 0; index < header.records; ++index) {
+            u32 result = 2;
+            try {
+                result = ReadListRecord(list, left, header, record);
+            } catch (const std::exception&) {
+                result = 2;
+            }
+            if (result == 2) {
+                count.cut = true;
+                return;
+            }
+            if (result == 1) {
+                ++count.invalid;
+                continue;
+            }
+            const u64 hash = RecordKeyHash(record);
+            if (!seen.insert(hash ^ record.kind).second) {
+                ++count.twice;
+                continue;
+            }
+            ++count.read[record.kind];
+            on_valid(record, hash);
