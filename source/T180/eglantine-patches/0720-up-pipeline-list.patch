+            if (count.written[kind] != 0) {
+                std::filesystem::rename(temporaries[kind], final_path, ec);
+                write_ok &= !ec;
+            } else {
+                std::filesystem::remove(final_path, ec);
+            }
+        }
+        if (count.written[ListGraphics] == 0) {
+            // The stamp's check looks for this file: an empty one stands for "none".
+            std::ofstream empty(ImportedFile(job.dir, ListGraphics), std::ios::binary);
+            empty.write(CacheFileMagic.data(), CacheFileMagic.size());
+            empty.write(reinterpret_cast<const char*>(&job.cache_version),
+                        sizeof(job.cache_version));
+        }
+    }
+    if (!write_ok) {
+        for (u8 kind = 0; kind < 3; ++kind) {
+            if (!temporaries[kind].empty()) {
+                std::filesystem::remove(temporaries[kind], ec);
+            }
+        }
+        remove_outputs();
+        LOG_WARNING(Render_Vulkan, "EDEN_UP_PIPELINE_LIST_IMPORT: the imported records could "
+                                   "not be written; nothing imported");
+        return;
+    }
+    {
+        std::ofstream stamp(stamp_path, std::ios::trunc);
+        stamp << base_stamp << '\n'
+              << (count.missing_code == 0 ? std::string{"missing 0"} : "missing 1" + own_stamp)
+              << '\n';
+    }
+    const double seconds =
+        std::chrono::duration<double>(std::chrono::steady_clock::now() - begin).count();
+    LOG_INFO(Render_Vulkan,
+             "EDEN_UP_PIPELINE_LIST_IMPORT: {}: {} records ({} graphics, {} task/mesh, {} compute), "
+             "{} invalid, {} twice; {} this console has already, {} for another dynamic state, {} "
+             "made with another driver ({}), {} task/mesh with no mesh shaders here, {} whose code "
+             "is not on this console ({} of {} programs not found; {} found in own records, {} in "
+             "the shader set file); written for the preparation: {} graphics, {} task/mesh, {} "
+             "compute (the preparation counts them as predicted){}{}; {:.1f} s",
+             list_name, count.read[0] + count.read[1] + count.read[2], count.read[ListGraphics],
+             count.read[ListMesh], count.read[ListCompute], count.invalid, count.twice, count.own,
+             count.other_device, count.other_driver,
+             rewrite_driver ? "taken with this driver's fields" : "left out", count.no_mesh_shaders,
