+    {
+        std::ofstream code_file(code_path, std::ios::binary | std::ios::trunc);
+        if (!code_file.is_open()) {
+            LOG_WARNING(Render_Vulkan, "EDEN_UP_PIPELINE_LIST_IMPORT: {} cannot be written; "
+                                       "nothing imported",
+                        Common::FS::PathToUTF8String(code_path));
+            return;
+        }
+        u64 code_end = 0;
+        const auto offer = [&](u64 hash, std::span<const u8> code) -> bool {
+            const auto wanted = code_size_of.find(hash);
+            if (wanted == code_size_of.end() || wanted->second != code.size() ||
