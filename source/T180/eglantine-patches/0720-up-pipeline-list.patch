+        count.cut |= left != 0;
+    };
+    try {
+        pass([&](const RawRecord& valid, u64 hash) {
+            list_keys.insert(hash);
+            for (const RawEnvironment& env : valid.envs) {
+                code_size_of.emplace(env.code_hash, env.CodeSize());
+            }
+            if (valid.kind != ListCompute) {
+                GraphicsPipelineCacheKey key;
+                std::memcpy(&key, valid.key.data(), sizeof(key));
