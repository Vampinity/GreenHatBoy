+std::optional<u64> FileEnvironment::RecordTailSize(std::span<const u8> head,
+                                                   bool with_mesh_state, u64 limit) {
+    if (head.size() < RecordHeadSize) {
+        return std::nullopt;
+    }
+    // The order Serialize writes: code size, then the five answer counts.
+    std::array<u64, 6> counts{};
+    std::memcpy(counts.data(), head.data(), sizeof(counts));
+    static_assert(sizeof(Shader::Stage) == sizeof(u32));
+    u32 stage_value{};
+    std::memcpy(&stage_value, head.data() + RecordHeadSize - sizeof(stage_value),
+                sizeof(stage_value));
+    if (stage_value > static_cast<u32>(Shader::Stage::Mesh) || counts[0] > limit) {
+        return std::nullopt;
+    }
+    const auto record_stage = static_cast<Shader::Stage>(stage_value);
+    // One entry of each answer map, as Serialize writes it: its key, then its value.
+    const std::array<u64, 5> entry{
+        sizeof(u32) + sizeof(Shader::TextureType),
+        sizeof(u32) + sizeof(Shader::TexturePixelFormat),
+        sizeof(u64) + sizeof(u32),
+        sizeof(u64) + sizeof(u8),
+        sizeof(u64) + sizeof(Shader::ReplaceConstant),
+    };
+    u64 size = 0;
+    for (size_t index = 0; index < entry.size(); ++index) {
+        const u64 count = counts[index + 1];
+        if (count > limit / entry[index]) {
+            return std::nullopt;
+        }
+        size += count * entry[index];
+        if (size > limit) {
+            return std::nullopt;
+        }
+    }
+    if (record_stage == Shader::Stage::Compute) {
+        size += sizeof(workgroup_size) + sizeof(shared_memory_size);
+    } else {
+        size += sizeof(sph);
+        if (record_stage == Shader::Stage::Geometry) {
+            size += sizeof(gp_passthrough_mask);
+        }
+        if (with_mesh_state &&
+            (record_stage == Shader::Stage::Task || record_stage == Shader::Stage::Mesh)) {
+            size += sizeof(mesh_registers) + sizeof(mesh_primitive_header);
+        }
+    }
+    if (size > limit) {
+        return std::nullopt;
+    }
+    return size;
+}
