+        fmt::format("pipeline list import 2 cache {} driver {:x}.{:x} rewrite {} mesh {} list {} "
+                    "set {} device {}",
+                    job.cache_version, job.driver_id, job.driver_version, rewrite_driver ? 1 : 0,
