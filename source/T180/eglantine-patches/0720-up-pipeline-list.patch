+    // wants is copied once into a scratch file beside the outputs.
+    const auto code_path = job.dir / "prep_imported.code";
+    struct Found {
+        u64 at{};
+        u64 size{};
+    };
+    std::unordered_map<u64, Found> found;
+    std::unordered_set<u64> own_keys;
