diff --git a/src/video_core/renderer_vulkan/vk_pipeline_cache.cpp b/src/video_core/renderer_vulkan/vk_pipeline_cache.cpp
index 819c9da..896a31f 100644
--- a/src/video_core/renderer_vulkan/vk_pipeline_cache.cpp
+++ b/src/video_core/renderer_vulkan/vk_pipeline_cache.cpp
@@ -1313,6 +1313,823 @@ bool MeshCacheBoot() {
 }
 } // Anonymous namespace
 
+// EDEN_UP_PIPELINE_LIST_EXPORT / EDEN_UP_PIPELINE_LIST_IMPORT (0720, both off by default) -----
+//
+// A pipeline list is a console's pipeline records without the game's code. A record of
+// vulkan.bin / vulkan_mesh.bin holds, per program, the program's code (the game's shader, as
+// the lowerer made it), the answers its translation got from the game's state, and then the
+// key (the six program hashes and the 1,008 bytes of drawing state). A list record holds the
+// same minus the code: for each program the CityHash64 of its code and the environment's other
+// bytes (the code size is the first of them). So a list says which pipelines a game draws and
+// how, and cannot draw anything by itself.
+//
+// EXPORT=1: at boot, before anything is built, this console's own record files (vulkan.bin and
+// vulkan_mesh.bin, or their canonical files, in this build's shader folder) are written as
+// pipeline_export.list beside them (written beside and renamed over). Nothing else changes.
+//
+// IMPORT=1 reads pipeline_import.list from the same folder; IMPORT=<path> reads that file
+// (several consoles' lists go through tools/pipeline-list.py merge first). Each program's code
+// is looked for by its hash in this console's own files: its records, and the shader set file
+// made from the player's own game when it is there (prep_shader_set.bin, either layout). The
+// list's records whose code was all found, that this console has no record of, that are made
+// for this device's dynamic state and pass every check below are written back as whole
+// records: prep_imported.bin (ordinary graphics), prep_imported_mesh.bin (task/mesh, with their
+// mesh state) and prep_imported_compute.bin. The preparation (EDEN_UP_SHADER_PREP=1) reads the
+// first two as predicted records: translated on the workers, built once (the driver's disk
+// cache keeps the result), kept (task/mesh pipelines, which run as compute, cannot be kept and
+// are remembered as built), before play. The boot builds the compute ones as its own. A list
+// that is gone takes the three files with it. One line in the log gives every count. A stamp
+// (prep_imported.stamp: the list, the shader set file, this device's dynamic states and key
+// switches, and the own record files while code was missing) skips the work when unchanged.
+// EDEN_UP_PIPELINE_LIST_IMPORT_DRIVER=1: a record made with another driver version is taken
+// with this device's driver fields (the fields only exist to tell driver builds apart; the
+// translation and the build are made here); without it such records are counted and left out.
+//
+// Checked for every list record: the list's format, cache version and both key sizes; a known
+// kind; 1-6 programs (compute: exactly one, a compute program; graphics: none, and as many as
+// the key has program hashes; mesh: at least one task or mesh program; ordinary: none); each
+// program's bytes as long as its head says, the code at most 16 MiB; and the code found here
+// has that hash and that size; each program's code hash (XOR the native tag) is one of the
+// key's program hashes (task/mesh records: not for their mesh-state slots), so a key is never
+// built from another program's code. A record that fails is counted as invalid and left out. A list
+// that ends inside a record or holds more than it says stops the reading (what was read stays).
+//
+// Off (both unset): one switch read in LoadDiskResources and one in PrepareKept; nothing is
+// read, written or logged.
+namespace {
+constexpr std::array<char, 8> PipelineListMagic{'E', 'G', 'P', 'L', 'I', 'S', 'T', '1'};
+constexpr u32 PipelineListFormat = 1;
+constexpr std::array<char, 8> CacheFileMagic{'y', 'u', 'z', 'u', 'c', 'a', 'c', 'h'};
+constexpr u64 MostCodeBytes = 16ULL << 20;
+constexpr u64 NativeProgramTag = 0x4f554e4345000003ULL; // GenericEnvironment::Analyze
+enum : u8 { ListCompute = 0, ListGraphics = 1, ListMesh = 2 };
+
+struct PipelineListHeader {
+    std::array<char, 8> magic{};
+    u32 format{};
+    u32 cache_version{};
+    u32 graphics_key_size{};
+    u32 compute_key_size{};
+    u32 records{};
+    u32 flags{};
+};
+static_assert(sizeof(PipelineListHeader) == 32);
+
+struct RawEnvironment {
+    std::array<u8, VideoCommon::FileEnvironment::RecordHeadSize> head{};
+    std::vector<u8> code;
+    std::vector<u8> tail;
+    u64 code_hash{};
+
+    [[nodiscard]] u64 CodeSize() const noexcept {
+        u64 size{};
+        std::memcpy(&size, head.data(), sizeof(size));
+        return size;
+    }
+    [[nodiscard]] Shader::Stage Stage() const noexcept {
+        u32 value{};
+        std::memcpy(&value, head.data() + head.size() - sizeof(value), sizeof(value));
+        return static_cast<Shader::Stage>(value);
+    }
+};
+
+struct RawRecord {
+    u8 kind{};
+    std::vector<RawEnvironment> envs;
+    std::vector<u8> key;
+};
+
+[[nodiscard]] bool IsMeshStage(Shader::Stage stage) noexcept {
+    return stage == Shader::Stage::Task || stage == Shader::Stage::Mesh;
+}
+
+/// EDEN_UP_PIPELINE_LIST_IMPORT: "" off, "1" the default file, else the path given.
+[[nodiscard]] const std::string& PipelineListImportPath() {
+    static const std::string path = [] {
+        const char* const value = std::getenv("EDEN_UP_PIPELINE_LIST_IMPORT");
+        if (value == nullptr || value[0] == '\0' || (value[0] == '0' && value[1] == '\0')) {
+            return std::string{};
+        }
+        return std::string{value};
+    }();
+    return path;
+}
+
+[[nodiscard]] std::filesystem::path ImportedFile(const std::filesystem::path& dir, u8 kind) {
+    return dir / (kind == ListMesh      ? "prep_imported_mesh.bin"
+                  : kind == ListCompute ? "prep_imported_compute.bin"
+                                        : "prep_imported.bin");
+}
+
+/// One environment's bytes at `in`, `left` bytes before the end. False: not an environment.
+[[nodiscard]] bool ReadRawEnvironment(std::istream& in, u64& left, bool with_mesh_state,
+                                      RawEnvironment& env) {
+    if (left < env.head.size()) {
+        return false;
+    }
+    in.read(reinterpret_cast<char*>(env.head.data()), static_cast<std::streamsize>(env.head.size()));
+    left -= env.head.size();
+    const std::optional<u64> tail =
+        VideoCommon::FileEnvironment::RecordTailSize(env.head, with_mesh_state, left);
+    const u64 code_size = env.CodeSize();
+    if (!tail || code_size > MostCodeBytes || code_size + *tail > left) {
+        return false;
+    }
+    env.code.resize(static_cast<size_t>(code_size));
+    in.read(reinterpret_cast<char*>(env.code.data()), static_cast<std::streamsize>(code_size));
+    env.tail.resize(static_cast<size_t>(*tail));
+    in.read(reinterpret_cast<char*>(env.tail.data()), static_cast<std::streamsize>(*tail));
+    left -= code_size + *tail;
+    env.code_hash = Common::CityHash64(reinterpret_cast<const char*>(env.code.data()),
+                                       env.code.size());
+    return true;
+}
+
+/// Every record of a pipeline cache file of `cache_version`, in order, as bytes. Returns false
+/// when the file ends inside a record or holds one that cannot be (what was read stays read);
+/// a missing file or another version's reads as empty.
+template <typename OnRecord>
+bool ForEachRawRecord(const std::filesystem::path& path, u32 cache_version, bool with_mesh_state,
+                      OnRecord&& on_record) try {
+    std::ifstream file(path, std::ios::binary | std::ios::ate);
+    if (!file.is_open()) {
+        return true;
+    }
+    file.exceptions(std::ifstream::failbit | std::ifstream::badbit);
+    u64 left = static_cast<u64>(file.tellg());
+    file.seekg(0);
+    if (left < 12) {
+        return left == 0;
+    }
+    std::array<char, 8> magic{};
+    u32 version{};
+    file.read(magic.data(), magic.size());
+    file.read(reinterpret_cast<char*>(&version), sizeof(version));
+    left -= 12;
+    if (magic != CacheFileMagic || version != cache_version) {
+        return true;
+    }
+    RawRecord record;
+    while (left != 0) {
+        u32 count{};
+        if (left < sizeof(count)) {
+            return false;
+        }
+        file.read(reinterpret_cast<char*>(&count), sizeof(count));
+        left -= sizeof(count);
+        if (count == 0 || count > 6) {
+            return false;
+        }
+        record.envs.resize(count);
+        for (RawEnvironment& env : record.envs) {
+            if (!ReadRawEnvironment(file, left, with_mesh_state, env)) {
+                return false;
+            }
+        }
+        const bool compute = record.envs.front().Stage() == Shader::Stage::Compute;
+        const size_t key_size =
+            compute ? sizeof(ComputePipelineCacheKey) : sizeof(GraphicsPipelineCacheKey);
+        if (left < key_size) {
+            return false;
+        }
+        record.key.resize(key_size);
+        file.read(reinterpret_cast<char*>(record.key.data()),
+                  static_cast<std::streamsize>(key_size));
+        left -= key_size;
+        record.kind = compute ? ListCompute : with_mesh_state ? ListMesh : ListGraphics;
+        on_record(record);
+    }
+    return true;
+} catch (const std::exception&) {
+    return false;
+}
+
+[[nodiscard]] u64 RecordKeyHash(const RawRecord& record) {
+    if (record.kind == ListCompute) {
+        ComputePipelineCacheKey key;
+        std::memcpy(&key, record.key.data(), sizeof(key));
+        return key.Hash();
+    }
+    GraphicsPipelineCacheKey key;
+    std::memcpy(&key, record.key.data(), sizeof(key));
+    return key.Hash();
+}
+
+template <typename T>
+void PutValue(std::vector<u8>& out, const T& value) {
+    const auto* const bytes = reinterpret_cast<const u8*>(&value);
+    out.insert(out.end(), bytes, bytes + sizeof(value));
+}
+
+/// Writes `bytes` to `path` beside itself and renames it over. False: nothing changed.
+[[nodiscard]] bool WriteFileWhole(const std::filesystem::path& path,
+                                  const std::function<bool(std::ofstream&)>& write) {
+    std::filesystem::path temporary = path;
+    temporary += ".tmp";
+    try {
+        {
+            std::ofstream out(temporary, std::ios::binary | std::ios::trunc);
+            if (!out.is_open()) {
+                return false;
+            }
+            out.exceptions(std::ofstream::failbit | std::ofstream::badbit);
+            if (!write(out)) {
+                out.close();
+                std::error_code ignored;
+                std::filesystem::remove(temporary, ignored);
+                return false;
+            }
+            out.flush();
+        }
+        std::filesystem::rename(temporary, path);
+        return true;
+    } catch (const std::exception&) {
+        std::error_code ignored;
+        std::filesystem::remove(temporary, ignored);
+        return false;
+    }
+}
+
+/// EDEN_UP_PIPELINE_LIST_EXPORT: `sources` (file, read with mesh state) as one list at `path`.
+void ExportPipelineList(const std::vector<std::pair<std::filesystem::path, bool>>& sources,
+                        const std::filesystem::path& path, u32 cache_version) {
+    const auto begin = std::chrono::steady_clock::now();
+    std::array<size_t, 3> written{};
+    size_t skipped_mesh = 0;
+    bool whole = true;
+    u64 bytes = 0;
+    const bool ok = WriteFileWhole(path, [&](std::ofstream& out) {
+        PipelineListHeader header{};
+        header.magic = PipelineListMagic;
+        header.format = PipelineListFormat;
+        header.cache_version = cache_version;
+        header.graphics_key_size = static_cast<u32>(sizeof(GraphicsPipelineCacheKey));
+        header.compute_key_size = static_cast<u32>(sizeof(ComputePipelineCacheKey));
+        out.write(reinterpret_cast<const char*>(&header), sizeof(header));
+        std::vector<u8> row;
+        u32 records = 0;
+        for (const auto& [source, with_mesh_state] : sources) {
+            whole &= ForEachRawRecord(source, cache_version, with_mesh_state,
+                                      [&](const RawRecord& record) {
+                if (record.kind == ListGraphics &&
+                    std::ranges::any_of(record.envs, [](const RawEnvironment& env) {
+                        return IsMeshStage(env.Stage());
+                    })) {
+                    // A task/mesh record of vulkan.bin lacks its mesh state: no build reads it.
+                    ++skipped_mesh;
+                    return;
+                }
+                row.clear();
+                PutValue(row, record.kind);
+                PutValue(row, static_cast<u8>(record.envs.size()));
+                PutValue(row, u16{0});
+                for (const RawEnvironment& env : record.envs) {
+                    PutValue(row, env.code_hash);
+                    PutValue(row, static_cast<u32>(env.head.size() + env.tail.size()));
+                    row.insert(row.end(), env.head.begin(), env.head.end());
+                    row.insert(row.end(), env.tail.begin(), env.tail.end());
+                }
+                row.insert(row.end(), record.key.begin(), record.key.end());
+                out.write(reinterpret_cast<const char*>(row.data()),
+                          static_cast<std::streamsize>(row.size()));
+                bytes += row.size();
+                ++written[record.kind];
+                ++records;
+            });
+        }
+        header.records = records;
+        out.seekp(0);
+        out.write(reinterpret_cast<const char*>(&header), sizeof(header));
+        return true;
+    });
+    const double seconds =
+        std::chrono::duration<double>(std::chrono::steady_clock::now() - begin).count();
+    if (!ok) {
+        LOG_WARNING(Render_Vulkan, "EDEN_UP_PIPELINE_LIST_EXPORT: {} could not be written",
+                    Common::FS::PathToUTF8String(path));
+        return;
+    }
+    LOG_INFO(Render_Vulkan,
+             "EDEN_UP_PIPELINE_LIST_EXPORT: wrote {}: {} records ({} graphics, {} task/mesh, {} "
+             "compute), {} KiB, no program code; {} task/mesh records of vulkan.bin left out (no "
+             "mesh state){}; {:.1f} s",
+             Common::FS::PathToUTF8String(path), written[0] + written[1] + written[2],
+             written[ListGraphics], written[ListMesh], written[ListCompute],
+             (bytes + sizeof(PipelineListHeader)) >> 10, skipped_mesh,
+             whole ? "" : "; a record file could not be read to its end", seconds);
+}
+
+struct PipelineListImport {
+    std::filesystem::path list;
+    std::filesystem::path dir;
+    std::vector<std::pair<std::filesystem::path, bool>> own_files;
+    std::filesystem::path shader_set_file;
+    u32 cache_version{};
+    u32 driver_id{};
+    u32 driver_version{};
+    bool mesh_supported{};
+    std::function<u32(const GraphicsPipelineCacheKey&)> other_device;
+    /// What other_device's answer depends on (dynamic states, key switches): in the stamp, so
+    /// a changed setting (EDEN_NX2_MASK_COMPONENTS, say) imports again.
+    std::string device_identity;
+};
+
+/// One list record at `in` (`left` bytes before the end of the list). Returns 0 when read and
+/// valid, 1 when read but invalid (`record` partly filled), 2 when the list cannot be read on.
+[[nodiscard]] u32 ReadListRecord(std::istream& in, u64& left, const PipelineListHeader& header,
+                                 RawRecord& record) {
+    std::array<u8, 4> head{};
+    if (left < head.size()) {
+        return 2;
+    }
+    in.read(reinterpret_cast<char*>(head.data()), head.size());
+    left -= head.size();
+    record.kind = head[0];
+    const u32 count = head[1];
+    if (count == 0 || count > 6 || record.kind > ListMesh) {
+        return 2; // the record's size is unknown: nothing after it can be found
+    }
+    bool valid = true;
+    record.envs.resize(count);
+    for (RawEnvironment& env : record.envs) {
+        u32 size{};
+        if (left < sizeof(env.code_hash) + sizeof(size)) {
+            return 2;
+        }
+        in.read(reinterpret_cast<char*>(&env.code_hash), sizeof(env.code_hash));
+        in.read(reinterpret_cast<char*>(&size), sizeof(size));
+        left -= sizeof(env.code_hash) + sizeof(size);
+        if (size < env.head.size() || size > left) {
+            return 2;
+        }
+        in.read(reinterpret_cast<char*>(env.head.data()), env.head.size());
+        env.tail.resize(size - env.head.size());
+        in.read(reinterpret_cast<char*>(env.tail.data()),
+                static_cast<std::streamsize>(env.tail.size()));
+        left -= size;
+        env.code.clear();
+        const std::optional<u64> tail = VideoCommon::FileEnvironment::RecordTailSize(
+            env.head, record.kind == ListMesh, MostCodeBytes);
+        if (!tail || *tail != env.tail.size() || env.CodeSize() < 8) {
+            valid = false;
+        }
+    }
+    const size_t key_size =
+        record.kind == ListCompute ? header.compute_key_size : header.graphics_key_size;
+    if (left < key_size) {
+        return 2;
+    }
+    record.key.resize(key_size);
+    in.read(reinterpret_cast<char*>(record.key.data()), static_cast<std::streamsize>(key_size));
+    left -= key_size;
+    if (!valid) {
+        return 1;
+    }
+    const auto stage_of = [](const RawEnvironment& env) { return env.Stage(); };
+    // The code a record names must be the code of a program its key names, or a pipeline of
+    // one program would be built from another's code: a native program's key hash is its
+    // code's CityHash64 XOR NativeProgramTag (GenericEnvironment::Analyze). Not checkable from
+    // the list: a task/mesh record's vertex B / tessellation slots, which also carry the mesh
+    // state (ShaderCache, MeshStateHash); their code is still found by its own hash. A program
+    // that is not native (none of this game's 4,270 + 3,398 own records) is refused here.
+    if (record.kind == ListCompute) {
+        ComputePipelineCacheKey key;
+        std::memcpy(&key, record.key.data(), sizeof(key));
+        return count == 1 && record.envs.front().Stage() == Shader::Stage::Compute &&
+                       (record.envs.front().code_hash ^ NativeProgramTag) == key.unique_hash
+                   ? 0
+                   : 1;
+    }
+    if (std::ranges::any_of(record.envs, [&](const RawEnvironment& env) {
+            return stage_of(env) == Shader::Stage::Compute;
+        })) {
+        return 1;
+    }
+    const bool mesh = std::ranges::any_of(record.envs, [&](const RawEnvironment& env) {
+        return IsMeshStage(stage_of(env));
+    });
+    if (mesh != (record.kind == ListMesh)) {
+        return 1;
+    }
+    GraphicsPipelineCacheKey key;
+    std::memcpy(&key, record.key.data(), sizeof(key));
+    const auto programs = std::ranges::count_if(key.unique_hashes, [](u64 hash) {
+        return hash != 0;
+    });
+    if (static_cast<size_t>(programs) != count) {
+        return 1;
+    }
+    const bool paired = std::ranges::all_of(record.envs, [&](const RawEnvironment& env) {
+        const Shader::Stage stage = stage_of(env);
+        if (record.kind == ListMesh &&
+            (IsMeshStage(stage) || stage == Shader::Stage::VertexB ||
+             stage == Shader::Stage::TessellationControl ||
+             stage == Shader::Stage::TessellationEval)) {
+            return true;
+        }
+        return std::ranges::find(key.unique_hashes, env.code_hash ^ NativeProgramTag) !=
+               key.unique_hashes.end();
+    });
+    return paired ? 0 : 1;
+}
+
+void ImportPipelineList(const PipelineListImport& job) {
+    const auto begin = std::chrono::steady_clock::now();
+    const std::string list_name = Common::FS::PathToUTF8String(job.list);
+    const auto remove_outputs = [&job] {
+        std::error_code ignored;
+        for (const u8 kind : {ListGraphics, ListMesh, ListCompute}) {
+            std::filesystem::remove(ImportedFile(job.dir, kind), ignored);
+        }
+        std::filesystem::remove(job.dir / "prep_imported.stamp", ignored);
+    };
+    std::ifstream list(job.list, std::ios::binary | std::ios::ate);
+    if (!list.is_open()) {
+        remove_outputs();
+        LOG_WARNING(Render_Vulkan, "EDEN_UP_PIPELINE_LIST_IMPORT: no list at {}; nothing imported",
+                    list_name);
+        return;
+    }
+    // What the written files were made from. Kept as they are when it holds: the same list,
+    // the same shader set file and, unless every program was found last time, the same own
+    // record files (they grow when play makes new records).
+    std::error_code ec;
+    const auto stamp_of = [&ec](const std::filesystem::path& path) {
+        const auto size = std::filesystem::file_size(path, ec);
+        const auto time = std::filesystem::last_write_time(path, ec);
+        return ec ? std::string{"-"}
+                  : fmt::format("{}.{}", size,
+                                static_cast<long long>(time.time_since_epoch().count()));
+    };
+    static const bool rewrite_driver = Common::PeSwitch("EDEN_UP_PIPELINE_LIST_IMPORT_DRIVER");
+    std::string own_stamp;
+    for (const auto& [own, mesh] : job.own_files) {
+        own_stamp += ' ' + stamp_of(own);
+    }
