diff --git a/src/video_core/renderer_vulkan/vk_build_burst.h b/src/video_core/renderer_vulkan/vk_build_burst.h
new file mode 100644
index 0000000..f4e9037
--- /dev/null
+++ b/src/video_core/renderer_vulkan/vk_build_burst.h
@@ -0,0 +1,441 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <cerrno>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <mutex>
+#include <optional>
+#include <pthread.h>
+#include <time.h>
+#include <unistd.h>
+#include "common/cpu_features.h"
+#include "common/pe_switch.h"
+// headless/heap_arenas.inc (front part of 0592): per-thread build heap counters.
+extern "C" void eden_build_heap_enable(void) __attribute__((weak));
+extern "C" unsigned eden_build_heap_begin(void) __attribute__((weak));
+extern "C" void eden_build_heap_read(unsigned, long long*, unsigned long long*, unsigned long long*) __attribute__((weak));
+extern "C" void eden_build_heap_end(unsigned) __attribute__((weak));
+// ... and read only: a record's heap pieces grown (existing `grown`), sidecar net and name; the
+// count of non-arena requests under 1 MiB (EDEN_HEAP_CLASSES under1M).
+extern "C" int eden_heap_record_growth(unsigned, unsigned*, long long*, char*) __attribute__((weak));
+extern "C" unsigned long long eden_heap_under1m_count(void) __attribute__((weak));
+
+extern "C" void eden_heap_usage(std::size_t*, std::size_t*, std::size_t*) __attribute__((weak));
+extern "C" std::size_t eden_heap_committed(void) __attribute__((weak));
+extern "C" std::size_t eden_heap_large_held(unsigned*) __attribute__((weak));
+extern "C" unsigned long long eden_pool_largest_free(void) __attribute__((weak));
+namespace Vulkan::BuildBurst {
+using U64 = std::uint64_t;
+using Clock = std::chrono::steady_clock;
+enum class Origin : unsigned { New, Disk, Evicted, Unknown };
+inline constexpr unsigned kRecords = 512;   // EDEN_HEAP_THREADS; the front says where its table ends
+inline constexpr unsigned kThreadLines = 12; // event=thread lines per window, most grown first
+inline constexpr unsigned kPieceMib = 32;    // EDEN_HEAP_PIECE_SHIFT 25
+inline constexpr std::size_t kReporterStack = 256 * 1024;
+inline std::atomic<bool> enabled{};
+inline std::atomic<U64> main_held{};
+inline bool Enabled() noexcept { return enabled.load(std::memory_order_relaxed); }
+inline U64 Ms() noexcept {
+    return std::chrono::duration_cast<std::chrono::milliseconds>(Clock::now().time_since_epoch()).count();
+}
+// The app clock: Common::g_wall_clock, the one Eden::Performance::NowNs reads (time since start).
+inline U64 AppMs() noexcept { return static_cast<U64>(Common::g_wall_clock.GetTimeMS().count()); }
+// The line goes to the C stream stderr (stderr.log), never to a fixed descriptor: on the console
+// freopen cannot keep descriptors 1 and 2 (dup2: EPERM, headless/log_flusher.h), so a line written
+// to descriptor 1 reached no log file (T136's first cold start: 0 lines). The census's call
+// (memory_census.h): fputs on the stream, whose buffer is already set (no allocation); it takes
+// only the stream's own lock, held by a printing thread for one line; Poll calls it outside
+// state.mutex.
+inline void Write(const char* line, int n, std::size_t capacity) noexcept {
+    if (n <= 0 || std::size_t(n) >= capacity) return;
+    const int saved = errno;
+    std::fputs(line, stderr);
+    errno = saved;
+}
+struct Heap { U64 pieces{}, large{}, live{}, returned{}, main{}, pool{}, under1m{}; };
+inline Heap ReadHeap() noexcept {
+    Heap h;
+    if (eden_heap_committed) h.pieces = eden_heap_committed();
+    if (eden_heap_large_held) h.large = eden_heap_large_held(nullptr);
+    if (eden_heap_usage) {
+        std::size_t live{}, returned{};
+        eden_heap_usage(nullptr, &live, &returned);
+        h.live = live; h.returned = returned;
+    }
+    h.main = main_held.load(std::memory_order_relaxed);
+    if (eden_pool_largest_free) h.pool = eden_pool_largest_free();
+    if (eden_heap_under1m_count) h.under1m = eden_heap_under1m_count();
+    return h;
+}
+struct Entry {
+    const void* owner{};
+    U64 id{}, key{}, begin{}, end{};
+    unsigned token{}, kind{}; // graphics=0, compute=1, translator=2, GPU translation=3
+    Origin origin{Origin::Unknown};
+    bool mesh{}, done{}, success{}, queued{};
+    long long net{};
+    unsigned long long allocated{}, peak{};
+};
+// A heap record's counters at the start of a window.
+struct ThreadBase { unsigned grown{}; long long net{}; };
+struct State {
+    std::mutex mutex;
+    std::array<Entry, 512> jobs{};
+    U64 id{}, sequence{}, start{}, app_start{}, started{}, finished{}, failed{}, active{}, max_active{}, overflow{},
+        observations{}, pending{};
+    Heap first{}, peak{}, last{};
+    U64 pieces_max{}, large_max{}, main_max{}, pool_min{};
+    std::array<ThreadBase, kRecords> thread_base{};
+    unsigned thread_records{};
+    bool open{};
+    // Reporter lifetime (Lifetime below), under its own mutex.
+    std::mutex lifetime_mutex;
+    unsigned users{};
+};
+// Never destroyed: the detached reporter may still be in Poll while static destructors run (an
+// exit that skips renderer teardown), so neither the state nor its mutexes may go away.
+union StateHolder {
+    State value;
+    constexpr StateHolder() : value{} {}
+    ~StateHolder() {}
+};
+constinit inline StateHolder state_holder;
+constinit inline State& state = state_holder.value;
+inline void ReadJob(Entry& e) noexcept {
+    if (!e.queued && !e.done && e.token && eden_build_heap_read)
+        eden_build_heap_read(e.token, &e.net, &e.allocated, &e.peak);
+}
+inline void Sample() noexcept { // state.mutex held; never reads a pool object from a builder
+    const auto h = ReadHeap(); state.last = h;
+    if (h.live >= state.peak.live) state.peak = h;
+    state.pieces_max = std::max(state.pieces_max, h.pieces);
+    state.large_max = std::max(state.large_max, h.large);
+    state.main_max = std::max(state.main_max, h.main);
+    state.pool_min = std::min(state.pool_min, h.pool);
+}
+// state.mutex held. Up to 512 lock-free reads of the front's table, only when a window opens.
+inline void SnapshotThreads() noexcept {
+    state.thread_records = 0;
+    if (!eden_heap_record_growth) return;
+    for (unsigned i = 0; i < kRecords; ++i) {
+        ThreadBase b{};
+        if (!eden_heap_record_growth(i, &b.grown, &b.net, nullptr)) break;
+        state.thread_base[i] = b;
+        state.thread_records = i + 1;
+    }
+}
+inline void Open(U64 now) noexcept {
+    state.open = true; state.start = now; state.app_start = AppMs();
+    state.first = state.peak = state.last = ReadHeap();
+    state.pieces_max = state.first.pieces; state.large_max = state.first.large;
+    state.main_max = state.first.main; state.pool_min = state.first.pool;
+    SnapshotThreads();
+}
+struct ThreadRow { unsigned rec{}; unsigned grew{}; long long net{}; char name[16]{}; };
+// One window summary, up to kThreadLines thread lines (which heap record's requests grew the heap
+// in this window) and fixed-size job lines with the same window id. Every job active at reporting,
+// and every job finishing in this window, gets a line. Only the reporter thread calls this (and a
+// host check, never concurrently), so the row buffers are static, not on its 256 KiB stack. The
+// lines are written outside the observation mutex.
+inline void Poll(bool force = false) noexcept {
+    State& s = state;
+    static std::array<Entry, 512> rows{};
+    static std::array<ThreadRow, kRecords> threads{};
+    Heap first{}, peak{}, last{};
+    U64 seq{}, start{}, end{}, app_start{}, app_end{}, started{}, finished{}, failed{}, active{}, max{}, overflow{},
+        pmax{}, lmax{}, mmax{}, low{}, pending{};
+    std::size_t count{}, thread_count{};
+    {
+        std::lock_guard lock{s.mutex};
+        if (!s.open) return;
+        Sample(); end = Ms();
+        if (!force && end - s.start < 2000) return;
+        app_end = AppMs();
+        first=s.first; peak=s.peak; last=s.last;
+        seq=++s.sequence; pending=s.pending; start=s.start; app_start=s.app_start; started=s.started;
+        finished=s.finished;
+        failed=s.failed; active=s.active; max=s.max_active; overflow=s.overflow;
+        pmax=s.pieces_max; lmax=s.large_max; mmax=s.main_max; low=s.pool_min;
+        for (auto& e : s.jobs) if (e.owner) {
+            ReadJob(e); rows[count++] = e;
+            if (e.done) e = {};
+        }
+        for (unsigned i = 0; i < s.thread_records; ++i) {
+            ThreadRow row{};
+            unsigned grown{};
+            long long net{};
+            if (!eden_heap_record_growth(i, &grown, &net, row.name)) break;
+            const ThreadBase& b = s.thread_base[i];
+            row.rec = i;
+            row.grew = grown >= b.grown ? grown - b.grown : grown; // a counter never goes down
+            row.net = net - b.net;
+            if (row.grew != 0 || row.net != 0) threads[thread_count++] = row;
+        }
+        s.started=s.finished=s.failed=s.overflow=0; s.max_active=s.active;
+        s.open = false;
+        if (force) { s.pending=0; s.observations=0; for (auto& e : s.jobs) e={}; }
+        else if (s.observations || s.pending) Open(end);
+    }
+    U64 graphics{}, compute{}, mesh{}, origins[4]{}, other{};
+    for (std::size_t i=0; i<count; ++i) {
+        const auto& e = rows[i];
+        other += e.kind >= 2 && !e.done && !e.queued;
+        if (e.done && e.success && e.kind < 2) {
+            ++(e.kind == 0 ? graphics : compute); mesh += e.mesh;
+            ++origins[static_cast<unsigned>(e.origin)];
+        }
+    }
+    char line[2048];
+    const long long growth = static_cast<long long>(last.pieces) - static_cast<long long>(first.pieces) +
+                             static_cast<long long>(last.returned - first.returned);
+    int n = std::snprintf(line, sizeof(line),
+        "EDEN_BUILD_BURST event=window window=%llu start_ms=%llu end_ms=%llu app_start_ms=%llu app_end_ms=%llu "
+        "partial=%u "
+        "started=%llu inflight=%llu pending=%llu finished=%llu failed=%llu max_inflight=%llu overflow=%llu "
+        "graphics=%llu compute=%llu mesh=%llu new=%llu disk=%llu evicted=%llu unknown=%llu other_inflight=%llu "
+        "growth_b=%lld growth_mib=%lld under1m_n=%llu live_b=%llu pool_b=%llu pool_min_b=%llu "
+        "start_pieces_b=%llu peak_pieces_b=%llu end_pieces_b=%llu "
+        "start_large_b=%llu peak_large_b=%llu end_large_b=%llu "
+        "start_live_b=%llu peak_live_b=%llu peak_main_b=%llu main_b=%llu "
+        "pieces_max_b=%llu large_max_b=%llu main_max_b=%llu heap_hook=%u pool_hook=%u thread_hook=%u\n",
+        (unsigned long long)seq, (unsigned long long)start, (unsigned long long)end,
+        (unsigned long long)app_start, (unsigned long long)app_end, unsigned(force),
+        (unsigned long long)started, (unsigned long long)active, (unsigned long long)pending, (unsigned long long)finished,
+        (unsigned long long)failed, (unsigned long long)max, (unsigned long long)overflow,
+        (unsigned long long)graphics, (unsigned long long)compute, (unsigned long long)mesh,
+        (unsigned long long)origins[0], (unsigned long long)origins[1], (unsigned long long)origins[2],
+        (unsigned long long)origins[3], (unsigned long long)other,
+        growth, growth / (1LL<<20), (unsigned long long)(last.under1m - first.under1m),
+        (unsigned long long)last.live, (unsigned long long)last.pool,
+        (unsigned long long)low, (unsigned long long)first.pieces, (unsigned long long)peak.pieces,
+        (unsigned long long)last.pieces, (unsigned long long)first.large, (unsigned long long)peak.large,
+        (unsigned long long)last.large, (unsigned long long)first.live, (unsigned long long)peak.live,
+        (unsigned long long)peak.main, (unsigned long long)last.main, (unsigned long long)pmax,
+        (unsigned long long)lmax, (unsigned long long)mmax,
+        unsigned(eden_build_heap_begin && eden_build_heap_read && eden_build_heap_end),
+        unsigned(eden_pool_largest_free != nullptr), unsigned(eden_heap_record_growth != nullptr));
+    Write(line, n, sizeof(line));
+    // The heap records whose requests grew the heap most in this window (then the most net bytes
+    // inside build scopes): a VkPipelineBuilder name = the builders, the GPU or VulkanWorker thread =
+    // the draw path, "?" = a thread that never named itself (a driver helper, for example).
+    const std::size_t shown = std::min<std::size_t>(thread_count, kThreadLines);
+    std::partial_sort(threads.begin(), threads.begin() + shown, threads.begin() + thread_count,
+                      [](const ThreadRow& a, const ThreadRow& b) {
+                          if (a.grew != b.grew) return a.grew > b.grew;
+                          return a.net > b.net;
+                      });
+    for (std::size_t i = 0; i < shown; ++i) {
+        ThreadRow& t = threads[i];
+        for (char& c : t.name) { // one key=value token for the parser
+            if (c == 0) break;
+            if (c == ' ' || c == '=' || c == '\t' || c == '\n' || c == '\r') c = '_';
+        }
+        n = std::snprintf(line, sizeof(line),
+            "EDEN_BUILD_BURST event=thread window=%llu rec=%u name=%s grew_mib=%llu net_b=%lld\n",
+            (unsigned long long)seq, t.rec, t.name[0] ? t.name : "?",
+            (unsigned long long)t.grew * kPieceMib, t.net);
+        Write(line, n, sizeof(line));
+    }
+    for (std::size_t i=0; i<count; ++i) {
+        const auto& e = rows[i];
+        n = std::snprintf(line, sizeof(line),
+            "EDEN_BUILD_BURST event=job window=%llu id=%llu key=%016llx thread=%u kind=%u mesh=%u "
+            "origin=%u queued=%u done=%u success=%u begin_ms=%llu end_ms=%llu net_b=%lld allocated_b=%llu peak_b=%llu\n",
+            (unsigned long long)seq, (unsigned long long)e.id, (unsigned long long)e.key,
+            e.token, e.kind, unsigned(e.mesh), unsigned(e.origin), unsigned(e.queued), unsigned(e.done), unsigned(e.success),
+            (unsigned long long)e.begin, (unsigned long long)e.end, e.net, e.allocated, e.peak);
+        Write(line, n, sizeof(line));
+    }
+}
+// Register before QueueWork: provenance can arrive before a queued job starts, or
+// after a very fast one finishes. No per-pipeline metadata or closure capture.
+class Queued {
+public:
+    Queued(const void* owner, U64 key, unsigned kind, bool mesh = false) : owner_{owner} {
+        std::lock_guard lock{state.mutex};
+        const auto now = Ms();
+        if (!state.open) Open(now);
+        ++state.pending;
+        for (auto& e : state.jobs) if (!e.owner) {
+            e.owner=owner; e.id=++state.id; e.key=key; e.kind=kind; e.mesh=mesh; e.queued=true;
+            return;
+        }
+        ++state.overflow;
+    }
+    ~Queued() {
+        if (committed_) return;
+        std::lock_guard lock{state.mutex};
+        --state.pending;
+        for (auto& e : state.jobs) if (e.owner == owner_ && e.queued) { e={}; break; }
+    }
+    void Commit() noexcept { committed_=true; }
+    Queued(const Queued&) = delete;
+    Queued& operator=(const Queued&) = delete;
+private:
+    const void* owner_;
+    bool committed_{};
+};
+class Job {
+public:
+    Job(const void* owner, U64 key, unsigned kind, bool mesh = false)
+        : kind_{kind} {
+        std::lock_guard lock{state.mutex};
+        const auto now = Ms();
+        if (!state.open) Open(now);
+        ++state.observations;
+        if (kind < 2) {
+            ++state.started; ++state.active;
+            state.max_active = std::max(state.max_active, state.active);
+        }
+        token_ = eden_build_heap_begin && eden_build_heap_read && eden_build_heap_end ? eden_build_heap_begin() : 0;
+        if (kind < 2) {
+            --state.pending;
+            for (auto& e : state.jobs) if (e.owner == owner && e.queued) { entry_=&e; break; }
+        }
+        if (entry_) {
+            entry_->begin=now; entry_->token=token_; entry_->queued=false;
+        } else {
+            for (auto& e : state.jobs) if (!e.owner) { entry_=&e; break; }
+            if (entry_) *entry_ = Entry{owner, ++state.id, key, now, 0, token_, kind, Origin::Unknown, mesh};
+            else ++state.overflow;
+        }
+        Sample();
+    }
+    ~Job() {
+        std::lock_guard lock{state.mutex};
+        if (entry_) {
+            ReadJob(*entry_); entry_->done = true; entry_->success = success_; entry_->end = Ms();
+        }
+        if (token_ && eden_build_heap_end) eden_build_heap_end(token_);
+        --state.observations;
+        if (kind_ < 2) { --state.active; ++state.finished; state.failed += !success_; }
+        Sample();
+    }
+    void Success() noexcept { success_ = true; }
+    Job(const Job&) = delete;
+    Job& operator=(const Job&) = delete;
+private:
+    bool success_{};
+    unsigned kind_{};
+    Entry* entry_{};
+    unsigned token_{};
+};
+inline void Classify(const void* owner, Origin origin) noexcept {
+    if (!Enabled()) return;
+    std::lock_guard lock{state.mutex};
+    // Constructors queue asynchronously; a fast job can have finished already.
+    Entry* latest{};
+    for (auto& e : state.jobs) if (e.owner == owner && (!latest || e.id > latest->id)) latest = &e;
+    if (latest) latest->origin = origin;
+}
+// Owned-thread publication, at translation boundaries and once per frame.
+// These pool walks never run on the reporter or builder threads.
+template <class Pools>
+class PoolSample {
+public:
+    explicit PoolSample(Pools* p) noexcept : pools_{p} { Publish(); }
+    ~PoolSample() { Publish(); }
+    void Publish() const noexcept {
+        if (pools_) main_held.store(pools_->inst.HeldBytes() + pools_->block.HeldBytes() +
+                                   pools_->flow_block.HeldBytes(), std::memory_order_relaxed);
+    }
+private: Pools* pools_;
+};
+// One process reporter shared by caches: a detached pthread with its own 256 KiB stack, so no
+// joinable std::thread is left for a static destructor (std::terminate at an exit that skips the
+// renderer's teardown). Lifetime is declared immediately before workers, hence stops after the
+// workers join; it waits for the reporter's last window at most 1 s and never throws.
+inline std::atomic<bool> stop{}, running{};
+inline void SleepMs(long ms) noexcept {
+    timespec t{ms / 1000, (ms % 1000) * 1000000L};
+    while (nanosleep(&t, &t) != 0 && errno == EINTR) {}
+}
+inline void* ReporterMain(void*) noexcept {
+    while (!stop.load(std::memory_order_acquire)) {
+        for (int i = 0; i < 10 && !stop.load(std::memory_order_acquire); ++i)
+            SleepMs(10);
+        if (stop.load(std::memory_order_acquire)) break;
+        Poll(); // no dependency on TickFrame or a draw completing
+    }
+    Poll(true);
+    running.store(false, std::memory_order_release);
+    return nullptr;
+}
+// lifetime_mutex held.
+inline bool StartReporter() noexcept {
+    char line[256];
+    for (int i = 0; i < 1000 && running.load(std::memory_order_acquire); ++i) SleepMs(1);
+    if (running.load(std::memory_order_acquire)) {
+        const int n = std::snprintf(line, sizeof(line),
+            "EDEN_BUILD_BURST event=off reason=old_reporter_still_running\n");
+        Write(line, n, sizeof(line));
+        return false;
+    }
+    pthread_attr_t attr;
+    int error = pthread_attr_init(&attr);
+    if (error == 0) {
+        error = pthread_attr_setstacksize(&attr, kReporterStack);
+        if (error == 0) error = pthread_attr_setdetachstate(&attr, PTHREAD_CREATE_DETACHED);
+        if (error == 0) {
+            stop.store(false, std::memory_order_release);
+            running.store(true, std::memory_order_release);
+            pthread_t thread;
+            error = pthread_create(&thread, &attr, &ReporterMain, nullptr);
+            if (error != 0) running.store(false, std::memory_order_release);
+        }
+        pthread_attr_destroy(&attr);
+    }
+    if (error != 0) {
+        const int n = std::snprintf(line, sizeof(line),
+            "EDEN_BUILD_BURST event=off reason=no_reporter_thread error=%d (switch stays off)\n", error);
+        Write(line, n, sizeof(line));
+        return false;
+    }
+    if (eden_build_heap_enable) eden_build_heap_enable();
+    const int n = std::snprintf(line, sizeof(line),
+        "EDEN_BUILD_BURST event=on steady_ms=%llu app_ms=%llu window_ms=2000 reporter_stack_kib=%u "
+        "heap_hook=%u pool_hook=%u thread_hook=%u under1m_hook=%u\n",
+        (unsigned long long)Ms(), (unsigned long long)AppMs(), unsigned(kReporterStack >> 10),
+        unsigned(eden_build_heap_begin && eden_build_heap_read && eden_build_heap_end),
+        unsigned(eden_pool_largest_free != nullptr), unsigned(eden_heap_record_growth != nullptr),
+        unsigned(eden_heap_under1m_count != nullptr));
+    Write(line, n, sizeof(line));
+    return true;
+}
+// lifetime_mutex held.
+inline void StopReporter() noexcept {
+    stop.store(true, std::memory_order_release);
+    for (int i = 0; i < 1000 && running.load(std::memory_order_acquire); ++i) SleepMs(1);
+    if (running.load(std::memory_order_acquire)) {
+        char line[128];
+        const int n = std::snprintf(line, sizeof(line), "EDEN_BUILD_BURST event=stop finished=0 waited_ms=1000\n");
+        Write(line, n, sizeof(line));
+    }
+}
+struct Lifetime {
+    Lifetime() noexcept {
+        static const bool value = Common::PeSwitch("EDEN_UP_BUILD_BURST_LOG");
+        if (!value) return;
+        std::lock_guard lock{state.lifetime_mutex};
+        if (state.users == 0 && !StartReporter()) return; // said why; stays off
+        ++state.users;
+        active_ = true;
+        enabled.store(true, std::memory_order_relaxed);
+    }
+    ~Lifetime() {
+        if (!active_) return;
+        std::lock_guard lock{state.lifetime_mutex};
+        if (--state.users != 0) return;
+        enabled.store(false, std::memory_order_relaxed);
+        StopReporter();
+    }
+    Lifetime(const Lifetime&) = delete;
+    Lifetime& operator=(const Lifetime&) = delete;
+private:
+    bool active_{};
+};
+} // namespace Vulkan::BuildBurst
