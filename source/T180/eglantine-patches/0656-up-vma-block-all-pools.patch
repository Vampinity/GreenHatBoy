index 52239e5..4f7db1b 100644
--- a/src/video_core/vulkan_common/vulkan_device.h
+++ b/src/video_core/vulkan_common/vulkan_device.h
@@ -275,12 +275,20 @@ public:
         DeviceBuffers,
         TrimmedImages, ///< EDEN_UP_VMA_TRIM's small blocks for images (vma_trim.h)
     };
-    static constexpr VkDeviceSize SeparatePoolBlockSize = 16ULL << 20;
+    /// The block size of the separate pools: 16 MiB, or EDEN_UP_VMA_BLOCK_MIB's (0656). Read once.
+    static VkDeviceSize SeparatePoolBlockSize();
+
+    /// EDEN_UP_VMA_BLOCK_MIB=<n> (0656; lethevimlet's EDEN_NX2_VMA_BLOCK_MIB, oot-bc250 9cc177c +
+    /// c8594b8): n MiB for the default blocks AND the separate pools, and half of it as the size
+    /// over which an allocation takes memory of its own. Digits only, 2 to 64; anything else, or
+    /// unset: 0 (today's sizes: EDEN_VMA_BLOCK_MIB or 16 for the default blocks, 16 for the pools).
+    /// Read once.
+    static VkDeviceSize UpVmaBlockBytes();
 
     /// The pool of that kind for a memory type, created on first use (null if that failed).
     /// `block_size` counts only when the call creates it.
     VmaPool GetSeparatePool(SeparatePool kind, u32 memory_type,
-                            VkDeviceSize block_size = SeparatePoolBlockSize) const;
+                            VkDeviceSize block_size = SeparatePoolBlockSize()) const;
 
     /// Adds the blocks and the use of the pools of that kind made so far, all memory types
     /// (vmaGetPoolStatistics: one step per block, no walk of the allocations). For the
diff --git a/src/video_core/vulkan_common/vulkan_memory_allocator.cpp b/src/video_core/vulkan_common/vulkan_memory_allocator.cpp
index d21cb41..380a970 100644
--- a/src/video_core/vulkan_common/vulkan_memory_allocator.cpp
+++ b/src/video_core/vulkan_common/vulkan_memory_allocator.cpp
@@ -122,11 +122,14 @@ namespace {
     return mark;
 }
 
-/// Half of VMA's own blocks (EDEN_VMA_BLOCK_MIB, 16 MiB, read as vulkan_device.cpp reads it):
-/// what VMA gives memory of its own anyway.
+/// Half of VMA's own blocks (EDEN_VMA_BLOCK_MIB, 16 MiB, read as vulkan_device.cpp reads it;
+/// EDEN_UP_VMA_BLOCK_MIB over both, 0656): what VMA gives memory of its own anyway.
 [[nodiscard]] VkDeviceSize TrimDefaultHalfBlock() {
     static const VkDeviceSize half = [] {
         VkDeviceSize bytes = 16ULL << 20;
+        if (const VkDeviceSize up = Device::UpVmaBlockBytes(); up != 0) {
+            return up / 2;
+        }
         if (const char* value = std::getenv("EDEN_VMA_BLOCK_MIB")) {
             const unsigned long mib = std::strtoul(value, nullptr, 10);
             if (mib >= 2 && mib <= 64) {
@@ -715,7 +718,7 @@ VmaAllocation MemoryAllocator::AllocateSparseMemory(const VkMemoryRequirements &
     // In a pool of their own (see Device::SeparatePool); anything over half a block, or a pool
     // allocation that fails, takes the default blocks.
     u32 memory_type{};
-    if (requirements.size <= Device::SeparatePoolBlockSize / 2 &&
+    if (requirements.size <= Device::SeparatePoolBlockSize() / 2 &&
         vmaFindMemoryTypeIndex(allocator, requirements.memoryTypeBits, &alloc_ci, &memory_type) ==
             VK_SUCCESS) {
         if (const VmaPool pool =
@@ -750,7 +753,7 @@ bool MemoryAllocator::CreateBufferInSeparatePool(const VkBufferCreateInfo& ci, M
                                                  VmaAllocationInfo& alloc_info) const {
     // The buffer cache's buffers, churned by its collector: in a pool of their own (see
     // Device::SeparatePool). Anything over half a block takes the default blocks (dedicated).
-    if (usage != MemoryUsage::DeviceLocal || ci.size > Device::SeparatePoolBlockSize / 2) {
+    if (usage != MemoryUsage::DeviceLocal || ci.size > Device::SeparatePoolBlockSize() / 2) {
         return false;
     }
     u32 memory_type{};
