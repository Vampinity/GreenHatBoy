+++ b/src/video_core/buffer_cache/buffer_cache.h
@@ -270,6 +270,17 @@ void BufferCache<P>::ReleasePendingBuffers() {
     }
 }
 
+template <class P>
+std::pair<size_t, u64> BufferCache<P>::DeletedWaiting() const {
+    size_t buffers = 0;
+    u64 bytes = 0;
+    delayed_destruction_ring.ForEach([&](const Buffer& buffer) {
+        ++buffers;
+        bytes += buffer.SizeBytes();
+    });
+    return {buffers, bytes};
+}
