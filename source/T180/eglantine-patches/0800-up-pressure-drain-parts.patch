+bool MasterSemaphore::WaitFor(u64 tick, u64 timeout_ns) {
+    if (IsFree(tick)) {
+        return true;
+    }
+    Refresh();
+    if (IsFree(tick) || timeout_ns == 0) {
+        return IsFree(tick);
+    }
+    if (!semaphore) {
+        // The fence path: the wait thread moves gpu_tick; look every 200 us until the deadline.
+        const auto deadline =
+            std::chrono::steady_clock::now() + std::chrono::nanoseconds{timeout_ns};
+        while (!IsFree(tick)) {
+            if (std::chrono::steady_clock::now() >= deadline) {
+                return false;
+            }
+            std::this_thread::sleep_for(std::chrono::microseconds{200});
+        }
+        return true;
+    }
+    const VideoCommon::SubmitStats::WaitTimer stats_timer{tick};
+    const bool reached = semaphore.Wait(tick, timeout_ns);
+    Refresh();
+    return reached || IsFree(tick);
+}
