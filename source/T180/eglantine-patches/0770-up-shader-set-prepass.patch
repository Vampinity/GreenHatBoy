+//   1. the keys list files name (first_start.list and the other *.list files of the shader
+//      folder and the title folder, EDEN_UP_PIPELINE_LIST_IMPORT=<path>): the ones the game
+//      asked for before;
+//   2. the records of programs earlier sessions saw live (prep_shader_set.live);
+//   3. the rest of the set, in the file's order.
+// A key already in the kept store is never queued (a second start does only what is left), and
+// a key the set holds more than once is queued once. It ends when all is done, at
+// EDEN_UP_SHADER_SET_PREPASS_MAX_S, under the disk floor, after EDEN_UP_SHADER_SET_PREPASS_MEMORY_WAIT_S
+// (300) under the memory floor, or when shader_set_prepass.skip appears in the shader folder (the
+// file is removed, so it skips one start). What is left goes on beside the game as before
+// (StartShaderSet), or at the next start. The boot screen shows done / total, records a second
+// and minutes left (LoadCallbackStage::Prepare); the log has a line every 10 s and one at the end.
+// Off: one cached switch read in LoadDiskResources.
+
+namespace {
+/// The keys of the list files, in order, each once. first_start.list (EDEN_FIRST_START_2, its
+/// header must name this cache version, driver, lowering tag and canonical keys; G rows only:
+/// the set has no task/mesh or compute records) and pipeline lists (EGPLIST1, 0720: graphics
+/// records; the key is taken with this device's driver fields, as EDEN_UP_PIPELINE_LIST_IMPORT_
+/// DRIVER takes it, and hashed as stored: a list of canonical records matches the set's keys).
+struct PrepassLists {
+    std::vector<u64> keys;
+    std::string report;
+};
+
+PrepassLists ReadPrepassLists(const std::vector<std::filesystem::path>& files, u32 cache_version,
+                              u32 driver_id, u32 driver_version, bool canonical,
+                              const std::function<u64(GraphicsPipelineCacheKey&)>& list_key_hash) {
+    PrepassLists out;
+    std::unordered_set<u64> seen;
+    constexpr size_t MostKeys = 1U << 20;
+    constexpr u64 MostBytes = 256ULL << 20;
+    const auto add = [&](u64 hash) {
+        if (out.keys.size() < MostKeys && seen.insert(hash).second) {
+            out.keys.push_back(hash);
+        }
+    };
+    for (const auto& path : files) {
+        const std::string name = path.filename().string();
+        std::error_code error;
+        const u64 bytes = std::filesystem::file_size(path, error);
+        if (error || bytes > MostBytes) {
+            out.report += fmt::format(" {}: not read ({});", name, error ? "no size" : "over 256 MiB");
+            continue;
+        }
+        std::ifstream in{path, std::ios::binary};
+        std::array<char, 8> magic{};
+        if (!in.read(magic.data(), magic.size())) {
+            out.report += fmt::format(" {}: too short;", name);
+            continue;
+        }
+        const size_t before = out.keys.size();
+        if (std::string_view{magic.data(), magic.size()} == "EDEN_FIR") {
+            in.seekg(0);
+            std::string line;
+            std::getline(in, line);
+            std::map<std::string, std::string> fields;
+            for (size_t at = 0; at < line.size();) {
+                const size_t end = std::min(line.find(' ', at), line.size());
+                const std::string token = line.substr(at, end - at);
+                if (const size_t equals = token.find('='); equals != std::string::npos) {
+                    fields[token.substr(0, equals)] = token.substr(equals + 1);
+                }
+                at = end + 1;
+            }
+            const bool fits =
+                line.rfind("EDEN_FIRST_START_2 ", 0) == 0 &&
+                fields["cache"] == fmt::format("{}", cache_version) &&
+                fields["driver"] == fmt::format("{:x}.{:x}", driver_id, driver_version) &&
+                fields["canonical"] == (canonical ? "1" : "0") &&
+                fields["lowering"] == fmt::format("{:016x}", ShaderSetLoweringTag);
+            if (!fits) {
+                out.report += fmt::format(" {}: made with another cache, driver, lowering or key "
+                                          "policy, not used;",
+                                          name);
+                continue;
+            }
+            size_t rows = 0, other_rows = 0;
+            while (std::getline(in, line)) {
+                if (line.size() == 18 && line[0] == 'G' && line[1] == ' ') {
+                    add(std::strtoull(line.c_str() + 2, nullptr, 16));
+                    ++rows;
+                } else if (!line.empty() && line[0] != '#' && line[0] != 'T') {
+                    ++other_rows; // M (task/mesh) and C (compute): not in the set
+                }
+            }
+            out.report += fmt::format(" {}: {} graphics rows ({} new), {} mesh or compute;", name,
+                                      rows, out.keys.size() - before, other_rows);
+            continue;
+        }
+        if (std::string_view{magic.data(), magic.size()} != "EGPLIST1") {
+            out.report += fmt::format(" {}: not a list;", name);
+            continue;
+        }
+        u32 header[6]{}; // format, cache version, graphics key size, compute key size, count, flags
+        if (!in.read(reinterpret_cast<char*>(header), sizeof(header)) || header[0] != 1 ||
+            header[1] != cache_version || header[2] != sizeof(GraphicsPipelineCacheKey)) {
+            out.report += fmt::format(" {}: another format or cache version;", name);
+            continue;
+        }
+        u64 left = bytes - 32;
+        size_t graphics = 0, others = 0;
+        bool cut = false;
+        for (u32 record = 0; record < header[4] && !cut; ++record) {
+            std::array<u8, 4> head{};
+            if (left < head.size() || !in.read(reinterpret_cast<char*>(head.data()), 4)) {
+                cut = true;
+                break;
+            }
+            left -= head.size();
+            const u8 kind = head[0];
+            const u32 count = head[1];
+            if (count == 0 || count > 6 || kind > 2) {
+                cut = true;
+                break;
+            }
+            for (u32 program = 0; program < count && !cut; ++program) {
+                u64 code_hash{};
+                u32 size{};
+                if (left < 12 || !in.read(reinterpret_cast<char*>(&code_hash), 8) ||
+                    !in.read(reinterpret_cast<char*>(&size), 4) || size > left - 12) {
+                    cut = true;
+                    break;
+                }
+                left -= 12 + u64{size};
+                in.seekg(size, std::ios::cur);
+            }
+            const u64 key_size = kind == 0 ? header[3] : header[2];
+            if (cut || left < key_size) {
+                cut = true;
+                break;
+            }
+            left -= key_size;
+            if (kind != 1) {
+                in.seekg(static_cast<std::streamoff>(key_size), std::ios::cur);
+                ++others;
+                continue;
+            }
+            GraphicsPipelineCacheKey key;
+            if (!in.read(reinterpret_cast<char*>(&key), sizeof(key))) {
+                cut = true;
+                break;
+            }
+            add(list_key_hash(key));
+            ++graphics;
+        }
+        out.report += fmt::format(" {}: {} graphics records ({} new), {} task/mesh or compute{};",
+                                  name, graphics, out.keys.size() - before, others,
+                                  cut ? ", cut short" : "");
+    }
+    return out;
+}
+
+/// Free space where the store grows, in MB (0 when it cannot be read).
+u64 FreeDiskMegabytes(const std::filesystem::path& dir) {
+    std::error_code error;
+    const auto space = std::filesystem::space(dir, error);
+    return error ? 0 : space.available >> 20;
+}
+} // namespace
+
+void PipelineCache::RunShaderSetPrepass(const std::filesystem::path& title_dir,
+                                        std::stop_token stop,
+                                        const VideoCore::DiskResourceLoadCallback& callback) try {
+    using Clock = std::chrono::steady_clock;
+    const auto begin = Clock::now();
+    const auto since = [](Clock::time_point from) {
+        return std::chrono::duration<double>(Clock::now() - from).count();
+    };
+    const auto output_dir = pipeline_cache_filename.parent_path();
+    // Threads of its own (EDEN_UP_SHADER_SET_PREPASS_WORKERS, default one per core but one, at
+    // most 16), gone when the prepass ends: EDEN_NX2_PIPELINE_WORKERS (2 in test d4) stays the
+    // number for play.
+    const size_t cores = std::max<size_t>(std::thread::hardware_concurrency(), 2) - 1;
+    const size_t jobs =
+        device.HasBrokenParallelShaderCompiling()
+            ? size_t{1}
+            : std::clamp<size_t>(ShaderSetNumber("EDEN_UP_SHADER_SET_PREPASS_WORKERS", cores), 1, 16);
+    const size_t max_seconds = ShaderSetNumber("EDEN_UP_SHADER_SET_PREPASS_MAX_S", 0);
+    const size_t memory_wait = ShaderSetNumber("EDEN_UP_SHADER_SET_PREPASS_MEMORY_WAIT_S", 300);
+    LOG_INFO(Render_Vulkan,
+             "Shader set prepass (EDEN_UP_SHADER_SET_PREPASS=1): before the game starts, {} "
+             "threads of its own ({} cores but one), full duty, no cap, time limit {}, memory "
+             "floor {} MB (waits up to {} s), disk floor {} MB",
+             jobs, cores, max_seconds ? fmt::format("{} s", max_seconds) : "none",
+             VideoCommon::ShaderSet::MinimumFreeBytes() >> 20, memory_wait,
+             VideoCommon::ShaderSet::MinimumFreeDiskBytes() >> 20);
+
+    // 1. The set file: reused while its stamp holds, else made now (once; minutes) at full duty.
+    VideoCommon::ShaderSet::OverrideDuty(100);
+    VideoCommon::ShaderSet::Outputs outputs;
+    try {
+        outputs = VideoCommon::ShaderSet::Prepare(
+            visual_workaround_title, title_dir, output_dir, MakeShaderSetIdentity(),
+            [this](std::span<const u8> state, std::array<u64, 6> hashes, u32 read_mask,
+                   std::vector<u8>& bytes) {
+                return MapShaderSetState(state, hashes, read_mask, bytes);
+            },
+            stop);
+    } catch (...) {
+        VideoCommon::ShaderSet::OverrideDuty(0);
+        throw;
+    }
+    VideoCommon::ShaderSet::OverrideDuty(0);
+    if (stop.stop_requested()) {
+        return;
+    }
+    shader_set_prepared = true;
+    shader_set_prepared_records = outputs.records;
+    shader_set_prepared_programs = outputs.programs;
+    if (outputs.records.empty()) {
+        LOG_WARNING(Render_Vulkan, "Shader set prepass: no set file this start ({:.0f} s); "
+                                   "nothing prepared",
+                    since(begin));
+        return;
+    }
+    if (VideoCommon::ShaderSet::FreeMemoryBytes() == 0 &&
+        !VideoCommon::ShaderSet::MemoryCheckWaived()) {
+        return; // PrepareShaderSet says why
+    }
+    const double set_seconds = since(begin);
+
+    // 2. What is left: every usable key of the set not in the kept store, once.
+    std::unordered_set<u64> left;
+    size_t records = 0, known = 0, repeats = 0, unusable = 0;
+    const auto count_begin = Clock::now();
+    const bool counted = VideoCommon::ShaderSet::ReadRecords(
+        outputs.records, CACHE_VERSION, [](std::ifstream&, std::vector<VideoCommon::FileEnvironment>) {},
+        {},
+        [&](std::span<const u8> bytes) {
+            if (stop.stop_requested()) {
+                throw std::runtime_error("stopped at shutdown");
+            }
+            ++records;
+            if (bytes.size() != sizeof(GraphicsPipelineCacheKey)) {
+                ++unusable;
+                return false;
+            }
+            GraphicsPipelineCacheKey key;
+            std::memcpy(static_cast<void*>(&key), bytes.data(), sizeof(key));
+            if (key.unique_hashes[0] != 0 || key.state.driver_id != dynamic_features.driver_id ||
+                key.state.driver_version != dynamic_features.driver_version ||
+                key.state.app_stage.Value() == Tegra::Engines::Maxwell3D::EngineHint::OnHLEMacro ||
+                OtherDeviceBits(key) != 0) {
+                ++unusable;
+                return false;
+            }
+            const u64 hash = key.Hash();
+            if (prep_store.Contains(hash)) {
+                ++known;
+            } else if (!left.insert(hash).second) {
+                ++repeats;
+            }
+            return false; // keys only: no record's environments are built
+        });
+    if (!counted || stop.stop_requested()) {
+        LOG_WARNING(Render_Vulkan, "Shader set prepass: {} could not be read to its end; "
+                                   "nothing prepared before play",
+                    outputs.records.filename().string());
+        return;
+    }
+    const size_t total = left.size();
+
+    // 3. The keys list files name.
+    std::vector<std::filesystem::path> list_files;
+    {
+        std::vector<std::filesystem::path> dirs{output_dir};
+        if (title_dir != output_dir) {
+            dirs.push_back(title_dir);
+        }
+        for (const auto& dir : dirs) {
+            std::vector<std::filesystem::path> found;
+            std::error_code error;
+            for (std::filesystem::directory_iterator it{dir, error}, end; !error && it != end;
+                 it.increment(error)) {
+                if (it->is_regular_file(error) && it->path().extension() == ".list") {
+                    found.push_back(it->path());
+                }
+            }
+            // first_start.list first, then its previous copy, then the rest by name.
+            const auto rank = [](const std::filesystem::path& path) {
+                const auto name = path.filename().string();
+                return name == "first_start.list" ? 0 : name == "first_start.prev.list" ? 1 : 2;
+            };
+            std::ranges::sort(found, [&rank](const auto& a, const auto& b) {
+                return std::pair{rank(a), a.filename().string()} <
+                       std::pair{rank(b), b.filename().string()};
+            });
+            list_files.insert(list_files.end(), found.begin(), found.end());
+        }
+        if (const char* const value = std::getenv("EDEN_UP_PIPELINE_LIST_IMPORT");
+            value != nullptr && value[0] != '\0' && std::string_view{value} != "1") {
+            list_files.emplace_back(value);
+        }
+    }
+    const auto lists = ReadPrepassLists(
+        list_files, CACHE_VERSION, static_cast<u32>(device.GetDriverID()), device.GetDriverVersion(),
+        canonical_keys, [this](GraphicsPipelineCacheKey& key) {
+            key.state.driver_id = dynamic_features.driver_id;
+            key.state.driver_version = dynamic_features.driver_version;
+            return key.Hash();
+        });
+    std::unordered_set<u64> listed;
+    size_t listed_known = 0, listed_missing = 0;
+    for (const u64 hash : lists.keys) {
+        if (left.contains(hash)) {
+            listed.insert(hash);
+        } else if (prep_store.Contains(hash)) {
+            ++listed_known;
+        } else {
+            ++listed_missing;
+        }
+    }
+    // About 21 KiB a kept record (d4: 820 kept in 17 MiB; own stores 18-20.5 KiB).
+    const u64 disk_needed_mb = (u64{total} * 21) >> 10;
+    const u64 disk_free_mb = FreeDiskMegabytes(output_dir);
+    LOG_INFO(Render_Vulkan,
+             "Shader set prepass: set file ready in {:.0f} s; {} records: {} keys to prepare, {} "
+             "known already, {} repeats of a key, {} not for this device ({:.1f} s to count). "
+             "Lists: {} keys from {} files, {} of them to prepare first, {} known already, {} not "
+             "in the set;{} Needs about {} MB of disk, {} MB free (floor {} MB)",
+             set_seconds, records, total, known, repeats, unusable, since(count_begin),
+             lists.keys.size(), list_files.size(), listed.size(), listed_known, listed_missing,
+             lists.report, disk_needed_mb, disk_free_mb,
+             VideoCommon::ShaderSet::MinimumFreeDiskBytes() >> 20);
+    if (total == 0) {
+        return;
+    }
+
+    // 4. The passes, with a reporter beside them: the boot screen twice a second, the log every
+    // 10 s, the skip flag once a second.
+    const auto pool = std::make_unique<Common::ThreadWorker>(jobs, "ShaderSetPrepass");
+    ShaderSetPass pass;
+    pass.left = &left;
+    pass.pool = pool.get();
+    pass.jobs = jobs;
+    pass.memory_wait = std::chrono::seconds{memory_wait};
+    if (max_seconds != 0) {
+        pass.deadline = begin + std::chrono::seconds{max_seconds};
+    }
+    const auto pass_begin = Clock::now();
+    const auto rate = [&] {
+        const double seconds = since(pass_begin);
+        return seconds > 0 ? static_cast<double>(pass.processed.load()) / seconds : 0.0;
+    };
+    const auto minutes_left = [&](double per_second) {
+        const size_t done = pass.processed.load();
+        return per_second > 0 ? static_cast<double>(total - std::min(done, total)) / per_second / 60.0
+                              : 0.0;
+    };
+    std::mutex callback_mutex;
+    callback(VideoCore::LoadCallbackStage::Prepare, 0, total);
+    std::jthread reporter([&](std::stop_token done) {
+        Common::SetCurrentThreadName("ShaderSetPrepass");
+        const std::array<std::filesystem::path, 2> flags{output_dir / "shader_set_prepass.skip",
+                                                         title_dir / "shader_set_prepass.skip"};
+        for (unsigned tick = 1; Common::StoppableTimedWait(done, std::chrono::milliseconds{500});
+             ++tick) {
+            {
+                std::scoped_lock lock{callback_mutex};
+                callback(VideoCore::LoadCallbackStage::Prepare,
+                         std::min(pass.processed.load(), total), total);
+            }
+            if (tick % 2 == 0 && !pass.skip.load()) {
+                for (const auto& flag : flags) {
+                    std::error_code error;
+                    if (std::filesystem::exists(flag, error)) {
+                        std::filesystem::remove(flag, error);
+                        pass.skip.store(true);
+                        LOG_INFO(Render_Vulkan, "Shader set prepass: {} found (removed); the "
+                                                "game starts after the builds in flight",
+                                 Common::FS::PathToUTF8String(flag));
+                        break;
+                    }
+                }
+            }
+            if (tick % 20 == 0) {
+                const double per_second = rate();
+                LOG_INFO(Render_Vulkan,
+                         "Shader set prepass: {} of {} ({} of {} listed), {:.1f} a second, about "
+                         "{:.0f} min left; {} kept, {} failed; {:.0f} s; {} MB free memory, {} MB "
+                         "free disk, store {} MiB",
+                         pass.processed.load(), total, pass.listed_done.load(), listed.size(),
+                         per_second, minutes_left(per_second), pass.kept.load(), pass.failed.load(),
+                         since(pass_begin), VideoCommon::ShaderSet::FreeMemoryBytes() >> 20,
+                         FreeDiskMegabytes(output_dir), prep_store.DataBytes() >> 20);
+            }
+        }
+    });
+    if (!listed.empty()) {
+        pass.only_keys = &listed;
+        (void)PrepareShaderSet(outputs.records, stop, nullptr, &pass);
+        pass.only_keys = nullptr;
+    }
+    if (pass.ended.empty() && !stop.stop_requested()) {
+        std::unordered_set<u64> earlier;
+        for (const u64 hash :
+             VideoCommon::ShaderSet::ReadPrograms(output_dir / "prep_shader_set.live")) {
+            earlier.insert(hash);
+        }
+        if (!earlier.empty()) {
+            (void)PrepareShaderSet(outputs.records, stop, &earlier, &pass);
+        }
+    }
+    if (pass.ended.empty() && !stop.stop_requested()) {
+        (void)PrepareShaderSet(outputs.records, stop, nullptr, &pass);
+    }
+    reporter.request_stop();
+    reporter.join();
+    const size_t done = std::min(pass.processed.load(), total);
+    callback(VideoCore::LoadCallbackStage::Prepare, done, total);
+    const double per_second = rate();
+    LOG_INFO(Render_Vulkan,
+             "Shader set prepass done: {} of {} keys taken ({} kept, {} failed; {} of {} listed) in "
+             "{:.0f} s ({:.1f} a second; {:.0f} s with the set file and the count); {} left for "
+             "beside the game or the next start; store {} records, {} MiB; {} MB free disk; {}",
+             done, total, pass.kept.load(), pass.failed.load(), pass.listed_done.load(),
+             listed.size(), since(pass_begin), per_second, since(begin), left.size(),
+             prep_store.Size(), prep_store.DataBytes() >> 20, FreeDiskMegabytes(output_dir),
+             stop.stop_requested() ? std::string{"stopped at shutdown"}
+             : pass.ended.empty()  ? std::string{"all done"}
+                                   : "ended early: " + pass.ended);
+} catch (const std::exception& e) {
+    VideoCommon::ShaderSet::OverrideDuty(0);
+    LOG_WARNING(Render_Vulkan, "Shader set prepass: ended: {}; the game starts", e.what());
+}
