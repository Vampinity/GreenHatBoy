+void Maxwell3D::ProcessDirtyRegisters(u32 method, u32 argument) {
+    WriteDirtyRegister(method, argument);
+}
+
+// EDEN_UP_REG_WRITE_ONE_CALL (waveydude/Eglantine-PS5- 711c2c7, his core patch 0916, adapted from
+// jpkto's zortos293/Lichii PR #1095, 73a1b58e7): a state register is written in one inlined step,
+// 260.7 instead of 278.8 instructions a write upstream. What
+// CallMethod does before its state register branch cannot apply to these writes: no macro
+// collects parameters, the method is no macro call, the write history, the first-write trace
+// and the profile are off, and SET_SHADOW_RAM_CONTROL is in execution_mask.
+[[gnu::always_inline]] inline bool Maxwell3D::OneCallEligible(bool plain, u32 method) const {
+    return plain && executing_macro == 0 && method < MacroRegistersStart &&
+           !execution_mask[method] && !VideoCommon::Nx2Profile::Enabled();
+}
+
+// CallMethod's state register branch and ProcessShadowRam, without acting on it.
+[[gnu::always_inline]] inline Maxwell3D::OneCallPlan Maxwell3D::PlanOneCall(
+    u32 method, u32 method_argument) const {
+    const auto control = shadow_state.shadow_ram_control;
+    OneCallPlan plan{method_argument, false, false};
+    if (control == Regs::ShadowRamControl::Track ||
+        control == Regs::ShadowRamControl::TrackWithFilter) {
+        plan.track = true;
+    } else if (control == Regs::ShadowRamControl::Replay) {
+        plan.value = shadow_state.reg_array[method];
+    }
+    plan.write = !one_call_skip_same || regs.reg_array[method] != plan.value;
+    return plan;
+}
+
+// CallMethod's state register branch, ProcessShadowRam and ProcessDirtyRegisters in one.
+// The caller counts the write (CallMethod: one_call_writes, MacroWrite: one_call_macro).
+[[gnu::always_inline]] inline void Maxwell3D::WriteStateOneCall(u32 method, u32 method_argument) {
+    const OneCallPlan plan = PlanOneCall(method, method_argument);
+    if (plan.track) {
+        shadow_state.reg_array[method] = method_argument;
+    }
+    if (plan.write) {
+        WriteDirtyRegister(method, plan.value);
+    }
+}
+
+void Maxwell3D::VerifyOneCall(Core::System& system, u32 method, u32 method_argument,
+                              bool is_last_call) {
+    const bool eligible = OneCallEligible(one_call_plain, method);
+    // What WriteStateOneCall would leave (PlanOneCall, its own code), before the full path runs.
+    u32 value = method_argument;
+    u32 shadow = 0;
+    bool write = false;
+    std::array<bool, std::tuple_size<DirtyState::Tables>::value> flags_before{};
+    if (eligible) {
+        const OneCallPlan plan = PlanOneCall(method, method_argument);
+        value = plan.value;
+        shadow = plan.track ? method_argument : shadow_state.reg_array[method];
+        write = plan.write;
+        for (size_t i = 0; i < flags_before.size(); ++i) {
+            flags_before[i] = dirty.flags[dirty.tables[i][method]];
+        }
+    }
+    one_call_verifying = true;
+    CallMethod(system, method, method_argument, is_last_call);
+    one_call_verifying = false;
+    if (!eligible) {
+        return;
+    }
+    ++one_call_verified;
+    bool same = regs.reg_array[method] == value && shadow_state.reg_array[method] == shadow;
+    for (size_t i = 0; i < flags_before.size(); ++i) {
+        const bool flag = dirty.flags[dirty.tables[i][method]];
+        same = same && (write ? flag : flag == flags_before[i]);
+    }
+    if (!same) {
+        ++one_call_differences;
+        if (one_call_differences <= 8) {
+            LOG_WARNING(HW_GPU,
+                        "Register write one call differs: method {:#x} argument {:#x}: full "
+                        "path left {:#x} (shadow {:#x}), short path {:#x} (shadow {:#x}, {})",
+                        method, method_argument, regs.reg_array[method],
+                        shadow_state.reg_array[method], value, shadow,
+                        write ? "write" : "skip");
+        }
+    }
+}
+
+void Maxwell3D::ConsumeSinkOneCall() {
+    one_call_sink += method_sink.size();
+    const auto control = shadow_state.shadow_ram_control;
+    const bool skip_same = one_call_skip_same;
+    const auto process = [&](u32 method, u32 value) {
+        if (!skip_same || regs.reg_array[method] != value) {
+            WriteDirtyRegister(method, value);
+        }
+    };
+    if (control == Regs::ShadowRamControl::Track || control == Regs::ShadowRamControl::TrackWithFilter) {
+        for (auto [method, value] : method_sink) {
+            shadow_state.reg_array[method] = value;
+            process(method, value);
+        }
+    } else if (control == Regs::ShadowRamControl::Replay) {
+        for (auto [method, value] : method_sink)
+            process(method, shadow_state.reg_array[method]);
+    } else {
+        for (auto [method, value] : method_sink)
+            process(method, value);
+    }
+    method_sink.clear();
+}
+
+void Maxwell3D::ReportOneCall() {
+    // From ProcessSyncPoint once a counter has moved, so only after the switch was on. One line
+    // every 10 s, also while it is off again (the window's counts then stay 0), so a live A/B
+    // shows its A phases too.
+    const u64 now = VideoCommon::Nx2Profile::Now();
+    if (one_call_window_start == 0) {
+        one_call_window_start = now;
+        return;
+    }
+    const u64 window = now - one_call_window_start;
+    if (window < 10'000'000'000ULL) {
+        return;
+    }
+    const u64 writes = one_call_writes - one_call_logged[0];
+    const u64 macro = one_call_macro - one_call_logged[1];
+    const u64 sink = one_call_sink - one_call_logged[2];
+    const u64 verified = one_call_verified - one_call_logged[3];
+    const u64 differences = one_call_differences - one_call_logged[4];
+    one_call_logged = {one_call_writes, one_call_macro, one_call_sink, one_call_verified,
+                       one_call_differences};
+    one_call_window_start = now;
+    LOG_INFO(HW_GPU,
+             "Register write one call in {:.1f} s (EDEN_UP_REG_WRITE_ONE_CALL={}, _VERIFY={}): "
+             "{} short-path writes, {} macro writes, {} sink writes, {} verified, {} differences "
+             "(session: {} short, {} macro, {} sink, {} verified, {} differences)",
+             static_cast<double>(window) / 1e9,
+             Common::LiveSwitch::Peek<Common::LiveSwitch::Id::RegWriteOneCall>(),
+             one_call_verify ? 1 : 0, writes, macro, sink, verified, differences, one_call_writes,
+             one_call_macro, one_call_sink, one_call_verified, one_call_differences);
+}
