--- a/src/video_core/renderer_vulkan/vk_texture_cache.h
+++ b/src/video_core/renderer_vulkan/vk_texture_cache.h
@@ -106,6 +106,10 @@ public:
 
     void TickFrame();
 
+    /// EDEN_UP_SCALED_ONLY=1: a rescaled image's native copy, freed once the GPU is past `tick`
