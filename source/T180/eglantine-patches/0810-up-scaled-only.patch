+    void RetireNativeImage(vk::Image image);
+
     void FlushDeferredClear();
 
     u64 GetDeviceLocalMemory() const;
@@ -399,6 +403,7 @@ public:
     std::vector<MsaaScratchImage> msaa_scratch_images;
     ::Common::unordered_map<VkImage, ResolveShadow> resolve_shadows;
     std::vector<std::pair<u64, ResolveShadow>> pending_resolve_shadows;
+    std::vector<std::pair<u64, vk::Image>> retired_native_images; ///< EDEN_UP_SCALED_ONLY
 };
 
 class Framebuffer {
@@ -655,6 +660,11 @@ public:
 
     bool ScaleDown(bool ignore = false);
 
+    /// EDEN_UP_SCALED_ONLY=1: the native copy was freed while the image is rescaled.
+    [[nodiscard]] bool NativeReleased() const noexcept {
+        return native_released;
+    }
+
     u64 allocation_tick;
 
     friend class BlockLinearUnswizzle3DPass;
@@ -664,6 +674,17 @@ private:
 
     bool NeedsScaleHelper() const;
 
+    /// EDEN_UP_SCALED_ONLY=1: below 1x, frees the native copy of a rescaled image until something
+    /// needs it (a scale down, an upload, a download). True when it was freed.
+    bool ReleaseNative();
+
+    /// Makes the native copy again (same create info as the constructor's backed path).
+    void BringNativeBack();
+
+    /// Images whose native copy may be freed: plain 2D single-sample images the copy engine can
+    /// blit, with no sparse, trimmed, converted or decoded backing.
+    [[nodiscard]] bool CanReleaseNative() const;
+
     Scheduler* scheduler{};
     TextureCacheRuntime* runtime{};
 
@@ -772,6 +793,9 @@ private:
     std::vector<vk::ImageView> storage_layer_views; ///< By host level * layers + layer
     VkImageAspectFlags aspect_mask = 0;
     bool initialized = false;
+    bool native_released = false; ///< EDEN_UP_SCALED_ONLY: original_image is freed
+    u8 native_returns = 0;        ///< times the native copy was made again (2: kept from then on)
+    u64 native_released_bytes = 0;
     Trim2dHeld trim_2d_held; ///< EDEN_UP_TEX_TRIM_2D's saved host bytes for this image
 
     std::optional<Framebuffer> scale_framebuffer;
