index 0000000000000000000000000000000000000000..c5cb1ecb7e01225b9e5ce8a4b927a0ad5890a8b4
--- /dev/null
+++ b/tools/test-pack-place.cpp
@@ -0,0 +1,163 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Host test for src/pack_place.h (EDEN_GUEST_SWAP_PACK_IN_PLACE, PackOut in src/guest_memory_service.inc).
+//   c++ -std=c++20 -O2 -fsanitize=address,undefined -Isrc tools/test-pack-place.cpp -o /tmp/pp && /tmp/pp
+// The pool is modelled in 16 KiB pages with the lowest room that fits (what the console does,
+// src/direct_memory.c): guest slots are 2 MiB blocks at 2 MiB steps, a packed slot keeps `kept` pages.
+// The pool starts full of guest slots, as at the memory wall of the W-13 to W-19 sessions.
+#include <algorithm>
+#include <cstdio>
+#include <cstring>
+#include <random>
+#include <vector>
+
+#include "pack_place.h"
+
+using namespace Eden::PackPlace;
+
+static int failures = 0;
+#define CHECK(c) do { if (!(c)) { std::fprintf(stderr, "FAIL %s:%d: %s\n", __FILE__, __LINE__, #c); ++failures; } } while (0)
+
+namespace {
+constexpr int SlotPages = 128;
+struct Pool {
+    std::vector<char> used;
+    explicit Pool(int slots) : used(static_cast<size_t>(slots) * SlotPages, 0) {}
+    int Take(int pages, int align) {
+        const int n = static_cast<int>(used.size());
+        for (int at = 0; at + pages <= n;) {
+            const void* hit = std::memchr(used.data() + at, 1, static_cast<size_t>(pages));
+            if (hit == nullptr) {
+                std::fill_n(used.begin() + at, pages, 1);
+                return at;
+            }
+            const int taken = static_cast<int>(static_cast<const char*>(hit) - used.data());
+            at = (taken + 1 + align - 1) / align * align;
+        }
+        return -1;
+    }
+    void Give(int at, int pages) { std::fill_n(used.begin() + at, pages, 0); }
+    int FreePages() const { return static_cast<int>(std::count(used.begin(), used.end(), 0)); }
+    int WholeFreeSlots() const {
+        int whole = 0;
+        for (size_t slot = 0; slot * SlotPages < used.size(); ++slot)
+            whole += std::all_of(used.begin() + slot * SlotPages, used.begin() + (slot + 1) * SlotPages,
+                                 [](char page) { return page == 0; });
+        return whole;
+    }
+};
+struct Result { int free_mib, whole_mib, in_place, own_block, not_packed, unpack_refused; };
+
+// `slots` guest slots fill the pool; the swapper keeps about 60% packed while touches bring slots back.
+Result Run(Mode mode, unsigned seed, int slots = 512, int steps = 20000) {
+    std::mt19937 random{seed};
+    Pool pool{slots};
+    struct Slot { int at = -1, kept = 0; };
+    std::vector<Slot> guest(static_cast<size_t>(slots));
+    for (Slot& slot : guest) slot.at = pool.Take(SlotPages, SlotPages);
+    std::vector<int> own(static_cast<size_t>(slots)), out;
+    for (int i = 0; i < slots; ++i) own[static_cast<size_t>(i)] = i;
+    Result result{};
+    std::normal_distribution<double> packs_to{64.0, 18.0}; // about half, as the W-19 run packed
+    const auto pick = [&](std::vector<int>& from) {
+        const size_t index = random() % from.size();
+        const int id = from[index];
+        from[index] = from.back();
+        from.pop_back();
+        return id;
+    };
+    for (int step = 0; step < steps; ++step) {
+        const bool pack = static_cast<int>(out.size()) < slots * 6 / 10 && (out.empty() || random() % 100 < 55);
+        if (pack) {
+            const int id = pick(own);
+            Slot& slot = guest[static_cast<size_t>(id)];
+            const int kept = std::clamp(static_cast<int>(packs_to(random)), 8, 112);
+            int block = -1;
+            if (AsksPoolFirst(true, mode)) block = pool.Take(kept, 1);
+            switch (Choose(true, mode, block >= 0)) {
+            case Place::OwnBlock:
+                pool.Give(slot.at, SlotPages);
+                slot = Slot{block, kept};
+                ++result.own_block;
+                out.push_back(id);
+                break;
+            case Place::InPlace:
+                CHECK(block < 0); // nothing taken from the pool is left behind
+                pool.Give(slot.at + kept, SlotPages - kept);
+                slot.kept = kept;
+                ++result.in_place;
+                out.push_back(id);
+                break;
+            case Place::None:
+                CHECK(block < 0);
+                ++result.not_packed;
+                own.push_back(id);
+                break;
+            }
+        } else {
+            const int id = pick(out);
+            Slot& slot = guest[static_cast<size_t>(id)];
+            const int block = pool.Take(SlotPages, SlotPages);
+            if (block < 0) { // the guest touched a packed slot and the pool has no 2 MiB block
+                ++result.unpack_refused;
+                out.push_back(id);
+                continue;
+            }
+            pool.Give(slot.at, slot.kept);
+            slot = Slot{block, 0};
+            own.push_back(id);
+        }
+    }
+    result.free_mib = pool.FreePages() / 64;
+    result.whole_mib = pool.WholeFreeSlots() * 2;
+    return result;
+}
+} // namespace
+
+int main() {
+    // The setting. "1" keeps its old meaning (any value starting with 1); only "2" is the new mode.
+    CHECK(ModeOf(nullptr) == Mode::Own);
+    CHECK(ModeOf("") == Mode::Own);
+    CHECK(ModeOf("0") == Mode::Own);
+    CHECK(ModeOf("1") == Mode::InPlace);
+    CHECK(ModeOf("2") == Mode::PoolFirst);
+    CHECK(ModeOf("20") == Mode::Own);
+    CHECK(ModeOf("3") == Mode::Own);
+    CHECK(ModeOf("on") == Mode::Own);
+
+    // The choice, every case.
+    for (const Mode mode : {Mode::Own, Mode::InPlace, Mode::PoolFirst})
+        for (const bool gave : {false, true}) CHECK(Choose(false, mode, gave) == Place::None);
+    CHECK(AsksPoolFirst(true, Mode::Own) && AsksPoolFirst(true, Mode::PoolFirst));
+    CHECK(!AsksPoolFirst(true, Mode::InPlace)); // =1 asks the pool for nothing, as before
+    CHECK(!AsksPoolFirst(false, Mode::Own) && !AsksPoolFirst(false, Mode::PoolFirst));
+    CHECK(Choose(true, Mode::Own, true) == Place::OwnBlock);
+    CHECK(Choose(true, Mode::Own, false) == Place::None);       // as before: the slot waits
+    CHECK(Choose(true, Mode::InPlace, false) == Place::InPlace);
+    CHECK(Choose(true, Mode::PoolFirst, true) == Place::OwnBlock);
+    CHECK(Choose(true, Mode::PoolFirst, false) == Place::InPlace); // packing never stops for memory
+
+    for (const unsigned seed : {1u, 2u, 3u, 4u}) {
+        const Result in_place = Run(Mode::InPlace, seed);
+        const Result pool_first = Run(Mode::PoolFirst, seed);
+        const Result own = Run(Mode::Own, seed);
+        std::printf("seed %u  in place: %d MiB free, %d whole, %d unpacks refused | pool first: %d MiB free, %d whole, "
+                    "%d in place of %d, %d unpacks refused | own block only: %d not packed\n",
+                    seed, in_place.free_mib, in_place.whole_mib, in_place.unpack_refused, pool_first.free_mib,
+                    pool_first.whole_mib, pool_first.in_place, pool_first.in_place + pool_first.own_block,
+                    pool_first.unpack_refused, own.not_packed);
+        // What the consoles showed with =1: hundreds of MiB free and no whole block among them.
+        CHECK(in_place.free_mib > 200 && in_place.whole_mib == 0);
+        CHECK(in_place.unpack_refused > 0);
+        // =2: most of what is free is whole 2 MiB blocks, and about as much is free.
+        CHECK(pool_first.whole_mib * 10 >= pool_first.free_mib * 7);
+        CHECK(pool_first.free_mib * 10 >= in_place.free_mib * 9);
+        // With the pool full the first slots can only go in place; that is rare afterwards.
+        CHECK(pool_first.in_place >= 1);
+        CHECK(pool_first.in_place * 20 < pool_first.own_block);
+        CHECK(pool_first.not_packed == 0); // packing never stopped for memory
+        // Without the fallback a full pool packs nothing at all (run 161).
+        CHECK(own.own_block == 0 && own.not_packed > 0 && own.free_mib == 0);
+    }
+    if (failures == 0) std::puts("PASS");
+    return failures != 0;
+}
diff --git a/tools/test-stall-probe.cpp b/tools/test-stall-probe.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..70cc8dacda5b7a2457e94daf9a53514623f85bd1
--- /dev/null
+++ b/tools/test-stall-probe.cpp
@@ -0,0 +1,213 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Host test for src/stall_probe.h (EDEN_UP_STALL_PROBE). 0642: waveydude's, from 2e75fb7; <mutex> added.
+//   c++ -std=c++20 -O1 -fsanitize=address,undefined -Isrc tools/test-stall-probe.cpp -o /tmp/t && /tmp/t
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <cstring>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include "stall_probe.h"
+
+namespace SP = StallProbe;
+static int failures = 0;
+#define CHECK(cond)                                                                                \
+    do {                                                                                           \
+        if (!(cond)) {                                                                             \
+            std::printf("FAIL %s:%d: %s\n", __FILE__, __LINE__, #cond);                            \
+            ++failures;                                                                            \
+        }                                                                                          \
+    } while (0)
+
+static bool Has(const std::string& text, const char* part) {
+    return text.find(part) != std::string::npos;
+}
+
+// Off: the hooks record nothing and read no clock.
+static void Off() {
+    SP::enabled.store(false);
+    SP::SlotWaited(1);
+    SP::SlotTaken();
+    SP::SlotReleased();
+    SP::BlockWaited(1);
+    CHECK(SP::Get().slot_wait.count[SP::Fault].load() == 0);
+    CHECK(SP::Get().slot_hold.count[SP::Fault].load() == 0);
+    CHECK(SP::Get().block_wait.count[SP::Fault].load() == 0);
+    CHECK(SP::held_depth == 0);
+}
+
+// Records go to the caller's role; only 50 ms and over reach the window; the window empties when
+// taken; totals stay.
+static void Windows() {
+    SP::enabled.store(true);
+    auto& s = SP::Get();
+    SP::Record(s.slot_wait, SP::Fault, 10 * SP::Ms);   // under the window floor
+    SP::Record(s.slot_wait, SP::Fault, 60 * SP::Ms);
+    SP::Record(s.slot_wait, SP::Fault, 900 * SP::Ms);
+    SP::Record(s.slot_hold, SP::Swapper, 950 * SP::Ms);
+    SP::Record(s.slot_hold, 9, 70 * SP::Ms); // an unknown role counts as a fault
+    char line[512];
+    const int n = SP::StallLine(line, sizeof(line), s.start_ns.load() + 12'340'000'000ull, 960 * SP::Ms);
+    const std::string text(line, n);
+    std::printf("  %s", text.c_str());
+    CHECK(Has(text, "EDEN_STALL t=12.34s late=960ms;"));
+    CHECK(Has(text, "slot_wait fault=2/900ms"));
+    CHECK(Has(text, "slot_hold fault=1/70ms swapper=1/950ms"));
+    CHECK(Has(text, "block_wait none"));
+    CHECK(text.back() == '\n');
+    // Taken: the next line has nothing.
+    const std::string again(line, SP::StallLine(line, sizeof(line), s.start_ns.load(), 100 * SP::Ms));
+    CHECK(Has(again, "slot_wait none") && Has(again, "slot_hold none"));
+    // Totals keep everything, the 10 ms wait too.
+    CHECK(s.slot_wait.count[SP::Fault].load() == 3);
+    CHECK(s.slot_wait.over_100ms[SP::Fault].load() == 1);
+    CHECK(s.slot_wait.longest_ns[SP::Fault].load() == 900 * SP::Ms);
+    const std::string totals(line, SP::TotalsLine(line, sizeof(line)));
+    std::printf("  %s", totals.c_str());
+    CHECK(Has(totals, "EDEN_SLOT_LOCK"));
+    CHECK(Has(totals, "slot_wait fault=3/970ms/900ms/>100ms:1"));
+    CHECK(Has(totals, "slot_hold fault=1/70ms/70ms/>100ms:0 swapper=1/950ms/950ms/>100ms:1"));
+}
+
+// A small buffer truncates and stays terminated.
+static void Truncation() {
+    SP::Record(SP::Get().block_wait, SP::Scanner, 500 * SP::Ms);
+    char small[24];
+    std::memset(small, 'x', sizeof(small));
+    const int n = SP::StallLine(small, sizeof(small), SP::Get().start_ns.load(), 200 * SP::Ms);
+    CHECK(n >= 0 && n < static_cast<int>(sizeof(small)));
+    CHECK(std::memchr(small, '\0', sizeof(small)) != nullptr);
+    char tiny[8];
+    CHECK(SP::TotalsLine(tiny, sizeof(tiny)) < static_cast<int>(sizeof(tiny)));
+    CHECK(std::memchr(tiny, '\0', sizeof(tiny)) != nullptr);
+}
+
+// Nested holds count once, from the outermost take to the outermost release; a release with
+// nothing held does nothing.
+static void Nesting() {
+    auto& hold = SP::Get().slot_hold;
+    const auto before = hold.count[SP::Keeper].load();
+    std::thread([&] {
+        SP::role = SP::Keeper;
+        SP::SlotReleased(); // nothing held
+        SP::SlotTaken();
+        SP::SlotTaken();
+        std::this_thread::sleep_for(std::chrono::milliseconds(60));
+        SP::SlotReleased();
+        CHECK(SP::held_depth == 1);
+        SP::SlotReleased();
+        CHECK(SP::held_depth == 0);
+    }).join();
+    CHECK(hold.count[SP::Keeper].load() == before + 1);
+    CHECK(hold.longest_ns[SP::Keeper].load() >= 60 * SP::Ms);
+}
+
+// The loop: a 10 ms sleep that took 970 ms is a stall of 960 ms; one that took 105 ms is not.
+// The extra 50 ms sleep after a stall comes before the line.
+static void Loop() {
+    std::vector<std::uint64_t> sleeps;
+    std::vector<std::string> lines;
+    std::uint64_t clock = SP::Get().start_ns.load() + 1'000'000'000ull;
+    const std::uint64_t durations[] = {10 * SP::Ms, 105 * SP::Ms, 970 * SP::Ms, 50 * SP::Ms, 10 * SP::Ms};
+    std::size_t step = 0;
+    int rounds = 0;
+    const auto stalls_before = SP::Get().stalls.load();
+    SP::ProbeLoop([&] { return rounds++ >= 3; },
+                  [&](std::uint64_t ns) {
+                      sleeps.push_back(ns);
+                      clock += step < std::size(durations) ? durations[step++] : ns;
+                  },
+                  [&] { return clock; }, [&](const char* line) { lines.emplace_back(line); });
+    CHECK(SP::Get().stalls.load() == stalls_before + 1);
+    CHECK(lines.size() == 1);
+    if (!lines.empty()) CHECK(Has(lines[0], "late=960ms"));
+    CHECK(sleeps.size() == 4 && sleeps[3] == SP::WindowFloorNs);
+    CHECK(SP::Get().longest_stall_ns.load() >= 960 * SP::Ms);
+}
+
+// The real case: a holder keeps a slot 300 ms while a fault spins for it, and the probe thread
+// misses its wake because this test pauses it (a stand-in for the console's stall). The stall line
+// names both: the fault's wait and the swapper's hold.
+static void Threads() {
+    std::atomic<bool> locked{false}, stop{false}, release{false};
+    std::vector<std::string> lines;
+    std::mutex lines_mutex;
+    std::atomic<bool> pause_probe{false};
+    std::thread probe([&] {
+        SP::ProbeLoop([&] { return stop.load(); },
+                      [&](std::uint64_t ns) {
+                          std::this_thread::sleep_for(std::chrono::nanoseconds(ns));
+                          while (pause_probe.load()) std::this_thread::sleep_for(std::chrono::milliseconds(1));
+                      },
+                      SP::NowNs,
+                      [&](const char* line) {
+                          std::lock_guard lock{lines_mutex};
+                          lines.emplace_back(line);
+                      });
+    });
+    std::thread holder([&] {
+        SP::role = SP::Swapper;
+        bool expected = false;
+        while (!locked.compare_exchange_weak(expected, true)) expected = false;
+        SP::SlotTaken();
+        while (!release.load()) std::this_thread::yield();
+        SP::SlotReleased();
+        locked.store(false);
+    });
+    while (!locked.load()) std::this_thread::yield();
+    std::thread fault([&] {
+        SP::role = SP::Fault;
+        std::uint64_t since = 0;
+        bool waited = false;
+        bool expected = false;
+        while (!locked.compare_exchange_weak(expected, true)) {
+            expected = false;
+            if (!waited) since = SP::NowNs();
+            waited = true;
+            std::this_thread::yield();
+        }
+        if (waited) SP::SlotWaited(since);
+        SP::SlotTaken();
+        SP::SlotReleased();
+        locked.store(false);
+    });
+    pause_probe.store(true);
+    std::this_thread::sleep_for(std::chrono::milliseconds(300));
+    release.store(true);
+    holder.join();
+    fault.join();
+    pause_probe.store(false);
+    std::this_thread::sleep_for(std::chrono::milliseconds(150));
+    stop.store(true);
+    probe.join();
+    std::lock_guard lock{lines_mutex};
+    CHECK(!lines.empty());
+    bool named = false;
+    for (const auto& line : lines) {
+        std::printf("  %s", line.c_str());
+        named |= Has(line, "slot_wait fault=1/") && Has(line, "slot_hold swapper=1/");
+    }
+    CHECK(named);
+}
+
+int main() {
+    SP::Get().start_ns.store(SP::NowNs());
+    Off();
+    Windows();
+    Truncation();
+    Nesting();
+    Loop();
+    Threads();
+    // The switch: exact "1" only.
+    setenv("EDEN_UP_STALL_PROBE", "1", 1);
+    CHECK(SP::ReadSwitch());
+    setenv("EDEN_UP_STALL_PROBE", "10", 1);
+    CHECK(!SP::ReadSwitch());
+    unsetenv("EDEN_UP_STALL_PROBE");
+    CHECK(!SP::ReadSwitch());
+    std::printf("stall probe: %s (%d failures)\n", failures ? "FAILED" : "passed", failures);
+    return failures ? 1 : 0;
+}
