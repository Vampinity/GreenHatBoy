index 8f9f600d1097ef0fab6ce27b79c06e475bac3d4d..5005f6c8f1da505a58aaef54af8a18d007a0347a 100644
--- a/headless/gpu_time_probe.inc
+++ b/headless/gpu_time_probe.inc
@@ -23,6 +23,280 @@ struct GpuTimeProbe {
