+    const char *at = refill;
+    while (*at >= '0' && *at <= '9' && refill_mib <= 4096)
+      refill_mib = refill_mib * 10 + (unsigned long long)(*at++ - '0');
+    if (*at != '\0' || refill_mib < 32 || refill_mib > 4096)
