+         if (AsyncBufferDownloads()) {
+             uncommitted_gpu_modified_ranges.Add(device_addr, size);
++            VideoCore::GbbReadSyncPending::NoteGpuWrite(device_addr, size); // 0929
+             return;
+         }
+         const DAddr end = device_addr + size;
+@@ -1138,6 +1141,7 @@ private:
+                 ArmReadTraps(cursor, lower - cursor);
+             }
+             uncommitted_gpu_modified_ranges.Add(lower, upper - lower);
++            VideoCore::GbbReadSyncPending::NoteGpuWrite(lower, upper - lower); // 0929
+             cursor = upper;
+         });
+         if (cursor < end) {
