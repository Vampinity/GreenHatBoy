+       for (unsigned i = 0; i < RADV_GS_COMPUTE_SHADERS; i++) {
+@@ -3563,7 +3566,9 @@ radv_graphics_pipeline_create(VkDevice _device, VkPipelineCache _cache, const Vk
+    struct radv_graphics_pipeline *pipeline;
+    VkResult result;
+ 
++   u_eden_long_lived_enter(); /* lead-mesh-42: the pipeline object is kept */
+    pipeline = vk_zalloc2(&device->vk.alloc, pAllocator, sizeof(*pipeline), 8, VK_SYSTEM_ALLOCATION_SCOPE_OBJECT);
++   u_eden_long_lived_leave();
+    if (pipeline == NULL)
+       return vk_error(device, VK_ERROR_OUT_OF_HOST_MEMORY);
+ 
+@@ -3711,7 +3716,9 @@ radv_graphics_lib_pipeline_create(VkDevice _device, VkPipelineCache _cache,
+    struct radv_graphics_lib_pipeline *pipeline;
