++    /// that covered the whole image (a clear; TextureCache::NoteWholeClears), and the last frame
++    /// the image was prepared for use in (PrepareImage). Both stay 0 with the switch off.
++    u64 full_write_tick = 0;
++    u64 last_use_frame = 0;
