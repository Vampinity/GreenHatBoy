++    }
+     if (TcTrace() && image.guest_size_bytes >= TcTraceMinBytes()) {
+         const double ms = std::chrono::duration<double, std::milli>(
+                               std::chrono::steady_clock::now() - trace_start)
diff --git a/tools/eglantine-patches/0720-up-pipeline-list.patch b/tools/eglantine-patches/0720-up-pipeline-list.patch
new file mode 100644
index 0000000000000000000000000000000000000000..760f48f4a96a8f7f14f6c02558673fb43d958e54
--- /dev/null
+++ b/tools/eglantine-patches/0720-up-pipeline-list.patch
@@ -0,0 +1,1140 @@
+From: EglantinePS5
+Subject: up: pipeline lists: export this console's pipeline records without code, import another console's (EDEN_UP_PIPELINE_LIST_EXPORT / EDEN_UP_PIPELINE_LIST_IMPORT), off by default
+
+What: a pipeline list is a console's pipeline records (vulkan.bin, vulkan_mesh.bin) with the
+game's code taken out: per record its kind, its key (six program hashes and the 1,008 bytes of
+drawing state) and, per program, the CityHash64 of its code and the environment's other bytes
+(code size, answers, program header). Format "EGPLIST1" 1: a 32-byte header (format, cache
+version 23, key sizes 1056 and 24, record count), then per record u8 kind (0 compute, 1
+graphics, 2 task/mesh with mesh state), u8 program count, u16 0, per program u64 code hash, u32
+size and the bytes, then the key. tools/pipeline-list.py writes the same bytes on the Mac.
+
+EDEN_UP_PIPELINE_LIST_EXPORT=1: at boot, before anything is built, the console's own record files
+of this shader folder go to pipeline_export.list beside them (written beside, renamed over).
+
+EDEN_UP_PIPELINE_LIST_IMPORT=1 (pipeline_import.list in the shader folder) or =<path>: at boot,
+before anything is built, each program's code is looked up by its hash in this console's own
+record files and in the shader set file made from the player's own game (prep_shader_set.bin,
+layouts edenset3 and the older edenset2: VideoCommon::ShaderSet::ForEachProgramCode). The list's
+records whose code was all found, that this console has no record of, that this device's dynamic
+state can draw (OtherDeviceBits) and that were made with this driver are written back whole:
+prep_imported.bin, prep_imported_mesh.bin, prep_imported_compute.bin. EDEN_UP_SHADER_PREP's
+preparation reads the first two as predicted records (translated on the workers before play,
+built once so the driver's disk cache holds them, kept; task/mesh ones, which run as compute,
+are built and remembered, not kept); the boot builds the compute ones like its own. One log line
+gives every count. prep_imported.stamp keeps the files as they are while the list, the shader
+set file, this device's dynamic states and key switches (ShaderSetDeviceIdentity) and (unless
+all code was found) the own record files are unchanged. A list that is
+gone, or not a list of this build, takes the three files away.
+EDEN_UP_PIPELINE_LIST_IMPORT_DRIVER=1: a record made with another driver version is taken with
+this device's driver fields; without it such records are counted and left out.
+
+Checks on every list record: a known kind, 1-6 programs, compute exactly one compute program,
+graphics as many programs as the key has hashes, task/mesh kind only with a task or mesh
+program, each program's bytes as long as FileEnvironment::RecordTailSize (new, from the head
+alone) says, code at most 16 MiB, each program's code hash XOR the native tag one of the key's
+program hashes (not for a task/mesh record's mesh-state slots), and found code of the same hash
+and size (checked again when it is copied back). A bad record is counted and left out; a list
+that cannot be read on stops there. With _DRIVER=1 two records that become one key are written
+once. Host check (t154/host): the console's records rebuilt from a list are byte for byte the
+original records (1,346 + 2,975 + 368 + 401 + 705 + 3,458 records, 0 differ); C++ export and
+tools/pipeline-list.py export give the same bytes.
+
+Off (both unset): one getenv in LoadDiskResources (two with EXPORT's) and one in PrepareKept,
+cached; nothing read, written or logged. Not in the store stamp (the translation is unchanged),
+but vk_pipeline_cache.cpp and shader_environment.cpp are inputs of the translation id (0596), so
+a build with this patch gives a new id and one cold preparation when EDEN_UP_SHADER_PREP_SOURCE_STAMP=1.
+
+Credits: the shader set's program table and extractor this reads (T122, Fritchii's extractor);
+the preparation it feeds (0567, after zortos293/Lichii#895 and #896, zmckenney).
+---
+diff --git a/src/video_core/renderer_vulkan/vk_pipeline_cache.cpp b/src/video_core/renderer_vulkan/vk_pipeline_cache.cpp
+index 819c9da..896a31f 100644
+--- a/src/video_core/renderer_vulkan/vk_pipeline_cache.cpp
++++ b/src/video_core/renderer_vulkan/vk_pipeline_cache.cpp
+@@ -1313,6 +1313,823 @@ bool MeshCacheBoot() {
+ }
+ } // Anonymous namespace
+ 
++// EDEN_UP_PIPELINE_LIST_EXPORT / EDEN_UP_PIPELINE_LIST_IMPORT (0720, both off by default) -----
++//
++// A pipeline list is a console's pipeline records without the game's code. A record of
++// vulkan.bin / vulkan_mesh.bin holds, per program, the program's code (the game's shader, as
++// the lowerer made it), the answers its translation got from the game's state, and then the
++// key (the six program hashes and the 1,008 bytes of drawing state). A list record holds the
++// same minus the code: for each program the CityHash64 of its code and the environment's other
++// bytes (the code size is the first of them). So a list says which pipelines a game draws and
++// how, and cannot draw anything by itself.
++//
++// EXPORT=1: at boot, before anything is built, this console's own record files (vulkan.bin and
++// vulkan_mesh.bin, or their canonical files, in this build's shader folder) are written as
++// pipeline_export.list beside them (written beside and renamed over). Nothing else changes.
++//
++// IMPORT=1 reads pipeline_import.list from the same folder; IMPORT=<path> reads that file
++// (several consoles' lists go through tools/pipeline-list.py merge first). Each program's code
++// is looked for by its hash in this console's own files: its records, and the shader set file
++// made from the player's own game when it is there (prep_shader_set.bin, either layout). The
++// list's records whose code was all found, that this console has no record of, that are made
++// for this device's dynamic state and pass every check below are written back as whole
++// records: prep_imported.bin (ordinary graphics), prep_imported_mesh.bin (task/mesh, with their
++// mesh state) and prep_imported_compute.bin. The preparation (EDEN_UP_SHADER_PREP=1) reads the
++// first two as predicted records: translated on the workers, built once (the driver's disk
++// cache keeps the result), kept (task/mesh pipelines, which run as compute, cannot be kept and
++// are remembered as built), before play. The boot builds the compute ones as its own. A list
++// that is gone takes the three files with it. One line in the log gives every count. A stamp
++// (prep_imported.stamp: the list, the shader set file, this device's dynamic states and key
++// switches, and the own record files while code was missing) skips the work when unchanged.
++// EDEN_UP_PIPELINE_LIST_IMPORT_DRIVER=1: a record made with another driver version is taken
++// with this device's driver fields (the fields only exist to tell driver builds apart; the
++// translation and the build are made here); without it such records are counted and left out.
++//
++// Checked for every list record: the list's format, cache version and both key sizes; a known
++// kind; 1-6 programs (compute: exactly one, a compute program; graphics: none, and as many as
++// the key has program hashes; mesh: at least one task or mesh program; ordinary: none); each
++// program's bytes as long as its head says, the code at most 16 MiB; and the code found here
++// has that hash and that size; each program's code hash (XOR the native tag) is one of the
++// key's program hashes (task/mesh records: not for their mesh-state slots), so a key is never
++// built from another program's code. A record that fails is counted as invalid and left out. A list
++// that ends inside a record or holds more than it says stops the reading (what was read stays).
