-// GPU thread after the lists sent so far. 1 when queued, 0 when there is no rasterizer.
+// GPU thread after the lists sent so far. 1 when queued, 0 when there is no rasterizer or no memory
+// for the queued function, 2 in synchronous GPU mode (nothing queued: there PushCommand would block
+// the helper, with the registry mutex held, until the GPU thread ran the pass, and the GPU thread may
+// be the one waiting). In asynchronous mode the GPU thread's queue is unbounded (host_command_queue.h)
+// and the push takes its write_lock only for the push itself. `flags` bit 0: the wait is urgent (recent
+// ASTC under EDEN_UP_TC_OOM_SPARE_FRAMES may go too).
 extern "C" int eden_wait_reclaim_request(unsigned long long seq, unsigned long long target_bytes,
-                                         unsigned min_age, unsigned gpu_wait_ms) noexcept {
+                                         unsigned min_age, unsigned gpu_wait_ms,
+                                         unsigned flags) noexcept {
     namespace WR = Vulkan::WaitReclaim;
     try {
         std::scoped_lock lock{WR::registry_mutex};
         if (WR::registered == nullptr) {
             return 0;
         }
-        WR::registered->QueueWaitReclaim(seq, target_bytes, min_age, gpu_wait_ms);
-        return 1;
+        return WR::registered->QueueWaitReclaim(seq, target_bytes, min_age, gpu_wait_ms,
+                                                (flags & 1u) != 0)
+                   ? 1
+                   : 2;
     } catch (...) {
         return 0; // no memory for the queued function: nothing queued
     }
@@ -3523,14 +3531,31 @@ void RasterizerVulkan::PressureDrainLook(bool frame_end) {
 }
 
 // EDEN_UP_WAIT_RECLAIM (wait_reclaim.h). The front asks for at most one pass at a time and waits
-// for its result before asking again, so at most one of these is queued.
-void RasterizerVulkan::QueueWaitReclaim(u64 seq, u64 target_bytes, u32 min_age, u32 gpu_wait_ms) {
-    gpu.RunInOrder([this, seq, target_bytes, min_age, gpu_wait_ms] {
-        WaitReclaimPass(seq, target_bytes, min_age, gpu_wait_ms);
+// for its result before asking again, so at most one of these is queued. Asynchronous GPU mode only.
+bool RasterizerVulkan::QueueWaitReclaim(u64 seq, u64 target_bytes, u32 min_age, u32 gpu_wait_ms,
+                                        bool urgent) {
+    if (!gpu.IsAsync()) {
+        return false;
+    }
+    gpu.RunInOrder([this, seq, target_bytes, min_age, gpu_wait_ms, urgent] {
+        // A deferred Call entry rethrows (the 0921 backstop absorbs Method entries only), and the
+        // pass allocates exactly when memory is short: nothing leaves it. A throw ends the pass
+        // with outcome Failed (the locks unlock on the way out; WaitReclaimEvict deletes one image at
+        // a time, so an image is either deleted or still registered, except the one it was in).
+        try {
+            WaitReclaimPass(seq, target_bytes, min_age, gpu_wait_ms, urgent);
+        } catch (...) {
+            namespace WR = WaitReclaim;
+            WR::g_result.outcome.store(WR::Failed, std::memory_order_relaxed);
+            WR::g_result.passes.fetch_add(1, std::memory_order_relaxed);
+            WR::g_result.done_seq.store(seq, std::memory_order_release);
+        }
     });
+    return true;
 }
 
-void RasterizerVulkan::WaitReclaimPass(u64 seq, u64 target_bytes, u32 min_age, u32 gpu_wait_ms) {
+void RasterizerVulkan::WaitReclaimPass(u64 seq, u64 target_bytes, u32 min_age, u32 gpu_wait_ms,
+                                       bool urgent) {
     namespace WR = WaitReclaim;
     const auto start = std::chrono::steady_clock::now();
     const u64 largest_before = PressureDrain::LargestFree();
@@ -3605,7 +3630,8 @@ void RasterizerVulkan::WaitReclaimPass(u64 seq, u64 target_bytes, u32 min_age, u
             u64 used2 = used1;
             if (reached && target_bytes != 0) {
                 size_t count = 0;
-                image_marked = texture_cache.WaitReclaimEvict(target_bytes, (std::max)(min_age, 1u), count);
+                image_marked =
+                    texture_cache.WaitReclaimEvict(target_bytes, (std::max)(min_age, 1u), urgent, count);
                 images = count;
                 if (count != 0) {
                     const u64 tick = scheduler.CurrentTick();
