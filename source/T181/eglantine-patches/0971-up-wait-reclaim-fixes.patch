+    for (int sweep = 0; sweep < sweeps && total < target && doomed.size() < MAX_IMAGES; ++sweep) {
         lru_cache.ForEachItemBelow(frame_tick - min_age, [&](ImageId image_id) {
             const Image& image = slot_images[image_id];
             const u64 bytes =
                 ImageMemoryBytes(image) + (image.HasScaled() ? GetScaledImageSizeBytes(image) : 0);
-            // The second sweep takes what the first passed over for its size only.
