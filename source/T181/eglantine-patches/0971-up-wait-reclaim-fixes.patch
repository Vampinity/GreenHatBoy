-template <class P>
-u64 TextureCache<P>::WaitReclaimEvict(u64 target, u64 min_age, size_t& count) {
+// where there are any; with EDEN_UP_TC_OOM_SPARE_FRAMES=K, ASTC (CostlyLoad) unused for under 2K
+// frames only in a last sweep, and only when the front says the wait is `urgent`. The images this
+// frame used (render targets, sampled textures, anything a recorded command refers to) were touched
+// at frame_tick and are never below the cutoff; the bound render targets are passed over by name
+// too. Never an image the GPU wrote (GpuModified), downloadable or not: an unbacked, MSAA, trimmed,
+// CPU-and-GPU-written or BadOverlap image would lose what the GPU drew (stricter than
+// CollectForBuffer's and LoadHoldEvict's test). Reason "wait-reclaim", not "gc...": an emergency
+// drop does not make EDEN_UP_TC_KEEP_REMADE keep the image when it is made again.
+template <class P>
+u64 TextureCache<P>::WaitReclaimEvict(u64 target, u64 min_age, bool urgent, size_t& count) {
     count = 0;
     if (target == 0 || min_age == 0 || frame_tick < min_age) {
         return 0;
     }
     static constexpr size_t MAX_IMAGES = 512;
     static constexpr u64 LARGE = 1_MiB;
+    const u64 spare = OomSpareFrames();
     std::array<ImageId, NUM_RT + 1> bound{};
     for (size_t index = 0; index < NUM_RT; ++index) {
         if (const ImageViewId view_id = render_targets.color_buffer_ids[index]; view_id) {
@@ -1367,20 +1373,24 @@ u64 TextureCache<P>::WaitReclaimEvict(u64 target, u64 min_age, size_t& count) {
     }
     boost::container::small_vector<ImageId, MAX_IMAGES> doomed;
