diff --git a/src/video_core/renderer_vulkan/wait_reclaim.h b/src/video_core/renderer_vulkan/wait_reclaim.h
new file mode 100644
index 0000000000..a0439af557
--- /dev/null
+++ b/src/video_core/renderer_vulkan/wait_reclaim.h
@@ -0,0 +1,69 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <atomic>
+
+#include "common/common_types.h"
+
+/// EDEN_UP_WAIT_RECLAIM=1 (the front's switch, src/guest_memory_service.inc; off unless set).
+///
+/// A game thread that faults on a packed slot needs one free 2 MiB block. When the pool is dry and
+/// no frame is drawn (an area load), nothing frees graphics memory: the collector, the pressure
+/// drain and the area evictor run at frame ends and the collector ages images by frames. The front
+/// sees a write wait for a block longer than a moment and asks for an emergency pass here
+/// (eden_wait_reclaim_request). The pass goes to the GPU thread as a RunInOrder function: with the
+/// split it runs on the back between two entries, as any deferred function does, so the back owns
+/// the scheduler and holds no cache lock; without the split on the GPU thread between commands. No
+/// signal handler calls into this: the request comes from the front's own helper thread.
+///
+/// The pass (RasterizerVulkan::WaitReclaimPass), both cache locks by try_lock only (a waiting
+/// thread may hold one: then the pass is "busy" and the front asks again later):
+///   (a) the pressure drain's releases: the recorded work submitted, the GPU waited for (at most
+///       the front's gpu_ms), deleted images the GPU is past destroyed, deleted buffers destroyed
+///       when the GPU got there, the staging pool's finished buffers;
+///   (b) images deleted by least-recent use, larger ones (1 MiB and up) first, until the front's
+///       target: only ones unused for `age` frames or more (2: not in this frame or the last), not
+///       a bound render target, and with nothing to copy back (CollectForBuffer's and
+///       LoadHoldEvict's test: GPU-written images that can be downloaded stay); then the GPU
+///       waited for again and the deleted images destroyed. They come back by upload when used;
+///   (c) what of that went back to the driver (VMA's device memory before and after; the console's
+///       RADV frees memory the GPU is done with at once, radv_ps5_bo.c radv_ps5_memory_retire, and
+///       VMA frees empty blocks itself while the budget reads exceeded); with EDEN_UP_DRAIN_TO_POOL=1
+///       new buffers get memory of their own for the next 3 s.
+/// The heap trim, step (d), is the front's (no cache lock needed).
+namespace Vulkan::WaitReclaim {
+
+enum Outcome : u32 {
+    Done = 1,        ///< The pass ran
+    Busy = 2,        ///< A cache lock was held by another thread: nothing done
+    Conditional = 3, ///< The guest's conditional rendering is on: nothing done (as the drain)
+    Behind = 4,      ///< The GPU did not reach the recorded work in time: what it is past only
+};
+
+/// The last finished pass, for the front (eden_wait_reclaim_stats). Written by the pass's thread,
+/// `done_seq` last (release).
+struct Result {
+    std::atomic<u64> done_seq{};
+    std::atomic<u64> outcome{};
+    std::atomic<u64> drain_bytes{};    ///< (a) allocator use fallen by the releases
+    std::atomic<u64> staging_bytes{};  ///< (a) of it, and after (b), the staging pool's
+    std::atomic<u64> image_bytes{};    ///< (b) allocator use fallen after the deletions
+    std::atomic<u64> images{};         ///< (b) images deleted
+    std::atomic<u64> image_marked{};   ///< (b) their bytes as the cache counts them
+    std::atomic<u64> to_driver{};      ///< (c) VMA device memory given back
+    std::atomic<u64> largest_before{};
+    std::atomic<u64> largest_after{};
+    std::atomic<u64> took_us{};
+    std::atomic<u64> passes{};
+    std::atomic<u64> freed_total{};    ///< (a) + (b) over all passes
+};
+
+inline Result g_result{};
+
+/// A wait for the GPU that ran out: no new wait until the GPU passed that tick (as the drain's
+/// behind_tick). The pass's thread only.
+inline u64 g_behind_tick{};
+
+} // namespace Vulkan::WaitReclaim
diff --git a/src/video_core/texture_cache/texture_cache.h b/src/video_core/texture_cache/texture_cache.h
index ce757ec65e..c236825c3c 100644
--- a/src/video_core/texture_cache/texture_cache.h
+++ b/src/video_core/texture_cache/texture_cache.h
@@ -1342,6 +1342,66 @@ u64 TextureCache<P>::LoadHoldEvict(u64 min_age, size_t max_images, size_t& count
     return total;
 }
 
+// EDEN_UP_WAIT_RECLAIM (renderer_vulkan/wait_reclaim.h): no frame-age floor beyond `min_age` (2 by
+// default: not used in this frame or the last), a byte target instead. Two sweeps of the LRU, oldest
+// first: images of 1 MiB and more, then the smaller ones, so the target is met by few large images
+// where there are any. The images this frame used (render targets, sampled textures, anything a
+// recorded command refers to) were touched at frame_tick and are never below the cutoff; the bound
+// render targets are passed over by name too.
+template <class P>
+u64 TextureCache<P>::WaitReclaimEvict(u64 target, u64 min_age, size_t& count) {
+    count = 0;
+    if (target == 0 || min_age == 0 || frame_tick < min_age) {
+        return 0;
+    }
+    static constexpr size_t MAX_IMAGES = 512;
+    static constexpr u64 LARGE = 1_MiB;
+    std::array<ImageId, NUM_RT + 1> bound{};
+    for (size_t index = 0; index < NUM_RT; ++index) {
+        if (const ImageViewId view_id = render_targets.color_buffer_ids[index]; view_id) {
+            bound[index] = slot_image_views[view_id].image_id;
+        }
+    }
+    if (const ImageViewId view_id = render_targets.depth_buffer_id; view_id) {
+        bound[NUM_RT] = slot_image_views[view_id].image_id;
+    }
+    boost::container::small_vector<ImageId, MAX_IMAGES> doomed;
+    u64 total = 0;
+    for (int sweep = 0; sweep < 2 && total < target && doomed.size() < MAX_IMAGES; ++sweep) {
+        lru_cache.ForEachItemBelow(frame_tick - min_age, [&](ImageId image_id) {
+            const Image& image = slot_images[image_id];
+            const u64 bytes =
+                ImageMemoryBytes(image) + (image.HasScaled() ? GetScaledImageSizeBytes(image) : 0);
+            // The second sweep takes what the first passed over for its size only.
+            if (sweep == 0 ? bytes < LARGE : bytes >= LARGE) {
+                return false;
+            }
+            if (bytes == 0 || True(image.flags & ImageFlagBits::IsDecoding) ||
+                (KeepAsyncDecodedFrames() != 0 &&
+                 True(image.flags & ImageFlagBits::AsynchronousDecode)) ||
+                KeptRemade(image) ||
+                (IsDownloadable(image) && False(image.flags & ImageFlagBits::BadOverlap)) ||
+                std::ranges::find(bound, image_id) != bound.end()) {
+                return false;
+            }
+            total += bytes;
+            doomed.push_back(image_id);
+            return total >= target || doomed.size() >= MAX_IMAGES;
+        });
+    }
+    for (const ImageId image_id : doomed) {
+        Image& image = slot_images[image_id];
+        if (True(image.flags & ImageFlagBits::Tracked)) {
+            UntrackImage(image, image_id);
+        }
+        UnregisterImage(image_id);
+        trace_delete_reason = "gc-wait-reclaim";
+        DeleteImage(image_id, image.scale_tick > frame_tick + 5);
+    }
+    count = doomed.size();
+    return total;
+}
