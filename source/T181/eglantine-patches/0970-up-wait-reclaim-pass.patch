+// EDEN_UP_WAIT_RECLAIM (wait_reclaim.h). The front asks for at most one pass at a time and waits
+// for its result before asking again, so at most one of these is queued.
+void RasterizerVulkan::QueueWaitReclaim(u64 seq, u64 target_bytes, u32 min_age, u32 gpu_wait_ms) {
+    gpu.RunInOrder([this, seq, target_bytes, min_age, gpu_wait_ms] {
+        WaitReclaimPass(seq, target_bytes, min_age, gpu_wait_ms);
+    });
+}
+
+void RasterizerVulkan::WaitReclaimPass(u64 seq, u64 target_bytes, u32 min_age, u32 gpu_wait_ms) {
+    namespace WR = WaitReclaim;
+    const auto start = std::chrono::steady_clock::now();
+    const u64 largest_before = PressureDrain::LargestFree();
+    u64 outcome = WR::Done;
+    u64 drain = 0, staging = 0, image_bytes = 0, images = 0, image_marked = 0, to_driver = 0;
+    const u64 wait_ns = u64{(std::clamp<u32>)(gpu_wait_ms, 10, 1000)} * 1'000'000ULL;
+    const auto release_staging = [this]() -> u64 {
+        // As PressureDrainLook: the console's port has ReleaseCompleted; elsewhere nothing.
+        return [](auto& pool) -> u64 {
+            if constexpr (requires { pool.ReleaseCompleted(); }) {
+                return static_cast<u64>(pool.ReleaseCompleted());
+            } else {
+                return 0;
+            }
+        }(staging_pool);
+    };
+    if (query_cache_runtime.IsHostConditionalRenderingSet()) {
+        // Its predicate buffer may be among the deleted buffers (as the drain: nothing then).
+        outcome = WR::Conditional;
+    } else {
+        // try_lock only: a thread that waits for memory may hold one of these (a CPU thread's
+        // download under the texture cache's lock); blocking here would wait for its whole limit.
+        std::unique_lock buffer_lock{buffer_cache.mutex, std::defer_lock};
+        std::unique_lock texture_lock{texture_cache.mutex, std::defer_lock};
+        bool locked = false;
+        for (int tries = 0; tries < 10 && !locked; ++tries) {
+            if (buffer_lock.try_lock()) {
+                if (texture_lock.try_lock()) {
+                    locked = true;
+                    break;
+                }
+                buffer_lock.unlock();
+            }
+            std::this_thread::sleep_for(std::chrono::milliseconds{2});
+        }
+        if (!locked) {
+            outcome = WR::Busy;
+        } else {
+            u64 device_before = 0, objects_before = 0, device_after = 0, objects_after = 0;
+            memory_allocator.DeviceMemory(device_before, objects_before);
+            const u64 used0 = memory_allocator.UsedBytes();
+            if (VideoCommon::Nx2FastDraw::Enabled()) {
+                VideoCommon::Nx2FastDraw::Break(VideoCommon::Nx2FastDraw::Reason::Frame);
+            }
+            MasterSemaphore& master = scheduler.GetMasterSemaphore();
+            bool reached = false;
+            if (WR::g_behind_tick != 0) {
+                master.Refresh();
+                if (master.IsFree(WR::g_behind_tick)) {
+                    WR::g_behind_tick = 0;
+                }
+            }
+            // (a) the drain's releases. Everything recorded so far is in this tick or earlier.
+            if (WR::g_behind_tick == 0) {
+                const u64 tick = scheduler.CurrentTick();
+                scheduler.Flush();
+                reached = master.WaitFor(tick, wait_ns);
+                if (!reached) {
+                    WR::g_behind_tick = tick;
+                }
+            }
+            texture_cache.ReleaseFinished();
+            if (reached) {
+                buffer_cache.ReleaseFinished();
+                buffer_cache.RetryRefusedNow();
+            }
+            staging += release_staging();
+            const u64 used1 = memory_allocator.UsedBytes();
+            drain = used0 > used1 ? used0 - used1 : 0;
+            // (b) images by least-recent use, only when the GPU caught up: the deleted ones are
+            // destroyed after one more wait, which a GPU that is behind would not pass.
+            u64 used2 = used1;
+            if (reached && target_bytes != 0) {
+                size_t count = 0;
+                image_marked = texture_cache.WaitReclaimEvict(target_bytes, (std::max)(min_age, 1u), count);
+                images = count;
+                if (count != 0) {
+                    const u64 tick = scheduler.CurrentTick();
+                    scheduler.Flush();
+                    if (!master.WaitFor(tick, wait_ns)) {
+                        WR::g_behind_tick = tick;
+                        outcome = WR::Behind;
+                    }
+                    texture_cache.ReleaseFinished();
+                    staging += release_staging();
+                }
+                used2 = memory_allocator.UsedBytes();
+                image_bytes = used1 > used2 ? used1 - used2 : 0;
+            } else if (!reached) {
+                outcome = WR::Behind;
+            }
+            // (c) what went back to the driver.
+            memory_allocator.DeviceMemory(device_after, objects_after);
+            to_driver = device_before > device_after ? device_before - device_after : 0;
+            if (DrainToPool::OwnMemoryOn()) {
+                DrainToPool::Arm(3000);
+            }
+        }
+    }
+    const u64 largest_after = PressureDrain::LargestFree();
+    const u64 took_us = static_cast<u64>(std::chrono::duration_cast<std::chrono::microseconds>(
+                                             std::chrono::steady_clock::now() - start)
+                                             .count());
+    WR::Result& r = WR::g_result;
+    r.outcome.store(outcome, std::memory_order_relaxed);
+    r.drain_bytes.store(drain, std::memory_order_relaxed);
+    r.staging_bytes.store(staging, std::memory_order_relaxed);
+    r.image_bytes.store(image_bytes, std::memory_order_relaxed);
+    r.images.store(images, std::memory_order_relaxed);
+    r.image_marked.store(image_marked, std::memory_order_relaxed);
+    r.to_driver.store(to_driver, std::memory_order_relaxed);
+    r.largest_before.store(largest_before, std::memory_order_relaxed);
+    r.largest_after.store(largest_after, std::memory_order_relaxed);
+    r.took_us.store(took_us, std::memory_order_relaxed);
+    r.passes.fetch_add(1, std::memory_order_relaxed);
+    r.freed_total.fetch_add(drain + image_bytes, std::memory_order_relaxed);
+    r.done_seq.store(seq, std::memory_order_release);
+}
+
 bool RasterizerVulkan::AccelerateConditionalRendering() {
     gpu_memory->FlushCaching();
     return query_cache.AccelerateHostConditionalRendering();
