+        const std::uint64_t waited_now = since != 0 && now > since ? now - since : 0;
+        // The swap's emergency pack of cold slots (swap_out_mutex by try_lock, locked slots passed over): needs
+        // no cache lock, so it runs whenever the pass cannot help this round: a GPU thread waits (its copy holds
+        // the caches' locks, so a pass would not run before it lost), the pass asked earlier is still out after a
+        // round, the last pass freed nothing (busy: a waiter holds a cache lock; conditional; failed), or there
+        // is no core pass. Not for heap waits alone, nor for game waiters while a pass can still serve them (a
+        // pack makes cold game slots fault again later).
+        const bool pass_stuck = pending && now - pending_since_ms >= c.every_ms;
+        const bool pass_useless = last_outcome == 2 || last_outcome == 3 || last_outcome == 5;
+        const bool want_pack = gpu != 0 || (cpu != 0 && (!servable || pass_stuck || pass_useless));
+        std::size_t pack = 0, slots = 0;
+        bool swap_busy = false;
