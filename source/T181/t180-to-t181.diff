+std::atomic<unsigned> reclaim_gpu_waiters{0};            // past AFTER_MS, GPUBack or GPU: the pass cannot run
+std::atomic<std::uint64_t> reclaim_grant_until_ms{0};    // waiters may go on past their limits until then
+std::atomic<const char*> reclaim_who{nullptr};           // the last thread to count itself, for the line
+std::atomic<std::uint64_t> reclaim_who_slot{0}, reclaim_who_since_ms{0};
