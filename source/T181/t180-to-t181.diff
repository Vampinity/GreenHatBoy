++        r.largest_before.load(std::memory_order_relaxed), r.largest_after.load(std::memory_order_relaxed),
++        r.took_us.load(std::memory_order_relaxed),      r.passes.load(std::memory_order_relaxed),
++        r.freed_total.load(std::memory_order_relaxed),
++    };
++    for (unsigned i = 0; i < count && i < std::size(all); ++i) {
++        values[i] = all[i];
++    }
++}
