++// EDEN_UP_WAIT_RECLAIM (wait_reclaim.h; the front's switch). The rasterizer that serves requests:
++// set by the constructor, cleared by the destructor, under the mutex the request takes.
++namespace Vulkan::WaitReclaim {
++std::mutex registry_mutex;
++RasterizerVulkan* registered{};
++} // namespace Vulkan::WaitReclaim
++
++// The front's helper thread (never a signal handler, never a GPU thread): queues one pass on the
++// GPU thread after the lists sent so far. 1 when queued, 0 when there is no rasterizer.
++extern "C" int eden_wait_reclaim_request(unsigned long long seq, unsigned long long target_bytes,
++                                         unsigned min_age, unsigned gpu_wait_ms) noexcept {
++    namespace WR = Vulkan::WaitReclaim;
++    try {
++        std::scoped_lock lock{WR::registry_mutex};
++        if (WR::registered == nullptr) {
++            return 0;
++        }
++        WR::registered->QueueWaitReclaim(seq, target_bytes, min_age, gpu_wait_ms);
++        return 1;
++    } catch (...) {
++        return 0; // no memory for the queued function: nothing queued
++    }
++}
++
++// In this order: done_seq, outcome, drain, staging, image bytes, images, image bytes as counted,
++// to the driver, largest piece before, after, took_us, passes, freed in all. At most `count`.
++extern "C" void eden_wait_reclaim_stats(unsigned long long* values, unsigned count) noexcept {
++    const auto& r = Vulkan::WaitReclaim::g_result;
++    // done_seq first (acquire): the rest belongs to that pass or a later one.
++    const unsigned long long all[] = {
++        r.done_seq.load(std::memory_order_acquire),     r.outcome.load(std::memory_order_relaxed),
++        r.drain_bytes.load(std::memory_order_relaxed),  r.staging_bytes.load(std::memory_order_relaxed),
