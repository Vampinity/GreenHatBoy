+        stretch.pack += pack;
+        if (servable && !pending) {
+            // EDEN_UP_WAIT_RECLAIM_TOTAL_MIB: images one stretch of waiting may delete in all; past it the pass
+            // still does the drain's releases.
+            const unsigned long long target =
+                stretch.marked >= c.total ? 0 : (std::min)(c.target, c.total - stretch.marked);
+            const unsigned flags = c.urgent_ms != 0 && waited_now >= c.urgent_ms ? 1u : 0u;
+            ++seq;
+            const int asked = eden_wait_reclaim_request(seq, target, c.age, c.gpu_ms, flags);
+            if (asked == 2) {
+                core_usable = false;
+                if (!sync_noted) {
+                    sync_noted = true;
+                    Report("EDEN_UP_WAIT_RECLAIM: synchronous GPU mode, no core pass (heap trim and swap pack only)\n");
+                }
+            } else if (asked == 1) {
+                pending = true;
+                pending_noted = false;
+                last_outcome = 0;
+                pending_seq = seq;
+                pending_since_ms = now;
+                pending_trim = trim;
+                pending_pack = pack;
+                pending_largest = largest0;
+                pending_who = who != nullptr ? who : "?";
+                pending_slot = reclaim_who_slot.load(std::memory_order_relaxed);
+                pending_waited = waited_now;
+                pending_cpu = cpu;
+                pending_gpu = gpu;
+                pending_heap = heap;
+                lock.lock();
+                continue;
+            }
+        }
+        const unsigned long long freed = trim + pack;
+        const std::uint64_t largest1 = PoolLargest();
+        const bool granted = grant(now, pack, largest0, largest1);
+        if ((freed != 0 || stretch.rounds == 1 || granted) && line_wanted()) {
+            char line[500];
+            const int length = std::snprintf(
+                line, sizeof(line),
+                "EDEN_UP_WAIT_RECLAIM round t_ms=%llu who=%s waited_ms=%llu waiters=%u/%u/%u gpu_pass=%s trim_mib=%llu "
+                "pack_mib=%llu (%zu slots%s) largest_mib=%llu->%llu freed_mib=%llu grant=%d\n",
+                (unsigned long long)(now - fault_log_start_ms), who != nullptr ? who : "heap",
+                (unsigned long long)waited_now, cpu, gpu, heap,
+                pending ? "still out" : cpu == 0 ? (gpu != 0 ? "none (GPU waiter)" : "none (heap wait)")
+                          : !core_usable ? "no core" : "not queued",
+                (unsigned long long)(trim / MiB), (unsigned long long)(pack / MiB), slots,
+                swap_busy ? ", swap busy" : "", (unsigned long long)(largest0 / MiB),
+                (unsigned long long)(largest1 / MiB), freed / MiB, granted ? 1 : 0);
+            if (length > 0) Report(line);
+        }
+        lock.lock();
+    }
+}
