+// A waiter's mark: raised once it waited AFTER_MS, dropped when its wait ends. A fault handler's: atomics only.
+struct ReclaimMark {
+    bool raised = false;
+    bool gpu = false;
+    void Raise(bool gpu_thread, const char* who, std::size_t slot, std::uint64_t since_ms) noexcept {
+        if (raised) return;
+        raised = true;
+        gpu = gpu_thread;
+        reclaim_who.store(who, std::memory_order_relaxed);
+        reclaim_who_slot.store(slot, std::memory_order_relaxed);
+        reclaim_who_since_ms.store(since_ms, std::memory_order_relaxed);
+        (gpu ? reclaim_gpu_waiters : reclaim_cpu_waiters).fetch_add(1, std::memory_order_acq_rel);
+    }
+    void Drop() noexcept {
+        if (!raised) return;
+        raised = false;
+        (gpu ? reclaim_gpu_waiters : reclaim_cpu_waiters).fetch_sub(1, std::memory_order_acq_rel);
+    }
+    // Raised when due; true while the wait may go on past its own limit (a recent round freed memory).
+    bool Tick(bool gpu_thread, const char* who, std::size_t slot, std::uint64_t start_ms) noexcept {
+        const std::uint64_t now = MonotonicMs();
+        if (!raised && now - start_ms >= wait_reclaim_after_ms.load(std::memory_order_relaxed))
+            Raise(gpu_thread, who, slot, start_ms);
+        return now < reclaim_grant_until_ms.load(std::memory_order_acquire) &&
+               now - start_ms < wait_reclaim_max_ms.load(std::memory_order_relaxed);
+    }
+};
