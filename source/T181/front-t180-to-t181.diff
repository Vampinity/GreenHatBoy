+// ---- T181a EDEN_UP_WAIT_RECLAIM's helper thread (the switch and the waiters' side: at wait_reclaim_on) ----
+//
+// A thread of its own, never a fault handler: it may take locks, ask the core to queue work, and write lines.
+// What it calls: eden_heap_trim_unheld (any thread; a fault handler's wait calls it too), EmergencyPackColdSlots
+// (swap_out_mutex by try_lock, slots locked now passed over), PoolLargest (a kernel query), and the core's
+// eden_wait_reclaim_request (takes the rasterizer's registry mutex and the GPU thread's queue lock, queues one
+// function, waits for nothing in asynchronous GPU mode). It holds no lock of its own while it calls them.
+struct WaitReclaimConfig {
+    unsigned every_ms = 100;
+    unsigned extend_ms = 3000;
+    unsigned age = 2;
+    unsigned gpu_ms = 200;
+    unsigned urgent_ms = 2000;
+    unsigned long long target = 128ull << 20;
+    unsigned long long total = 512ull << 20;
+    unsigned long long grant = 16ull << 20;
+};
+WaitReclaimConfig wait_reclaim_config; // written before the thread starts, read only after
+std::thread wait_reclaimer;
+void WaitReclaimLoop();
+
+void ReadWaitReclaimSwitches() noexcept {
+    const char* const value = std::getenv("EDEN_UP_WAIT_RECLAIM");
+    const bool on = value != nullptr && value[0] == '1' && value[1] == '\0';
+    wait_reclaim_on.store(false, std::memory_order_relaxed);
+    if (!on) return;
+    using ::Eden::MemoryWait::ReadMs;
+    auto& c = wait_reclaim_config;
+    wait_reclaim_after_ms.store(ReadMs("EDEN_UP_WAIT_RECLAIM_AFTER_MS", 50, 20, 5000), std::memory_order_relaxed);
+    wait_reclaim_max_ms.store(ReadMs("EDEN_UP_WAIT_RECLAIM_MAX_MS", 60000, 1000, 60000), std::memory_order_relaxed);
+    c.every_ms = ReadMs("EDEN_UP_WAIT_RECLAIM_EVERY_MS", 100, 50, 2000);
+    c.extend_ms = ReadMs("EDEN_UP_WAIT_RECLAIM_EXTEND_MS", 3000, 0, 10000);
+    c.age = ReadMs("EDEN_UP_WAIT_RECLAIM_AGE", 2, 1, 1000);
+    c.gpu_ms = ReadMs("EDEN_UP_WAIT_RECLAIM_GPU_MS", 200, 10, 1000);
+    c.target = static_cast<unsigned long long>(ReadMs("EDEN_UP_WAIT_RECLAIM_MIB", 128, 0, 2048)) << 20;
+    c.total = static_cast<unsigned long long>(ReadMs("EDEN_UP_WAIT_RECLAIM_TOTAL_MIB", 512, 0, 4096)) << 20;
+    c.urgent_ms = ReadMs("EDEN_UP_WAIT_RECLAIM_URGENT_MS", 2000, 0, 60000);
+    c.grant = static_cast<unsigned long long>(ReadMs("EDEN_UP_WAIT_RECLAIM_GRANT_MIB", 16, 1, 1024)) << 20;
+    try {
+        wait_reclaimer = std::thread(WaitReclaimLoop);
+    } catch (...) {
+        Report("EDEN_UP_WAIT_RECLAIM off: no thread\n");
+        return;
+    }
+    wait_reclaim_on.store(true, std::memory_order_release);
+    char line[400];
+    const int length = std::snprintf(
+        line, sizeof(line),
+        "EDEN_UP_WAIT_RECLAIM on: after %u ms of waiting, a round every %u ms (heap trim; a GPU pass of %llu MiB, "
+        "at most %llu MiB of images in one stretch, images unused for %u frames, spared ASTC after %u ms, GPU "
+        "waited for up to %u ms); a round that gives %llu MiB back to the pool in whole blocks or grows its "
+        "largest piece to 2 MiB lets waiters go on %u ms more, at most %u ms in all; core pass %s\n",
+        wait_reclaim_after_ms.load(std::memory_order_relaxed), c.every_ms, c.target >> 20, c.total >> 20, c.age,
+        c.urgent_ms, c.gpu_ms, c.grant >> 20, c.extend_ms, wait_reclaim_max_ms.load(std::memory_order_relaxed),
+        eden_wait_reclaim_request != nullptr ? "linked" : "missing (heap trim and swap only)");
+    if (length > 0) Report(line);
+}
