+                           drain = 0, staging = 0, image_bytes = 0, images = 0, marked = 0, to_driver = 0, trim = 0,
+                           pack = 0, grants = 0;
+        void Add(const Totals& o) noexcept {
+            rounds += o.rounds; passes += o.passes; busy += o.busy; conditional += o.conditional; behind += o.behind;
+            failed += o.failed; unserved += o.unserved; drain += o.drain; staging += o.staging;
+            image_bytes += o.image_bytes; images += o.images; marked += o.marked; to_driver += o.to_driver;
+            trim += o.trim; pack += o.pack; grants += o.grants;
+        }
+    };
+    Totals session{}, stretch{};
+    bool in_stretch = false;
+    std::uint64_t stretch_start_ms = 0, last_totals_ms = 0, last_round_ms = 0, seq = 0;
+    unsigned heap_ticks = 0, lines = 0;
+    // The pass asked for and not answered yet (one at a time), and what its round did on this side.
+    bool pending = false, pending_noted = false, sync_noted = false, core_usable = eden_wait_reclaim_request != nullptr;
+    std::uint64_t pending_seq = 0, pending_since_ms = 0, pending_trim = 0, pending_pack = 0, pending_largest = 0,
