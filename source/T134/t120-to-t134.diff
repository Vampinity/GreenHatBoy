++// null for a command with no output buffer. Off the retry, no try block: a refusal goes on from where
++// it was thrown, as before. v2 (review): not a template, so one copy for all ~1,300 commands; the
++// wrapper hands its ReadInArgument in as `read_inputs(read_context)`.
++inline void Prepare(Lease* lease, const Sizes& sizes, void (*read_inputs)(void*), void* read_context,
++                    std::string_view service, std::uint32_t command) {
++    const Config& config = Get();
