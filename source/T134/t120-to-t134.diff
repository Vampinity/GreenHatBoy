++// One request's hold on its output buffers (`buffers`: the wrapper's own, which ReadInArgument and
++// WriteOutArgument use as before). With the reuse on, the thread's kept buffers are swapped into
++// `buffers` for the request and swapped back when it ends (destructor: after the reply is written,
++// and on any exception). `mask`: the slots that are output buffers (OutBufferSlotMask).
++class Lease {
++public:
++    Lease(Slots& buffers, std::uint32_t mask) noexcept : m_buffers{buffers}, m_mask{mask} {}
++    ~Lease() {
++        Return();
++    }
++    Lease(const Lease&) = delete;
++    Lease& operator=(const Lease&) = delete;
++
++    // Before ReadInArgument. `sizes`: what ReadInArgument will size each slot to. Throws
++    // std::bad_alloc only for the test; the allocations themselves stay in ReadInArgument.
++    // `test_counts`: this request's service is the one EDEN_TEST_HLE_ALLOC_FAIL counts.
++    void Take(const Sizes& sizes, bool test_counts) {
++        const Config& config = Get();
