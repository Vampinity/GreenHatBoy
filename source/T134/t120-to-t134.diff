++            const std::uint32_t bit = 1U << i;
++            if ((m_mask & bit) == 0 || sizes[i] == 0) {
++                continue;
++            }
++            counters.setups.fetch_add(1, std::memory_order_relaxed);
++            NoteLargest(sizes[i]);
++            if (m_own && sizes[i] <= config.cap_bytes) {
++                if ((m_taken & bit) == 0) {
++                    m_buffers[i].swap(t_slots[i]);
++                    m_before[i] = m_buffers[i].capacity();
++                    m_taken |= bit;
++                }
++                if (sizes[i] <= m_buffers[i].capacity()) {
++                    counters.saved.fetch_add(1, std::memory_order_relaxed);
++                    if (!counters.said_reuse.exchange(true, std::memory_order_relaxed)) {
++                        char line[160];
++                        std::snprintf(line, sizeof(line),
++                                      "EDEN_UP_HLE_REPLY_BUFFER acts: a reply of %zu bytes built in a kept buffer "
++                                      "of %zu, no allocation\n",
++                                      sizes[i], m_buffers[i].capacity());
++                        Line(line);
++                    }
++                    continue;
++                }
++                counters.grew.fetch_add(1, std::memory_order_relaxed);
++            } else if (config.reuse) {
++                if (m_own) {
++                    counters.over_cap.fetch_add(1, std::memory_order_relaxed);
++                    if (!counters.said_over_cap.exchange(true, std::memory_order_relaxed)) {
++                        char line[160];
++                        std::snprintf(line, sizeof(line),
++                                      "EDEN_UP_HLE_REPLY_BUFFER a reply of %zu bytes is over the %zu MiB cap: "
++                                      "one-off buffer as before\n",
++                                      sizes[i], config.cap_bytes >> 20);
++                        Line(line);
++                    }
++                } else {
++                    counters.nested.fetch_add(1, std::memory_order_relaxed);
++                }
++            }
++            if (sizes[i] <= m_buffers[i].capacity()) {
++                continue; // a retry's slot that kept its buffer: no allocation
++            }
++            // ReadInArgument's resize_destructive allocates for this slot.
++            counters.allocated.fetch_add(1, std::memory_order_relaxed);
++            if (TestFailNow(test_counts)) {
++                counters.test_thrown.fetch_add(1, std::memory_order_relaxed);
++                char line[160];
++                std::snprintf(line, sizeof(line),
++                              "EDEN_TEST_HLE_ALLOC_FAIL throws std::bad_alloc for a reply buffer of %zu bytes\n",
++                              sizes[i]);
