++private:
++    Slots& m_buffers;
++    const std::uint32_t m_mask;
++    std::uint32_t m_taken = 0;
++    std::array<std::size_t, 3> m_before{};
++    bool m_own = false;
++    bool m_tried_own = false;
++    bool m_lined = false;
