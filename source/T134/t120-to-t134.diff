++// v2 (review): the "memory wanted" mark held for the pause and the second try, taken back on every
++// way out (also an exception that is not std::bad_alloc), so the caches never stay at their hardest.
++class WantScope {
++public:
++    WantScope() noexcept {
++        if (eden_heap_want) {
