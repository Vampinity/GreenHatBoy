++    // After a refusal, before the retry: the buffers that were to grow go now (their old room is of
++    // no use to the request, and growth asks for the new one before the old goes).
++    void DropGrowing(const Sizes& sizes) noexcept {
++        for (std::size_t i = 0; i < sizes.size(); ++i) {
++            if ((m_mask & (1U << i)) != 0 && sizes[i] > m_buffers[i].capacity()) {
++                m_buffers[i].release();
++            }
