+    if (eden_heap_steal_within(last, start, EDEN_HEAP_STEAL_COUNT_US)) {
+      eden_heap_steal_bump(EDEN_STEAL_RATE, 1);
+      return NULL;
+    }
+  } else if ((self == NULL || self->steal == 0) && eden_heap_steal_cached(start, bytes)) {
