+constexpr std::size_t JitReclaimAsk = std::size_t{16} << 20;     // one step; under PackRefusalLarge (64 MiB)
+constexpr unsigned ClearsPerWindow = 4;
+constexpr std::uint64_t ClearWindowMs = 120'000;
