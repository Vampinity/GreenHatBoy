+bool WritebackBandsCover([[maybe_unused]] const ImageInfo& info, [[maybe_unused]] s32 level,
+                         [[maybe_unused]] size_t subresource_size) {
+    // EDEN_UP_WRITEBACK_BANDS (0565): TrySwizzleLayerInBands' own refusals that do not depend on
+    // the guest range, so WritebackNeedsHeap leaves to the bands every level they would take
+    // through the kept buffer. A guest-thread DownloadMemory holding the buffer (g_band_busy)
+    // can still send such a write-back to the old path after this said yes: today's behaviour.
+    if (Common::LiveSwitch::Peek<Common::LiveSwitch::Id::WritebackBands>() == 0 ||
+        g_band_cap == 0) {
+        return false;
+    }
+    const LevelInfo level_info = MakeLevelInfo(info);
+    const Extent2D tile_size = DefaultBlockSize(info.format);
+    const u32 bytes_per_block = BytesPerBlock(info.format);
+    const Extent3D level_size = AdjustMipSize(info.size, level);
+    const Extent3D num_tiles = AdjustTileSize(level_size, tile_size);
+    const Extent3D block =
+        AdjustMipBlockSize(num_tiles, level_info.block, level, level_info.num_levels);
+    if (num_tiles.depth != 1 || block.depth != 0) {
+        return false;
+    }
+    // The same arithmetic as TrySwizzleLayerInBands (SwizzleImpl's block_size, stride_alignment 1).
+    const u32 stride = Common::AlignUpLog2(num_tiles.width, 1) * bytes_per_block;
+    const u64 row_bytes = u64{Common::DivCeilLog2(stride, GOB_SIZE_X_SHIFT)}
+                          << (GOB_SIZE_SHIFT + block.height);
+    const u32 rows = Common::DivCeilLog2(num_tiles.height, block.height + GOB_SIZE_Y_SHIFT);
+    const u64 footprint = u64{rows} * row_bytes;
+    return row_bytes != 0 && rows != 0 && footprint <= subresource_size && row_bytes <= g_band_cap;
+}
+
+bool WritebackNeedsHeap(Tegra::MemoryManager& gpu_memory, GPUVAddr gpu_addr, const ImageInfo& info,
+                        size_t scratch_capacity) {
+    if (info.type == ImageType::Linear) {
+        return false; // SwizzlePitchLinearImage writes line by line, with no scratch
+    }
+    // The geometry SwizzleBlockLinearImage uses, written out again so that function stays as it
+    // was: per level, the same offset, layer stride and subresource size, every layer.
+    const Extent3D size = info.size;
+    const LevelInfo level_info = MakeLevelInfo(info);
+    const Extent2D tile_size = DefaultBlockSize(info.format);
+    const u32 num_levels = info.resources.levels;
+    const std::array sizes = CalculateLevelSizes(level_info, num_levels);
+    const size_t layer_stride =
+        AlignLayerSize(CalculateLevelBytes(sizes, num_levels), size, level_info.block,
+                       tile_size.height, info.tile_width_spacing);
+    for (s32 level = 0; level < info.resources.levels; ++level) {
+        const size_t subresource_size = sizes[level];
+        // GuestMemory::Read grows the scratch only when the range is no host span and the
+        // size is above the capacity (ScratchBuffer::resize_destructive); size 0 reads nothing.
+        // A growth below WritebackSmallGrowthBytes is a small request (the heap's small path)
+        // and is allowed: after a scratch release (capacity 0) every split write-back would
+        // otherwise be left, however small.
+        if (subresource_size == 0 || subresource_size <= scratch_capacity ||
+            subresource_size < WritebackSmallGrowthBytes ||
+            WritebackBandsCover(info, level, subresource_size)) {
+            continue;
+        }
+        size_t guest_offset = CalculateLevelBytes(sizes, level);
+        for (s32 layer = 0; layer < info.resources.layers; ++layer) {
+            if (gpu_memory.GetSpan(gpu_addr + guest_offset, subresource_size) == nullptr) {
+                return true;
+            }
+            guest_offset += layer_stride;
+        }
+    }
+    return false;
+}
+
+bool GcWritebackStarveScope::Enter() noexcept {
+    if (!eden_heap_wait_scope) {
+        return false; // not on the console's heap: nothing to enter
+    }
+    eden_heap_wait_scope(1);
+    return true;
+}
+
+void GcWritebackStarveScope::Leave() noexcept {
+    eden_heap_wait_scope(0);
+}
