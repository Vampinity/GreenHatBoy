+/// EDEN_UP_WRITEBACK_BANDS: whether its banded write-back takes this level's subresource through
+/// the kept buffer, with no growth of the scratch. Without that patch: false.
+[[nodiscard]] bool WritebackBandsCover(const ImageInfo& info, s32 level, size_t subresource_size);
+
+/// EDEN_UP_GC_WRITEBACK_SKIP: whether SwizzleImage of the whole image (FullDownloadCopies) would
+/// grow a scratch of scratch_capacity bytes: some block-linear subresource is not one host span,
+/// is larger than the scratch, and the band path does not take it. Reads the page tables only.
+[[nodiscard]] bool WritebackNeedsHeap(Tegra::MemoryManager& gpu_memory, GPUVAddr gpu_addr,
+                                      const ImageInfo& info, size_t scratch_capacity);
+
+/// EDEN_UP_GC_WRITEBACK_SKIP: a scratch growth below this many bytes does not count as needing
+/// heap. It is the console heap's small-request size (headless/heap_arenas.inc
+/// EDEN_HEAP_SMALL_REQUEST), the size from which EDEN_TEST_HEAP_STARVE refuses.
+inline constexpr size_t WritebackSmallGrowthBytes = size_t{256} << 10;
+
+/// EDEN_TEST_GC_WRITEBACK_STARVE=1 (a test aid, read at boot, never in a play env): the
+/// collector's write-back runs inside the front's heap wait scope, so EDEN_TEST_HEAP_STARVE with
+/// EDEN_TEST_HEAP_STARVE_GPU=1 refuses its requests of 256 KiB or more. Off (or not on the
+/// console's heap): nothing is called. Lives on the stack of the thread that writes back.
+class GcWritebackStarveScope {
+public:
+    explicit GcWritebackStarveScope(bool on_) noexcept : on{on_ && Enter()} {}
+    ~GcWritebackStarveScope() {
+        End();
+    }
+    GcWritebackStarveScope(const GcWritebackStarveScope&) = delete;
+    GcWritebackStarveScope& operator=(const GcWritebackStarveScope&) = delete;
+
+    void End() noexcept {
+        if (on) {
+            Leave();
+            on = false;
+        }
+    }
+
+private:
+    static bool Enter() noexcept;
+    static void Leave() noexcept;
+
+    bool on;
+};
