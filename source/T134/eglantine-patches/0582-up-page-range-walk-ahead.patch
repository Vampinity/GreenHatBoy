+size_t MemoryManager::MaxContinuousRangeAhead(GPUVAddr gpu_addr, size_t size) const {
+    if (size == 0 || !IsWithinGPUAddressRange(gpu_addr) ||
+        size > address_space_size - gpu_addr || map_writers.load(std::memory_order_acquire) != 0) {
+        return MaxContinuousRangeUncached(gpu_addr, size);
+    }
+
+    struct Interval {
+        GPUVAddr begin{};
+        GPUVAddr end{};
+        u64 serial{};
+        bool complete{};
+    };
+    // Port addition: plain per-thread counters (no atomics on this path), one stderr line per
+    // thread at most every 10 s, the clock read once per 65,536 calls.
+    struct Counters {
+        u64 calls{};
+        u64 hits{};
+        u64 walks{};
+        u64 walked_bytes{};
+        u64 dropped{};
+        u64 fell_back{};
+        u64 verified{};
+        u64 wrong{};
+        u64 serial_at_line{};
+    };
+    struct Cache {
+        size_t owner{};
+        std::array<Interval, 16> intervals{};
+        size_t next{};
+        Counters counts{};
+        u64 owner_changes{};
+        // Port addition (review minor 2): wrong answers on this thread since boot, never reset,
+        // so a fault prints its first 16 lines per thread in all, not 16 every 10 s.
+        u64 wrong_total{};
+        std::chrono::steady_clock::time_point last_line{};
+    };
+    thread_local Cache cache{};
+    if (cache.owner != unique_identifier + 1) {
+        const Counters counts = cache.counts;
+        const u64 owner_changes = cache.owner_changes + (cache.owner != 0 ? 1 : 0);
+        const auto last_line = cache.last_line;
+        const u64 wrong_total = cache.wrong_total;
+        cache = {};
+        cache.owner = unique_identifier + 1;
+        cache.counts = counts;
+        cache.owner_changes = owner_changes;
+        cache.last_line = last_line;
+        cache.wrong_total = wrong_total;
+    }
+    Counters& counts = cache.counts;
+    if ((++counts.calls & 0xFFFF) == 0) [[unlikely]] {
+        const auto now = std::chrono::steady_clock::now();
+        if (now - cache.last_line >= std::chrono::seconds{10}) {
+            const u64 serial_now = map_serial.load(std::memory_order_relaxed);
+            std::fprintf(stderr,
+                         "EDEN_NX2_PAGE_RANGE_WALK_AHEAD 10s (this thread): calls %llu, kept-run "
+                         "hits %llu, walks ahead %llu (%llu MiB walked), runs dropped by a map "
+                         "change %llu, fell back (map change in flight) %llu, map changes %llu, "
+                         "address space switches %llu, verified %llu, wrong %llu (since boot "
+                         "%llu)\n",
+                         static_cast<unsigned long long>(counts.calls),
+                         static_cast<unsigned long long>(counts.hits),
+                         static_cast<unsigned long long>(counts.walks),
+                         static_cast<unsigned long long>(counts.walked_bytes >> 20),
+                         static_cast<unsigned long long>(counts.dropped),
+                         static_cast<unsigned long long>(counts.fell_back),
+                         static_cast<unsigned long long>(serial_now - counts.serial_at_line),
+                         static_cast<unsigned long long>(cache.owner_changes),
+                         static_cast<unsigned long long>(counts.verified),
+                         static_cast<unsigned long long>(counts.wrong),
+                         static_cast<unsigned long long>(cache.wrong_total));
+            counts = {};
+            counts.serial_at_line = serial_now;
+            cache.owner_changes = 0;
+            cache.last_line = now;
+        }
+    }
+    const u64 serial = map_serial.load(std::memory_order_acquire);
+    const auto mapping_is_current = [&] {
+        return map_writers.load(std::memory_order_acquire) == 0 &&
+               map_serial.load(std::memory_order_acquire) == serial;
+    };
+    for (auto& interval : cache.intervals) {
+        if (gpu_addr < interval.begin || gpu_addr >= interval.end) {
+            continue;
+        }
+        const size_t available = interval.end - gpu_addr;
+        if (size > available && !interval.complete) {
+            continue;
+        }
+        if (interval.serial != serial &&
+            MapChangedSince(interval.serial, serial, interval.begin, interval.end)) {
+            interval = {};
+            ++counts.dropped;
+            continue;
+        }
+        if (mapping_is_current()) {
+            interval.serial = serial;
+            const size_t kept = (std::min)(size, available);
+            ++counts.hits;
+            if (RangeWalkAheadVerify()) [[unlikely]] {
+                const size_t walked = MaxContinuousRangeUncached(gpu_addr, size);
+                ++counts.verified;
+                if (walked != kept && mapping_is_current()) {
+                    ++counts.wrong;
+                    if (++cache.wrong_total <= 16) {
+                        std::fprintf(stderr,
+                                     "EDEN_NX2_PAGE_RANGE_WALK_AHEAD_VERIFY: address 0x%llx size "
+                                     "%zu: kept %zu, walked %zu (run 0x%llx-0x%llx, %s)\n",
+                                     static_cast<unsigned long long>(gpu_addr), size, kept,
+                                     walked, static_cast<unsigned long long>(interval.begin),
+                                     static_cast<unsigned long long>(interval.end),
+                                     interval.complete ? "complete" : "open");
+                    }
+                }
+                return walked;
+            }
+            return kept;
+        }
+        ++counts.fell_back;
+        return MaxContinuousRangeUncached(gpu_addr, size);
+    }
+
+    constexpr size_t walk_ahead = size_t{256} << 20;
+    const auto walk = (std::min<size_t>)((std::max)(size, walk_ahead), address_space_size - gpu_addr);
+    const size_t found = MaxContinuousRangeUncached(gpu_addr, walk);
+    ++counts.walks;
+    counts.walked_bytes += found;
+    if (!mapping_is_current()) {
+        ++counts.fell_back;
+        return MaxContinuousRangeUncached(gpu_addr, size);
+    }
+    if (found != 0) {
+        cache.intervals[cache.next++ % cache.intervals.size()] =
+            {gpu_addr, gpu_addr + found, serial, found < walk};
+    }
+    return (std::min)(size, found);
+}
+
