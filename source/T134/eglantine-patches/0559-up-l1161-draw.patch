+/// Full range list: retain a conservative superset, never drop a guest write.
+inline void AppendConservativeRange(std::array<u64, Delta::MaxWrites>& begins,
+                                    std::array<u64, Delta::MaxWrites>& ends, u32& count,
+                                    u64 begin, u64 end) {
+    for (u32 i = 0; i < count; ++i) {
+        if (begin <= ends[i] && begins[i] <= end) {
+            begins[i] = (std::min)(begins[i], begin);
+            ends[i] = (std::max)(ends[i], end);
+            return;
+        }
+    }
+    if (count < WriteLimit()) {
+        begins[count] = begin;
+        ends[count++] = end;
+        return;
+    }
+    u32 best = 0;
+    u64 growth = ~u64{0};
+    for (u32 i = 0; i < count; ++i) {
+        const u64 added = ((std::max)(ends[i], end) - (std::min)(begins[i], begin)) -
+                          (ends[i] - begins[i]);
+        if (added < growth) { growth = added; best = i; }
+    }
+    begins[best] = (std::min)(begins[best], begin);
+    ends[best] = (std::max)(ends[best], end);
+    g_delta.no_uniform_keeps = true;
+}
