+void GraphicsPipeline::BuildHandleWords() {
+    handle_words = std::make_unique<HandleWordTable>();
+    {
+        for (size_t stage = 0; stage < NUM_STAGES; ++stage) {
+            const auto add = [&](const auto& desc) {
+                if (desc.handle_program != ~0U) return;
+                const auto range = [&](u32 slot, u32 offset) {
+                    precise_handle_buffers[stage] |= 1U << slot;
+                    for (u32 i = 0; i < desc.count; ++i) {
+                        const u32 first = offset + (i << desc.size_shift);
+                        handle_words->words[stage][slot].emplace_back(first, first + 4);
+                    }
+                };
+                range(desc.cbuf_index, desc.cbuf_offset);
+                if constexpr (requires { desc.has_secondary; }) {
+                    if (desc.has_secondary) range(desc.secondary_cbuf_index, desc.secondary_cbuf_offset);
+                }
+            };
+            const auto& info = stage_infos[stage];
+            for (const auto& desc : info.texture_buffer_descriptors) add(desc);
+            for (const auto& desc : info.image_buffer_descriptors) add(desc);
+            for (const auto& desc : info.texture_descriptors) add(desc);
+            for (const auto& desc : info.image_descriptors) add(desc);
+        }
+    }
+
+    handle_words_ready = true;
+}
+
+bool GraphicsPipeline::ComputedHandlesChanged() const {
+    for (const ComputedHandle& handle : delta_computed_handles) {
+        const Shader::Info& info{stage_infos[handle.stage]};
+        const auto& cbufs{maxwell3d->state.shader_stages[handle.stage].const_buffers};
+        u32 program{};
+        switch (handle.kind) {
+        case HandleTextureBuffer:
+            program = info.texture_buffer_descriptors[handle.descriptor].handle_program;
+            break;
+        case HandleImageBuffer:
+            program = info.image_buffer_descriptors[handle.descriptor].handle_program;
+            break;
+        case HandleTexture:
+            program = info.texture_descriptors[handle.descriptor].handle_program;
+            break;
+        default:
+            program = info.image_descriptors[handle.descriptor].handle_program;
+            break;
+        }
+        // As ConfigureImpl's read_handle computes it.
+        const u32 value{VideoCommon::EvaluateTextureHandle(
+            info, program, *gpu_memory,
+            [&](u32 cbuf) -> GPUVAddr {
+                return cbuf < cbufs.size() && cbufs[cbuf].enabled ? cbufs[cbuf].address
+                                                                  : GPUVAddr{};
+            })};
+        if (value != handle.value) {
+            return true;
+        }
+    }
+    return false;
+}
