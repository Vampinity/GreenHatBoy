+// headless/performance.cpp: the largest free block of the pool the CPU shares with the GPU, in
+// bytes, 0 when unknown. Weak: without it the gate below never waits.
+extern "C" unsigned long long eden_pool_largest_free(void) __attribute__((weak));
+// headless/heap_arenas.inc (EDEN_UP_HEAP_WAIT_MS): the heap requests waiting for memory now.
+extern "C" unsigned eden_heap_wanted(void) __attribute__((weak));
+
+namespace PipelineMemoryGate {
+namespace {
+Counters gate_counters; // constant-initialized: atomics only
+} // Anonymous namespace
+
+// EDEN_PIPELINE_MEMORY_GATE_MIB=<n> (off unless set): while the pool's largest free block is under
+// n MiB, pipeline builds take turns (pipeline_memory_gate.h). EDEN_PIPELINE_MEMORY_GATE_MS=<ms>
+// (default 2000): the longest one waits before it goes ahead anyway.
+// EDEN_PIPELINE_MEMORY_GATE_WORKERS=1 (exact "1", only with a mark; 0554, not in 0915): the driver
+// compile a builder runs for a pipeline made during play takes its turn too (vk_graphics_pipeline.cpp,
+// vk_compute_pipeline.cpp). Without it, during play the gate only sees the threads that translate.
+const GateConfig& GateSettings() {
+    static const GateConfig settings = [] {
+        GateConfig result{};
+        if (const char* const mib = std::getenv("EDEN_PIPELINE_MEMORY_GATE_MIB")) {
+            result.mark = std::strtoull(mib, nullptr, 10) << 20;
+        }
+        const char* const ms = std::getenv("EDEN_PIPELINE_MEMORY_GATE_MS");
+        // At most 10 s: a wait here must never hide a real shortage for long.
+        result.limit = std::chrono::milliseconds{
+            std::min<unsigned long long>(ms != nullptr ? std::strtoull(ms, nullptr, 10) : 2000ULL, 10000ULL)};
+        const char* const workers = std::getenv("EDEN_PIPELINE_MEMORY_GATE_WORKERS");
+        result.workers = result.mark != 0 && workers != nullptr && std::string_view{workers} == "1";
+        if (result.mark != 0) {
+            try {
+                LOG_INFO(Render_Vulkan, "EDEN_PIPELINE_MEMORY_GATE: builds take turns under {} MiB free, "
+                                        "waiting at most {} ms{}",
+                         result.mark >> 20, result.limit.count() / 1000,
+                         result.workers ? ", builders' driver compiles too" : "");
+            } catch (const std::bad_alloc&) {
+            }
+        }
+        return result;
+    }();
+    return settings;
+}
+
+Counters& GateCounters() {
+    return gate_counters;
+}
+
+std::uint64_t GateFree() {
+    return eden_pool_largest_free ? eden_pool_largest_free() : 0;
+}
+
+// A line when the waits grew by 32 since the last one (and at the first), at most one per 10 s:
+// how many builds waited, for how long in all, and how many went ahead at the limit. A line that
+// finds no memory is left out (a std::bad_alloc here would drop the pipeline being built).
+void GateReport() {
+    static std::atomic<std::uint64_t> reported{0};
+    static std::atomic<s64> reported_ns{0};
+    const std::uint64_t waited = gate_counters.waited.load(std::memory_order_relaxed);
+    const std::uint64_t last = reported.load(std::memory_order_relaxed);
+    if (waited == 0 || (last != 0 && waited < last + 32)) {
+        return;
+    }
+    const s64 now = std::chrono::duration_cast<std::chrono::nanoseconds>(
+                        std::chrono::steady_clock::now().time_since_epoch())
+                        .count();
+    s64 last_ns = reported_ns.load(std::memory_order_relaxed);
+    if ((last_ns != 0 && now - last_ns < 10'000'000'000LL) ||
+        !reported_ns.compare_exchange_strong(last_ns, now, std::memory_order_relaxed)) {
+        return;
+    }
+    reported.store(waited, std::memory_order_relaxed);
+    try {
+        LOG_INFO(Render_Vulkan,
+                 "EDEN_PIPELINE_MEMORY_GATE: {} of {} builds waited, {} ms in all, {} at the limit, "
+                 "{} inside now, {} MiB free",
+                 waited, gate_counters.builds.load(std::memory_order_relaxed),
+                 gate_counters.wait_us.load(std::memory_order_relaxed) / 1000,
+                 gate_counters.timeouts.load(std::memory_order_relaxed),
+                 gate_counters.running.load(std::memory_order_relaxed), GateFree() >> 20);
+    } catch (const std::bad_alloc&) {
+    }
+}
+} // namespace PipelineMemoryGate
+
+namespace {
+// 0554, not in 0915: what the GPU thread's builds (build_in_parallel, not a translator) give the
+// gate for the free memory. While a builder's heap request waits for memory (EDEN_UP_HEAP_WAIT_MS),
+// 0 ("unknown": go ahead). That wait counts on the texture collector, which runs on this thread;
+// held at the gate behind that same builder, the two would wait on each other until the gate's
+// limit. Without EDEN_UP_HEAP_WAIT_MS eden_heap_wanted() stays 0 and this is the gate's own value.
+std::uint64_t GateFreeOnGpuThread() {
+    // With EDEN_PIPELINE_MEMORY_GATE_WORKERS=1 the driver compiles take their turns on the
+    // builders, and the GPU thread, which draws the frame and runs the texture collector they may
+    // be waiting on, never waits here (it still counts while inside).
+    if (PipelineMemoryGate::GateSettings().workers) {
+        return 0;
+    }
+    if (eden_heap_wanted && eden_heap_wanted() != 0) {
+        return 0;
+    }
+    return PipelineMemoryGate::GateFree();
+}
+} // Anonymous namespace
