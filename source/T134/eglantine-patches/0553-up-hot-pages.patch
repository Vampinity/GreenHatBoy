 void BufferCache<P>::TickFrame() {
+    if (VideoCommon::HotPagesEnabled()) {
+        VideoCommon::g_hot_page_epoch.fetch_add(1, std::memory_order_relaxed);
+    }
     // Homebrew console apps don't create or bind any channels, so this will be nullptr.
     if (!channel_state) {
         return;
@@ -3499,7 +3502,7 @@
         }
         const DAddr begin = (std::max<DAddr>)(page, device_addr);
         const u64 length = (std::min<DAddr>)(page + Core::DEVICE_PAGESIZE, end) - begin;
-        if (memory_tracker.IsRegionCpuModified(begin, length)) {
+        if (!VideoCommon::HotPagesEnabled() && memory_tracker.IsRegionCpuModified(begin, length)) {
             // Uploaded by this bind anyway.
             ++nx2_bank_flag_stats.already_modified;
