         {
             Tegra::Memory::GpuGuestMemoryScoped<u8,
                                                 Tegra::Memory::GuestMemoryFlags::UnsafeReadWrite>
@@ -1661,9 +1946,88 @@ boost::container::small_vector<SwizzleParameters, 16> FullUploadSwizzles(const I
