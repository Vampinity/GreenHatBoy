+void ArmWritebackBands() {
+    // Once, from the TextureCache constructor, before any thread writes back through the cache.
+    static bool armed = false;
+    if (armed) {
+        return;
+    }
+    armed = true;
+    // The switch's first use, so that Peek reads its value from here on.
+    static_cast<void>(Common::LiveSwitch::Value<Common::LiveSwitch::Id::WritebackBands>());
+    g_band_verify = Common::PeSwitch("EDEN_UP_WRITEBACK_BANDS_VERIFY");
+    g_band_test_split = Common::PeSwitch("EDEN_TEST_WRITEBACK_SPLIT");
+    if (g_band_test_split) {
+        LOG_WARNING(HW_GPU, "EDEN_TEST_WRITEBACK_SPLIT=1: every block-linear write-back is "
+                            "treated as split and runs in the heap wait scope (a test aid)");
+    }
+    if (!Common::PeSwitch("EDEN_UP_WRITEBACK_BANDS")) {
+        return; // Off at boot: no buffer, and turning it on later counts fb_no_buf
+    }
+    size_t mib = 8;
+    if (const char* const value = std::getenv("EDEN_UP_WRITEBACK_BANDS_MIB")) {
+        char* end = nullptr;
+        const unsigned long asked = std::strtoul(value, &end, 10);
+        if (end != value && *end == '\0' && asked >= 1 && asked <= 32) {
+            mib = asked;
+        } else {
+            LOG_WARNING(HW_GPU, "EDEN_UP_WRITEBACK_BANDS_MIB={} is not 1 to 32: 8 MiB", value);
+        }
+    }
+    // std::malloc, not new: on the console a refusal is a quiet NULL, not the new_handler's
+    // snapshot. Never freed; HEAP_HOLDERS and SCRATCH_KEEP do not see it.
+    g_band_buf = static_cast<u8*>(std::malloc(mib << 20));
+    if (g_band_buf == nullptr) {
+        LOG_WARNING(HW_GPU,
+                    "EDEN_UP_WRITEBACK_BANDS: no {} MiB for the kept buffer, write-backs take "
+                    "the old path",
+                    mib);
+        return;
+    }
+    g_band_cap = mib << 20;
+    LOG_INFO(HW_GPU,
+             "EDEN_UP_WRITEBACK_BANDS: split write-backs go in block-row bands through a kept "
+             "{} MiB buffer{}",
+             mib, g_band_verify ? " (verify: each one compared with the old result)" : "");
+}
+
+void LogWritebackBands() {
+    // TickFrame on GPUBack, under texture_cache.mutex, with the switch on.
+    using Clock = std::chrono::steady_clock;
+    static Clock::time_point last{};
+    static std::array<u64, WbCountEnd> seen{};
+    const Clock::time_point now = Clock::now();
+    if (last == Clock::time_point{}) {
+        last = now;
+        return;
+    }
+    if (now - last < std::chrono::seconds{10}) {
+        return;
+    }
+    last = now;
+    std::array<u64, WbCountEnd> delta{};
+    for (size_t i = 0; i < WbCountEnd; ++i) {
+        const u64 value = g_wb_counts[i].load(std::memory_order_relaxed);
+        delta[i] = value - seen[i];
+        seen[i] = value;
+    }
+    g_wb_mismatch_logs.store(0, std::memory_order_relaxed);
+    LOG_INFO(HW_GPU,
+             "EDEN_UP_WRITEBACK_BANDS: wb={} whole={} banded={} bands={} MiB={} tail_KiB={} "
+             "fb_no_buf={} fb_row_wide={} fb_layout={} fb_busy={} verify={} mismatch_bytes={} "
+             "verify_skipped={} aid_old_copy={} buf_mib={}",
