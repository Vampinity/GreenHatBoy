+            }
             for (const auto& [address, size] : ahead_held_writes) {
                 callback_writes(address, size);
             }
             ahead_held_writes.clear();
+            ahead_held_tags.clear();
             system.GatherGPUDirtyMemory(callback_writes);
             VideoCommon::AheadGuard::TakeRedirty(callback_writes);
             return;
@@ -231,6 +246,135 @@ struct GPU::Impl {
             renderer->ReadRasterizer()->ClaimCpuWrites(kept);
             ahead_held_writes.insert(ahead_held_writes.end(), kept.begin(), kept.end());
         }
+        const bool held_age =
+            Common::LiveSwitch::Peek<Common::LiveSwitch::Id::AheadGuardHeldAge>() != 0;
+        if (held_age ||
+            Common::LiveSwitch::Peek<Common::LiveSwitch::Id::AheadGuardHeldAgeVerify>() != 0)
+            [[unlikely]] {
+            ReleaseLiftedHeldLocked(callback_writes, kept.size(), held_age);
+        }
+    }
+
+    /// EDEN_UP_AHEAD_GUARD_HELD_AGE=1 (live), at =3 in a gather while a guard is up, under
+    /// ahead_gather_mutex (GPUBack, GPUFencingThread, or the thread a sync operation runs on).
+    /// Without it a held write waits for a gather with no guard up at all; with
+    /// EDEN_UP_AHEAD_ALWAYS each present puts a new guard up right after the last one is lifted,
+    /// and the per-fence gathers run while one is up, so held writes (and the ranges uploads took
+    /// from copies, TakeRedirty) can wait for several frames: buffers and textures keep older
+    /// bytes than memory has. A held write protected only the frame of the guard it was held
+    /// under; that guard's copies are gone once it is lifted, and later frames must see the
+    /// write. So it is applied at the first gather after its guard is lifted, unless the guard up
+    /// now has a copy of its page too: then the page was written after this guard's present,
+    /// memory holds a later frame's bytes there, and the write is held for this guard as well
+    /// (as the old rule would). `act` false (EDEN_UP_AHEAD_GUARD_HELD_AGE_VERIFY=1): the same
+    /// split is made and counted, nothing is applied.
+    void ReleaseLiftedHeldLocked(std::function<void(PAddr, size_t)>& callback_writes,
+                                 size_t new_kept, bool act) {
+        const VideoCommon::AheadGuard::Now now = VideoCommon::AheadGuard::GuardNow();
+        HeldAgeStats& st = held_age_stats;
+        ++st.gathers;
+        // The writes this gather kept get the guard up now: read after the gather, it is no older
+        // than the guard they were kept for, so they are held at least as long as before. When
+        // the tags are not one per held write (the switches were off at a gather that kept
+        // writes), every held write gets the guard up now, for the same reason.
+        const HeldTag fresh{now.serial, now.frame, false, false};
+        if (ahead_held_tags.size() + new_kept != ahead_held_writes.size()) {
+            ahead_held_tags.assign(ahead_held_writes.size(), fresh);
+            ++st.resyncs;
+        } else {
+            ahead_held_tags.resize(ahead_held_writes.size(), fresh);
+        }
+        size_t keep_at = 0;
+        for (size_t i = 0; i < ahead_held_writes.size(); ++i) {
+            const std::pair<DAddr, u64> write = ahead_held_writes[i];
+            HeldTag tag = ahead_held_tags[i];
+            const u64 age = now.frame >= tag.frame ? now.frame - tag.frame : 0;
+            const bool lifted = !now.active || tag.serial < now.serial;
+            if (lifted && VideoCommon::AheadGuard::HasCopy(write.first, write.second)) {
+                // Written again since the present of the guard up now: held for it too.
+                tag.serial = now.serial;
+                tag.reheld = true;
+                ++st.retagged;
+            } else if (lifted) {
+                if (!tag.late) {
+                    tag.late = true;
+                    ++st.early;
+                    st.early_bytes += write.second;
+                    st.max_age_applied = (std::max)(st.max_age_applied, age);
+                }
+                if (act) {
+                    // Counted at each apply, so writes marked late under _VERIFY before the
+                    // switch came on are counted too.
+                    ++st.applied;
+                    st.applied_bytes += write.second;
+                    callback_writes(write.first, static_cast<size_t>(write.second));
+                    continue;
+                }
+            }
+            ahead_held_writes[keep_at] = write;
+            ahead_held_tags[keep_at] = tag;
+            ++keep_at;
+            // Ages from the guard a write was first held under. A write kept for a newer guard's
+            // copy (its page is written every frame) keeps aging by design: counted apart, so
+            // the age of the writes this switch is meant to free stays readable.
+            if (tag.reheld) {
+                st.max_age_reheld = (std::max)(st.max_age_reheld, age);
+            } else {
+                st.max_age_held = (std::max)(st.max_age_held, age);
+            }
+        }
+        ahead_held_writes.erase(ahead_held_writes.begin() + static_cast<std::ptrdiff_t>(keep_at),
+                                ahead_held_writes.end());
+        ahead_held_tags.erase(ahead_held_tags.begin() + static_cast<std::ptrdiff_t>(keep_at),
+                              ahead_held_tags.end());
+        st.max_held = (std::max)(st.max_held, static_cast<u64>(ahead_held_writes.size()));
+        // What uploads took from the copies of lifted guards: applied now as well, except where
+        // the guard up now has a copy (held for it, with the guard up now as tag). Not claimed:
+        // they are upload ranges, the guest's bytes, as the old rule applies them.
+        if (act) {
+            VideoCommon::AheadGuard::TakeRedirty([&](u64 address, size_t bytes) {
+                if (VideoCommon::AheadGuard::HasCopy(address, bytes)) {
+                    ahead_held_writes.emplace_back(address, static_cast<u64>(bytes));
+                    ahead_held_tags.push_back(fresh);
+                    ++st.redirty_held;
+                } else {
+                    callback_writes(address, bytes);
+                    ++st.redirty_early;
+                }
+            });
+        } else if (VideoCommon::AheadGuard::Get().redirty_ready.load(std::memory_order_acquire)) {
+            ++st.redirty_waiting;
+        }
+        LogHeldAgeLocked(act);
+    }
+
+    /// EDEN_UP_AHEAD_GUARD_HELD_AGE(_VERIFY): one line every 10 s while either is on, under
+    /// ahead_gather_mutex.
+    void LogHeldAgeLocked(bool act) {
+        HeldAgeStats& st = held_age_stats;
+        const auto at = std::chrono::steady_clock::now();
+        if (st.window_start == std::chrono::steady_clock::time_point{}) {
+            st.window_start = at;
+            return;
+        }
+        if (at - st.window_start < std::chrono::seconds{10}) {
+            return;
+        }
+        LOG_INFO(HW_GPU,
+                 "EDEN_UP_AHEAD_GUARD_HELD_AGE{}: last 10 s: {} gathers with a guard up; held "
+                 "writes now {} (most {}), oldest still held {} presents ({} for writes kept for "
+                 "a newer guard's copy); {} {} with their guard lifted and a newer one up ({} "
+                 "KiB, oldest {} presents); {} kept for the newer guard's copy; {} applied at "
+                 "gathers with no guard up; upload ranges from copies: {} applied early, {} held "
+                 "for a copy, {} gathers found them waiting; tags reset {}",
+                 act ? "" : "_VERIFY", st.gathers, ahead_held_writes.size(), st.max_held,
+                 st.max_age_held, st.max_age_reheld, act ? st.applied : st.early,
+                 act ? "applied" : "would be applied",
+                 (act ? st.applied_bytes : st.early_bytes) >> 10, st.max_age_applied,
+                 st.retagged, st.unguarded_applied, st.redirty_early, st.redirty_held,
+                 st.redirty_waiting, st.resyncs);
+        st = HeldAgeStats{};
+        st.window_start = at;
     }
 
     /// EDEN_UP_AHEAD_GUARD=3, from nx2:vi2 PresentClientBuffer on its own thread, just before a
@@ -865,6 +1009,22 @@ struct GPU::Impl {
     std::vector<std::pair<DAddr, u64>> ahead_gathered_writes;
     std::vector<std::pair<DAddr, u64>> ahead_held_writes;
     std::mutex ahead_gather_mutex;
+    /// EDEN_UP_AHEAD_GUARD_HELD_AGE(_VERIFY), under ahead_gather_mutex (the gathering thread:
+    /// GPUBack, GPUFencingThread or a sync operation's): one tag per held write, in its order,
+    /// while either switch is on (cleared with the held writes at a gather with no guard up).
+    struct HeldTag {
+        u64 serial; ///< the guard it is held for (AheadGuard::State::arm_serial)
+        u64 frame;  ///< the present that guard was put up at, for its age
+        bool late;  ///< counted once as held past its guard
+        bool reheld; ///< kept for a newer guard's copy at least once
+    };
+    std::vector<HeldTag> ahead_held_tags;
+    struct HeldAgeStats {
+        u64 gathers{}, early{}, early_bytes{}, applied{}, applied_bytes{}, retagged{};
+        u64 unguarded_applied{}, redirty_early{}, redirty_held{}, redirty_waiting{}, resyncs{};
+        u64 max_held{}, max_age_held{}, max_age_reheld{}, max_age_applied{};
+        std::chrono::steady_clock::time_point window_start{};
+    } held_age_stats;
 
     const bool is_async;
 
