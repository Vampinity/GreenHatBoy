+            const char* guard = std::getenv("EDEN_UP_AHEAD_GUARD");
+            if (guard == nullptr || std::strcmp(guard, "3") != 0) {
+                Quiet([&] {
+                    LOG_WARNING(Common,
+                                "Live switches: {} needs EDEN_UP_AHEAD_GUARD=3 at boot: its "
