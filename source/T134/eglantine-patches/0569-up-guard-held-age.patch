     AheadReadSync,
+    /// EDEN_UP_AHEAD_GUARD_HELD_AGE (with EDEN_UP_AHEAD_GUARD=3 at boot). Each gather while a
+    /// guard is up applies the held writes of guards already lifted, or keeps them all as
+    /// before. Writes held while it was off have no tag of their own: when it comes on they get
+    /// the guard up then, which holds them at least as long as before (video_core/gpu.cpp,
+    /// GatherForApply).
+    AheadGuardHeldAge,
+    /// EDEN_UP_AHEAD_GUARD_HELD_AGE_VERIFY. Log only: counts what the switch above would apply
+    /// early at each gather, and applies as before.
+    AheadGuardHeldAgeVerify,
     Count,
 };
 
@@ -319,6 +328,8 @@ inline constexpr std::array<Def, NumSwitches> kDefs{{
     {"EDEN_UP_UBO_BIND_TRIM", ParseExactOne, false, -1},
     {"EDEN_UP_WRITEBACK_BANDS", ParseExactOne, true, -1},
     {"EDEN_UP_AHEAD_READ_SYNC", ParseExactOne, false, -1},
+    {"EDEN_UP_AHEAD_GUARD_HELD_AGE", ParseExactOne, false, -1},
+    {"EDEN_UP_AHEAD_GUARD_HELD_AGE_VERIFY", ParseExactOne, false, -1},
 }};
 
 static_assert(kDefs[static_cast<size_t>(Id::PollBackoffUs)].needs ==
@@ -628,6 +639,20 @@ inline void WarnOfDeadSwitches(const Schedule& schedule) {
                             "this run");
             });
         }
+        if (static_cast<Id>(i) == Id::AheadGuardHeldAge ||
+            static_cast<Id>(i) == Id::AheadGuardHeldAgeVerify) {
+            // Not a live switch, so not a `needs` index: the guard's level is read once
