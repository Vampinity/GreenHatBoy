     }
 }
 
diff --git a/src/video_core/ahead_guard.h b/src/video_core/ahead_guard.h
index fd404d9..35745fd 100644
--- a/src/video_core/ahead_guard.h
+++ b/src/video_core/ahead_guard.h
@@ -55,6 +55,9 @@
 ///      uploaded into the host buffer at once (BufferCache's inline page writes), and a texture
 ///      the write touches is uploaded again from memory. One or two small dark glitches and a
 ///      fade out of order stayed, and nine moments with EDEN_UP_AHEAD_ALWAYS.
+///      EDEN_UP_AHEAD_GUARD_HELD_AGE=1 (live): a held write is applied at the first gather after
+///      its own guard is lifted, even with a newer guard up, unless the newer guard has a copy
+///      of its page too (see GPU::GatherForApply).
 ///
 ///   EDEN_UP_AHEAD_GUARD_SETS=<mask>   which finished frames' pages are guarded, bit d = the frame
 ///                                     d presents back (default 14: one, two and three back;
@@ -619,6 +622,22 @@ inline bool HoldWrites() {
     return Mode() == 3 && Get().active.load(std::memory_order_acquire);
 }
 
+/// EDEN_UP_AHEAD_GUARD_HELD_AGE (GPU::GatherForApply): the guard as it is now. `serial` counts
+/// the guards put up so far and `frame` is the present the newest one was put up at. A guard is
+/// put up only while none is (AtPresent), so with `active` every guard of a lower serial is
+/// lifted, and without it every guard is. Takes the guard's lock: for a gather, not a draw.
+struct Now {
+    bool active{};
+    u64 serial{};
+    u64 frame{};
+};
+
+[[nodiscard]] inline Now GuardNow() {
+    State& s = Get();
+    std::scoped_lock lk{s.mutex};
+    return Now{s.active.load(std::memory_order_relaxed), s.arm_serial, s.armed_frame};
+}
+
 /// Whether a page of [device_addr, device_addr + size) has a copy now: a guest thread wrote it
 /// after the present of the frame in flight. Lock-free.
 inline bool HasCopy(u64 device_addr, u64 size) {
diff --git a/src/video_core/gpu.cpp b/src/video_core/gpu.cpp
index 4f8a4a4..a9f180a 100644
--- a/src/video_core/gpu.cpp
+++ b/src/video_core/gpu.cpp
@@ -20,6 +20,7 @@
 
 #include "common/assert.h"
 #include "common/live_switch.h"
+#include "common/live_switch.h"
 #include "common/pe_switch.h"
 #include "common/scope_exit.h"
 #include "common/settings.h"
@@ -103,7 +104,14 @@ struct GPU::Impl {
         , use_nvdec{use_nvdec_}
