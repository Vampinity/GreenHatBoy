         , is_async{is_async_}
-    {}
+    {
+        // EDEN_UP_AHEAD_GUARD_HELD_AGE: the first use of its live switches, so GatherForApply
+        // can Peek them.
+        static_cast<void>(
+            Common::LiveSwitch::Value<Common::LiveSwitch::Id::AheadGuardHeldAge>());
+        static_cast<void>(
+            Common::LiveSwitch::Value<Common::LiveSwitch::Id::AheadGuardHeldAgeVerify>());
+    }
 
     ~Impl() = default;
 
@@ -210,10 +218,17 @@ struct GPU::Impl {
         }
         ahead_gathered_writes.clear();
         if (!VideoCommon::AheadGuard::HoldWrites()) {
+            if (!ahead_held_writes.empty() &&
+                (Common::LiveSwitch::Peek<Common::LiveSwitch::Id::AheadGuardHeldAge>() != 0 ||
+                 Common::LiveSwitch::Peek<Common::LiveSwitch::Id::AheadGuardHeldAgeVerify>() !=
+                     0)) [[unlikely]] {
