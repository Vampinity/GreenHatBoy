+            cmdbuf.PipelineBarrier(VK_PIPELINE_STAGE_TRANSFER_BIT, post_copy_stages, 0,
                                    WRITE_BARRIER);
         }
     });
@@ -722,8 +724,8 @@
         .dstAccessMask = VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT,
