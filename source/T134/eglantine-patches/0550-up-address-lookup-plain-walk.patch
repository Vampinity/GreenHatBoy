+
+// The page-table walk of GpuToCpuAddress, a function of its own since T121 so that the lookup
+// without EDEN_UP_GPU_PAGE_CACHE is again what it was before 0541: nothing but the walk, no stack
+// frame for the cache's cold paths (its first-use allocation and per-thread pointer).
+[[gnu::always_inline]] inline std::optional<DAddr> MemoryManager::WalkGpuToCpuAddress(
+    GPUVAddr gpu_addr) const {
+    DAddr dev_addr;
+    if (GetEntry(gpu_addr, true) != EntryType::Mapped) [[unlikely]] {
+        if (GetEntry(gpu_addr, false) != EntryType::Mapped)
+            return std::nullopt;
+        dev_addr = (DAddr(page_table[PageEntryIndex(gpu_addr, false)]) << cpu_page_bits) +
+                   (gpu_addr & page_mask);
+    } else {
+        dev_addr = (DAddr(big_page_table_dev[PageEntryIndex(gpu_addr, true)]) << cpu_page_bits) +
+                   (gpu_addr & big_page_mask);
+    }
+    // Djihads80/Eglantine c6d2acd37: an entry past the device address space would index past the
+    // device memory manager's tables (every caller treats nullopt as unmapped).
+    if ((dev_addr >> MaxwellDeviceMemoryManager::AS_BITS) != 0) [[unlikely]] {
+        static std::atomic<u32> reported{};
+        if (reported.fetch_add(1, std::memory_order_relaxed) < 16) {
+            LOG_ERROR(HW_GPU, "GPU address {:#x} maps outside the device space, to {:#x}",
+                      gpu_addr, dev_addr);
+        }
+        return std::nullopt;
+    }
+    return dev_addr;
 }
 
 std::optional<DAddr> MemoryManager::GpuToCpuAddress(GPUVAddr gpu_addr) const {
     if (!IsWithinGPUAddressRange(gpu_addr)) [[unlikely]] {
         return std::nullopt;
     }
+    // A live switch since T119 (common/live_switch.h): read at each lookup, one plain load. Peek,
+    // not Value: Value's first-use check would bring a guard and a call into this function, and
+    // with them the stack frame this split removes. The constructor made the first use.
+    if (Common::LiveSwitch::Peek<Common::LiveSwitch::Id::GpuPageCache>() != 0) [[unlikely]] {
+        // A jump, not a call: with a call here the compiler kept a frame for the whole function.
+#if defined(__clang__)
+        [[clang::musttail]]
+#endif
+        return GpuToCpuAddressCached(gpu_addr);
+    }
+    return WalkGpuToCpuAddress(gpu_addr);
+}
