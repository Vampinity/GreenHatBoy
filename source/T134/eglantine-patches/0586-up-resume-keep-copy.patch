 }
+
+// EDEN_UP_RESUME_KEEP_COPY (first-start crash, 12 Nov 2026, run1233): Ocarina of Time on Switch
+// 2 only. A refresh copies queued command lists again from memory: at a resume after a semaphore
+// wait (Step, judged) and when a list whose channel waited since its submit is handed to the
+// pusher (Push, "hand-over", not judged: memory as T63). On a first start the GPU thread stalls
+// ~25 s, the present wait gives up after 4 s three times, the game runs ahead and records later
+// frames into the same ring, and the hand-over refresh took those words for this frame's: 221
+// entries parsed later-frame words, junk, a draw with shape type 3734, SIGSEGV. In Ocarina the
+// words as submitted never change before the parse (0 of 7,675,038 with the full wait), and 485
+// runs one frame ahead with EDEN_GBB_TRUST_COPY=1 + EDEN_NX2_RESNAPSHOT=0 (submit copy always)
+// logged no junk. So at both refreshes an entry whose memory differs from its copy keeps the
+// copy when:
+// - its pages carry no GPU-written mark (GPU-written entries read the GPU's words, as before),
+// - it is not deferred (its slot holds no words yet) and the copy was written (not zeros where
+//   memory holds commands: submitted before written, upstream 256b1dc346),
+// - the copy walks clean from the stream's carry there (no word in a mode the parser drops);
+//   at the hand-over the carry restarts at 0 at the list's first entry (lists end on a method
+//   boundary, see Step), at a resume it is the stream's own,
+// - =3 only: the list was copied before the suspension, not during it.
+// Data-only differences keep the copy too: in run404 (DESYNC_FIX=1) the fix kept reshaped entries
+// but took 4 data-only ones from memory, a later frame's semaphore values (0xf04 against 0xede),
+// and channels 1, 2, 3 and 5 waited forever. A resumed entry then parses its (refreshed) copy
+// from its resume word instead of memory at the parse.
+// =1: the same judgement, counted and logged, memory taken (as off). =2 acts. =3 acts, except for
+// lists copied during a suspension (those take memory, as T63). 0, unset or anything else: off,
+// nothing read or counted. Read once. Default flip for the alpha: ResumeKeepCopyDefault.
+constexpr int ResumeKeepCopyDefault = 0; // the alpha: 2 (unset then means 2; "0" stays off)
+
+int ResumeKeepCopyMode() {
+    static const int mode = [] {
+        const char* value = std::getenv("EDEN_UP_RESUME_KEEP_COPY");
+        if (value == nullptr) {
+            return ResumeKeepCopyDefault;
+        }
+        return value[0] >= '1' && value[0] <= '3' && value[1] == '\0' ? value[0] - '0' : 0;
+    }();
+    return mode;
+}
+
+// Why a differing entry kept its copy or took memory (EDEN_UP_RESUME_KEEP_COPY).
+enum class KeepCopyCase : u32 {
+    Kept,          // copy kept (=2/3), or would be (=1)
+    GpuWritten,    // memory: GPU-written pages (parsed from the GPU's words)
+    Deferred,      // memory: deferred entry (no words in its slot)
+    Unwritten,     // memory: copy never written (zeros where memory has commands)
+    CopyBroken,    // memory: the copy drops words
+    CarryUnknown,  // memory: the walk can't know where methods start
+    DuringSuspend, // memory: =3 and the list was copied during a suspension
+    Count,
+};
+
+struct KeepCopyStats {
+    std::array<std::atomic<u64>, static_cast<size_t>(KeepCopyCase::Count)> cases{};
+    std::atomic<u64> refreshes_handover{};
+    std::atomic<u64> refreshes_resume{};
+    std::atomic<u64> differing{};
+    std::atomic<u64> kept_data_only{};
+    std::atomic<u64> kept_at_resume{};
+    std::atomic<u64> kept_by_desync_fix{};
+    std::atomic<u64> resumed_from_copy{};
+    std::atomic<u64> kept_total{};
+    std::atomic<u64> memory_total{};
+    std::atomic<u64> actions{};
+    std::atomic<u64> window_start{};
+};
+KeepCopyStats g_keep_copy;
+
+// One refresh's tally, for its action line.
+struct KeepCopyTally {
+    u32 differing = 0;
+    u32 kept = 0;
+    u32 memory = 0;
+    u64 first_address = 0;
+    u32 first_size = 0;
+    u32 first_words = 0;
+    u32 first_header_diffs = 0;
+};
+
+void NoteKeepCopy(KeepCopyCase why, bool data_only, bool at_resume, KeepCopyTally& tally,
+                  u64 address, size_t size, size_t start, std::span<const CommandHeader> copy,
+                  std::span<const CommandHeader> memory, const ShapeWalk& copy_walk,
+                  const ShapeWalk& memory_walk) {
+    g_keep_copy.cases[static_cast<size_t>(why)].fetch_add(1, std::memory_order_relaxed);
+    g_keep_copy.differing.fetch_add(1, std::memory_order_relaxed);
+    ++tally.differing;
+    if (why != KeepCopyCase::Kept) {
+        ++tally.memory;
+        g_keep_copy.memory_total.fetch_add(1, std::memory_order_relaxed);
+        return;
+    }
+    g_keep_copy.kept_total.fetch_add(1, std::memory_order_relaxed);
+    g_keep_copy.kept_data_only.fetch_add(data_only ? 1 : 0, std::memory_order_relaxed);
+    g_keep_copy.kept_at_resume.fetch_add(at_resume ? 1 : 0, std::memory_order_relaxed);
+    if (tally.kept++ == 0) {
+        tally.first_address = address;
+        tally.first_size = static_cast<u32>(size);
+        u32 differing = 0;
+        for (size_t w = start; w < size; ++w) {
+            differing += copy[w].argument != memory[w].argument ? 1 : 0;
+        }
+        tally.first_words = differing;
+        tally.first_header_diffs = (std::max)(copy_walk.header_diffs, memory_walk.header_diffs);
+    }
+}
+
+// One line per refresh that kept (or, =1, would keep) a copy: the first 256, then every 1024th.
+void ReportKeepCopyAction(int mode, bool at_resume, bool suspended_copy, size_t entries,
+                          const KeepCopyTally& tally) {
+    if (tally.kept == 0) {
+        return;
+    }
+    const u64 action = g_keep_copy.actions.fetch_add(1, std::memory_order_relaxed) + 1;
+    if (action > 256 && (action & 0x3ff) != 0) {
+        return;
+    }
+    LOG_WARNING(HW_GPU,
+                "EDEN_UP_RESUME_KEEP_COPY={} action {}: {} the submit copy of {} of {} differing "
+                "entries of a {}-entry list at {} (list copied {} the suspension), first at "
+                "{:#x}+{:#x}: {} words differ, {} header words differ; took memory for {}",
+                mode, action, mode == 1 ? "would keep (count only, took memory)" : "kept",
+                tally.kept, tally.differing, entries, at_resume ? "a resume" : "the hand-over",
+                suspended_copy ? "during" : "before", tally.first_address, tally.first_size,
+                tally.first_words, tally.first_header_diffs, tally.memory);
+}
+
+// Every 10 s, from the refresh that ends a window (nothing while no refresh runs).
+void ReportKeepCopyWindow(int mode) {
+    const u64 now = static_cast<u64>(Common::g_wall_clock.GetTimeNS().count());
+    u64 start = g_keep_copy.window_start.load(std::memory_order_relaxed);
+    if (start == 0) {
+        g_keep_copy.window_start.compare_exchange_strong(start, now, std::memory_order_relaxed);
+        return;
+    }
+    if (now - start < 10'000'000'000ULL ||
+        !g_keep_copy.window_start.compare_exchange_strong(start, now, std::memory_order_relaxed)) {
+        return;
+    }
+    const auto take = [](std::atomic<u64>& counter) {
+        return counter.exchange(0, std::memory_order_relaxed);
+    };
+    std::array<u64, static_cast<size_t>(KeepCopyCase::Count)> cases{};
+    for (size_t i = 0; i < cases.size(); ++i) {
+        cases[i] = take(g_keep_copy.cases[i]);
+    }
+    const auto at = [&cases](KeepCopyCase why) { return cases[static_cast<size_t>(why)]; };
+    const u64 handover = take(g_keep_copy.refreshes_handover);
+    const u64 resume = take(g_keep_copy.refreshes_resume);
+    const u64 differing = take(g_keep_copy.differing);
+    const u64 data_only = take(g_keep_copy.kept_data_only);
+    const u64 kept_at_resume = take(g_keep_copy.kept_at_resume);
+    const u64 desync_fix = take(g_keep_copy.kept_by_desync_fix);
+    const u64 resumed = take(g_keep_copy.resumed_from_copy);
+    const u64 kept = at(KeepCopyCase::Kept);
+    u64 memory = 0;
+    for (size_t i = 1; i < cases.size(); ++i) {
+        memory += cases[i];
+    }
+    LOG_WARNING(HW_GPU,
+                "EDEN_UP_RESUME_KEEP_COPY={} 10 s: {} list refreshes ({} at the hand-over, {} at a "
+                "resume), {} entries differed from their submit copy: {} {} ({} data words only, "
+                "{} other header words; {} at a resume), {} took memory ({} GPU-written, {} "
+                "deferred, {} never written, {} copy does not walk clean, {} carry unknown, {} "
+                "copied during a suspension), {} kept by EDEN_NX2_DESYNC_FIX; resumed entries {} "
+                "{}; since boot {} {}, {} took memory",
+                mode, handover + resume, handover, resume, differing,
+                mode == 1 ? "would keep the copy (count only)" : "kept the copy", kept, data_only,
+                kept - data_only, kept_at_resume, memory,
+                at(KeepCopyCase::GpuWritten), at(KeepCopyCase::Deferred),
+                at(KeepCopyCase::Unwritten), at(KeepCopyCase::CopyBroken),
+                at(KeepCopyCase::CarryUnknown), at(KeepCopyCase::DuringSuspend), desync_fix,
+                mode == 1 ? "that would parse the copy" : "parsed from the copy", resumed,
+                mode == 1 ? "would keep" : "kept", g_keep_copy.kept_total.load(std::memory_order_relaxed),
+                g_keep_copy.memory_total.load(std::memory_order_relaxed));
+}
+
+// The walk matches the parser only with the junk guard, split-method parking and the split parse
+// check off (as EDEN_NX2_DESYNC_FIX): with any of them set the switch stays off (logged once).
+bool KeepCopyParserClash(int split_check_mode) {
+    static const bool clash = [split_check_mode] {
+        const char* guard = std::getenv("EDEN_NX2_JUNK_GUARD");
+        const bool clash_now = (guard != nullptr && guard[0] == '1') ||
+                               std::getenv("EDEN_NX2_PARK_SPLIT_METHODS") != nullptr ||
+                               split_check_mode != 0;
+        if (clash_now) {
+            LOG_WARNING(HW_GPU, "EDEN_UP_RESUME_KEEP_COPY={} stays off: JUNK_GUARD, "
+                                "PARK_SPLIT_METHODS or SPLIT_PARSE_CHECK is set, and its walk "
+                                "doesn't model them",
+                        ResumeKeepCopyMode());
+        }
+        return clash_now;
+    }();
+    return clash;
+}
 } // Anonymous namespace
 
+int DmaPusher::ResumeKeepCopyActing() const {
+    const int mode = ResumeKeepCopyMode();
+    if (mode == 0 || !ResnapshotEnabled() || KeepCopyParserClash(SplitCheckMode())) {
+        return 0;
+    }
+    if (keep_copy_title < 0) {
+        // Known once the application has its program id (the gate as EDEN_NX2_DESYNC_FIX).
+        constexpr u64 OcarinaOfTimeProgramId = 0x0400486024DEC000ULL;
+        const u64 program = system.GetApplicationProcessProgramID();
+        if (program == 0) {
+            return 0;
+        }
+        keep_copy_title = Tegra::g_nx2_ampere.load(std::memory_order_relaxed) &&
+                                  program == OcarinaOfTimeProgramId
+                              ? 1
+                              : 0;
+        static std::atomic<bool> reported{};
+        if (!reported.exchange(true)) {
+            LOG_WARNING(HW_GPU, "EDEN_UP_RESUME_KEEP_COPY={} {} (program {:#018x})", mode,
+                        keep_copy_title != 0 ? "active: Ocarina of Time on Switch 2"
+                                             : "stays off: not Ocarina of Time on Switch 2",
+                        program);
+        }
+    }
+    return keep_copy_title != 0 ? mode : 0;
+}
+
 // EDEN_NX2_DESYNC_FIX=1 (exact "1"): see DmaPusher::RefreshSnapshot. =2: the same, except lists
 // copied during a suspension take memory as T63 (judged for the log only). Read once.
 int DmaPusher::DesyncFixMode() {
@@ -431,6 +651,28 @@ DmaPusher::DmaPusher(Core::System& system_, MemoryManager& memory_manager_, Cont
                     DesyncFixMode(), DesyncFixMode() == 1 ? "judged" : "as T63");
         DesyncFixParserClash(SplitCheckMode());
     }
+    // EDEN_UP_RESUME_KEEP_COPY: proves the switch was read; the title gate is logged at the first
+    // refresh ("active" or "stays off").
+    if (static std::atomic<bool> reported{}; ResumeKeepCopyMode() != 0 && !reported.exchange(true)) {
+        if (!ResnapshotEnabled()) {
+            LOG_WARNING(HW_GPU, "EDEN_UP_RESUME_KEEP_COPY={} idle: EDEN_NX2_RESNAPSHOT=0, no "
+                                "refresh runs, so there is nothing to keep (the submit copy is "
+                                "then parsed only with EDEN_GBB_TRUST_COPY=1)",
+                        ResumeKeepCopyMode());
+        } else {
+            LOG_WARNING(HW_GPU, "EDEN_UP_RESUME_KEEP_COPY={} on: {} a command entry's submit copy "
+                                "at a refresh (hand-over and resume) when memory differs and the "
+                                "copy walks clean; GPU-written, deferred and never-written "
+                                "entries read as before{}; Ocarina of Time on Switch 2 only",
+                        ResumeKeepCopyMode(),
+                        ResumeKeepCopyMode() == 1 ? "counts (memory taken) where it would keep"
+                                                  : "keeps",
+                        ResumeKeepCopyMode() == 3
+                            ? "; lists copied during a suspension take memory as before"
+                            : "");
+            KeepCopyParserClash(SplitCheckMode());
+        }
+    }
 }
 
 DmaPusher::~DmaPusher() = default;
@@ -692,8 +934,15 @@ bool DmaPusher::Step() {
