+    // EDEN_UP_STALE_BACKING_FIX (zortos293/Lichii #1199): memory [cpu_address, +size) is
+    // destroyed (sub 102), so every GPU range that still reaches it stops reaching it, wherever it
+    // was mapped; the game reuses the memory as ordinary heap right after. With `apply` false
+    // nothing changes (the check mode only counts). Returns the ranges other than the one at the
+    // memory's own address, as (GPU address, size).
+    std::vector<std::pair<u64, u64>> UnmapMemory(u64 cpu_address, u64 size, bool apply) {
+        std::scoped_lock lk{mutex};
+        const u64 end = cpu_address + size;
+        struct Range {
+            u64 gpu_address;
+            u64 size;
+            bool own; ///< The mapping at the memory's own address
+        };
+        std::vector<Range> ranges;
+        for (const auto& m : mappings) {
+            const u64 first = (std::max)(m.cpu_address, cpu_address);
+            const u64 last = (std::min)(m.cpu_address + m.size, end);
+            if (first < last) {
+                ranges.push_back({m.gpu_address + (first - m.cpu_address), last - first,
+                                  m.gpu_address == m.cpu_address});
+            }
+        }
+        std::vector<std::pair<u64, u64>> leftovers;
+        for (const auto& range : ranges) {
