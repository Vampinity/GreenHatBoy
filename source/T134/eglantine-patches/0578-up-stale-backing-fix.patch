+inline bool Nx2StaleBackingFix() {
+    static const bool on = [] {
+        const char* value = std::getenv("EDEN_UP_STALE_BACKING_FIX");
+        return value != nullptr && value[0] == '1' && value[1] == '\0';
+    }();
+    return on;
+}
+
+// EDEN_UP_STALE_BACKING_FIX_VERIFY=1: count only (with the fix off), or check after each 102
+// (with it on).
+inline bool Nx2StaleBackingVerify() {
+    static const bool on = [] {
+        const char* value = std::getenv("EDEN_UP_STALE_BACKING_FIX_VERIFY");
+        return value != nullptr && value[0] == '1' && value[1] == '\0';
+    }();
+    return on;
+}
+
+// EDEN_UP_STALE_BACKING_FIX(_VERIFY): heap-mapper releases queued for the GPU thread and not run
+// yet. The heap mapper counts how often each page is mapped; a release drops its count only when
+// the GPU thread gets to it. A new map of the same pages on the service thread before that finds
+// them still mapped, maps nothing, and the late release then leaves the old pages in place. With
+// the fix a map that overlaps a queued release is itself queued behind it (nvhost_as_gpu.cpp).
+// Only used while one of the two switches is on. One list for every process and address space:
+// fine for one game at a time.
+class Nx2PendingHeapReleases {
+public:
+    static Nx2PendingHeapReleases& Get() {
+        static Nx2PendingHeapReleases pending;
+        return pending;
+    }
+
+    void Add(u64 cpu_address, u64 size) {
+        std::scoped_lock lk{mutex};
+        ranges.emplace_back(cpu_address, size);
+        queued.fetch_add(1, std::memory_order_relaxed);
+    }
+
+    // On the GPU thread, after the release ran.
+    void Done(u64 cpu_address, u64 size) {
+        std::scoped_lock lk{mutex};
+        if (const auto it = std::ranges::find(ranges, std::pair{cpu_address, size});
+            it != ranges.end()) {
+            ranges.erase(it);
+        }
+    }
+
+    bool Overlaps(u64 cpu_address, u64 size) {
+        std::scoped_lock lk{mutex};
+        return std::ranges::any_of(ranges, [&](const auto& range) {
+            return range.first < cpu_address + size && cpu_address < range.first + range.second;
+        });
+    }
+
+    std::atomic<u64> queued{};        ///< Heap releases queued in all
+    std::atomic<u64> racing_maps{};   ///< Heap maps that overlapped a queued release
+    std::atomic<u64> stale_pages{};   ///< _VERIFY: heap pages whose device page was not the CPU page
+
+private:
+    std::mutex mutex;
+    std::vector<std::pair<u64, u64>> ranges;
+};
+
+// EDEN_UP_STALE_BACKING_FIX(_VERIFY): totals since start for the counter line. Atomics, so the
+// 102 path (nx2_gsv.h, under its region lock) and the map path (nvhost_as_gpu.cpp, under the
+// address space lock) can both add to them and print the line.
+struct Nx2StaleBackingStats {
+    static Nx2StaleBackingStats& Get() {
+        static Nx2StaleBackingStats stats;
+        return stats;
+    }
+    std::atomic<u64> destroys{};        ///< 102s seen
+    std::atomic<u64> leftovers{};       ///< GPU ranges besides the memory's own (check: would be)
+    std::atomic<u64> tiles{};           ///< GPU-only tiles of destroyed memory (check: would drop)
+    std::atomic<u64> released{};        ///< Fix: device ranges a 102 released, counted in the
+                                        ///< release itself, one per address space that freed it
+    std::atomic<u64> would_release{};   ///< Check: destroyed memories with a device range
+                                        ///< recorded at their own address
+    std::atomic<u64> verify_failures{}; ///< Fix + _VERIFY: GPU ranges still reaching it after 102
+    std::atomic<std::chrono::steady_clock::rep> last_line{};
+};
+
+// Set by the 102 path (nx2_gsv.h) around its ReleaseBacking call, so Nx2Release counts the device
+// ranges it really frees for a 102 (and not those 215, the re-register or decoder images free).
+inline thread_local bool g_nx2_stale_backing_release = false;
+
+// The EDEN_UP_STALE_BACKING_FIX(_VERIFY) counter line: with `first` (the first 102) at once,
+// otherwise at most every 10 s, from a 102 or from a map, whichever comes. Totals since start.
+inline void Nx2LogStaleBackingCounters(bool first) {
+    using Clock = std::chrono::steady_clock;
+    auto& stats = Nx2StaleBackingStats::Get();
+    const Clock::rep now = Clock::now().time_since_epoch().count();
+    Clock::rep last = stats.last_line.load(std::memory_order_relaxed);
+    constexpr Clock::rep every =
+        std::chrono::duration_cast<Clock::duration>(std::chrono::seconds{10}).count();
+    if ((!first && last != Clock::rep{} && now - last < every) ||
+        !stats.last_line.compare_exchange_strong(last, now, std::memory_order_relaxed)) {
+        return; // too soon, or another thread prints this one
+    }
+    const bool apply = Nx2StaleBackingFix();
+    auto& heap = Nx2PendingHeapReleases::Get();
+    LOG_INFO(Service,
+             "EDEN_UP_STALE_BACKING_FIX {} counts: {} destroys (102); {} other GPU ranges {}; "
+             "{} GPU-only tiles {}; {} own device ranges {}; heap mapper: {} releases queued, "
+             "{} maps overlapped a queued release ({}), {} pages stale at map (_VERIFY); {} "
+             "verify failures",
+             apply ? "fix" : "check", stats.destroys.load(std::memory_order_relaxed),
+             stats.leftovers.load(std::memory_order_relaxed), apply ? "unmapped" : "would unmap",
+             stats.tiles.load(std::memory_order_relaxed), apply ? "dropped" : "would drop",
+             apply ? stats.released.load(std::memory_order_relaxed)
+                   : stats.would_release.load(std::memory_order_relaxed),
+             apply ? "released" : "would release", heap.queued.load(std::memory_order_relaxed),
+             heap.racing_maps.load(std::memory_order_relaxed),
+             apply ? "queued behind it" : "may keep old pages",
+             heap.stale_pages.load(std::memory_order_relaxed),
+             stats.verify_failures.load(std::memory_order_relaxed));
+}
