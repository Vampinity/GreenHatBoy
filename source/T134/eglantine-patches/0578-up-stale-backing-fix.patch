+    void DestroyMemoryEverywhere(u32 handle, u64 address, u64 size) {
+        const bool apply = StaleBackingFix();
+        auto& registry = Nvidia::Devices::Nx2GpuMemoryRegistry::Get();
+        auto& stats = Nvidia::Devices::Nx2StaleBackingStats::Get();
+        {
