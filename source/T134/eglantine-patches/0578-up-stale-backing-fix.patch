+                }
+            }
+            if (!range.own) {
+                leftovers.emplace_back(range.gpu_address, range.size);
+            }
+        }
+        return leftovers;
+    }
+
+    // Recorded GPU ranges that still reach CPU memory [cpu_address, +size) (check mode).
