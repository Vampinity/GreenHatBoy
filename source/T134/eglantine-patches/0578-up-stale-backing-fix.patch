+namespace {
+// EDEN_UP_STALE_BACKING_FIX_VERIFY: heap pages whose device page is not the CPU page behind the
+// address now (the 0039 comparison, count only, nothing mapped again).
+template <typename Smmu, typename Memory>
+u64 Nx2CountStalePages(Smmu& smmu, Memory& memory, u64 cpu_address, u64 size,
+                       DAddr device_address) {
+    constexpr u64 PageSize = Core::Memory::YUZU_PAGESIZE;
+    const u64 pages = Common::DivCeil(size + (cpu_address & (PageSize - 1)), PageSize);
+    const u64 cpu_base = Common::AlignDown(cpu_address, PageSize);
+    const DAddr device_base = Common::AlignDown(device_address, PageSize);
+    u64 stale = 0;
+    for (u64 page = 0; page < pages; ++page) {
+        if (memory.GetPointerSilent(Common::ProcessAddress{cpu_base + page * PageSize}) !=
+            smmu.template GetPointer<u8>(device_base + page * PageSize)) {
+            ++stale;
+        }
+    }
+    return stale;
+}
