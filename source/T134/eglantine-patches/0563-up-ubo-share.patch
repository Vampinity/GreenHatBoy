+/// EDEN_UP_UBO_SHARE: one line every 10 s while the switch is on, checked every 4096 tries.
+template <class Reuse>
+void LogUniformShare(Reuse& reuse) {
+    const u64 now = static_cast<u64>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                         std::chrono::steady_clock::now().time_since_epoch())
+                                         .count());
+    if (now < reuse.next_log_ns) {
+        return;
+    }
+    reuse.next_log_ns = now + 10'000'000'000ULL;
+    LOG_INFO(HW_GPU,
+             "EDEN_UP_UBO_SHARE: {} tries, {} shared ({} with its own copy current), {} bytes "
+             "differed, {} no newer donor, {} no single span; verify {} checked {} bad",
+             reuse.share_tries, reuse.share_hits, reuse.share_own_current,
+             reuse.share_misses_bytes, reuse.share_no_donor, reuse.share_no_span,
+             reuse.verify_checked, reuse.verify_bad);
+}
+
+/// EDEN_UP_UBO_SHARE_VERIFY: whether the donor's stream memory still holds its bytes and a plain
+/// guest read (ReadBlockUnsafe, as the old path reads) gives the same bytes as GetSpan did.
+template <class DeviceMemory, class Reuse>
+[[nodiscard]] bool UniformShareHolds(DeviceMemory& device_memory, Reuse& reuse,
+                                     const typename Reuse::Slot& donor, size_t stage, u32 index,
+                                     u64 device_addr, u32 size) {
+    ++reuse.verify_checked;
+    bool ring_holds = true;
+    if constexpr (requires { donor.ref.mapped; }) {
+        ring_holds = donor.ref.mapped != nullptr &&
+                     std::memcmp(donor.ref.mapped, donor.bytes.data(), size) == 0;
+    }
+    device_memory.ReadBlockUnsafe(device_addr, reuse.scratch.data(), size);
+    const bool guest_holds = std::memcmp(reuse.scratch.data(), donor.bytes.data(), size) == 0;
+    if (ring_holds && guest_holds) {
+        return true;
+    }
+    if (++reuse.verify_bad <= 32) {
+        LOG_WARNING(HW_GPU,
+                    "EDEN_UP_UBO_SHARE_VERIFY: stage {} cbuf {} at {:#x} size {:#x}: stream copy "
+                    "{}, guest read {}; bound the old way",
+                    stage, index, device_addr, size, ring_holds ? "same" : "CHANGED",
+                    guest_holds ? "same" : "DIFFERS");
     }
+    return false;
+}
+
+/// EDEN_UP_UBO_SHARE: binds the newest allocation another stage made of the same range for the
+/// same cbuf index on this tick, when it is newer than this slot's own and guest memory still
+/// holds exactly the bytes it was filled with (compared in place). Returns false with nothing
+/// bound and the slot untouched otherwise, and the caller binds the old way. On a share the slot
+/// keeps its bytes, ref, tick and serial (they still match each other) and is marked so that no
+/// EDEN_UP_L949_UBO_KEEP or later share takes its now older allocation for this range.
+template <class Runtime, class DeviceMemory, class Reuse>
+[[nodiscard]] bool ShareSmallUniform(Runtime& runtime, DeviceMemory& device_memory, Reuse& reuse,
+                                     typename Reuse::Slot& slot, size_t stage, u32 index,
+                                     u64 device_addr, u32 size) {
+    if ((++reuse.share_tries & 4095) == 0) {
+        LogUniformShare(reuse);
+    }
+    const typename Reuse::Slot* donor = nullptr;
+    for (size_t other = 0; other < Reuse::NumStages; ++other) {
+        if (other == stage) {
+            continue;
+        }
+        const typename Reuse::Slot& candidate = reuse.slots[other][index];
+        if (candidate.device_addr == device_addr && candidate.size == size &&
+            (donor == nullptr || candidate.serial > donor->serial)) {
+            donor = &candidate;
+        }
+    }
+    // The tick (a call into the runtime) only for a candidate: most binds have none.
+    if (donor == nullptr || donor->serial <= slot.serial) {
+        ++reuse.share_no_donor;
+        return false;
+    }
+    const u64 tick = runtime.CurrentTick();
+    if (donor->tick != tick) {
+        ++reuse.share_no_donor;
+        return false;
+    }
+    const u8* guest = nullptr;
+    // Test memories have no GetSpan.
+    if constexpr (requires { device_memory.GetSpan(device_addr, size); }) {
+        guest = device_memory.GetSpan(device_addr, size);
+    }
+    if (guest == nullptr) {
+        ++reuse.share_no_span;
+        return false;
+    }
+    if (std::memcmp(donor->bytes.data(), guest, size) != 0) {
+        ++reuse.share_misses_bytes;
+        return false;
+    }
+    if (UniformShareVerifyEnabled() &&
+        !UniformShareHolds(device_memory, reuse, *donor, stage, index, device_addr, size)) {
+        return false;
+    }
+    runtime.RebindStreamUniform(donor->ref, size);
+    slot.device_addr = ~u64{0};
+    ++reuse.share_hits;
+    if (slot.size == size && slot.tick == tick) {
+        ++reuse.share_own_current;
+    }
+    return true;
 }
 
