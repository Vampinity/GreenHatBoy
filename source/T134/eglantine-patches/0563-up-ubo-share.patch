+/// EDEN_UP_UBO_SHARE_VERIFY=1 (exact "1"), with EDEN_UP_UBO_SHARE on: every bind that would take
+/// another stage's copy also checks that the copy's stream memory still holds the donor's bytes
+/// and that a plain guest read gives them too, and binds the old way when either differs.
+[[nodiscard]] inline bool UniformShareVerifyEnabled() noexcept {
+    static const bool enabled = [] {
+        const char* const value = std::getenv("EDEN_UP_UBO_SHARE_VERIFY");
+        return value != nullptr && value[0] == '1' && value[1] == '\0';
+    }();
+    return enabled;
+}
