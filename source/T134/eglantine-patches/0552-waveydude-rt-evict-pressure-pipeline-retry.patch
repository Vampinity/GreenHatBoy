+    if (retry_enabled && on_worker) {
+        try {
+            pipeline = DriverBuildReport::Build(DriverBuildReport::Kind::Graphics, [&] {
+                return device.GetLogical().CreateGraphicsPipeline(pipeline_ci, *pipeline_cache);
+            });
+        } catch (const vk::Exception& exception) {
+            const VkResult result = exception.GetResult();
+            if (result != VK_ERROR_OUT_OF_HOST_MEMORY && result != VK_ERROR_OUT_OF_DEVICE_MEMORY) {
+                throw;
+            }
+            // The driver call has unwound. Only on a pipeline worker: the renderer's inline
+            // builds do not wait here. Out of host memory is mostly the shader compiler's own
+            // allocations, which the driver's retry (lead-mesh-22) never sees: ask for the same
+            // memory it would (16 MiB), give the collector a frame, and try once more.
+            const std::uint64_t freed =
+                eden_radv_out_of_memory ? eden_radv_out_of_memory(std::uint64_t{16} << 20) : 0;
+            std::this_thread::sleep_for(std::chrono::milliseconds{16});
+            // One shared rate limit for both outcomes, including concurrent workers.
+            static std::atomic<s64> last_log_ns{};
+            const auto log_due = [&] {
+                const s64 now = std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                    std::chrono::steady_clock::now().time_since_epoch()).count();
+                s64 last = last_log_ns.load(std::memory_order_relaxed);
+                return now - last >= 10'000'000'000LL &&
+                       last_log_ns.compare_exchange_strong(last, now, std::memory_order_relaxed);
+            };
+            try {
