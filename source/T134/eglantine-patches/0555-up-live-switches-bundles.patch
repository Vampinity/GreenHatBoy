+/// EDEN_NX2_PIPELINE_CLEAN, EDEN_NX2_RANGE_PREFIX: starting with '1' is 1, anything else 0.
+[[nodiscard]] inline s64 ParseLeadingOne(const char* text) noexcept {
+    return text != nullptr && text[0] == '1' ? 1 : 0;
+}
+
+/// EDEN_UP_OOT_POLL_BACKOFF_US: the longest sleep in us. A number above 1 (strtoll: leading
+/// blanks and a sign are read, trailing text ignored), at most 16000; unset, empty or anything
+/// else is the default 4000.
+[[nodiscard]] inline s64 ParsePollBackoffUs(const char* text) noexcept {
+    s64 us = 4000;
+    if (text != nullptr && text[0] != 0) {
+        const long long parsed = std::strtoll(text, nullptr, 10);
+        if (parsed > 1) {
+            us = parsed < 16000 ? parsed : 16000;
+        }
+    }
+    return us;
+}
