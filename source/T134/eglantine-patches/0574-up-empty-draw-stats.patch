new file mode 100644
index 0000000..bf508f1
--- /dev/null
+++ b/src/video_core/empty_draw_stats.h
@@ -0,0 +1,111 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+
+#include <array>
+#include <chrono>
+#include <cstdio>
+#include "common/common_types.h"
+#include "common/live_switch.h"
+
+namespace VideoCommon::EmptyDrawStats {
+enum class Outcome : u8 {
+    Recorded, RecordedZeroVertices, RecordedZeroInstances,
+    RenderDisabled, InvalidVertexRange, DebugShader, ZeroVertices, ZeroInstances,
+    MeshSkipped, NoPipeline, PipelineBuilding, ConfigureFailed, IndirectReset,
+    TimedAb, MeshNotRecorded, MeshGroupLimit, EmptyIndirectArgs, EmptyCountArgs,
+    WorkerPipelineMissing, Other, Count,
+};
+using Counts = std::array<u64, static_cast<size_t>(Outcome::Count)>;
+// The emulator has one rasterizer/GPUBack. No field here is read by VulkanWorker.
+struct BackState {
+    Counts counts{};
+    u64 requests{}; ///< Sampled draw requests (Begin) and render-disabled ones: what outcomes add up to
+    bool measuring{};
+    bool pending{};
+    bool lookup_building{};
+};
+inline BackState back;
+inline bool Enabled() noexcept {
+    return Common::LiveSwitch::Peek<Common::LiveSwitch::Id::EmptyDrawStats>() != 0;
+}
+inline void Begin() noexcept {
+    back.measuring = Enabled(); // exactly one live load per Rasterizer draw request
+    if (back.measuring) {
+        ++back.requests;
+        back.pending = true;
+        back.lookup_building = false;
+    }
+}
+inline void Add(Outcome outcome) noexcept {
+    if (back.measuring) ++back.counts[static_cast<size_t>(outcome)];
+}
+inline void Building() noexcept {
+    if (back.measuring) back.lookup_building = true;
+}
+inline void RenderDisabled() noexcept {
+    if (Enabled()) {
+        back.pending = true;
+        ++back.requests;
+        ++back.counts[static_cast<size_t>(Outcome::RenderDisabled)];
+    }
+}
+// Worker-owned, including the clock and frame count. Existing scheduler FIFO ordering
+// places every sampled draw outcome before the marker for its TickFrame.
+struct WorkerState {
+    Counts counts{};
+    u64 requests{};
+    u64 frames{};
+    std::chrono::steady_clock::time_point start{};
+};
+inline WorkerState worker;
+inline void Recorded(bool sample, bool missing, Outcome outcome = Outcome::Recorded) noexcept {
+    if (sample) ++worker.counts[static_cast<size_t>(missing ? Outcome::WorkerPipelineMissing : outcome)];
+}
+inline void EndFrame(const Counts& early, u64 early_requests, bool enabled) {
+    const auto now = std::chrono::steady_clock::now();
+    if (worker.start == std::chrono::steady_clock::time_point{}) worker.start = now;
+    for (size_t i = 0; i < early.size(); ++i) worker.counts[i] += early[i];
+    worker.requests += early_requests;
+    ++worker.frames;
+    const double seconds = std::chrono::duration<double>(now - worker.start).count();
+    if (seconds >= 10.0) {
+        static constexpr std::array<const char*, static_cast<size_t>(Outcome::Count)> names{
+            "recorded", "recorded_zero_vertices", "recorded_zero_instances",
+            "render_disabled", "invalid_vertex_range", "debug_shader", "zero_vertices", "zero_instances",
+            "mesh_skipped", "no_pipeline", "pipeline_building", "configure_failed", "indirect_reset",
+            "timed_ab", "mesh_not_recorded", "mesh_group_limit", "empty_indirect_args", "empty_count_args",
+            "worker_pipeline_missing", "other"};
+        // "other" is what no hook saw: requests that ended without any outcome (a return
+        // nobody hooked). double_counted is the reverse (a request with two outcomes). Both
+        // should read 0; anything else means a count below lies.
+        const u64 requests = worker.requests;
+        u64 accounted = 0;
+        for (size_t i = 0; i < worker.counts.size(); ++i) {
+            if (i != static_cast<size_t>(Outcome::Other)) accounted += worker.counts[i];
+        }
+        worker.counts[static_cast<size_t>(Outcome::Other)] =
+            requests > accounted ? requests - accounted : 0;
+        const u64 double_counted = accounted > requests ? accounted - requests : 0;
+        const double frames = static_cast<double>(worker.frames);
+        const u64 recorded = worker.counts[0] + worker.counts[1] + worker.counts[2];
+        char line[2048];
+        int used = std::snprintf(line, sizeof(line),
+            "EDEN_UP_EMPTY_DRAW_STATS seconds=%.3f frames=%llu requests/frame=%.3f recorded_total/frame=%.3f",
+            seconds, static_cast<unsigned long long>(worker.frames), requests / frames, recorded / frames);
+        for (size_t i = 0; i < names.size() && used > 0 && size_t(used) < sizeof(line); ++i) {
+            used += std::snprintf(line + used, sizeof(line) - size_t(used), " %s/frame=%.3f",
+                names[i], worker.counts[i] / frames);
+        }
+        if (used > 0 && size_t(used) < sizeof(line)) {
+            std::snprintf(line + used, sizeof(line) - size_t(used), " double_counted/frame=%.3f",
+                double_counted / frames);
+        }
+        std::fprintf(stderr, "%s\n", line);
+        worker = {};
+        worker.start = now;
+    }
+    // A sampled partial frame may finish after off. Do not carry its window into
+    // a later on phase. In-flight outcomes before this marker are already included.
+    if (!enabled) worker = {};
+}
+} // namespace VideoCommon::EmptyDrawStats
