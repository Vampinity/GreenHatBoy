+template <class P>
+bool BufferCache<P>::Nx2UboTrimGpuModified(DAddr device_addr, u32 size, bool walked,
+                                           bool touched, bool first) {
+    // EDEN_UP_UBO_BIND_TRIM: GPU-modified bits change only on GPUBack under this cache's mutex,
+    // held for the whole draw, so without a tracker-changing block since the first walk a walk
+    // of the same range gives the same answer.
+    Nx2UboTrimStats& stats = nx2_ubo_trim_stats;
+    if (!walked || touched) {
+        ++(walked ? stats.walks_redone : stats.walks_plain);
+        return memory_tracker.IsRegionGpuModified(device_addr, size);
+    }
+    if (!nx2_ubo_trim_verify) [[likely]] {
+        ++stats.walks_saved;
+        return first;
+    }
+    const bool now = memory_tracker.IsRegionGpuModified(device_addr, size);
+    ++stats.walks_verified;
+    if (now != first) {
+        ++stats.verify_bad;
+        if (nx2_ubo_trim_warnings < 32) {
+            ++nx2_ubo_trim_warnings;
+            LOG_WARNING(HW_GPU,
+                        "EDEN_UP_UBO_BIND_TRIM_VERIFY: the second walk of {:#x}+{:#x} says GPU "
+                        "modified {}, the first {}; the second is used",
+                        device_addr, size, now, first);
+        }
+    }
+    return now;
+}
+
+template <class P>
+bool BufferCache<P>::Nx2BankFirstThisFrame(size_t stage, u32 index, DAddr device_addr) {
+    // EDEN_UP_UBO_BIND_TRIM: native_indirect_uniforms_this_frame only grows between the
+    // TickFrame calls that clear it and move frame_tick, so a stamp of this frame for this
+    // address means the insert below ran this frame for it and would now answer false.
+    Nx2UboTrimStats& stats = nx2_ubo_trim_stats;
+    const u64 stamp = frame_tick + 1;
+    const bool in_range = stage < NUM_STAGES && index < NUM_GRAPHICS_UNIFORM_BUFFERS;
+    if (in_range && nx2_bank_seen_frame[stage][index] == stamp &&
+        nx2_bank_seen_addr[stage][index] == device_addr) {
+        if (!nx2_ubo_trim_verify) [[likely]] {
+            ++stats.bank_insert_skipped;
+            return false;
+        }
+        if (native_indirect_uniforms_this_frame.contains(device_addr)) {
+            ++stats.bank_insert_verified;
+            return false;
+        }
+        // Not in the set after all: the insert below gives the old answer (an upload).
+        ++stats.verify_bad;
+        if (nx2_ubo_trim_warnings < 32) {
+            ++nx2_ubo_trim_warnings;
+            LOG_WARNING(HW_GPU,
+                        "EDEN_UP_UBO_BIND_TRIM_VERIFY: bank {:#x} (stage {} slot {}) was stamped "
+                        "this frame but is not in the set; inserted and uploaded",
+                        device_addr, stage, index);
+        }
+    }
+    const bool first = native_indirect_uniforms_this_frame.insert(device_addr).second;
+    ++stats.bank_insert_done;
+    if (in_range) {
+        nx2_bank_seen_addr[stage][index] = device_addr;
+        nx2_bank_seen_frame[stage][index] = stamp;
+    }
+    return first;
+}
+
+template <class P>
+void BufferCache<P>::Nx2UboTrimReport() {
+    // EDEN_UP_UBO_BIND_TRIM: one line every 10 s while on (TickFrame).
+    Nx2UboTrimStats& stats = nx2_ubo_trim_stats;
+    // The skip size TickFrame just set holds for the frame that starts now: count each frame's.
+    ++stats.frames;
+    if (channel_state->uniform_buffer_skip_cache_size == 0) {
+        ++stats.frames_skip_off;
+    }
+    const auto now = std::chrono::steady_clock::now();
+    if (stats.since == std::chrono::steady_clock::time_point{}) {
+        stats.since = now;
+        return;
+    }
+    const auto elapsed = now - stats.since;
+    if (elapsed < std::chrono::seconds{10}) {
+        return;
+    }
+    const double seconds = std::chrono::duration<double>(elapsed).count();
+    const double draws = stats.draws != 0 ? static_cast<double>(stats.draws) : 1.0;
+    const u64 bank_checks =
+        stats.bank_insert_skipped + stats.bank_insert_verified + stats.bank_insert_done;
+    LOG_INFO(HW_GPU,
+             "EDEN_UP_UBO_BIND_TRIM: {:.1f} s, {} draws; per draw {:.2f} stream binds, {:.2f} "
+             "classic binds, {:.2f} bank set checks; skip size 0 in {} of {} frames (now {}); "
+             "second walks: {} saved, {} redone (tracker touched), {} plain (no first walk), {} "
+             "verified; bank set inserts: {} skipped, {} done, {} verified; verify differences {}",
+             seconds, stats.draws, static_cast<double>(stats.stream_binds) / draws,
+             static_cast<double>(stats.classic_binds) / draws,
+             static_cast<double>(bank_checks) / draws, stats.frames_skip_off, stats.frames,
+             channel_state->uniform_buffer_skip_cache_size, stats.walks_saved, stats.walks_redone,
+             stats.walks_plain, stats.walks_verified, stats.bank_insert_skipped,
+             stats.bank_insert_done, stats.bank_insert_verified, stats.verify_bad);
+    stats = {};
+    stats.since = now;
+}
