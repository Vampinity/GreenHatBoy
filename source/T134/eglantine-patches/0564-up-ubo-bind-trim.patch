+        u64 frames{};              ///< TickFrame calls in this window
+        u64 frames_skip_off{};     ///< ... that left uniform_buffer_skip_cache_size at 0
+        std::chrono::steady_clock::time_point since{}; ///< start of this line's window
+    } nx2_ubo_trim_stats;
+    u64 nx2_ubo_trim_warnings = 0; ///< _VERIFY difference lines logged, at most 32
+    /// EDEN_UP_UBO_BIND_TRIM: the second GPU-modified walk of a uniform bind. `walked`: the first
+    /// walk ran, `touched`: a block that can change tracker bits ran after it, `first`: its answer.
+    [[nodiscard]] bool Nx2UboTrimGpuModified(DAddr device_addr, u32 size, bool walked,
+                                             bool touched, bool first);
+    /// EDEN_UP_UBO_BIND_TRIM: native_indirect_uniforms_this_frame.insert(device_addr).second, or
+    /// false without the insert when this slot's memo says the insert ran this frame.
+    [[nodiscard]] bool Nx2BankFirstThisFrame(size_t stage, u32 index, DAddr device_addr);
+    /// EDEN_UP_UBO_BIND_TRIM: the 10 s counter line (TickFrame, while on).
+    void Nx2UboTrimReport();
     /// EDEN_UP_BANK_HASH_SKIP (zortos293/Lichii PR 1131): a native 64 KiB bank's bytes as its
     /// last once-per-frame upload took them, by device address. An entry stands only while the
     /// host buffer there still holds those bytes: every other write into its range drops it
