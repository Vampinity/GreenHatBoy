--- /dev/null
+++ b/src/video_core/report_no_alloc.h
@@ -0,0 +1,20 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <atomic>
+#include "common/pe_switch.h"
+#include "common/logging.h"
+namespace VideoCommon {
+inline std::atomic<bool> g_report_no_alloc{false};
+inline void InitReportNoAlloc() {
+    // Boot-fixed: query free IDs are stored only in the chosen mode's FIFO.
+    static const bool on = [] {
+        const bool enabled = Common::PeSwitch("EDEN_UP_REPORT_NO_ALLOC");
+        if (enabled) LOG_INFO(HW_GPU, "EDEN_UP_REPORT_NO_ALLOC=1: compact reports and recycled fence lists");
+        return enabled;
+    }();
+    g_report_no_alloc.store(on, std::memory_order_relaxed);
+}
+[[nodiscard]] inline bool ReportNoAllocEnabled() noexcept {
+    return g_report_no_alloc.load(std::memory_order_relaxed);
+}
+} // namespace VideoCommon
