+bool Maxwell3D::IsL974DrawParameter(u32 method) {
+    if (!VideoCommon::Nx2FastDraw::L974ChainEnabled()) {
+        return false;
+    }
+    // MME memory A/B and data RAM address, only while macros run on the split's front (as
+    // 0446's QUERY_LIGHT rule): a macro run inline on the back (no split, EDEN_NX2_SPLIT=1 with
+    // EDEN_NX2_MME_JIT=0) flushes GPU-written memory in its DMA read (macro.cpp) with no break of
+    // its own, so there these words must keep ending reuse.
+    if (method >= 0x154 && method <= 0x156 && VideoCommon::GpuSplit::Get().FrontMacros()) {
+        return true;
+    }
+    switch (method) {
+    case MAXWELL3D_REG_INDEX(vertex_id_base):
+    case MAXWELL3D_REG_INDEX(report_semaphore.address_high):
+    case MAXWELL3D_REG_INDEX(report_semaphore.address_low):
+    case MAXWELL3D_REG_INDEX(report_semaphore.payload):
+    case MAXWELL3D_REG_INDEX(clear_report_value):
+    case MAXWELL3D_REG_INDEX(render_enable.mode):
+    case MAXWELL3D_REG_INDEX(report_semaphore.query):
+        return true;
+    default:
+        return false;
+    }
+}
+
+bool Maxwell3D::IsL974NeutralMethod(u32 method, u32 argument) {
+    if (!VideoCommon::Nx2FastDraw::L974ChainEnabled()) {
+        return false;
+    }
+    if (method == MAXWELL3D_REG_INDEX(report_semaphore.query)) {
+        // Decode the argument, not a possibly older shadow/register word. Keep fence releases
+        // conservative already in J1: they may flush, wait or run callbacks writing memory.
+        Regs::ReportSemaphore report{};
+        report.query.raw = argument;
+        return report.query.operation == Regs::ReportSemaphore::Operation::ReportOnly ||
+               (report.query.operation == Regs::ReportSemaphore::Operation::Release &&
+                report.query.short_query == 0);
+    }
+    return method == MAXWELL3D_REG_INDEX(clear_report_value) ||
+           method == MAXWELL3D_REG_INDEX(render_enable.mode);
+}
+
 bool Maxwell3D::IsFastDrawVertexBuffer(u32 method) {
     constexpr u32 streams = MAXWELL3D_REG_INDEX(vertex_streams);
     constexpr u32 stream_words = sizeof(Regs::VertexStream) / sizeof(u32);
