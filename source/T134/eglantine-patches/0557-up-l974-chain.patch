+/// EDEN_UP_L974_CHAIN, read first by Maxwell3D's constructor (Value), before either GPU thread
+/// runs: one relaxed load (Peek), without Value's first-use guard.
+[[nodiscard]] inline bool L974ChainEnabled() noexcept {
+    return Common::LiveSwitch::Peek<Common::LiveSwitch::Id::L974Chain>() != 0;
+}
+
 /// EDEN_UP_L949_UBO_KEEP=1 with EDEN_UP_FAST_DRAW=1 (zortos293/Lichii #949: 6b38851501 and
 /// 3e86407514, zortos293): a delta draw binds a small streamed uniform buffer from the stream
 /// allocation the previous draw made for the same stage, slot, address and size in the same
@@ -151,9 +157,21 @@ inline std::atomic<u64> g_serial{1};
 /// The last break's reason and, for Register and Method, its 3D method (diagnostics).
 inline std::atomic<u32> g_last_break{};
 
+/// Set once by Maxwell3D's constructor: the 10-second log line will be written
+/// (EDEN_NX2_GPU_PROFILE or EDEN_UP_FAST_DRAW_VERIFY), so Break counts each reason.
+inline std::atomic<bool> g_chain_diagnostics{false};
+[[nodiscard]] inline bool ChainDiagnosticsEnabled() noexcept {
+    return g_chain_diagnostics.load(std::memory_order_relaxed);
+}
+
+inline std::array<std::atomic<u64>, static_cast<size_t>(Reason::Count)> g_break_counts{};
+
 /// Any thread.
 inline void Break(Reason reason, u32 method = 0) {
     if (Enabled()) {
+        if (ChainDiagnosticsEnabled()) {
+            g_break_counts[static_cast<size_t>(reason)].fetch_add(1, std::memory_order_relaxed);
+        }
         g_serial.fetch_add(1, std::memory_order_relaxed);
         g_last_break.store(static_cast<u32>(reason) | (method << 8), std::memory_order_relaxed);
     }
