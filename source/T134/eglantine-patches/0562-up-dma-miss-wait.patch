diff --git a/src/video_core/gpu_split.cpp b/src/video_core/gpu_split.cpp
index 6418f53..5b2402a 100644
--- a/src/video_core/gpu_split.cpp
+++ b/src/video_core/gpu_split.cpp
@@ -527,6 +527,16 @@ void GpuSplit::Drain(DrainSite site) {
     }
 }
 
+// EDEN_UP_DMA_MISS_WAIT: the open Regs entry is published first, as DrainAt does, so the wait
+// covers it; publish_every goes back to 8 words, as after a drain, so what the front sends next
+// reaches the back soon. No idle hook is asked for: the back runs its own after its spin.
+bool GpuSplit::WaitForSent(DrainSite site) {
+    CloseRegs();
+    const bool waited = WaitFor(write_position, site);
+    publish_every = 8;
+    return waited;
+}
+
 bool GpuSplit::WaitForWriters(DrainSite site) {
     return WaitFor(std::min(last_writer_position, write_position), site);
 }
