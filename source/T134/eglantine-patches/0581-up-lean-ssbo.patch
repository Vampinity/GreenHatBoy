+// EDEN_UP_LEAN_SSBO (0581; Duck912, Eglantine 9a362357a2, there EDEN_NX2_LEAN_SSBO and on by
+// default): exact "1" keeps the global memory helpers as calls (DontInline) and picks the
+// candidate buffer of a native pointer access with one OpSwitch instead of one if per buffer.
+// Exact "2" emits the old code and only prints the counts. Unset or anything else: the old code.
+// It changes the emitted SPIR-V, so it is in vk_pipeline_prep.cpp's TranslationSwitches (stamp).
+u32 LeanSsboMode() {
+    static const u32 mode = [] {
+        const char* const value = std::getenv("EDEN_UP_LEAN_SSBO");
+        if (value == nullptr || value[0] == '\0' || value[1] != '\0') {
+            return 0U;
+        }
+        return value[0] == '1' ? 1U : value[0] == '2' ? 2U : 0U;
+    }();
+    return mode;
+}
