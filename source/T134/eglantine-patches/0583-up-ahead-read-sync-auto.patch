+// ---- EDEN_UP_AHEAD_READ_SYNC_AUTO: read sync only around a cut through black ----
+
+/// Hold after the last black frame seen, in ms; 0 = off. Read once (present thread or renderer,
+/// whichever asks first). Off when the value is missing, 0 or not a number, or without the guard.
+[[nodiscard]] inline s64 AutoHoldMs() {
+    static const s64 hold = [] {
+        const char* value = std::getenv("EDEN_UP_AHEAD_READ_SYNC_AUTO");
+        if (value == nullptr || value[0] == '\0' || (value[0] == '0' && value[1] == '\0')) {
+            return s64{0};
+        }
+        char* end = nullptr;
+        const long long parsed = std::strtoll(value, &end, 10);
+        if (end == value || *end != '\0' || parsed <= 0) {
+            LOG_WARNING(HW_GPU, "EDEN_UP_AHEAD_READ_SYNC_AUTO={}: not a number of ms, off", value);
+            return s64{0};
+        }
+        if (!AheadGuard::Enabled()) {
+            LOG_WARNING(HW_GPU, "EDEN_UP_AHEAD_READ_SYNC_AUTO={}: needs EDEN_UP_AHEAD_GUARD, off",
+                        value);
+            return s64{0};
+        }
+        const s64 ms = parsed == 1 ? s64{1500} : static_cast<s64>((std::clamp)(parsed, 100LL, 10000LL));
+        LOG_INFO(HW_GPU,
+                 "EDEN_UP_AHEAD_READ_SYNC_AUTO={}: read sync from a black frame until {} ms after "
+                 "the last one (EDEN_UP_AHEAD_READ_SYNC=1 still means always)",
+                 value, ms);
+        return ms;
+    }();
+    return hold;
+}
+
+/// Black probe (renderer_vulkan/present/black_probe.h): 64 points, black when at least
+/// BlackSamples of them have every colour channel at or below DarkMax.
+inline constexpr u32 ProbeSamples = 64;
+inline constexpr u32 BlackSamples = 56;
+inline constexpr u32 DarkMax = 16;
+/// Arm, disarm, cap and hand-over lines logged at most this many times in a run.
+inline constexpr u32 AutoLineCap = 200;
+/// Ceiling: the longest the auto mode stays armed while no lit probe has been read since it
+/// armed (the picture still black or dark).
+inline constexpr s64 AutoMaxArmedMs = 4000;
+
+/// steady_clock ns when the renderer last read a black probe (the GPU thread writes, the present
+/// thread reads). Far in the past until then.
+inline std::atomic<s64> g_last_black_ns{(std::numeric_limits<s64>::min)() / 2};
+/// Dark points in the last probe read (for the arm line).
+inline std::atomic<u32> g_last_dark{0};
+/// steady_clock ns when the renderer last read a probe that was not black (GPU thread writes,
+/// present thread reads), for the ceiling.
+inline std::atomic<s64> g_last_lit_ns{(std::numeric_limits<s64>::min)() / 2};
+
+/// Probe counters: GPU thread adds, present thread takes them in the 10 s line.
+struct ProbeCounters {
+    std::atomic<u64> made{};
+    std::atomic<u64> read{};
+    std::atomic<u64> black{};
+    /// The slot to write still on the GPU: no probe for that frame (never waits).
+    std::atomic<u64> skipped{};
+};
+inline ProbeCounters g_probe;
+
+/// Reads synced while armed by the auto mode, never reset (stretch and window differences).
+inline std::atomic<u64> g_auto_syncs{0};
+
+/// The present thread's arm state: touched by AutoAtPresent only.
+struct AutoState {
+    bool armed{};
+    /// The ceiling disarmed it; no arming again until a lit probe newer than capped_at_ns.
+    bool capped{};
+    s64 capped_at_ns{};
+    s64 armed_since_ns{};
+    u64 armed_since_present{};
+    u64 syncs_at_arm{};
+    u32 lines{};
+    s64 window_start_ns{};
+    u64 window_syncs_start{};
+    u64 window_arms{};
+    u64 window_capped{};
+    u64 window_presents{};
+    u64 window_armed_presents{};
+    s64 window_longest_ns{};
+    u64 window_longest_presents{};
+};
+inline AutoState g_auto;
+
+/// After a logged arm, disarm, cap or hand-over line (or one not logged for the cap).
+inline void AutoLineSpent(AutoState& s) {
+    if (++s.lines == AutoLineCap) {
+        LOG_INFO(HW_GPU, "EDEN_UP_AHEAD_READ_SYNC_AUTO: {} arm and disarm lines; no more of "
+                         "them in this run (the 10 s line goes on counting)",
+                 AutoLineCap);
+    }
+}
+
+/// The nx2:vi2 present thread, once per present while EDEN_UP_AHEAD_READ_SYNC is off and
+/// AutoHoldMs() != 0. Says whether read sync is armed for this present.
+inline bool AutoAtPresent(u64 present, s64 now_ns) {
+    AutoState& s = g_auto;
+    const s64 hold_ns = AutoHoldMs() * 1'000'000;
+    const s64 last_black = g_last_black_ns.load(std::memory_order_acquire);
+    const s64 last_lit = g_last_lit_ns.load(std::memory_order_acquire);
+    if (s.capped && last_lit > s.capped_at_ns) {
+        s.capped = false; // the black or dark stretch ended: the normal hold applies again
+    }
+    if (s.armed && !s.capped && last_lit < s.armed_since_ns &&
+        now_ns - s.armed_since_ns > AutoMaxArmedMs * 1'000'000) {
+        s.capped = true;
+        s.capped_at_ns = now_ns;
+        ++s.window_capped;
+        if (s.lines < AutoLineCap) {
+            LOG_INFO(HW_GPU,
+                     "EDEN_UP_AHEAD_READ_SYNC_AUTO: capped at present #{}: armed {} ms with no "
+                     "lit frame read since; off until a lit frame is read",
+                     present, (now_ns - s.armed_since_ns) / 1'000'000);
+        }
+        AutoLineSpent(s);
+    }
+    const bool want = !s.capped && now_ns - last_black <= hold_ns;
+    if (want != s.armed) {
+        const u64 syncs_now = g_auto_syncs.load(std::memory_order_relaxed);
+        if (want) {
+            s.armed = true;
+            s.armed_since_ns = now_ns;
+            s.armed_since_present = present;
+            s.syncs_at_arm = syncs_now;
+            ++s.window_arms;
+            if (s.lines < AutoLineCap) {
+                LOG_INFO(HW_GPU,
+                         "EDEN_UP_AHEAD_READ_SYNC_AUTO: armed at present #{} (black frame read "
+                         "{} ms ago, {} of {} points dark)",
+                         present, (std::max)(s64{0}, now_ns - last_black) / 1'000'000,
+                         g_last_dark.load(std::memory_order_relaxed), ProbeSamples);
+            }
+        } else {
+            const s64 stretch = now_ns - s.armed_since_ns;
+            const u64 presents = present - s.armed_since_present;
+            if (stretch > s.window_longest_ns) {
+                s.window_longest_ns = stretch;
+                s.window_longest_presents = presents;
+            }
+            s.armed = false;
+            if (s.lines < AutoLineCap) {
+                LOG_INFO(HW_GPU,
+                         "EDEN_UP_AHEAD_READ_SYNC_AUTO: disarmed at present #{} after {} ms, {} "
+                         "presents, {} synced reads",
+                         present, stretch / 1'000'000, presents, syncs_now - s.syncs_at_arm);
+            }
+        }
+        AutoLineSpent(s);
+    }
+    ++s.window_presents;
+    s.window_armed_presents += s.armed ? 1 : 0;
+    if (s.window_start_ns == 0) {
+        s.window_start_ns = now_ns;
+        s.window_syncs_start = g_auto_syncs.load(std::memory_order_relaxed);
+    } else if (now_ns - s.window_start_ns >= 10'000'000'000LL) {
+        const u64 syncs_now = g_auto_syncs.load(std::memory_order_relaxed);
+        s64 longest = s.window_longest_ns;
+        u64 longest_presents = s.window_longest_presents;
+        if (s.armed && now_ns - s.armed_since_ns > longest) {
+            longest = now_ns - s.armed_since_ns;
+            longest_presents = present - s.armed_since_present;
+        }
+        LOG_INFO(HW_GPU,
+                 "EDEN_UP_AHEAD_READ_SYNC_AUTO 10 s: armed {} times ({} capped), {} of {} "
+                 "presents armed, synced reads while armed {}, longest armed stretch {} ms ({} "
+                 "presents){}; black probes made {}, read {}, black {}, skipped {} (slot still "
+                 "on the GPU)",
+                 s.window_arms, s.window_capped, s.window_armed_presents, s.window_presents,
+                 syncs_now - s.window_syncs_start, longest / 1'000'000, longest_presents,
+                 s.armed ? ", armed now" : "",
+                 g_probe.made.exchange(0, std::memory_order_relaxed),
+                 g_probe.read.exchange(0, std::memory_order_relaxed),
+                 g_probe.black.exchange(0, std::memory_order_relaxed),
+                 g_probe.skipped.exchange(0, std::memory_order_relaxed));
+        s.window_start_ns = now_ns;
+        s.window_syncs_start = syncs_now;
+        s.window_arms = 0;
+        s.window_capped = 0;
+        s.window_presents = 0;
+        s.window_armed_presents = 0;
+        s.window_longest_ns = 0;
+        s.window_longest_presents = 0;
+    }
+    return s.armed;
+}
+
+/// The nx2:vi2 present thread, at a present while EDEN_UP_AHEAD_READ_SYNC is live on and
+/// AutoHoldMs() != 0: the switch means always, so the auto state is closed (one hand-over line
+/// when it was armed) and reset; it starts afresh at the first present with the switch off.
+inline void AutoAtLiveOn(u64 present, s64 now_ns) {
+    AutoState& s = g_auto;
+    if (!s.armed && !s.capped && s.window_start_ns == 0) {
+        return; // already reset
+    }
+    if (s.armed) {
+        if (s.lines < AutoLineCap) {
+            LOG_INFO(HW_GPU,
+                     "EDEN_UP_AHEAD_READ_SYNC_AUTO: handed over at present #{} after {} ms, {} "
+                     "presents, {} synced reads (EDEN_UP_AHEAD_READ_SYNC=1 is on: always)",
+                     present, (now_ns - s.armed_since_ns) / 1'000'000,
+                     present - s.armed_since_present,
+                     g_auto_syncs.load(std::memory_order_relaxed) - s.syncs_at_arm);
+        }
+        AutoLineSpent(s);
+    }
+    const u32 lines = s.lines;
+    s = AutoState{};
+    s.lines = lines;
+}
+
 } // namespace VideoCommon::AheadReadSync
