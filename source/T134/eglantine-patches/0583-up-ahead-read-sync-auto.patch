+/// EDEN_UP_AHEAD_READ_SYNC_AUTO (video_core/ahead_read_sync.h): is the frame about to be shown
+/// black? At each composite, 64 single pixels on an 8x8 grid inside the drawn area of the frame
+/// image are copied into one of Slots small host buffers, with the present's own commands (no
+/// extra submit). A slot is read at a later composite, only once the GPU is past it
+/// (Scheduler::IsFree): nothing ever waits for a probe. When the slot to write is still on the
+/// GPU, that frame gets no probe. A black probe sets g_last_black_ns to the time it was read, so
+/// the present thread knows a black frame was shown one or a few presents ago.
+/// Cost while on: 64 one-pixel copies (256 bytes) and two barriers per present on the GPU, and a
+/// 256-byte read on the GPU thread. Formats with 4 bytes a pixel only (8-bit RGBA/BGRA and
+/// 10-bit packed); another format turns the probe off with one line.
+class BlackProbe {
+public:
+    static constexpr u32 Grid = 8;
+    static constexpr u32 Samples = Grid * Grid;
+    static constexpr u32 Slots = 4;
+    static_assert(Samples == VideoCommon::AheadReadSync::ProbeSamples);
+
+    /// The GPU thread, in RendererVulkan::Composite after the frame is drawn, before its submit.
+    void AtComposite(MemoryAllocator& allocator, Scheduler& scheduler, Frame* frame,
+                     VkFormat format, const Layout::FramebufferLayout& layout) {
+        namespace ReadSync = VideoCommon::AheadReadSync;
+        if (disabled || frame == nullptr || !frame->image) {
+            return;
+        }
+        // IsFree compares with the scheduler's known GPU tick, which only moves when some code
+        // refreshes it; nothing else in Composite does. One counter read (no wait), only while
+        // a probe is pending, so a finished probe is read at once and slots do not stay full.
+        if (std::any_of(slots.begin(), slots.end(), [](const Slot& s) { return s.pending; })) {
+            scheduler.GetMasterSemaphore().Refresh();
+        }
+        // Read every probe the GPU has finished, oldest first.
+        for (u32 i = 0; i < Slots; ++i) {
+            Slot& slot = slots[(next + i) % Slots];
+            if (slot.pending && scheduler.IsFree(slot.tick)) {
+                Read(slot);
+            }
+        }
+        if (Kind(format) == PixelKind::Unsupported) {
+            disabled = true;
+            LOG_WARNING(Render_Vulkan,
+                        "EDEN_UP_AHEAD_READ_SYNC_AUTO: frame format {} has no black probe; the "
+                        "auto mode never arms in this run",
+                        static_cast<int>(format));
+            return;
+        }
+        if (!made) {
+            try {
+                for (Slot& slot : slots) {
+                    slot.buffer = CreateWrappedBuffer(allocator, Samples * 4, MemoryUsage::Download);
+                }
+            } catch (const std::exception&) {
+                disabled = true;
+                LOG_WARNING(Render_Vulkan, "EDEN_UP_AHEAD_READ_SYNC_AUTO: no memory for the black "
+                                           "probe; the auto mode never arms in this run");
+                return;
+            }
+            made = true;
+        }
+        Slot& slot = slots[next];
+        if (slot.pending) {
+            ReadSync::g_probe.skipped.fetch_add(1, std::memory_order_relaxed);
+            return;
+        }
+        // The drawn area (black bars of a wider window are not the game's picture).
+        const u32 left = (std::min)(layout.screen.left, frame->width - 1);
+        const u32 top = (std::min)(layout.screen.top, frame->height - 1);
+        const u32 right = (std::clamp)(layout.screen.right, left + 1, frame->width);
+        const u32 bottom = (std::clamp)(layout.screen.bottom, top + 1, frame->height);
+        for (u32 y = 0; y < Grid; ++y) {
+            for (u32 x = 0; x < Grid; ++x) {
+                const u32 px = left + ((2 * x + 1) * (right - left)) / (2 * Grid);
+                const u32 py = top + ((2 * y + 1) * (bottom - top)) / (2 * Grid);
+                slot.regions[y * Grid + x] = VkBufferImageCopy{
+                    .bufferOffset = VkDeviceSize{(y * Grid + x) * 4U},
+                    .bufferRowLength = 0,
+                    .bufferImageHeight = 0,
+                    .imageSubresource{
+                        .aspectMask = VK_IMAGE_ASPECT_COLOR_BIT,
+                        .mipLevel = 0,
+                        .baseArrayLayer = 0,
+                        .layerCount = 1,
+                    },
+                    .imageOffset{.x = static_cast<s32>(px), .y = static_cast<s32>(py), .z = 0},
+                    .imageExtent{.width = 1, .height = 1, .depth = 1},
+                };
+            }
+        }
+        slot.format = format;
+        slot.pending = true;
+        // The tick of the commands recorded now: the composite's submit (Flush) signals it.
+        slot.tick = scheduler.CurrentTick();
+        next = (next + 1) % Slots;
+        ReadSync::g_probe.made.fetch_add(1, std::memory_order_relaxed);
+        scheduler.RequestOutsideRenderPassOperationContext();
+        // The regions live in the slot, which is not written again before IsFree(tick).
+        scheduler.Record([image = *frame->image, buffer = *slot.buffer,
+                          regions = slot.regions.data()](vk::CommandBuffer cmdbuf) {
+            static constexpr VkMemoryBarrier before{
+                .sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER,
+                .pNext = nullptr,
+                .srcAccessMask = VK_ACCESS_MEMORY_WRITE_BIT,
+                .dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT,
+            };
+            static constexpr VkMemoryBarrier to_host{
+                .sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER,
+                .pNext = nullptr,
+                .srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT,
+                .dstAccessMask = VK_ACCESS_HOST_READ_BIT,
+            };
+            cmdbuf.PipelineBarrier(vk::PIPELINE_STAGE_GRAPHICS_COMPUTE_TRANSFER,
+                                   VK_PIPELINE_STAGE_TRANSFER_BIT, 0, before);
+            // The frame image stays in GENERAL (the present pass's final layout): a copy may
+            // read it there, so its layout is not touched.
+            cmdbuf.CopyImageToBuffer(image, VK_IMAGE_LAYOUT_GENERAL, buffer,
+                                     vk::Span<VkBufferImageCopy>(regions, Samples));
+            // Makes the copy's result readable by the CPU (the submit's fence alone does not).
+            // No barrier after it: nothing later in this submit writes the frame image, and the
+            // next composite that draws into it gets it back only after the present's fence.
+            cmdbuf.PipelineBarrier(VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_HOST_BIT, 0,
+                                   to_host);
+        });
+    }
+
+private:
+    enum class PixelKind { Unsupported, Bytes8, Packed10 };
+
+    struct Slot {
+        vk::Buffer buffer;
+        std::array<VkBufferImageCopy, Samples> regions{};
+        u64 tick{};
+        VkFormat format{};
+        bool pending{};
+    };
+
+    static PixelKind Kind(VkFormat format) {
+        switch (format) {
+        case VK_FORMAT_B8G8R8A8_UNORM:
+        case VK_FORMAT_B8G8R8A8_SRGB:
+        case VK_FORMAT_R8G8B8A8_UNORM:
+        case VK_FORMAT_R8G8B8A8_SRGB:
+        case VK_FORMAT_A8B8G8R8_UNORM_PACK32:
+        case VK_FORMAT_A8B8G8R8_SRGB_PACK32:
+            return PixelKind::Bytes8;
+        case VK_FORMAT_A2B10G10R10_UNORM_PACK32:
+        case VK_FORMAT_A2R10G10B10_UNORM_PACK32:
+            return PixelKind::Packed10;
+        default:
+            return PixelKind::Unsupported;
+        }
+    }
+
+    /// The brightest colour channel of one pixel, 0-255.
+    static u32 Brightest(const u8* pixel, PixelKind kind) {
+        if (kind == PixelKind::Bytes8) {
+            // R, G, B (or B, G, R) in the first three bytes, alpha last, in every 8-bit format.
+            return (std::max)({u32{pixel[0]}, u32{pixel[1]}, u32{pixel[2]}});
+        }
+        u32 word{};
+        std::memcpy(&word, pixel, sizeof(word));
+        return (std::max)({word & 0x3ffU, (word >> 10) & 0x3ffU, (word >> 20) & 0x3ffU}) >> 2;
+    }
+
+    void Read(Slot& slot) {
+        namespace ReadSync = VideoCommon::AheadReadSync;
+        slot.pending = false;
+        slot.buffer.Invalidate();
+        const auto bytes = slot.buffer.Mapped();
+        if (bytes.size() < Samples * 4) {
+            return;
+        }
+        const PixelKind kind = Kind(slot.format);
+        u32 dark = 0;
+        for (u32 i = 0; i < Samples; ++i) {
+            dark += Brightest(bytes.data() + i * 4, kind) <= ReadSync::DarkMax ? 1 : 0;
+        }
+        ReadSync::g_probe.read.fetch_add(1, std::memory_order_relaxed);
+        ReadSync::g_last_dark.store(dark, std::memory_order_relaxed);
+        if (dark >= ReadSync::BlackSamples) {
+            ReadSync::g_probe.black.fetch_add(1, std::memory_order_relaxed);
+            ReadSync::g_last_black_ns.store(ReadSync::NowNs(), std::memory_order_release);
+        } else {
+            // Not black: the ceiling (AutoMaxArmedMs) waits for one of these before it lets
+            // the auto mode arm again.
+            ReadSync::g_last_lit_ns.store(ReadSync::NowNs(), std::memory_order_release);
+        }
+    }
+
+    std::array<Slot, Slots> slots{};
+    u32 next{};
+    bool made{};
+    bool disabled{};
+};
+
+} // namespace Vulkan
