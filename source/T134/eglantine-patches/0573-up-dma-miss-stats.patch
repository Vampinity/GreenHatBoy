+    /// EDEN_UP_DMA_MISS_STATS=1 (live, log only): what each macro DMA read of FrontDmaRead ended
+    /// as, and for a snapshot miss which kind of writer, sent since the page's snapshot, made it.
+    enum class DmaCause : u8 {
+        Hit, NewPage, ComputeLaunch, ComputeReport, ComputeUpload, ComputeMacro, ComputeOther, Copy, PullerFence,
+        PullerRelease, KeplerMemory, Fermi2D, Unranged, Report, Upload,
+        Ranged, HistoryLost, Unknown, ListedReport, Disabled, Ineligible,
+        Trace, Unmapped, Noncontiguous, Count,
+    };
+    static bool DmaMissStatsEnabled() noexcept {
+        return Common::LiveSwitch::Peek<Common::LiveSwitch::Id::DmaMissStats>() != 0;
+    }
+    // Front thread only (counts, clock and printing). Never consulted by snapshot validity or
+    // waits. A window ends after 10 s, or early at a gap of over a second between two counted
+    // reads (an off phase of the switch, a load): then its line covers up to its last read and
+    // says end=gap, so a rate taken from it never spreads its reads over time nobody counted.
+    void CountDmaRead(DmaCause cause) {
+        const auto now = std::chrono::steady_clock::now();
+        if (dma_stats_start == std::chrono::steady_clock::time_point{}) {
+            dma_stats_start = now;
+        } else if (now - dma_stats_last > std::chrono::seconds{1}) {
+            PrintDmaStats(dma_stats_last, "gap");
+            dma_stats_start = now;
+        }
+        dma_stats_last = now;
+        ++dma_stats_counts[static_cast<size_t>(cause)];
+        if (now - dma_stats_start >= std::chrono::seconds{10}) {
+            PrintDmaStats(now, "full");
+            dma_stats_start = now;
+        }
+    }
+    void PrintDmaStats(std::chrono::steady_clock::time_point end, const char* why) {
+        static constexpr std::array<const char*, static_cast<size_t>(DmaCause::Count)> names{
+            "hit", "new_page", "compute_launch_method", "compute_report", "compute_upload", "compute_macro", "compute_other", "copy",
+            "puller_fence", "puller_release", "kepler_memory", "fermi2d", "unranged",
+            "report", "upload", "ranged", "history_lost", "unknown_history",
+            "listed_report", "snapshot_off", "ineligible", "trace", "unmapped", "noncontiguous"};
+        char line[1024];
+        int used = std::snprintf(line, sizeof(line), "EDEN_UP_DMA_MISS_STATS seconds=%.3f end=%s",
+            std::chrono::duration<double>(end - dma_stats_start).count(), why);
+        for (size_t i = 0; i < names.size() && used > 0 && size_t(used) < sizeof(line); ++i) {
+            used += std::snprintf(line + used, sizeof(line) - size_t(used), " %s=%llu",
+                names[i], static_cast<unsigned long long>(dma_stats_counts[i]));
+        }
+        std::fprintf(stderr, "%s\n", line);
+        dma_stats_counts.fill(0);
+    }
+    [[nodiscard]] DmaCause DmaSnapshotCause(u64 since, u64 begin, u64 size) const {
+        if (last_writer_position > since) {
+            return dma_writer_at == last_writer_position ? dma_writer_cause : DmaCause::Unknown;
+        }
+        if (last_unranged_position > since) {
+            return dma_unranged_at == last_unranged_position ? dma_unranged_cause : DmaCause::Unknown;
+        }
+        const u64 remembered = (std::min<u64>)(pending_write_count, pending_writes.size());
+        for (u64 scanned = 0; scanned < remembered; ++scanned) {
+            const u64 serial = pending_write_count - scanned;
+            const size_t index = (serial - 1) % pending_writes.size();
+            const auto& write = pending_writes[index];
+            if (write.position <= since) {
+                return DmaCause::Unknown;
+            }
+            if (write.begin < begin + size && begin < write.end) {
+                return dma_ranged_serial[index] == serial ? dma_ranged_cause[index]
+                                                         : DmaCause::Unknown;
+            }
+        }
+        return remembered == pending_writes.size() ? DmaCause::HistoryLost : DmaCause::Unknown;
+    }
+    void NoteDmaWriterCause(DmaCause cause) noexcept {
+        dma_writer_at = last_writer_position;
+        dma_writer_cause = cause;
+    }
