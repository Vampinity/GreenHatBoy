 #include <atomic>
 #include <cstdlib>
 #include <chrono>
@@ -315,6 +316,17 @@ class TextureCache : public VideoCommon::ChannelSetupCaches<TextureCacheChannelI
     u64 astc_opaque_images{};
     u64 astc_alpha_images{};
     std::vector<u8> astc_scan_buffer;
+    /// EDEN_UP_ASTC_SCAN_CHUNKS (waveydude 0917): fixed scan piece, part of the cache object (no
