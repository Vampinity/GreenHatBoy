+    static const int mode = [] {
+        const char* const value = std::getenv("EDEN_UP_DECODE_KEPT_LEVELS");
+        if (value == nullptr || value[0] < '1' || value[0] > '3' || value[1] != '\0') {
+            return 0;
+        }
+        const int m = value[0] - '0';
+        std::fprintf(stderr,
