+/// EDEN_UP_DECODE_KEPT_LEVELS (texture_cache.h DecodeKeptLevelsMode): the asynchronous decodes of
+/// trimmed images (host_level_offset != 0) since the last 10 s line, the input and output bytes
+/// they left out (mode 2) or would have (mode 1), and the bytes of that kind the decodes still in
+/// flight hold less (input: until the worker is done with it; output: until the decode's context
+/// goes), with its highest since boot. Mode 3 counts its comparisons. All zero with the switch off.
+struct DecodeKeptStats {
+    std::atomic<u64> decodes{0};
+    std::atomic<u64> input_saved{0};
+    std::atomic<u64> output_saved{0};
+    std::atomic<u64> held{0};
+    std::atomic<u64> peak{0};
+    std::atomic<u64> verified{0};
+    std::atomic<u64> differ{0};
+};
+inline DecodeKeptStats decode_kept_stats;
+
+inline void DecodeKeptHold(u64 bytes) {
+    if (bytes == 0) {
+        return;
+    }
+    const u64 held = decode_kept_stats.held.fetch_add(bytes, std::memory_order_relaxed) + bytes;
+    u64 peak = decode_kept_stats.peak.load(std::memory_order_relaxed);
+    while (held > peak &&
+           !decode_kept_stats.peak.compare_exchange_weak(peak, held, std::memory_order_relaxed)) {
+    }
+}
+
+inline void DecodeKeptRelease(u64 bytes) {
+    if (bytes != 0) {
+        decode_kept_stats.held.fetch_sub(bytes, std::memory_order_relaxed);
+    }
+}
+
+/// The input part of DecodeKeptHold, carried by the decode task: released when the worker drops
+/// the task (and with it the input buffer), or when the task is dropped unrun.
+struct DecodeKeptInputHold {
+    u64 bytes{};
+    explicit DecodeKeptInputHold(u64 bytes_) : bytes{bytes_} {}
+    DecodeKeptInputHold(DecodeKeptInputHold&& other) noexcept : bytes{other.bytes} {
+        other.bytes = 0;
+    }
+    DecodeKeptInputHold& operator=(DecodeKeptInputHold&&) = delete;
+    DecodeKeptInputHold(const DecodeKeptInputHold&) = delete;
+    DecodeKeptInputHold& operator=(const DecodeKeptInputHold&) = delete;
+    ~DecodeKeptInputHold() {
+        DecodeKeptRelease(bytes);
+    }
+};
+
 struct AsyncDecodeContext {
+    ~AsyncDecodeContext() {
+        DecodeKeptRelease(kept_output_held);
+    }
+    /// EDEN_UP_DECODE_KEPT_LEVELS 1/2: output bytes this decode holds less (or would), for the
+    /// held total. 0 otherwise.
+    u64 kept_output_held{};
     ImageId image_id;
     Common::ScratchBuffer<u8> decoded_data;
     boost::container::small_vector<BufferImageCopy, 16> copies;
