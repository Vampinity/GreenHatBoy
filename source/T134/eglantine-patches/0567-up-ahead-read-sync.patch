+    /// EDEN_UP_AHEAD_READ_SYNC (video_core/ahead_read_sync.h): OnCPURead of a range fences
+    /// download (Preflushable) while the game's latest present returned before its own fence.
+    /// Waits for that frame's fence (at most WaitCapMs, and not while a channel waits on a
+    /// semaphore the CPU releases), so the back has recorded the frame and its writes to the
+    /// range are GPU-modified, then runs OnCPURead's synchronous flush, which downloads them into
+    /// guest memory now. On guest core threads only: other threads keep no area and take the
+    /// shortcut as before. No cache mutex is held here (GetFlushArea released both).
+    VideoCore::RasterizerDownloadArea ReadAheadSync(VideoCore::RasterizerDownloadArea raster_area,
+                                                    DAddr addr, u64 size) {
+        namespace ReadSync = VideoCommon::AheadReadSync;
+        auto& counters = ReadSync::g_counters;
+        if (system.GetCurrentHostThreadID() >= Core::Hardware::NUM_CPU_CORES) {
+            counters.service_reads.fetch_add(1, std::memory_order_relaxed);
+            return raster_area;
+        }
+        counters.lookups_ahead.fetch_add(1, std::memory_order_relaxed);
+        const s64 start = ReadSync::NowNs();
+        // EDEN_UP_AHEAD_READ_SYNC_VERIFY=1: the bytes the shortcut gives (guest memory as it is
+        // at the read, before any wait), up to 4 KiB from the read's page, against those after
+        // the flush. Observes only: the game reads the bytes after the flush either way.
+        const bool verify = ReadSync::VerifyEnabled();
+        std::array<u8, 4096> before{};
+        DAddr verify_begin = 0;
+        u64 verify_size = 0;
+        if (verify) [[unlikely]] {
+            verify_begin = (std::max)(static_cast<DAddr>(raster_area.start_address),
+                                      addr & ~DAddr{4095});
+            verify_size = (std::min)(static_cast<u64>(before.size()),
+                                     static_cast<u64>(raster_area.end_address) - verify_begin);
+            system.Host1x().MemoryManager().ReadBlockUnsafe(verify_begin, before.data(),
+                                                            verify_size);
+        }
+        const u64 fence_word = ReadSync::g_fence.load(std::memory_order_relaxed);
+        const u32 fence_id = static_cast<u32>(fence_word >> 32);
+        const u32 fence_value = static_cast<u32>(fence_word);
+        if (fence_id < 192) {
+            const auto& syncpoints = system.Host1x().GetSyncpointManager();
+            if (!syncpoints.IsReadyGuest(fence_id, fence_value)) {
+                counters.fence_waits.fetch_add(1, std::memory_order_relaxed);
+                // Bounded: a frame whose GPU work waits on a release this thread makes later
+                // would never reach its fence. Then the flush below runs as it would today.
+                const s64 deadline = start + ReadSync::WaitCapMs * 1'000'000;
+                while (!syncpoints.IsReadyGuest(fence_id, fence_value)) {
+                    const s64 now = ReadSync::NowNs();
+                    if (now >= deadline) {
+                        counters.fence_timeouts.fetch_add(1, std::memory_order_relaxed);
+                        break;
+                    }
+                    // Past EscapeAfterNs with a channel suspended on a semaphore acquire: the
+                    // frame may wait on a release this thread makes later (as AheadGuard's
+                    // HoldWriter, which lets such writers go).
+                    if (now - start >= ReadSync::EscapeAfterNs &&
+                        scheduler.HasPendingChannelsAnyThread()) {
+                        counters.fence_escapes.fetch_add(1, std::memory_order_relaxed);
+                        break;
+                    }
+                    if (now - start < 500'000) {
+                        std::this_thread::yield();
+                    } else {
+                        std::this_thread::sleep_for(std::chrono::microseconds{250});
+                    }
+                }
+            }
+        }
+        const u64 fence = RequestSyncOperation([this, raster_area]() {
+            // Apply collected guest writes before downloading GPU data over guest memory.
+            InvalidateGPUCache();
+            renderer->ReadRasterizer()->FlushRegion(raster_area.start_address,
+                                                    raster_area.end_address -
+                                                        raster_area.start_address);
+        });
+        gpu_thread.TickGPU(is_async);
+        WaitForSyncOperation(fence);
+        const u64 took = static_cast<u64>(ReadSync::NowNs() - start);
+        counters.syncs.fetch_add(1, std::memory_order_relaxed);
+        counters.sync_ns.fetch_add(took, std::memory_order_relaxed);
+        ReadSync::Max(counters.max_sync_ns, took);
+        if (verify) [[unlikely]] {
+            std::array<u8, 4096> after{};
+            system.Host1x().MemoryManager().ReadBlockUnsafe(verify_begin, after.data(),
+                                                            verify_size);
+            const u64 read_begin = addr > verify_begin ? addr - verify_begin : 0;
+            const u64 read_end = (std::min)(verify_size, read_begin + size);
+            u64 changed = 0;
+            u64 first = verify_size;
+            u64 first_in_read = verify_size;
+            for (u64 i = 0; i < verify_size; ++i) {
+                if (before[i] != after[i]) {
+                    first = changed == 0 ? i : first;
+                    ++changed;
+                    if (first_in_read == verify_size && i >= read_begin && i < read_end) {
+                        first_in_read = i;
+                    }
+                }
+            }
+            if (changed != 0) {
+                // The line the read asked for when its own bytes changed, else the first one.
+                const bool in_read = first_in_read != verify_size;
+                const u64 line = (in_read ? first_in_read : first) & ~u64{15};
+                const DAddr line_addr = verify_begin + line;
+                const u64 present = ReadSync::g_present.load(std::memory_order_relaxed);
+                counters.verify_changed.fetch_add(1, std::memory_order_relaxed);
+                counters.verify_bytes.fetch_add(changed, std::memory_order_relaxed);
+                if (in_read) {
+                    counters.verify_read_changed.fetch_add(1, std::memory_order_relaxed);
+                }
+                counters.last_changed_addr.store(line_addr, std::memory_order_relaxed);
+                counters.last_changed_present.store(present, std::memory_order_relaxed);
+                if (counters.verify_lines.fetch_add(1, std::memory_order_relaxed) < 8) {
+                    std::array<f32, 4> old_values{};
+                    std::array<f32, 4> new_values{};
+                    const u64 bytes = (std::min)(u64{16}, verify_size - line);
+                    std::memcpy(old_values.data(), before.data() + line, bytes);
+                    std::memcpy(new_values.data(), after.data() + line, bytes);
+                    LOG_INFO(HW_GPU,
+                             "Ahead read sync: read [{:#x}, +{}) at p{} changed {} B ({}), "
+                             "line {:#x}: {} {} {} {} -> {} {} {} {}",
+                             addr, size, present, changed, in_read ? "in read" : "window only",
+                             line_addr, old_values[0], old_values[1], old_values[2],
+                             old_values[3], new_values[0], new_values[1], new_values[2],
+                             new_values[3]);
+                }
+            }
+        }
+        ReadSync::MaybeReport();
+        return raster_area;
+    }
+
