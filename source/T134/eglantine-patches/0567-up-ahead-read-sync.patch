diff --git a/src/video_core/ahead_read_sync.h b/src/video_core/ahead_read_sync.h
new file mode 100644
index 0000000..6165ebd
--- /dev/null
+++ b/src/video_core/ahead_read_sync.h
@@ -0,0 +1,138 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <atomic>
+#include <chrono>
+
+#include "common/common_types.h"
+#include "common/logging.h"
+#include "common/pe_switch.h"
+
+/// EDEN_UP_AHEAD_READ_SYNC=1 (exact "1"; a live switch, common/live_switch.h; off by default):
+/// while the game's latest present returned before its own frame's fence (a frame ahead,
+/// EDEN_NX2_FRAMES_AHEAD=1), a guest read of a buffer range the GPU writes and fences download
+/// (Preflushable) waits for that frame's own bytes instead of taking guest memory as it is.
+///
+/// Why: below High GPU accuracy the guest fence goes up when the GPU back thread records the
+/// frame, and the frame's download of such a range lands later, on GPUFencingThread. Once the
+/// guest has read a range, BufferCache::GetFlushArea answers "preemtive" for it and the core
+/// keeps the area, so later reads take guest memory as it is. A frame ahead, CPU frame C+1 starts
+/// while frame C is not recorded or not landed, and a per-frame read-back gets frame C-1's value;
+/// at a cut from black that is the black frame (the over-bright second, 0 of 45 with the full
+/// wait). With the switch on, GPU::OnCPURead sends such a read through its synchronous flush:
+/// it first waits (at most WaitCapMs) for the presented frame's fence, so the back has recorded
+/// frame C, then flushes the range on the GPU thread, which downloads what the GPU holds there
+/// now: frame C's bytes, or newer ones only where the game already submitted later work that
+/// writes the range before reading it (what a synchronous read of a non-Preflushable range
+/// gets today, and what the hardware would show after the game's own fence wait).
+///
+/// Not covered: images the texture cache downloads at fences (forced_flushed), query reports,
+/// GPU-only chains. EDEN_UP_AHEAD_READ_SYNC_VERIFY=1 (boot) reads the range's bytes before and
+/// after the sync and logs the reads where they differ (address, present, old and new as floats).
+///
+/// Every 10 s while on:
+///   Ahead read sync: ahead lookups <n> syncs <n> avg <us> us max <us> us fence waits <n>
+///       (timeouts <n>, escapes <n>) service reads <n> changed <n> (in read <n>, <bytes> B,
+///       last <addr> at p<n>) presents ahead <n>
+namespace VideoCommon::AheadReadSync {
+
+/// The longest a read waits for the presented frame's fence before it flushes anyway.
+inline constexpr s64 WaitCapMs = 50;
+/// After this long a wait also ends when a GPU channel is suspended on a semaphore acquire.
+inline constexpr s64 EscapeAfterNs = 2'000'000;
+
+/// 1 while the game's latest present returned with its own fence not reached. Written only by
+/// the nx2:vi2 present thread (release), read by guest core threads (acquire).
+inline std::atomic<u32> g_ahead{0};
+/// That present's number, and its frame's fence as (syncpoint id << 32) | value in one word.
+/// Present thread writes (before g_ahead), guest core threads read (after g_ahead).
+inline std::atomic<u64> g_present{0};
+inline std::atomic<u64> g_fence{~u64{0}};
+
+/// Counters: relaxed atomics, written by guest core threads (presents_ahead by the present
+/// thread), read by whichever thread logs.
+struct Counters {
+    std::atomic<u64> presents_ahead{};
+    std::atomic<u64> lookups_ahead{};
+    std::atomic<u64> syncs{};
+    std::atomic<u64> sync_ns{};
+    std::atomic<u64> max_sync_ns{};
+    std::atomic<u64> fence_waits{};
+    std::atomic<u64> fence_timeouts{};
+    /// Fence waits left early because a channel waits on a semaphore the CPU releases.
+    std::atomic<u64> fence_escapes{};
+    /// Caught reads on threads that are not guest cores: they keep the shortcut (old path).
+    std::atomic<u64> service_reads{};
+    std::atomic<u64> verify_changed{};
+    std::atomic<u64> verify_bytes{};
+    /// VERIFY: reads whose own bytes [addr, addr + size) changed (verify_changed counts the
+    /// read's 4 KiB window, which also holds bytes the read did not ask for).
+    std::atomic<u64> verify_read_changed{};
+    std::atomic<u64> last_changed_addr{};
+    std::atomic<u64> last_changed_present{};
+    /// Full lines logged in the current 10 s window (VERIFY).
+    std::atomic<u32> verify_lines{};
+};
+inline Counters g_counters;
+
+/// EDEN_UP_AHEAD_READ_SYNC_VERIFY=1 (exact "1"), read once. Asked only after the live switch is
+/// seen on, so the function-static check stays off the switch-off path.
+[[nodiscard]] inline bool VerifyEnabled() {
+    static const bool enabled = Common::PeSwitch("EDEN_UP_AHEAD_READ_SYNC_VERIFY");
+    return enabled;
+}
+
+[[nodiscard]] inline s64 NowNs() {
+    return std::chrono::duration_cast<std::chrono::nanoseconds>(
+               std::chrono::steady_clock::now().time_since_epoch())
+        .count();
+}
+
+inline void Max(std::atomic<u64>& value, u64 candidate) {
+    u64 current = value.load(std::memory_order_relaxed);
+    while (candidate > current &&
+           !value.compare_exchange_weak(current, candidate, std::memory_order_relaxed)) {
+    }
+}
+
+/// The 10 s line, from the present thread (while on) and from any thread that synced; only the
+/// thread that wins the window logs.
+inline void MaybeReport() {
+    static std::atomic<s64> last_report{0};
+    const s64 now = NowNs();
+    s64 last = last_report.load(std::memory_order_relaxed);
+    if (last == 0) {
+        last_report.compare_exchange_strong(last, now, std::memory_order_relaxed);
+        return;
+    }
+    if (now - last < 10'000'000'000LL ||
+        !last_report.compare_exchange_strong(last, now, std::memory_order_relaxed)) {
+        return;
+    }
+    auto& c = g_counters;
+    const u64 lookups = c.lookups_ahead.exchange(0, std::memory_order_relaxed);
+    const u64 syncs = c.syncs.exchange(0, std::memory_order_relaxed);
+    const u64 sync_ns = c.sync_ns.exchange(0, std::memory_order_relaxed);
+    const u64 max_ns = c.max_sync_ns.exchange(0, std::memory_order_relaxed);
+    const u64 waits = c.fence_waits.exchange(0, std::memory_order_relaxed);
+    const u64 timeouts = c.fence_timeouts.exchange(0, std::memory_order_relaxed);
+    const u64 escapes = c.fence_escapes.exchange(0, std::memory_order_relaxed);
+    const u64 service = c.service_reads.exchange(0, std::memory_order_relaxed);
+    const u64 read_changed = c.verify_read_changed.exchange(0, std::memory_order_relaxed);
+    const u64 changed = c.verify_changed.exchange(0, std::memory_order_relaxed);
+    const u64 changed_bytes = c.verify_bytes.exchange(0, std::memory_order_relaxed);
+    const u64 presents = c.presents_ahead.exchange(0, std::memory_order_relaxed);
+    c.verify_lines.store(0, std::memory_order_relaxed);
+    LOG_INFO(HW_GPU,
+             "Ahead read sync: ahead lookups {} syncs {} avg {} us max {} us fence waits {} "
+             "(timeouts {}, escapes {}) service reads {} changed {} (in read {}, {} B, last "
+             "{:#x} at p{}) presents ahead {}",
+             lookups, syncs, syncs != 0 ? sync_ns / syncs / 1000 : 0, max_ns / 1000, waits,
+             timeouts, escapes, service, changed, read_changed, changed_bytes,
+             c.last_changed_addr.load(std::memory_order_relaxed),
+             c.last_changed_present.load(std::memory_order_relaxed), presents);
+}
+
+} // namespace VideoCommon::AheadReadSync
