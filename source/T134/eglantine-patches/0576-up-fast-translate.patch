+    /// EDEN_UP_FAST_TRANSLATE (Djihads80 398dfbc1d): Sirit deduplicates constants, but by hashing
+    /// a freshly allocated copy of their words on every call; immediates are emitted over and
+    /// over, so the ids of scalar constants are remembered. Keys are bit patterns, like Sirit's
+    /// (0.0f and -0.0f, and NaN payloads, stay distinct). _VERIFY asks Sirit on every call, as
+    /// before, counts the remembered ids that differ from Sirit's and returns Sirit's.
+    template <typename T>
+    Id CachedConstant(::Common::unordered_map<u32, Id>& cache, Id type, T value) {
+        const auto [it, is_new]{cache.try_emplace(std::bit_cast<u32>(value))};
