+++ b/src/shader_recompiler/fast_translate.h
@@ -0,0 +1,147 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+// EDEN_UP_FAST_TRANSLATE=1 (default off): three shader translation speed-ups by Djihads80
+// (Djihads80/Eglantine#825; e4197fb88, 398dfbc1d, 87b0f018a), as zortos293/Lichii#1320
+// (StiensWout) carries them:
+//   - the SSA pass keeps the definitions of predicates, flags and the indirect branch variable in
+//     the blocks, like registers, instead of one node map per variable (ssa_rewrite_pass.cpp);
+//   - SPIR-V emission remembers the ids of scalar u32 and f32 constants (spirv_emit_context.h);
+//   - storage buffer tracking does not walk again what a failed search already walked
+//     (global_memory_to_storage_buffer_pass.cpp, BreadthFirstSearchPruned).
+// The SPIR-V is the same; only the time to make it changes.
+//
+// EDEN_UP_FAST_TRANSLATE_VERIFY=1: every translation runs both ways in lockstep and keeps the old
+// answer: each definition read, storage buffer search and constant id of the new way is compared
+// with the old way's, and the programs where any of them differs are counted. Logged every 10 s
+// while translating and at the end of shader preparation.
+//
+// The switches are read once per pass call (one program); the hot paths test a copy of the mode
+// held by the pass's own state. Every count is local to the translating thread until the pass
+// ends, then added here with relaxed atomics.
+
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstddef>
+#include <string_view>
+
+#include "common/common_types.h"
+#include "common/logging.h"
+#include "common/pe_switch.h"
+
+namespace Shader::FastTranslate {
+
+enum class Mode : u8 {
+    Off,    ///< the translation as before
+    Fast,   ///< EDEN_UP_FAST_TRANSLATE=1: the new way
+    Verify, ///< EDEN_UP_FAST_TRANSLATE_VERIFY=1: both ways, the old answer is used
+};
+
+/// Read once per process; callers copy it into their pass state.
+[[nodiscard]] inline Mode CurrentMode() noexcept {
+    static const Mode mode = Common::PeSwitch("EDEN_UP_FAST_TRANSLATE_VERIFY") ? Mode::Verify
+                             : Common::PeSwitch("EDEN_UP_FAST_TRANSLATE")      ? Mode::Fast
+                                                                               : Mode::Off;
+    return mode;
+}
+
+enum class Part : size_t {
+    Ssa,       ///< work: definitions kept in blocks; checks: definition reads
+    Storage,   ///< work: instructions a search skipped; checks: searches
+    Constants, ///< work: ids answered from the cache; checks: constant lookups
+};
+inline constexpr size_t NumParts = 3;
+
+/// What one pass call counted (owned by the translating thread).
+struct PassCounts {
+    Mode mode{Mode::Off};
+    u64 work{};
+    u64 checks{};
+    u64 mismatches{};
+};
+
+struct PartTotals {
+    std::atomic<u64> programs{};
+    std::atomic<u64> work{};
+    std::atomic<u64> compared{};
+    std::atomic<u64> differ{};
+    std::atomic<u64> checks{};
+    std::atomic<u64> mismatches{};
+};
+
+inline std::array<PartTotals, NumParts> totals{};
+inline std::atomic<s64> next_log_ns{};
+
+inline void Log(std::string_view when) noexcept {
+    try {
+        const PartTotals& ssa = totals[static_cast<size_t>(Part::Ssa)];
+        const PartTotals& storage = totals[static_cast<size_t>(Part::Storage)];
+        const PartTotals& constants = totals[static_cast<size_t>(Part::Constants)];
+        LOG_INFO(Shader,
+                 "Fast translate {}: ssa {} programs, {} definitions kept in blocks; storage "
+                 "buffers {} programs, {} instructions not walked again; constants {} programs, "
+                 "{} ids from the cache",
+                 when, ssa.programs.load(std::memory_order_relaxed),
+                 ssa.work.load(std::memory_order_relaxed),
+                 storage.programs.load(std::memory_order_relaxed),
+                 storage.work.load(std::memory_order_relaxed),
+                 constants.programs.load(std::memory_order_relaxed),
+                 constants.work.load(std::memory_order_relaxed));
+        if (CurrentMode() != Mode::Verify) {
+            return;
+        }
+        LOG_INFO(Shader,
+                 "Fast translate verify {}: ssa {} programs compared, {} differ ({} of {} reads); "
+                 "storage buffers {} compared, {} differ ({} of {} searches); constants {} "
+                 "compared, {} differ ({} of {} lookups)",
+                 when, ssa.compared.load(std::memory_order_relaxed),
+                 ssa.differ.load(std::memory_order_relaxed),
+                 ssa.mismatches.load(std::memory_order_relaxed),
+                 ssa.checks.load(std::memory_order_relaxed),
+                 storage.compared.load(std::memory_order_relaxed),
+                 storage.differ.load(std::memory_order_relaxed),
+                 storage.mismatches.load(std::memory_order_relaxed),
+                 storage.checks.load(std::memory_order_relaxed),
+                 constants.compared.load(std::memory_order_relaxed),
+                 constants.differ.load(std::memory_order_relaxed),
+                 constants.mismatches.load(std::memory_order_relaxed),
+                 constants.checks.load(std::memory_order_relaxed));
+    } catch (...) {
+        // A log line that cannot be formatted is not worth a translation.
+    }
+}
+
+/// Adds what one pass call counted; at most one thread logs, every 10 s. Only called with the
+/// mode not Off.
+inline void Note(Part part, const PassCounts& counts) noexcept {
+    auto& total = totals[static_cast<size_t>(part)];
+    total.programs.fetch_add(1, std::memory_order_relaxed);
+    total.work.fetch_add(counts.work, std::memory_order_relaxed);
+    if (counts.mode == Mode::Verify) {
+        total.compared.fetch_add(1, std::memory_order_relaxed);
+        total.checks.fetch_add(counts.checks, std::memory_order_relaxed);
+        total.mismatches.fetch_add(counts.mismatches, std::memory_order_relaxed);
+        if (counts.mismatches != 0) {
+            total.differ.fetch_add(1, std::memory_order_relaxed);
+        }
+    }
+    constexpr s64 every_ns = 10'000'000'000;
+    const s64 now = std::chrono::duration_cast<std::chrono::nanoseconds>(
+                        std::chrono::steady_clock::now().time_since_epoch())
+                        .count();
+    s64 next = next_log_ns.load(std::memory_order_relaxed);
+    if (next == 0) {
+        next_log_ns.compare_exchange_strong(next, now + every_ns, std::memory_order_relaxed);
+        return;
+    }
+    if (now < next ||
+        !next_log_ns.compare_exchange_strong(next, now + every_ns, std::memory_order_relaxed)) {
+        return;
+    }
+    Log("every 10 s");
+}
+
+} // namespace Shader::FastTranslate
