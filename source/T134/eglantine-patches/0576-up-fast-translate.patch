+/// EDEN_UP_FAST_TRANSLATE (Djihads80 87b0f018a): BreadthFirstSearch for many searches with the
+/// same predicate and resolver over IR that does not change. `exhausted` holds instructions from
+/// which nothing reachable matches: a failed search adds every instruction it visited, and later
+/// searches resolve those to an immediate and skip them. The result is BreadthFirstSearch's: what
+/// a skipped instruction reaches is exhausted too, so every instruction that can still lead to a
+/// match is queued by the same instruction in the same order. `skipped` counts the skips.
+template <typename Pred, typename Resolve = std::identity>
+auto BreadthFirstSearchPruned(Value value, Pred&& pred, std::unordered_set<const Inst*>& exhausted,
+                              u64& skipped, Resolve&& resolve = {})
+    -> std::invoke_result_t<Pred, const Inst*> {
+    std::vector<const Inst*> visited;
+    const auto result{BreadthFirstSearch(
+        value,
+        [&](const Inst* inst) {
+            visited.push_back(inst);
+            return pred(inst);
+        },
+        [&](const Value& operand) {
+            const Value resolved{resolve(operand)};
+            if (!resolved.IsImmediate() && exhausted.contains(resolved.InstRecursive())) {
+                ++skipped;
+                return Value{u32{0}};
+            }
+            return resolved;
+        })};
+    if (!result) {
+        exhausted.insert(visited.begin(), visited.end());
+    }
+    return result;
+}
+
 } // namespace Shader::IR
