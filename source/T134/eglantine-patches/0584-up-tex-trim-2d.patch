+
+// EDEN_UP_TEX_TRIM_2D=<N> (pablotz, NotRexed/Hookshot e460da1dd5 "perf(vk): reduce ASTC memory
+// pressure on small VRAM budgets", #1009, GPL-3.0): a single 2D ASTC texture (one layer, one
+// sample) wider or taller than EDEN_UP_TEX_TRIM_2D_DIM texels (unset: 1024) whose decoded RGBA8
+// copy, every level, is over EDEN_UP_TEX_TRIM_2D_MIB (unset: 8) leaves out its top mip level, and
+// the next while both still hold, at most N levels. Their numbers: a 3072x3072 texture with all
+// its levels is about 48 MiB decoded, under the 64 MiB the old rule waited for. Here such a
+// texture is 12 MiB as BC3 and 6 as BC1 on the host, plus a 48 MiB decode image while the GPU
+// transcodes it; with one level left out 3 / 1.5 and 12. The same TrimmedLevels path as the
+// arrays above (views, uploads, the GPU transcode below); a shader that asks for a level by
+// number, or for the texture's size, gets the smaller one. Their rule only acted on a small
+// driver budget and their lowest preset; ours has no such signal, so it is the switch alone.
+// Unset or 0: off, nothing below runs past one test of a static. EDEN_UP_TEX_TRIM_2D_CHECK=1:
+// nothing is trimmed, the counter line says what would have been.
+struct Trim2dConfig {
+    u32 levels;  ///< 0: off.
+    u32 dim;     ///< Only while the kept top level is wider or taller than this.
+    u64 bytes;   ///< Only while the kept levels are over this as RGBA8.
+    bool check;  ///< Count only.
+};
+[[nodiscard]] const Trim2dConfig& Trim2d() {
+    static const Trim2dConfig config = [] {
+        Trim2dConfig c{0, 1024, u64{8} << 20, false};
+        const char* const value = std::getenv("EDEN_UP_TEX_TRIM_2D");
+        if (value == nullptr) {
+            return c;
+        }
+        c.levels = static_cast<u32>(std::strtoul(value, nullptr, 10));
+        if (c.levels == 0) {
+            return c;
+        }
+        if (const char* const dim = std::getenv("EDEN_UP_TEX_TRIM_2D_DIM")) {
+            c.dim = static_cast<u32>(std::strtoul(dim, nullptr, 10));
+        }
+        if (const char* const mib = std::getenv("EDEN_UP_TEX_TRIM_2D_MIB")) {
+            c.bytes = std::strtoull(mib, nullptr, 10) << 20;
+        }
+        const char* const check = std::getenv("EDEN_UP_TEX_TRIM_2D_CHECK");
+        c.check = check != nullptr && check[0] == '1';
+        LOG_INFO(Render_Vulkan,
+                 "EDEN_UP_TEX_TRIM_2D={}: single 2D ASTC over {} texels and {} MiB decoded lose up "
+                 "to {} top levels{}",
+                 c.levels, c.dim, c.bytes >> 20, c.levels, c.check ? " (check: counted only)" : "");
+        return c;
+    }();
+    return config;
+}
+// How many top levels EDEN_UP_TEX_TRIM_2D leaves out of `info`, given `from` already left out by
+// the rules above (it acts only on an image they left whole).
+[[nodiscard]] u32 Trim2dLevels(const ImageInfo& info, u32 from) {
+    const Trim2dConfig& c = Trim2d();
+    if (c.levels == 0 || from != 0 || !IsPixelFormatASTC(info.format) ||
+        info.type != ImageType::e2D || info.size.depth != 1 || info.num_samples != 1 ||
+        info.resources.layers != 1 || info.resources.levels < 2) {
+        return 0;
+    }
+    const auto decoded = [&](u32 skip) {
+        u64 bytes = 0;
+        for (s32 level = static_cast<s32>(skip); level < info.resources.levels; ++level) {
+            bytes += u64{(std::max)(info.size.width >> level, 1U)} *
+                     (std::max)(info.size.height >> level, 1U) * 4;
+        }
+        return bytes;
+    };
+    u32 skip = 0;
+    while (skip < c.levels && skip + 1 < static_cast<u32>(info.resources.levels) &&
+           decoded(skip) > c.bytes &&
+           ((std::max)(info.size.width, info.size.height) >> skip) > c.dim) {
+        ++skip;
+    }
+    return skip;
+}
