index a6d34ea..66c6928 100644
--- a/src/video_core/renderer_vulkan/vk_texture_cache.h
+++ b/src/video_core/renderer_vulkan/vk_texture_cache.h
@@ -504,6 +504,36 @@ private:
     mutable u32 num_memoized_variants{};
 };
 
+/// EDEN_UP_TEX_TRIM_2D: takes an image's saved host bytes off the counter's "held" total.
+void ReleaseTrim2dBytes(u64 bytes) noexcept;
+
+/// EDEN_UP_TEX_TRIM_2D: the host bytes the switch left out of one image (or would have, check),
+/// taken off the "held" total when the image goes. A move hands them over (SlotVector moves
+/// images when it grows), so each image's bytes leave the total once. Always 0 with the switch
+/// off, and then nothing is called.
+struct Trim2dHeld {
+    Trim2dHeld() = default;
+    Trim2dHeld(const Trim2dHeld&) = delete;
+    Trim2dHeld& operator=(const Trim2dHeld&) = delete;
+    Trim2dHeld(Trim2dHeld&& other) noexcept : bytes{std::exchange(other.bytes, 0)} {}
+    Trim2dHeld& operator=(Trim2dHeld&& other) noexcept {
+        if (this != &other) {
+            Release();
+            bytes = std::exchange(other.bytes, 0);
+        }
+        return *this;
+    }
+    ~Trim2dHeld() {
+        Release();
+    }
+    void Release() noexcept {
+        if (bytes != 0) {
+            ReleaseTrim2dBytes(std::exchange(bytes, u64{0}));
+        }
+    }
+    u64 bytes{};
+};
