 // The host bytes of `info`'s levels from `skip` on, as the host keeps them: ASTC as BC1 or BC3
 // (RGBA8 when not re-compressed), another format at its own size.
 [[nodiscard]] u64 HostBytesFromLevel(const ImageInfo& info, u32 skip) {
@@ -625,6 +698,78 @@ constexpr std::array<VkFormat, 2> OpaqueAstcViewFormats{VK_FORMAT_BC1_RGBA_UNORM
     return texels * static_cast<u64>(info.resources.layers) * numerator / denominator;
 }
 
+// EDEN_UP_TEX_TRIM_2D's counter. Per line: images made since the last line that it left levels
+// out of, or would have (check), the host bytes that saved at their creation, the decode-image
+// bytes that saved, and the largest such texture. Held: the host bytes saved by the images that
+// still exist (each image keeps its own number in Image::trim_2d_held and takes it off again when
+// it is destroyed), and the highest that has been since boot. Held, not made, is what a test can
+// set against the census: the collector deletes and remakes the same textures all the time.
+struct Trim2dStats {
+    std::atomic<u64> images{0}, host_saved{0}, decode_saved{0}, largest{0};
+    std::atomic<u64> held{0}, peak{0};
+};
+Trim2dStats trim_2d_stats;
+// The host bytes `info` keeps out (or would, check) for the caller to store in the image; 0 with
+// the switch off, for an unbacked image (it holds no memory yet) and for an image left whole.
+[[nodiscard]] u64 NoteTrim2d(const ImageInfo& info, u32 host_level_offset, bool unbacked) {
+    const Trim2dConfig& c = Trim2d();
+    if (c.levels == 0 || unbacked) {
+        return 0;
+    }
+    // Applied: the image's own offset (on one layer only this rule trims, unless
+    // EDEN_NX2_TEX_TRIM_LAYERS=1 is also set). Check: what the rule would have left out.
+    const u32 skip = c.check ? Trim2dLevels(info, host_level_offset)
+                             : (info.resources.layers == 1 && IsPixelFormatASTC(info.format)
+                                    ? host_level_offset
+                                    : 0U);
+    if (skip == 0) {
+        return 0;
+    }
+    u64 decoded_before = 0, decoded_after = 0;
+    for (s32 level = 0; level < info.resources.levels; ++level) {
+        const u64 bytes = u64{(std::max)(info.size.width >> level, 1U)} *
+                          (std::max)(info.size.height >> level, 1U) * 4;
+        decoded_before += bytes;
+        decoded_after += level >= static_cast<s32>(skip) ? bytes : 0;
+    }
+    const u64 host_saved = HostBytesFromLevel(info, 0) - HostBytesFromLevel(info, skip);
+    trim_2d_stats.images.fetch_add(1, std::memory_order_relaxed);
+    trim_2d_stats.host_saved.fetch_add(host_saved, std::memory_order_relaxed);
+    trim_2d_stats.decode_saved.fetch_add(decoded_before - decoded_after, std::memory_order_relaxed);
+    const u64 held =
+        trim_2d_stats.held.fetch_add(host_saved, std::memory_order_relaxed) + host_saved;
+    u64 peak = trim_2d_stats.peak.load(std::memory_order_relaxed);
+    while (held > peak &&
+           !trim_2d_stats.peak.compare_exchange_weak(peak, held, std::memory_order_relaxed)) {
+    }
+    const u64 side = (std::max)(info.size.width, info.size.height);
+    u64 largest = trim_2d_stats.largest.load(std::memory_order_relaxed);
+    while (side > largest &&
+           !trim_2d_stats.largest.compare_exchange_weak(largest, side, std::memory_order_relaxed)) {
+    }
+    return host_saved;
+}
+// Once every 10 s from TickFrame while the switch is on.
+void LogTrim2d() {
+    const Trim2dConfig& c = Trim2d();
+    if (c.levels == 0) {
+        return;
+    }
+    static auto last = std::chrono::steady_clock::now();
+    const auto now = std::chrono::steady_clock::now();
+    if (now - last < std::chrono::seconds(10)) {
+        return;
+    }
+    last = now;
+    LOG_INFO(Render_Vulkan,
+             "EDEN_UP_TEX_TRIM_2D 10s: mode {}, images {}, host saved {} MiB, held {} MiB (peak "
+             "{}), decode image saved {} MiB, largest side {}",
+             c.check ? "check" : "apply", trim_2d_stats.images.exchange(0),
+             trim_2d_stats.host_saved.exchange(0) >> 20, trim_2d_stats.held.load() >> 20,
+             trim_2d_stats.peak.load() >> 20, trim_2d_stats.decode_saved.exchange(0) >> 20,
+             trim_2d_stats.largest.exchange(0));
+}
