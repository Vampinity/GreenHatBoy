new file mode 100644
index 0000000..3e5fde9
--- /dev/null
+++ b/src/common/frame_wait_progress.h
@@ -0,0 +1,88 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <algorithm>
+#include <atomic>
+#include <cstdlib>
+
+#include "common/common_types.h"
+
+/// EDEN_UP_FRAME_WAIT_PROGRESS (read once): what a present does when the GPU threads have not
+/// reached its fence after the old 4 s (core/hle/service/nx2_gsv.h, WaitForFrame).
+///
+/// Why: on a first start (empty caches) the first 3D scene after the opening needs ~25 s on the
+/// GPU threads (173 pipelines, 95 shaders, a 6144x6144 texture). The present gave up after 4 s
+/// three times, the game ran ~25 fence steps ahead and rewrote command memory the GPU threads had
+/// not read yet; the re-read lists were junk and one junk draw crashed (12 Nov, run1233). The
+/// warm start of the same route waited once and went on.
+///
+/// Values: unset or 0 = off (the 4 s give-up as before, nothing sampled). 1 = count only: the
+/// waits still end at 4 s, and each says whether it would have gone on. 2 = act with a 30 s cap.
+/// 5 to 300 = act with that cap in seconds (3 and 4 also mean 30: a cap at or under 4 s would
+/// change nothing). Acting: past 4 s the wait goes on while the GPU side shows progress (below)
+/// within the last EDEN_UP_FRAME_WAIT_PROGRESS_IDLE_MS (default 8000, 500 to 60000; run1233's
+/// quiet stretches in the log reach ~4.4 s, so 5 s left too thin a margin), and ends at
+/// the fence, at the cap counted from the wait's start, at no progress for that long, or when the
+/// emulation stops. A wait that saw no progress at all still ends at 4 s.
+///
+/// Progress is any of: the waited syncpoint moved, the split's back consumed more of its ring
+/// (GpuSplit::ConsumedNow), or a beat below. Beats come from work that finishes on other threads
+/// while the back may be blocked: a pipeline build (builders and the GPU thread), a submission
+/// reached by the Vulkan worker, a texture decode finished on the decode thread.
+namespace Common::FrameWaitProgress {
+
+/// The value used when the switch is unset. Making it default on is this one line (30).
+inline constexpr long UnsetValue = 0;
+
+struct Config {
+    int mode{};        ///< 0 off, 1 count only, 2 act
+    long cap_s{};      ///< total wait limit, from the wait's start
+    long idle_ms{};    ///< no progress for this long ends a wait past 4 s
+    long raw{};        ///< the value as given, for the start line
+};
+
+[[nodiscard]] inline long ReadLong(const char* name, long fallback) {
+    const char* const value = std::getenv(name);
+    if (value == nullptr || value[0] == '\0') {
+        return fallback;
+    }
+    return std::strtol(value, nullptr, 10);
+}
+
+/// A function-local static: env.txt is read in main, after the globals.
+[[nodiscard]] inline const Config& Get() {
+    static const Config config = [] {
+        Config c{};
+        c.raw = ReadLong("EDEN_UP_FRAME_WAIT_PROGRESS", UnsetValue);
+        if (c.raw <= 0) {
+            c.mode = 0;
+        } else if (c.raw == 1) {
+            c.mode = 1;
+            c.cap_s = 30;
+        } else {
+            c.mode = 2;
+            c.cap_s = c.raw < 5 ? 30 : (std::min)(c.raw, 300L);
+        }
+        c.idle_ms =
+            (std::clamp)(ReadLong("EDEN_UP_FRAME_WAIT_PROGRESS_IDLE_MS", 8000L), 500L, 60000L);
+        return c;
+    }();
+    return config;
+}
+
+[[nodiscard]] inline bool On() {
+    return Get().mode != 0;
+}
+
+/// Work finished on the GPU side, counted only with the switch on. Any thread.
+inline std::atomic<u64> g_beats{};
+
+inline void Beat() {
+    if (On()) {
+        g_beats.fetch_add(1, std::memory_order_relaxed);
+    }
+}
+
+} // namespace Common::FrameWaitProgress
