+    /// EDEN_UP_FRAME_WAIT_PROGRESS: the values a wait starts from.
+    void StartWaitProgress(WaitProgress& progress, u32 fence_id,
+                           std::chrono::steady_clock::time_point now) {
+        progress.fence = system.Host1x().GetSyncpointManager().GetGuestSyncpointValue(fence_id);
+        progress.consumed = VideoCommon::GpuSplit::Get().ConsumedNow();
+        progress.beats = Common::FrameWaitProgress::g_beats.load(std::memory_order_relaxed);
+        progress.fence_start = progress.fence;
+        progress.consumed_start = progress.consumed;
+        progress.beats_start = progress.beats;
+        progress.moved = false;
+        progress.last_move = now;
+    }
+
+    /// EDEN_UP_FRAME_WAIT_PROGRESS: notes whether anything on the GPU side moved since the last look.
+    void SampleWaitProgress(WaitProgress& progress, u32 fence_id,
+                            std::chrono::steady_clock::time_point now) {
+        const u32 fence =
+            system.Host1x().GetSyncpointManager().GetGuestSyncpointValue(fence_id);
+        const u64 consumed = VideoCommon::GpuSplit::Get().ConsumedNow();
+        const u64 beats = Common::FrameWaitProgress::g_beats.load(std::memory_order_relaxed);
+        if (fence != progress.fence || consumed != progress.consumed || beats != progress.beats) {
+            progress.fence = fence;
+            progress.consumed = consumed;
+            progress.beats = beats;
+            progress.moved = true;
+            progress.last_move = now;
+        }
+    }
+
+    /// EDEN_UP_FRAME_WAIT_PROGRESS: the 4 s are over and the fence is not reached. With no
+    /// progress in the last idle window (or none at all) the wait ends as before. =1 only says it
+    /// would go on. =2 goes on in 2 ms guest sleeps, which leave this guest core to the game's
+    /// other threads (a host wait held it, see PaceToVblank), until the fence, no progress for
+    /// the idle window, the cap from the wait's start, or the emulation stopping.
+    void WaitPastDeadline(u32 fence_id, u32 fence_value,
+                          std::chrono::steady_clock::time_point start, WaitProgress& progress) {
+        using Clock = std::chrono::steady_clock;
+        const auto& config = Common::FrameWaitProgress::Get();
+        const auto idle = std::chrono::milliseconds{config.idle_ms};
+        auto& syncpoints = system.Host1x().GetSyncpointManager();
+        auto now = Clock::now();
+        SampleWaitProgress(progress, fence_id, now);
+        auto& stats = m_wait_progress;
+        ++stats.past_4s;
+        const auto since_move = [&] {
+            return std::chrono::duration_cast<std::chrono::milliseconds>(now - progress.last_move)
+                .count();
+        };
+        const auto moves = [&] {
+            return fmt::format(
+                "fence +{}, back +{} words, {} finished jobs",
+                progress.fence - progress.fence_start, progress.consumed - progress.consumed_start,
+                progress.beats - progress.beats_start);
+        };
+        if (!progress.moved || now - progress.last_move >= idle) {
+            ++stats.still_idle;
+            return;
+        }
+        if (config.mode == 1) {
+            ++stats.would_wait;
+            if (m_wait_progress_lines++ < 256) {
+                LOG_INFO(Service,
+                         "EDEN_UP_FRAME_WAIT_PROGRESS=1: present #{} fence ({}, {}) not reached in "
+                         "4 s (now {}); it would keep waiting: the GPU side moved {} ms ago ({})",
+                         m_presents, fence_id, fence_value, progress.fence, since_move(), moves());
+            }
+            return;
+        }
+        ++stats.kept;
+        const bool log_this = m_wait_progress_lines++ < 256;
+        if (log_this) {
+            LOG_INFO(Service,
+                     "EDEN_UP_FRAME_WAIT_PROGRESS: present #{} fence ({}, {}) not reached in 4 s "
+                     "(now {}); the GPU side moved {} ms ago ({}): waiting on, up to {} s in all",
+                     m_presents, fence_id, fence_value, progress.fence, since_move(), moves(),
+                     config.cap_s);
+        }
+        const auto cap = start + std::chrono::seconds{config.cap_s};
+        const char* end = "the fence was reached";
+        // Whether a GPU channel sat on a semaphore during the extra wait: one only the game
+        // releases after this present returns cannot be helped by waiting (the doubt the cold
+        // test must answer), so the end line says so.
+        bool channel_waited = system.GPU().HasSuspendedChannels();
+        for (;;) {
+            channel_waited |= system.GPU().HasSuspendedChannels();
+            if (syncpoints.IsReadyGuest(fence_id, fence_value)) {
+                ++stats.reached;
+                break;
+            }
+            if (!system.IsPoweredOn()) {
+                end = "the emulation is stopping";
+                ++stats.stopped;
+                break;
+            }
+            now = Clock::now();
+            SampleWaitProgress(progress, fence_id, now);
+            if (now >= cap) {
+                end = "the cap";
+                ++stats.capped;
+                break;
+            }
+            if (now - progress.last_move >= idle) {
+                end = "no progress for the idle window";
+                ++stats.idled;
+                break;
+            }
+            // A guest sleep, as PaceToVblank's: a host wait would hold this guest core.
+            constexpr s64 SliceNs = 2'000'000;
+            const auto slept_from = Clock::now();
+            if (Kernel::GetCurrentThread(kernel)
+                    .Sleep(kernel, kernel.HardwareTimer().GetTick() + SliceNs)
+                    .IsError() ||
+                Clock::now() - slept_from < std::chrono::microseconds{500}) {
+                // Termination asked, or the guest sleep returned at once (a host thread in
+                // single-core mode does not block in it): a short host sleep keeps this a wait,
+                // not a 30 s spin.
+                std::this_thread::sleep_for(std::chrono::milliseconds{2});
+            }
+        }
+        now = Clock::now();
+        const long long waited_ms =
+            std::chrono::duration_cast<std::chrono::milliseconds>(now - start).count();
+        stats.longest_ms = (std::max)(stats.longest_ms, waited_ms);
+        if (log_this) {
+            LOG_INFO(Service,
+                     "EDEN_UP_FRAME_WAIT_PROGRESS: present #{} fence ({}, {}) wait ended after {} "
+                     "ms: {} (now {}; {}; a GPU channel {} on a semaphore during it)",
+                     m_presents, fence_id, fence_value, waited_ms, end,
+                     syncpoints.GetGuestSyncpointValue(fence_id), moves(),
+                     channel_waited ? "waited" : "never waited");
+        }
+    }
+
+    /// EDEN_UP_FRAME_WAIT_PROGRESS: a start line, then a line per 10 s (written by the next wait
+    /// after the 10 s, so a long wait's line comes after it).
+    void ReportWaitProgress(std::chrono::steady_clock::time_point now) {
+        auto& stats = m_wait_progress;
+        const auto& config = Common::FrameWaitProgress::Get();
+        if (stats.window_start == std::chrono::steady_clock::time_point{}) {
+            stats.window_start = now;
+            LOG_INFO(Service,
+                     "EDEN_UP_FRAME_WAIT_PROGRESS={}: a present wait past 4 s {} while the GPU "
+                     "side moves (no move for {} ms ends it), at most {} s in all",
+                     config.raw, config.mode == 1 ? "is only counted as going on" : "goes on",
+                     config.idle_ms, config.cap_s);
+            return;
+        }
+        if (now - stats.window_start < std::chrono::seconds{10}) {
+            return;
+        }
+        LOG_INFO(Service,
+                 "EDEN_UP_FRAME_WAIT_PROGRESS: last {} s: {} present waits passed 4 s; {} with no "
+                 "progress ended as before, {} would have gone on, {} went on ({} reached the "
+                 "fence, {} ended by no progress, {} by the {} s cap, {} by the emulation "
+                 "stopping); longest {} ms",
+                 std::chrono::duration_cast<std::chrono::seconds>(now - stats.window_start).count(),
+                 stats.past_4s, stats.still_idle, stats.would_wait, stats.kept, stats.reached,
+                 stats.idled, stats.capped, config.cap_s, stats.stopped, stats.longest_ms);
+        stats = {.window_start = now};
+    }
+
     // Shows a presented native image: word 5 is the image id, ~word 22 / word 24 the GPU fence
     // (syncpoint, value) to wait for (layout from changes.patch). The image is a block-linear
     // RGBA8 surface in the console's native GOB layout at GPU address == CPU address.
