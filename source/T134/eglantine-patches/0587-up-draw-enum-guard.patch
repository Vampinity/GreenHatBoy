 namespace Tegra::Engines {
 
+namespace {
+namespace EnumGuard = VideoCommon::DrawEnumGuard;
+
+/// EDEN_UP_DRAW_ENUM_GUARD (draw_enum_guard.h): false when a draw must be skipped (mode 2 only).
+/// A shape type above 14 or an index format above 2 is not a value the GPU knows: the command
+/// stream is out of step and the draw's other registers are junk too, so it is not drawn as
+/// anything. The stored shape type is set to Triangles so the next reader sees a valid one.
+[[nodiscard]] bool GuardDrawEnums(Maxwell3D::Regs::PrimitiveTopology& topology, bool indexed,
+                                  Maxwell3D::Regs::IndexFormat format, EnumGuard::Site site) {
+    if (EnumGuard::Mode() == 0) {
+        return true;
+    }
+    EnumGuard::Tick();
+    bool run = true;
+    const u32 raw_topology = static_cast<u32>(topology);
+    if (raw_topology >= EnumGuard::TopologyCount &&
+        EnumGuard::Bad(site, raw_topology,
+                       "draw skipped, stored shape type set to Triangles")) {
+        topology = Maxwell3D::Regs::PrimitiveTopology::Triangles;
+        run = false;
+    }
+    const u32 raw_format = static_cast<u32>(format);
+    if (indexed && raw_format >= EnumGuard::IndexFormatCount &&
+        EnumGuard::Bad(EnumGuard::Site::IndexFormatDraw, raw_format, "draw skipped")) {
+        run = false;
+    }
+    if (!run) {
+        EnumGuard::Skipped();
+    }
+    return run;
+}
+} // Anonymous namespace
