--- /dev/null
+++ b/src/video_core/draw_enum_guard.h
@@ -0,0 +1,211 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstdlib>
+
+#include "common/common_types.h"
+#include "common/logging.h"
+
+/// EDEN_UP_DRAW_ENUM_GUARD: range checks on draw values the game's command stream sets and the
+/// renderer uses as a table index, or that reach an abort, with no check of their own.
+///
+/// Why: on a first start (empty caches) Ocarina's first 3D scene after the opening stalled the
+/// GPU thread about 25 s, the game ran ahead, and the command lists read again at resume held a
+/// later frame's words (first-start crash, 12 Nov 2026). One junk draw begin carried the shape
+/// type (primitive topology) 3734 where only 0-14 exist, and a texture draw after it read
+/// RasterizerVulkan::UpdateDepthBiasEnable's 15-entry table at index 3734: SIGSEGV. This is a
+/// safety net for that last step only; it does not stop the junk.
+///
+///   unset / =0  off: the old code runs (same behaviour, not the same bytes: the table reads gain
+///               one compare that is always true on a valid stream).
+///   =1          count only: every out-of-range value is counted and logged, nothing changes
+///               (so a table read still reads outside the table, as before).
+///   =2          act:
+///               - a draw (direct or indirect) whose shape type is above 14, or whose index
+///                 format is above 2, is skipped; a bad stored shape type is set to Triangles so
+///                 later readers see a valid one;
+///               - a texture draw (which does not use the shape type, but whose state update reads
+///                 the one left by the last draw begin) sets a bad stored shape type to Triangles
+///                 and goes ahead;
+///               - a separate-state override (topology_override) above 14 (the Legacy 0x1001-0x101B
+///                 names and junk; upstream casts them unchanged and maps none) is ignored: the
+///                 draw begin's shape type is kept;
+///               - Regs::IndexBuffer::FormatSizeInBytes on a bad format returns 1 instead of
+///                 UNREACHABLE (abort); the draw itself is skipped as above;
+///               - the renderer's tables indexed by the shape type (depth bias enable, pipeline
+///                 topology class) and the packed cull face read the Triangles / Back entry.
+///
+/// Lines (LOG_INFO, HW_GPU, in eden_log.txt):
+///   at the first use:  "EDEN_UP_DRAW_ENUM_GUARD=<m>: ..."
+///   each time:         "EDEN_UP_DRAW_ENUM_GUARD #<n>: <site> = <value> (valid <range>): <what>"
+///                      (the first 200, then one "further lines left out" line)
+///   every 10 s:        "EDEN_UP_DRAW_ENUM_GUARD 10s: mode <m>, <d> draws seen; out of range since
+///                      boot: ...; draws skipped <s>, values replaced <r>"
+///
+/// Default flip for the alpha: DefaultMode below (one line, 0 -> 2). "=0" still turns it off.
+namespace VideoCommon::DrawEnumGuard {
+
+/// The mode when EDEN_UP_DRAW_ENUM_GUARD is unset. 0 now (new switch, off until tested).
+inline constexpr int DefaultMode = 0;
+
+inline constexpr u32 TopologyCount = 15;   ///< Maxwell PrimitiveTopology Points (0) .. Patches (14)
+inline constexpr u32 IndexFormatCount = 3; ///< UnsignedByte, UnsignedShort, UnsignedInt
+inline constexpr u32 TrianglesIndex = 4;   ///< PrimitiveTopology::Triangles
+inline constexpr u32 CullBackIndex = 1;    ///< FixedPipelineState's packed CullFace::Back
+inline constexpr u64 ActionLineCap = 200;
+
+enum class Site : u32 {
+    DrawTopology,
+    IndirectTopology,
+    TextureDrawTopology,
+    TopologyOverride,
+    IndexFormatDraw,
+    IndexFormatSize,
+    DepthBiasTable,
+    PipelineDepthBiasTable,
+    PipelineClassTable,
+    CullFaceUnpack,
+    Count,
+};
+
+inline constexpr size_t SiteCount = static_cast<size_t>(Site::Count);
+
+inline constexpr std::array<const char*, SiteCount> SiteNames{
+    "draw shape type",
+    "indirect draw shape type",
+    "texture draw stored shape type",
+    "shape type override",
+    "draw index format",
+    "index format size",
+    "depth bias table (dynamic)",
+    "depth bias table (pipeline)",
+    "pipeline shape class table",
+    "packed cull face",
+};
+
+inline constexpr std::array<const char*, SiteCount> SiteRanges{
+    "0-14", "0-14", "0-14", "0-14, Legacy 0x1001-0x101B not mapped", "0-2", "0-2",
+    "0-14", "0-14", "0-14", "0-2",
+};
+
+/// Read once, at the first use. Exact "0", "1" or "2"; anything else keeps DefaultMode.
+[[nodiscard]] inline int Mode() {
+    static const int mode = [] {
+        const char* value = std::getenv("EDEN_UP_DRAW_ENUM_GUARD");
+        int parsed = DefaultMode;
+        if (value != nullptr && value[0] >= '0' && value[0] <= '2' && value[1] == '\0') {
+            parsed = value[0] - '0';
+        } else if (value != nullptr) {
+            LOG_WARNING(HW_GPU, "EDEN_UP_DRAW_ENUM_GUARD={}: not 0, 1 or 2, using {}", value,
+                        DefaultMode);
+        }
+        if (parsed == 1) {
+            LOG_INFO(HW_GPU, "EDEN_UP_DRAW_ENUM_GUARD=1: out-of-range draw shape types and "
+                             "index formats are counted, nothing changed");
+        } else if (parsed == 2) {
+            LOG_INFO(HW_GPU,
+                     "EDEN_UP_DRAW_ENUM_GUARD=2: a draw with an out-of-range shape type or index "
+                     "format is skipped, table reads use the Triangles entry");
+        }
+        return parsed;
+    }();
+    return mode;
+}
+
+/// Relaxed atomics: the GPU thread adds; FormatSizeInBytes can also run on the split's front.
+struct Counters {
+    std::array<std::atomic<u64>, SiteCount> bad{};
+    std::atomic<u64> draws{};
+    std::atomic<u64> draws_skipped{};
+    std::atomic<u64> values_replaced{};
+    std::atomic<u64> lines{};
+    std::atomic<s64> last_line_ns{};
+};
+
+inline Counters g_counters;
+
+inline void Skipped() {
+    g_counters.draws_skipped.fetch_add(1, std::memory_order_relaxed);
+}
+
+inline void Replaced() {
+    g_counters.values_replaced.fetch_add(1, std::memory_order_relaxed);
+}
+
+/// An out-of-range `value` at `site`. Mode 0: does nothing, returns false (the caller keeps the
+/// old code). Mode 1: counts and logs, returns false. Mode 2: counts and logs `action`, returns
+/// true (the caller acts and calls Skipped() or Replaced()).
+inline bool Bad(Site site, u64 value, const char* action) {
+    const int mode = Mode();
+    if (mode == 0) {
+        return false;
+    }
+    const size_t index = static_cast<size_t>(site);
+    g_counters.bad[index].fetch_add(1, std::memory_order_relaxed);
+    const u64 line = g_counters.lines.fetch_add(1, std::memory_order_relaxed) + 1;
+    if (line <= ActionLineCap) {
+        LOG_INFO(HW_GPU, "EDEN_UP_DRAW_ENUM_GUARD #{}: {} = {} (0x{:x}, valid {}): {}", line,
+                 SiteNames[index], value, value, SiteRanges[index],
+                 mode == 2 ? action : "count only, nothing changed");
+    } else if (line == ActionLineCap + 1) {
+        LOG_INFO(HW_GPU, "EDEN_UP_DRAW_ENUM_GUARD: further lines left out, the 10 s line keeps "
+                         "counting");
+    }
+    return mode == 2;
+}
+
+/// The index to read a table of `size` entries with. In range: `index` (one compare, every
+/// mode). Out of range: `fallback` in mode 2, `index` unchanged in modes 0 and 1.
+[[nodiscard]] inline u32 TableIndex(Site site, u32 index, size_t size, u32 fallback) {
+    if (index < size) [[likely]] {
+        return index;
+    }
+    if (Bad(site, index, "table read with the fallback entry")) {
+        Replaced();
+        return fallback;
+    }
+    return index;
+}
+
+/// One call per draw while the mode is not 0: the 10 s line. The clock is read every 1024 draws.
+inline void Tick() {
+    const u64 draws = g_counters.draws.fetch_add(1, std::memory_order_relaxed) + 1;
+    if ((draws & 1023) != 0) {
+        return;
+    }
+    const s64 now = std::chrono::duration_cast<std::chrono::nanoseconds>(
+                        std::chrono::steady_clock::now().time_since_epoch())
+                        .count();
+    s64 last = g_counters.last_line_ns.load(std::memory_order_relaxed);
+    if (last != 0 && now - last < 10'000'000'000LL) {
+        return;
+    }
+    if (!g_counters.last_line_ns.compare_exchange_strong(last, now, std::memory_order_relaxed)) {
+        return;
+    }
+    if (last == 0) {
+        return; // The first check only starts the clock.
+    }
+    const auto& bad = g_counters.bad;
+    const auto n = [&](Site site) {
+        return bad[static_cast<size_t>(site)].load(std::memory_order_relaxed);
+    };
+    LOG_INFO(HW_GPU,
+             "EDEN_UP_DRAW_ENUM_GUARD 10s: mode {}, {} draws seen; out of range since boot: draw "
+             "shape {}, indirect shape {}, texture draw shape {}, override {}, index format "
+             "(draw) {}, index format (size) {}, depth bias table {}, pipeline depth bias table "
+             "{}, pipeline class table {}, cull face {}; draws skipped {}, values replaced {}",
+             Mode(), draws, n(Site::DrawTopology), n(Site::IndirectTopology),
+             n(Site::TextureDrawTopology), n(Site::TopologyOverride), n(Site::IndexFormatDraw),
+             n(Site::IndexFormatSize), n(Site::DepthBiasTable), n(Site::PipelineDepthBiasTable),
+             n(Site::PipelineClassTable), n(Site::CullFaceUnpack),
+             g_counters.draws_skipped.load(std::memory_order_relaxed),
+             g_counters.values_replaced.load(std::memory_order_relaxed));
+}
+
+} // namespace VideoCommon::DrawEnumGuard
