+void Nx2MovieSafeAction(std::atomic<u64>& counter, std::string_view what, std::string_view detail) {
+    const u64 n = counter.fetch_add(1, std::memory_order_relaxed) + 1;
+    if (n <= 32) {
+        LOG_WARNING(HW_GPU, "nx2 movie safe {}: {}{}{} (#{}{})", Nx2MovieSafeMode(), what,
+                    detail.empty() ? "" : ": ", detail, n,
+                    n == 32 ? ", further ones only counted" : "");
+    }
+}
+
+void Nx2MovieSafeReport(bool force) {
+    const int mode = Nx2MovieSafeMode();
+    if (mode == 0) {
+        return;
+    }
+    static std::atomic<s64> last_ns{0};
+    const s64 now = std::chrono::duration_cast<std::chrono::nanoseconds>(
+                        std::chrono::steady_clock::now().time_since_epoch())
+                        .count();
+    s64 last = last_ns.load(std::memory_order_relaxed);
+    if (!force && last != 0 && now - last < 10'000'000'000LL) {
+        return;
+    }
+    if (!last_ns.compare_exchange_strong(last, now, std::memory_order_relaxed) && !force) {
+        return;
+    }
+    if (force) {
+        last_ns.store(now, std::memory_order_relaxed);
+    }
+    const auto& c = g_nx2_movie_safe;
+    LOG_INFO(HW_GPU,
+             "nx2 movie safe {} ({}): bad frames {}, stale-timestamp prunes {}, decoder errors {}, "
+             "exceptions {}, dead decoders {}, empty frames {}",
+             mode, mode == 2 ? "act" : "count only", c.bad_frames.load(), c.stale_pts.load(),
+             c.decoder_errors.load(), c.exceptions.load(), c.dead_decoders.load(),
+             c.empty_frames.load());
+}
