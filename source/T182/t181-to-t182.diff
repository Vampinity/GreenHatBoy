++    // EDEN_UP_L1515_QUERY_CHEAP=1 (zortos293/Lichii #1515, Zortos): queries take their slots'
++    // references where they are recorded (the GPU thread) and drop them where their results land
++    // (the fencing thread), a report at a time: one counter each, on its own cache line, so
++    // neither thread pulls the line from the other at every report. Off: `references` as before.
++    alignas(64) std::atomic<size_t> added{};
++    alignas(64) std::atomic<size_t> dropped{};
