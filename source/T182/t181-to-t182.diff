++        }
++        blocks.clear();
++    }
++    pool.kept_bytes = 0;
++    ++pool.trims;
++}
++
++std::size_t PooledBytes() noexcept {
++    if (!PoolEnabled()) {
++        return 0;
++    }
++    Pool& pool = GetPool();
