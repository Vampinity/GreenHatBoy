++// cap (EDEN_UP_L1520_WORDS_POOL_MIB, default 48 as upstream's classes add up to) and a count line.
++namespace CommandWordsPool {
++namespace {
++
++constexpr std::size_t SmallestBlock = std::size_t{4} << 10;
++constexpr std::size_t ClassCount = 11; ///< Blocks of 4 KiB to 4 MiB, each twice the one before
++constexpr std::size_t MaxBlocksPerClass = 32;
++constexpr std::size_t MaxBytesPerClass = std::size_t{8} << 20;
++
++bool PoolEnabled() {
++    static const bool enabled = [] {
++        const char* const value = std::getenv("EDEN_UP_L1520_WORDS_POOL");
++        return value != nullptr && value[0] == '1';
++    }();
++    return enabled;
++}
++
++std::size_t PoolCapBytes() {
++    static const std::size_t cap = [] {
++        const char* const value = std::getenv("EDEN_UP_L1520_WORDS_POOL_MIB");
++        const long mib = value != nullptr ? std::strtol(value, nullptr, 10) : 48;
++        return static_cast<std::size_t>(mib < 0 ? 0 : (std::min)(mib, 1024L)) << 20;
++    }();
++    return cap;
++}
++
++struct Pool {
++    Pool() {
++        for (auto& blocks : free) {
++            blocks.reserve(MaxBlocksPerClass);
++        }
++    }
++    std::mutex mutex;
++    std::array<std::vector<void*>, ClassCount> free;
++    std::size_t kept_bytes = 0;
++    // Counts for the line (under the mutex).
++    u64 allocations = 0;
++    u64 reused = 0;
++    u64 kept = 0;
++    u64 freed = 0;
++    u64 oversize = 0;
++    u64 trims = 0;
++    std::chrono::steady_clock::time_point last_report{};
++};
++
++Pool& GetPool() {
++    static Pool pool;
++    return pool;
++}
++
++/// The class of a block of `bytes`, ClassCount and over for blocks the pool does not keep.
++std::size_t ClassOf(std::size_t bytes) {
++    const std::size_t blocks = ((std::max<std::size_t>)(bytes, 1) + SmallestBlock - 1) / SmallestBlock;
++    return static_cast<std::size_t>(std::bit_width(blocks - 1));
++}
++
++std::size_t MaxBlocks(std::size_t index) {
++    return (std::min)(MaxBlocksPerClass,
++                      (std::max<std::size_t>)(1, MaxBytesPerClass / SmallestBlock >> index));
++}
++
++/// One "EDEN_UP_L1520_WORDS_POOL:" line every 10 s while blocks are asked for (mutex held).
++void MaybeReport(Pool& pool) {
++    if ((pool.allocations & 0x3ff) != 0) {
++        return;
++    }
++    const auto now = std::chrono::steady_clock::now();
++    if (now - pool.last_report < std::chrono::seconds{10}) {
++        return;
++    }
++    pool.last_report = now;
++    LOG_INFO(HW_GPU,
++             "EDEN_UP_L1520_WORDS_POOL: {} command word blocks asked for, {} reused, {} kept on "
++             "free, {} freed (class or cap full), {} too large to keep, {} trims; {:.1f} MiB kept "
++             "(cap {} MiB)",
++             pool.allocations, pool.reused, pool.kept, pool.freed, pool.oversize, pool.trims,
++             static_cast<double>(pool.kept_bytes) / (1024.0 * 1024.0), PoolCapBytes() >> 20);
++}
++
++} // Anonymous namespace
++
++void* Allocate(std::size_t bytes) {
++    if (!PoolEnabled()) {
++        return ::operator new(bytes);
++    }
++    const std::size_t index = ClassOf(bytes);
++    Pool& pool = GetPool();
++    if (index >= ClassCount) {
++        std::scoped_lock lock{pool.mutex};
++        ++pool.allocations;
++        ++pool.oversize;
++        MaybeReport(pool);
++        return ::operator new(bytes);
++    }
++    {
++        std::scoped_lock lock{pool.mutex};
++        ++pool.allocations;
++        MaybeReport(pool);
++        if (auto& blocks = pool.free[index]; !blocks.empty()) {
++            void* const block = blocks.back();
++            blocks.pop_back();
++            pool.kept_bytes -= SmallestBlock << index;
++            ++pool.reused;
++            return block;
++        }
++    }
++    return ::operator new(SmallestBlock << index);
++}
++
++void Deallocate(void* pointer, std::size_t bytes) noexcept {
++    if (!PoolEnabled()) {
++        ::operator delete(pointer);
++        return;
++    }
++    const std::size_t index = ClassOf(bytes);
++    if (index < ClassCount) {
++        Pool& pool = GetPool();
++        std::scoped_lock lock{pool.mutex};
++        const std::size_t block = SmallestBlock << index;
++        if (auto& blocks = pool.free[index];
++            blocks.size() < MaxBlocks(index) && pool.kept_bytes + block <= PoolCapBytes()) {
++            blocks.push_back(pointer);
++            pool.kept_bytes += block;
++            ++pool.kept;
++            return;
++        }
++        ++pool.freed;
++    }
++    ::operator delete(pointer);
++}
++
++void Trim() noexcept {
++    if (!PoolEnabled()) {
++        return;
++    }
++    Pool& pool = GetPool();
++    std::scoped_lock lock{pool.mutex};
++    for (auto& blocks : pool.free) {
++        for (void* const block : blocks) {
