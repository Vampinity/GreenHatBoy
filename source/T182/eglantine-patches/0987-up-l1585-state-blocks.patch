     bool report_write = false;
     if (fs.control == Regs::ShadowRamControl::Track ||
@@ -2149,7 +2358,14 @@ void Maxwell3D::FrontWrite(VideoCommon::GpuSplit& split, FrontState& fs, u32 met
     // entry. Only a plain Method entry of a state register leaves one there; a Regs or CbData
     // block, a direct (macro) write and an executable method consume the sink when they run.
     bool sink_left = false;
-    if (!execution_mask[method] && split.RegBlocks()) {
+    if (fs.state_blocks && !execution_mask[method] && !back_owned &&
+        fs.control != Regs::ShadowRamControl::Replay) {
+        // EDEN_UP_L1585_STATE_BLOCKS (zortos293/Lichii #1585, 19ae2d1): sent with the state
+        // writes around it, dirty flags and the fast draw check worked out here. The back
+        // consumes its method sink first, so nothing is left in it.
+        split.StateWrite(this, method, value, {dirty.tables[0][method], dirty.tables[1][method]},
+                         !IsFastDrawParameter(method));
+    } else if (!execution_mask[method] && split.RegBlocks()) {
         split.PlainWrite(this, method, argument);
     } else if (method >= cb_data_first && method < cb_data_first + 16 && split.RegBlocks()) {
         split.CbDataWrite(this, method, argument);
diff --git a/src/video_core/engines/maxwell_3d.h b/src/video_core/engines/maxwell_3d.h
