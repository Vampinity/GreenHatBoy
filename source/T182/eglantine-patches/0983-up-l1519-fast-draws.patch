+    struct L1519Stats {
+        u64 checked{};       ///< handle buffers checked over their handle words' span
+        u64 reached{};       ///< a write reached that span
+        u64 word_hits{};     ///< ...and a handle word: full draw (handle data written)
+        u64 between{};       ///< ...only between the words: delta draw kept, no uniform keeps
+        u64 not_linear{};    ///< reached spans that map to more than one run of device memory
+        u64 words_compared{}; ///< merged words compared (EDEN_UP_L1161_DRAW alone translated each)
+        u64 skipped_empty{}; ///< slots with no handle word left (all storage pointers)
+    } l1519_stats;
+    void ReportL1519();
     FastDrawStats fast_draw_stats;
     /// EDEN_UP_TESS_TOPOLOGY: the primitive topology last recorded as dynamic state
     /// (UpdateDynamicStates). Never read or written with the switch off.
