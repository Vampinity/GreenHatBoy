+void RasterizerVulkan::ReportL1519() {
+    // EDEN_UP_L1519_FAST_DRAWS: the first 16 reached checks, then each power of two.
+    const L1519Stats& stats = l1519_stats;
+    if (stats.reached > 16 && (stats.reached & (stats.reached - 1)) != 0) {
+        return;
+    }
+    LOG_INFO(Render_Vulkan,
+             "EDEN_UP_L1519_FAST_DRAWS: handle buffers checked over their words' span {}, a write "
+             "reached the span {} (not one device run {}), reached a handle word {} (full draw), "
+             "only between the words {} (delta kept, no uniform keeps), merged words compared {}, "
+             "slots with no word left {}",
+             stats.checked, stats.reached, stats.not_linear, stats.word_hits, stats.between,
+             stats.words_compared, stats.skipped_empty);
+}
+
 bool RasterizerVulkan::DeltaStillHolds(u64 serial, u64 map_serial) {
     // Lichii #921 (1c25fbdfb4): TakeReusableDraw ran before the caches were locked, while other
     // threads could still write, unmap or delete what the delta draw keeps.
