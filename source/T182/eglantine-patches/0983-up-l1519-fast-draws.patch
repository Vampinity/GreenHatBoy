+        /// EDEN_UP_L1519_FAST_DRAWS: `words` sorted and merged (with EDEN_NX2_NULL_POINTER_HANDLE,
+        /// without the storage pointer words), and the span of each slot's merged words.
+        std::array<std::array<std::vector<std::pair<u32, u32>>,
+                              Tegra::Engines::Maxwell3D::Regs::MaxConstBuffers>,
