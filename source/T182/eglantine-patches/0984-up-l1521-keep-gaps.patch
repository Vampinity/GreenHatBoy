+/// EDEN_UP_L1521_KEEP_GAPS=1 (exact "1") with EDEN_UP_L949_UBO_KEEP=1, read once (zortos293/Lichii
+/// #1521, 45d0fb6, Zortos; from #1161): closes gaps in uniform keeps. Each guest command list
+/// submitted ends them, in order on the split's back (a FastDrawNeutral deferred call; the guest's
+/// CPU writes before a submit go unseen on pages the caches don't watch); DMA copies (also from
+/// memory no GPU wrote), DMA clears and in-place inline uploads are noted as writes to the keeps;
+/// the keep verifier compares only ranges RebindKeptUniform would bind again.
+[[nodiscard]] inline bool L1521KeepGapsEnabled() {
+    static const bool enabled = UboKeepEnabled() && Common::PeSwitch("EDEN_UP_L1521_KEEP_GAPS");
+    return enabled;
+}
+/// EDEN_UP_L1521_KEEP_GAPS: bumped once per guest command list, on the thread that runs the
+/// draws (in order); BufferCache::BeginGraphicsUniforms keeps nothing across a change.
+inline std::atomic<u64> g_keep_submits{0};
+inline void NoteKeepSubmit() {
+    g_keep_submits.fetch_add(1, std::memory_order_relaxed);
+}
