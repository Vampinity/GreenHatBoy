+template <class P>
+void BufferCache<P>::ReportKeepGaps() {
+    const UniformKeep& keep = uniform_keep;
+    const u64 events = keep.gap_submit_ends + keep.gap_dma_copies + keep.gap_dma_clears +
+                       keep.gap_inline + keep.gap_verify_skips;
