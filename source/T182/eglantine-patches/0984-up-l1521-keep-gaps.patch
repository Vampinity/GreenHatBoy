+        return;
+    }
+    LOG_INFO(HW_GPU,
+             "EDEN_UP_L1521_KEEP_GAPS: keeps ended by a submitted list {}, noted writes: DMA "
+             "copies from memory no GPU wrote {}, DMA clears {}, inline uploads in place {}; "
+             "verify skipped {} (kept so far {})",
+             keep.gap_submit_ends, keep.gap_dma_copies, keep.gap_dma_clears, keep.gap_inline,
+             keep.gap_verify_skips, keep.kept);
+}
