+    template <typename... Args>
+    size_t BuildQueryBatched(Args&&... args) {
+        const std::thread::id self = std::this_thread::get_id();
+        std::thread::id owner = builder.load(std::memory_order_relaxed);
+        if (owner == std::thread::id{}) {
