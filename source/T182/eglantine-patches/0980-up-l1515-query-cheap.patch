diff --git a/src/video_core/up_l1515.h b/src/video_core/up_l1515.h
new file mode 100644
index 0000000000..69ee84f78b
--- /dev/null
+++ b/src/video_core/up_l1515.h
@@ -0,0 +1,62 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+// Port of zortos293/Lichii #1515 (5b9012f, Zortos), behind its own switch, read once at boot
+// (exact "1"), off by default:
+//   EDEN_UP_L1515_QUERY_CHEAP=1  cheaper report lookups, frees and locks (query cache)
+// Count lines: each counter logs when it reaches a power of two (1, 2, 4, ...), so a run shows
+// that the switch acted without a timer or a lock.
+
+#pragma once
+
+#include <atomic>
+#include <bit>
+
+#include "common/common_types.h"
+#include "common/logging.h"
+#include "common/pe_switch.h"
+
+namespace VideoCommon::UpL1515 {
+
+[[nodiscard]] inline bool Enabled() noexcept {
+    static const bool on = [] {
+        const bool enabled = Common::PeSwitch("EDEN_UP_L1515_QUERY_CHEAP");
+        if (enabled) {
+            LOG_INFO(HW_GPU, "EDEN_UP_L1515_QUERY_CHEAP=1: split bank references, batched query "
+                             "frees, filtered and probed report walks, batched query ids");
+        }
+        return enabled;
+    }();
+    return on;
+}
+
+enum class Count : u32 {
+    FreeBatches,  ///< UnregisterPending freed a streamer's queries as one batch
+    FreedQueries, ///< queries freed in those batches
+    FilterSkips,  ///< a region walk skipped: no report was ever registered on its pages
+    Probes,       ///< a small region walk looked up its few offsets instead of whole pages
+    IdRefills,    ///< BuildQuery took the streamer's lock to take a batch of free ids
+    ForeignBuild, ///< BuildQuery from a second thread (fully locked from then on)
+    Max,
+};
+
+inline const char* const Names[] = {"free_batches", "freed_queries", "filter_skips",
+                                    "probes",       "id_refills",    "foreign_build"};
+
+struct alignas(64) Counter {
+    std::atomic<u64> value{};
+};
+inline Counter counters[static_cast<u32>(Count::Max)];
+
+inline void Add(Count which, u64 amount = 1) noexcept {
+    const u64 before =
+        counters[static_cast<u32>(which)].value.fetch_add(amount, std::memory_order_relaxed);
+    const u64 after = before + amount;
+    // Logs once each time the count passes a power of two.
+    if (before == 0 || (std::bit_width(before) != std::bit_width(after))) {
+        LOG_INFO(HW_GPU, "EDEN_UP_L1515_QUERY_CHEAP count {}={}", Names[static_cast<u32>(which)],
+                 after);
+    }
+}
