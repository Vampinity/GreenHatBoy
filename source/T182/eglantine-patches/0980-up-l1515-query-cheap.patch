+    // EDEN_UP_L1515_QUERY_CHEAP=1 (zortos293/Lichii #1515, Zortos): queries take their slots'
+    // references where they are recorded (the GPU thread) and drop them where their results land
+    // (the fencing thread), a report at a time: one counter each, on its own cache line, so
+    // neither thread pulls the line from the other at every report. Off: `references` as before.
+    alignas(64) std::atomic<size_t> added{};
+    alignas(64) std::atomic<size_t> dropped{};
+    /// Keeps a derived bank's members off dropped's line.
+    char dropped_padding[64 - sizeof(std::atomic<size_t>)]{};
 
 public:
     explicit BankBase(size_t bank_size_) : base_bank_size{bank_size_}, bank_size(bank_size_) {}
@@ -34,6 +44,8 @@ public:
     virtual void Reset() {
         current_slot = 0;
         references = 0;
+        added = 0;
+        dropped = 0;
         bank_size = base_bank_size;
     }
 
@@ -42,16 +54,37 @@ public:
     }
 
     void AddReference(size_t how_many = 1) {
+        if (UpL1515::Enabled()) {
+            added.fetch_add(how_many, std::memory_order_relaxed);
+            return;
+        }
         references.fetch_add(how_many, std::memory_order_relaxed);
     }
 
     void CloseReference(size_t how_many = 1) {
+        if (UpL1515::Enabled()) {
+            dropped.fetch_add(how_many, std::memory_order_relaxed);
+            return;
+        }
         if (how_many > references.load(std::memory_order_relaxed)) {
             UNREACHABLE();
         }
         references.fetch_sub(how_many, std::memory_order_relaxed);
     }
 
+    /// The references taken and not dropped yet. With EDEN_UP_L1515_QUERY_CHEAP it is called
+    /// where references are taken, so every reference dropped was taken before: more dropped
+    /// than taken is a double free.
+    size_t References() const {
+        if (!UpL1515::Enabled()) {
+            return references.load(std::memory_order_relaxed);
+        }
+        const size_t dropped_now = dropped.load(std::memory_order_acquire);
+        const size_t added_now = added.load(std::memory_order_acquire);
+        ASSERT(dropped_now <= added_now);
+        return added_now - dropped_now;
+    }
+
     void Close() {
         bank_size = current_slot;
     }
@@ -61,7 +94,7 @@ public:
     }
 
     bool IsDead() const {
-        return IsClosed() && references == 0;
+        return IsClosed() && References() == 0;
     }
 };
 
