+/// EDEN_UP_L1520_WORDS_POOL=1 (zortos293/Lichii #1520, 8dcea11, Zortos; from #1161): keeps the
+/// blocks of the command lists' submit-time copies for reuse. The guest's submit thread
+/// allocated ~1000 a second, of up to hundreds of KiB, and the GPU thread freed them (upstream
+/// measured ~30 us a free on the GPU thread in Ocarina of Time, on PC). Blocks of 4 KiB to
+/// 4 MiB are kept by size class, at most EDEN_UP_L1520_WORDS_POOL_MIB (48) in all. Off (the
+/// default): plain ::operator new/delete, as std::allocator.
+namespace CommandWordsPool {
+[[nodiscard]] void* Allocate(std::size_t bytes);
+void Deallocate(void* pointer, std::size_t bytes) noexcept;
+/// Frees the blocks kept for reuse (when a channel goes away).
+void Trim() noexcept;
+/// Bytes kept for reuse.
+[[nodiscard]] std::size_t PooledBytes() noexcept;
+} // namespace CommandWordsPool
+
+template <typename T>
+struct CommandWordsAllocator {
+    using value_type = T;
+
+    CommandWordsAllocator() noexcept = default;
+    template <typename U>
+    CommandWordsAllocator(const CommandWordsAllocator<U>&) noexcept {}
+
+    [[nodiscard]] T* allocate(std::size_t count) {
+        return static_cast<T*>(CommandWordsPool::Allocate(count * sizeof(T)));
