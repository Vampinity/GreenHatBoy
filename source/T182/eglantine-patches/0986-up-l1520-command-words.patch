+// EDEN_UP_L1520_WORDS_POOL (zortos293/Lichii #1520, 8dcea11, Zortos, from #1161): see
+// dma_pusher.h. Ported with the switch (off: ::operator new/delete, as std::allocator), a total
+// cap (EDEN_UP_L1520_WORDS_POOL_MIB, default 48 as upstream's classes add up to) and a count line.
+namespace CommandWordsPool {
+namespace {
+
+constexpr std::size_t SmallestBlock = std::size_t{4} << 10;
+constexpr std::size_t ClassCount = 11; ///< Blocks of 4 KiB to 4 MiB, each twice the one before
+constexpr std::size_t MaxBlocksPerClass = 32;
+constexpr std::size_t MaxBytesPerClass = std::size_t{8} << 20;
+
+bool PoolEnabled() {
+    static const bool enabled = [] {
+        const char* const value = std::getenv("EDEN_UP_L1520_WORDS_POOL");
+        return value != nullptr && value[0] == '1';
+    }();
+    return enabled;
+}
+
+std::size_t PoolCapBytes() {
+    static const std::size_t cap = [] {
+        const char* const value = std::getenv("EDEN_UP_L1520_WORDS_POOL_MIB");
+        const long mib = value != nullptr ? std::strtol(value, nullptr, 10) : 48;
+        return static_cast<std::size_t>(mib < 0 ? 0 : (std::min)(mib, 1024L)) << 20;
+    }();
+    return cap;
+}
+
+struct Pool {
+    Pool() {
+        for (auto& blocks : free) {
+            blocks.reserve(MaxBlocksPerClass);
+        }
+    }
+    std::mutex mutex;
+    std::array<std::vector<void*>, ClassCount> free;
+    std::size_t kept_bytes = 0;
+    // Counts for the line (under the mutex).
+    u64 allocations = 0;
+    u64 reused = 0;
+    u64 kept = 0;
+    u64 freed = 0;
+    u64 oversize = 0;
+    u64 trims = 0;
+    std::chrono::steady_clock::time_point last_report{};
+};
+
+Pool& GetPool() {
+    static Pool pool;
+    return pool;
+}
+
+/// The class of a block of `bytes`, ClassCount and over for blocks the pool does not keep.
+std::size_t ClassOf(std::size_t bytes) {
+    const std::size_t blocks = ((std::max<std::size_t>)(bytes, 1) + SmallestBlock - 1) / SmallestBlock;
+    return static_cast<std::size_t>(std::bit_width(blocks - 1));
+}
+
+std::size_t MaxBlocks(std::size_t index) {
+    return (std::min)(MaxBlocksPerClass,
+                      (std::max<std::size_t>)(1, MaxBytesPerClass / SmallestBlock >> index));
+}
+
+/// One "EDEN_UP_L1520_WORDS_POOL:" line every 10 s while blocks are asked for (mutex held).
+void MaybeReport(Pool& pool) {
+    if ((pool.allocations & 0x3ff) != 0) {
+        return;
+    }
+    const auto now = std::chrono::steady_clock::now();
+    if (now - pool.last_report < std::chrono::seconds{10}) {
+        return;
+    }
+    pool.last_report = now;
+    LOG_INFO(HW_GPU,
+             "EDEN_UP_L1520_WORDS_POOL: {} command word blocks asked for, {} reused, {} kept on "
+             "free, {} freed (class or cap full), {} too large to keep, {} trims; {:.1f} MiB kept "
+             "(cap {} MiB)",
+             pool.allocations, pool.reused, pool.kept, pool.freed, pool.oversize, pool.trims,
+             static_cast<double>(pool.kept_bytes) / (1024.0 * 1024.0), PoolCapBytes() >> 20);
+}
+
+} // Anonymous namespace
+
+void* Allocate(std::size_t bytes) {
+    if (!PoolEnabled()) {
+        return ::operator new(bytes);
+    }
+    const std::size_t index = ClassOf(bytes);
+    Pool& pool = GetPool();
+    if (index >= ClassCount) {
+        std::scoped_lock lock{pool.mutex};
+        ++pool.allocations;
+        ++pool.oversize;
+        MaybeReport(pool);
+        return ::operator new(bytes);
+    }
+    {
+        std::scoped_lock lock{pool.mutex};
+        ++pool.allocations;
+        MaybeReport(pool);
+        if (auto& blocks = pool.free[index]; !blocks.empty()) {
+            void* const block = blocks.back();
+            blocks.pop_back();
+            pool.kept_bytes -= SmallestBlock << index;
+            ++pool.reused;
+            return block;
+        }
+    }
+    return ::operator new(SmallestBlock << index);
+}
+
+void Deallocate(void* pointer, std::size_t bytes) noexcept {
+    if (!PoolEnabled()) {
+        ::operator delete(pointer);
+        return;
+    }
+    const std::size_t index = ClassOf(bytes);
+    if (index < ClassCount) {
+        Pool& pool = GetPool();
+        std::scoped_lock lock{pool.mutex};
+        const std::size_t block = SmallestBlock << index;
+        if (auto& blocks = pool.free[index];
+            blocks.size() < MaxBlocks(index) && pool.kept_bytes + block <= PoolCapBytes()) {
+            blocks.push_back(pointer);
+            pool.kept_bytes += block;
+            ++pool.kept;
+            return;
+        }
+        ++pool.freed;
+    }
+    ::operator delete(pointer);
+}
+
+void Trim() noexcept {
+    if (!PoolEnabled()) {
+        return;
+    }
+    Pool& pool = GetPool();
+    std::scoped_lock lock{pool.mutex};
+    for (auto& blocks : pool.free) {
+        for (void* const block : blocks) {
+            ::operator delete(block);
+        }
+        blocks.clear();
+    }
+    pool.kept_bytes = 0;
+    ++pool.trims;
+}
+
+std::size_t PooledBytes() noexcept {
+    if (!PoolEnabled()) {
+        return 0;
+    }
+    Pool& pool = GetPool();
+    std::scoped_lock lock{pool.mutex};
+    return pool.kept_bytes;
+}
+
+} // namespace CommandWordsPool
+
+namespace {
+
+void CopierPause() {
+#if defined(_M_X64) || defined(__x86_64__)
+    _mm_pause();
+#else
+    std::this_thread::yield();
+#endif
+}
+
+/// EDEN_UP_L1520_ASYNC_COPY (zortos293/Lichii #1520, 8dcea11, Zortos, from #1161): copies the
+/// command lists queued behind a resumed acquire again (DmaPusher::Step) on a thread of its own,
+/// in the order they were queued, while the GPU thread goes on with the list it resumed in and
+/// waits for a list's copy only once it reaches it. Upstream measured the copies at ~13% of the
+/// split front's work at Ocarina of Time's water (PC). Ported with a condition variable for the
+/// sleep instead of std::atomic::wait, and a count line.
+class SnapshotCopier {
+public:
+    struct Job {
+        const MemoryManager* memory;
+        CommandList* list;
+    };
+
+    static SnapshotCopier& Get() {
+        static SnapshotCopier copier;
+        started.store(true, std::memory_order_release);
+        return copier;
+    }
+    [[nodiscard]] static bool Started() {
+        return started.load(std::memory_order_acquire);
+    }
+
+    /// Queues `job`; its number, or 0 when the queue is full.
+    u64 Queue(const Job& job) {
+        std::unique_lock lock{queue_mutex};
+        const u64 queued = published.load(std::memory_order_relaxed);
+        if (queued - completed.load(std::memory_order_acquire) >= Capacity) {
+            ++full;
+            return 0;
+        }
+        jobs[queued % Capacity] = job;
+        published.store(queued + 1, std::memory_order_seq_cst);
+        ++queued_jobs;
+        const bool wake = sleeping;
+        lock.unlock();
+        if (wake) {
+            wake_cv.notify_one();
+        }
+        return queued + 1;
+    }
+
+    /// Waits until job `number` and the ones before it ran.
+    void WaitFor(u64 number) {
+        if (completed.load(std::memory_order_acquire) >= number) {
+            return;
+        }
+        waits.fetch_add(1, std::memory_order_relaxed);
+        for (u32 spins = 0; completed.load(std::memory_order_acquire) < number; ++spins) {
+            if (spins < 4096) {
+                CopierPause();
+            } else {
+                std::this_thread::yield();
+            }
+        }
+    }
+    void WaitIdle() {
+        WaitFor(published.load(std::memory_order_acquire));
+    }
+
+    /// One "EDEN_UP_L1520_ASYNC_COPY:" line every 10 s while jobs are queued (GPU thread).
+    void MaybeReport(u64 refreshed_here) {
+        const auto now = std::chrono::steady_clock::now();
+        if (now - last_report < std::chrono::seconds{10}) {
+            return;
+        }
+        last_report = now;
+        u64 jobs_now;
+        u64 full_now;
+        {
+            std::scoped_lock lock{queue_mutex};
+            jobs_now = queued_jobs;
+            full_now = full;
+        }
+        LOG_INFO(HW_GPU,
+                 "EDEN_UP_L1520_ASYNC_COPY: {} later lists copied on the GPUSnapshot thread, {} "
+                 "copied here (queue full), {} times the GPU thread waited for a copy; {} lists "
+                 "refreshed on the GPU thread at resumes in all",
+                 jobs_now, full_now, waits.load(std::memory_order_relaxed), refreshed_here);
+    }
+
+private:
+    SnapshotCopier() : thread{[this](std::stop_token token) { Loop(token); }} {}
+    ~SnapshotCopier() {
+        thread.request_stop();
+        {
+            std::scoped_lock lock{queue_mutex};
+            sleeping = false;
+        }
+        wake_cv.notify_one();
+    }
+
+    void Loop(std::stop_token token) {
+        Common::SetCurrentThreadName("GPUSnapshot");
+        Common::SetCurrentThreadPriority(Common::ThreadPriority::High);
+        u64 done = 0;
+        while (!token.stop_requested()) {
+            u64 available = published.load(std::memory_order_acquire);
+            for (u32 spins = 0; available == done && spins < 2048; ++spins) {
+                CopierPause();
+                available = published.load(std::memory_order_acquire);
+            }
+            if (available == done) {
+                std::unique_lock lock{queue_mutex};
+                sleeping = true;
+                wake_cv.wait(lock, [this, done, &token] {
+                    return token.stop_requested() ||
+                           published.load(std::memory_order_relaxed) != done;
+                });
+                sleeping = false;
+                continue;
+            }
+            for (; done != available; ++done) {
+                Copy(jobs[done % Capacity]);
+                completed.store(done + 1, std::memory_order_release);
+            }
+        }
+    }
+
+    static void Copy(const Job& job) {
+        CommandList& list = *job.list;
+        for (size_t i = 0; i < list.command_lists.size() && i < list.submitted_offsets.size();
+             ++i) {
+            const CommandListHeader& entry = list.command_lists[i];
+            const u32 offset = list.submitted_offsets[i];
+            if (size_t{offset} + entry.size > list.submitted_words.size()) {
+                continue;
+            }
+            job.memory->ReadBlockUnsafe(entry.addr, list.submitted_words.data() + offset,
+                                        entry.size * sizeof(u32));
+        }
+    }
+
+    static constexpr u64 Capacity = 256;
+    static inline std::atomic<bool> started{};
+    std::mutex queue_mutex; ///< Queue's: jobs, the number it publishes, sleeping, the counts
+    std::condition_variable wake_cv;
+    std::array<Job, Capacity> jobs{};
+    alignas(64) std::atomic<u64> published{};
+    alignas(64) std::atomic<u64> completed{};
+    bool sleeping{};
+    u64 queued_jobs{};
+    u64 full{};
+    std::atomic<u64> waits{};
+    std::chrono::steady_clock::time_point last_report{};
+    std::jthread thread; ///< Last: it starts once the rest is constructed
+};
+
+/// Waits for the snapshot copier's job on `list`, if any: the list's words are needed now, or
+/// about to be copied on this thread.
+void WaitForCopyJob(CommandList& list) {
+    if (list.copy_job != 0) [[unlikely]] {
+        SnapshotCopier::Get().WaitFor(list.copy_job);
+        list.copy_job = 0;
+    }
+}
+
+} // Anonymous namespace
+
+bool DmaPusher::AsyncCopyEnabled() {
+    static const bool enabled = [] {
+        const char* const value = std::getenv("EDEN_UP_L1520_ASYNC_COPY");
+        return value != nullptr && value[0] == '1';
+    }();
+    return enabled;
+}
+
+void DmaPusher::WaitForSnapshotCopies() {
+    if (SnapshotCopier::Started()) {
+        SnapshotCopier::Get().WaitIdle();
+    }
+}
+
+bool DmaPusher::QueueSnapshotCopy(CommandList& list, u64 now) {
+    // An older job on this list (an earlier resume) is in the ring before this one: in order.
+    const u64 number = SnapshotCopier::Get().Queue({&memory_manager, &list});
+    if (number == 0) {
+        return false;
+    }
+    list.copy_job = number;
+    list.snapshot_suspensions = now;
+    // The copy covers them (as RefreshSnapshot clears them).
+    list.deferred_entries.clear();
+    return true;
+}
+
