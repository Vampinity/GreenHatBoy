+    static bool IsFastDrawParameter(u32 method, bool note = true);
     /// Methods fast draw records as light changes (constant buffer data and binds).
     static bool IsFastDrawDeltaMethod(u32 method);
     /// EDEN_UP_L1161_DRAW: a vertex attribute format word while vertex input is dynamic state;
