     // 76548f0bf1 and stephenjayakar's #641/#717). Ported onto this tree's split: CallMethod's
     // state register branch here is ProcessShadowRam, the same-value skip and WriteDirtyRegister
@@ -970,6 +976,15 @@ void Maxwell3D::WriteStateRegisters(Core::System& system, std::span<const u64, 4
         return;
     }
     StoreStateRegisters(flags, writes);
+    // 0986: WriteDirtyRegister's fast draw check also marks the delta for an EDEN_UP_L1161_DRAW
+    // vertex format word (IsL1161VertexFormat); the front's check has no side effect, so here.
+    if (vertex_formats && VideoCommon::Nx2FastDraw::Enabled()) [[unlikely]] {
+        for (const u64 write : writes) {
+            if (IsVertexFormatWord(static_cast<u32>(write))) {
+                static_cast<void>(IsFastDrawParameter(static_cast<u32>(write)));
+            }
+        }
+    }
     if (last_break != NoBreak && VideoCommon::Nx2FastDraw::Enabled()) {
         VideoCommon::Nx2FastDraw::Break(VideoCommon::Nx2FastDraw::Reason::Register, last_break);
     }
@@ -2363,8 +2378,10 @@ void Maxwell3D::FrontWrite(VideoCommon::GpuSplit& split, FrontState& fs, u32 met
         // EDEN_UP_L1585_STATE_BLOCKS (zortos293/Lichii #1585, 19ae2d1): sent with the state
         // writes around it, dirty flags and the fast draw check worked out here. The back
         // consumes its method sink first, so nothing is left in it.
+        // 0986: the check without IsL1161VertexFormat's side effect (the back's delta, marked
+        // where the block is stored).
         split.StateWrite(this, method, value, {dirty.tables[0][method], dirty.tables[1][method]},
-                         !IsFastDrawParameter(method));
+                         !IsFastDrawParameter(method, false), IsVertexFormatWord(method));
     } else if (!execution_mask[method] && split.RegBlocks()) {
         split.PlainWrite(this, method, argument);
     } else if (method >= cb_data_first && method < cb_data_first + 16 && split.RegBlocks()) {
