                IsFastDrawVertexBuffer(method) || IsFastDrawExempt(method) ||
-               IsL974DrawParameter(method) || IsL1161VertexFormat(method);
+               IsL974DrawParameter(method) || IsL1161VertexFormat(method, note);
     }
 }
 
-bool Maxwell3D::IsL1161VertexFormat(u32 method) {
+bool Maxwell3D::IsVertexFormatWord(u32 method) {
+    constexpr u32 first = MAXWELL3D_REG_INDEX(vertex_attrib_format);
+    return method >= first && method < first + Regs::NumVertexAttributes;
+}
+
+bool Maxwell3D::IsL1161VertexFormat(u32 method, bool note) {
     constexpr u32 first = MAXWELL3D_REG_INDEX(vertex_attrib_format);
     const bool light = VideoCommon::Nx2FastDraw::L1161DrawEnabled() &&
            VideoCommon::Nx2FastDraw::g_vertex_formats_dynamic.load(std::memory_order_relaxed) &&
            method >= first && method < first + Regs::NumVertexAttributes;
-    if (light) VideoCommon::Nx2FastDraw::g_delta.vertex_formats_changed = true;
+    if (light && note) VideoCommon::Nx2FastDraw::g_delta.vertex_formats_changed = true;
     return light;
 }
 
@@ -937,7 +942,8 @@ void Maxwell3D::TraceFirstMethodWrite(u32 method, u32 argument) {
 // Lichii PR 184 (commit 4a0bc9a007, with bfc3eb523d for the page limit): macros write constant
 // buffers a word at a time, and each word walked the GPU page table on its own.
 void Maxwell3D::WriteStateRegisters(Core::System& system, std::span<const u64, 4> flags,
-                                    std::span<const u64> writes, u32 last_break) {
+                                    std::span<const u64> writes, u32 last_break,
