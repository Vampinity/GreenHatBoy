-    static bool IsL1161VertexFormat(u32 method);
+    static bool IsL1161VertexFormat(u32 method, bool note = true);
+    /// EDEN_UP_L1585_STATE_BLOCKS (0986): `method` is a vertex attribute format word (no switch read).
+    static bool IsVertexFormatWord(u32 method);
     /// EDEN_UP_L974_CHAIN: report operands, MME memory words (front macros only), the vertex id
